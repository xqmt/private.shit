                        entry.Alpha = 0.0
                        if
                            (entry.IsVault or entry.IsTempBot)
                            and (not activeIds[tagId] or not entry.Adornee or not entry.Adornee.Parent)
                        then
                            table.insert(deadTagIds, tagId)
                        end
                    end
                else
                    if entry.Alpha ~= 0.0 then
                        entry.Alpha = 0.0
                    end
                    if entry.LastVisible then
                        entry.Label.Visible = false
                        entry.LastVisible = false
                    end
                    if entry.Highlight and entry.LastHlEnabled then
                        entry.Highlight.Enabled = false
                        entry.Highlight.Adornee = nil
                        entry.LastHlEnabled = false
                        entry.LastHlAdornee = nil
                    end
                    vaultCtx.HideBoxes(entry)
