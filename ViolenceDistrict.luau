        local function scanScreenGuiWidgets(screenGui)
            if not screenGui or not screenGui:IsA("ScreenGui") or isBlacklistedGui(screenGui) then
                return
            end
            for _, child in ipairs(screenGui:GetChildren()) do
                if child:IsA("GuiObject") and not isBlacklistedGui(child) then
                    if isFullScreenWrapper(child) then
                        for _, sub in ipairs(child:GetChildren()) do
                            if sub:IsA("GuiObject") and not isBlacklistedGui(sub) then
                                if isFullScreenWrapper(sub) then
                                    for _, sub2 in ipairs(sub:GetChildren()) do
                                        if isEligibleHudWidget(sub2) then
                                            registerElement(sub2)
                                        end
                                    end
                                elseif isEligibleHudWidget(sub) then
                                    registerElement(sub)
                                end
                            end
                        end
                    elseif isEligibleHudWidget(child) then
                        registerElement(child)
                    end
                end
            end
        end

