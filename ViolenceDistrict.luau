        local teamObj = player:FindFirstChild("Team")
        if
            teamObj
            and (
                teamObj:FindFirstChild("Survivors")
                or teamObj:FindFirstChild("Survivor")
                or (teamObj:IsA("ValueBase") and (teamObj.Value == "Survivors" or teamObj.Value == "Survivor"))
            )
        then
            return true
        end
        local char = player.Character or workspace:FindFirstChild(player.Name)
        if
            char
            and (
                char:FindFirstChild("SurvivorScript")
                or char:FindFirstChild("SurvivorRoot")
                or (char:FindFirstChild("Health") and not char:FindFirstChild("MorphedKiller"))
            )
        then
