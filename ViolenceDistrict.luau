    local function applyTabIconColor(tabId, color, duration)
        local targets = tabIconTargets[tabId]
        if not targets then
            return
        end
        for i = 1, #targets.strokes do
            local st = targets.strokes[i]
            if duration and duration > 0 then
                Tween(st, { Color = color }, duration)
            else
                st.Color = color
            end
        end
        for i = 1, #targets.fills do
            local fl = targets.fills[i]
            if duration and duration > 0 then
                Tween(fl, { BackgroundColor3 = color }, duration)
            else
                fl.BackgroundColor3 = color
            end
        end
    end

    local function buildTabIcon(parentBtn, tabId)
        local holder = Instance.new("Frame")
        holder.Name = "VectorIcon"
        holder.AnchorPoint = Vector2.new(0.5, 0.5)
        holder.Position = UDim2.new(0.5, 0, 0.5, 0)
        holder.Size = UDim2.new(0, 18, 0, 18)
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.Parent = parentBtn
        local strokes = {}
        local fills = {}

        local function addStrokeBox(x, y, w, h, radius, thick, zIdx, maskBg)
            local f = Instance.new("Frame", holder)
            f.Position = UDim2.new(0, x, 0, y)
            f.Size = UDim2.new(0, w, 0, h)
            f.BorderSizePixel = 0
            f.ZIndex = zIdx or 1
            if maskBg then
                f.BackgroundColor3 = Palette.SidebarBg
                f.BackgroundTransparency = 0
                ThemeBind(f, "BackgroundColor3", "SidebarBg")
            else
                f.BackgroundTransparency = 1
            end
            if radius and radius > 0 then
                local c = Instance.new("UICorner", f)
                c.CornerRadius = (radius >= 99) and UDim.new(1, 0) or UDim.new(0, radius)
            end
            local s = Instance.new("UIStroke", f)
            s.Color = Palette.TabDim
            s.Thickness = thick or 1.2
            table.insert(strokes, s)
            return f
        end

        local function addFillBox(x, y, w, h, radius, zIdx)
            local f = Instance.new("Frame", holder)
            f.Position = UDim2.new(0, x, 0, y)
            f.Size = UDim2.new(0, w, 0, h)
            f.BackgroundColor3 = Palette.TabDim
            f.BackgroundTransparency = 0
            f.BorderSizePixel = 0
            f.ZIndex = zIdx or 1
            if radius and radius > 0 then
                local c = Instance.new("UICorner", f)
                c.CornerRadius = (radius >= 99) and UDim.new(1, 0) or UDim.new(0, radius)
            end
            table.insert(fills, f)
            return f
        end
        if tabId == "Dashboard" then
            addStrokeBox(3, 3, 4, 5, 1, 1.2, 1)
            addStrokeBox(3, 12, 4, 3, 1, 1.2, 1)
            addStrokeBox(11, 3, 4, 3, 1, 1.2, 1)
            addStrokeBox(11, 10, 4, 5, 1, 1.2, 1)
        elseif tabId == "Visuals" then
            addStrokeBox(2, 5, 14, 8, 99, 1.25, 1)
            addStrokeBox(6.5, 6.5, 5, 5, 99, 1.2, 2)
            addFillBox(8, 8, 2, 2, 99, 3)
        elseif tabId == "Combat" then
            addStrokeBox(4, 4, 10, 10, 99, 1.25, 1)
            addFillBox(8, 1, 2, 4, 99, 2)
            addFillBox(8, 13, 2, 4, 99, 2)
            addFillBox(1, 8, 4, 2, 99, 2)
            addFillBox(13, 8, 4, 2, 99, 2)
            addFillBox(8, 8, 2, 2, 99, 2)
        elseif tabId == "Misc" then
            addFillBox(2, 3.25, 14, 1.5, 99, 1)
            addStrokeBox(10.5, 2.25, 3.5, 3.5, 99, 1.25, 2, true)
            addFillBox(2, 8.25, 14, 1.5, 99, 1)
            addStrokeBox(4.5, 7.25, 3.5, 3.5, 99, 1.25, 2, true)
            addFillBox(2, 13.25, 14, 1.5, 99, 1)
            addStrokeBox(9.5, 12.25, 3.5, 3.5, 99, 1.25, 2, true)
        elseif tabId == "Lobby Statistics" then
            addFillBox(2, 15, 14, 1.5, 99, 1)
            addFillBox(3, 9, 2.5, 5, 1, 1)
            addFillBox(7.75, 3, 2.5, 11, 1, 1)
            addFillBox(12.5, 6, 2.5, 8, 1, 1)
        else
            addStrokeBox(3, 4, 4, 2, 1, 1.2, 1)
            addStrokeBox(3, 6, 12, 8, 1, 1.2, 2, true)
            addFillBox(5.5, 9.5, 7, 1.2, 99, 3)
        end
        tabIconTargets[tabId] = { strokes = strokes, fills = fills }
        return holder
    end

    local function SwitchTab(tabId)
        if
            Hypnosis.CurrentTab == tabId
            and Hypnosis.TabPages[tabId]
            and Hypnosis.TabPages[tabId].Visible
            and Hypnosis.TabPages[tabId].GroupTransparency == 0
        then
            return
        end
        Hypnosis.CurrentTab = tabId
        if HeaderTitle then
            HeaderTitle.Text = "<b>" .. tostring(tabId) .. "</b>"
        end
        for id, page in pairs(Hypnosis.TabPages) do
            if id == tabId then
                page.Visible = true
                page.GroupTransparency = 0
                Tween(page, { GroupTransparency = 0 }, 0.15)
            else
                page.Visible = false
            end
        end
        for id, btn in pairs(Hypnosis.TabButtons) do
            local isSel = (id == tabId)
            applyTabIconColor(id, isSel and Palette.TabActive or Palette.TabDim, 0.12)
            local bar = btn:FindFirstChild("ActiveBar")
            if bar then
                Tween(bar, { BackgroundTransparency = isSel and 0 or 1 }, 0.12)
            end
            btn.BackgroundTransparency = 1
        end
    end

