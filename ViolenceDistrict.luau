                end)
                local activeInput = nil
                local startMouse = nil
                local startLeft, startTop = 0, 0
                local hasDragged = false
                dragBox.InputBegan:Connect(function(input)
                    if
                        input.UserInputType ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType ~= Enum.UserInputType.Touch
                    then
                        return
                    end
                    isDraggingNotifBox = true
                    activeInput = input
                    startMouse = input.Position
                    startLeft = dragBox.Position.X.Offset
                    startTop = dragBox.Position.Y.Offset
                    hasDragged = false
                end)
                table.insert(
                    Hypnosis.Connections,
                    UserInputService.InputChanged:Connect(function(input)
                        if not isDraggingNotifBox then
                            return
                        end
                        if input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement then
                            local cam = workspace.CurrentCamera or Camera
                            local vp = cam and cam.ViewportSize or ViewportSize or Vector2.new(1280, 720)
                            local w = dragBox.Size.X.Offset
                            local delta = input.Position - startMouse
                            if math.abs(delta.X) > 2 or math.abs(delta.Y) > 2 then
                                hasDragged = true
                            end
                            local newLeft =
                                math.clamp(math.floor(startLeft + delta.X + 0.5), 6, math.max(6, vp.X - w - 6))
                            local newTop =
                                math.clamp(math.floor(startTop + delta.Y + 0.5), 6, math.max(6, vp.Y - 46 - 6))
                            dragBox.Position = UDim2.new(0, newLeft, 0, newTop)
                        end
                    end)
                )
                table.insert(
                    Hypnosis.Connections,
                    UserInputService.InputEnded:Connect(function(input)
                        if not isDraggingNotifBox then
                            return
                        end
                        if
                            input ~= activeInput
                            and input.UserInputType ~= Enum.UserInputType.MouseButton1
                            and input.UserInputType ~= Enum.UserInputType.Touch
                        then
                            return
                        end
                        isDraggingNotifBox = false
                        activeInput = nil
                        if hasDragged and dragBox and dragBox.Parent then
                            local cam = workspace.CurrentCamera or Camera
                            local vp = cam and cam.ViewportSize or ViewportSize or Vector2.new(1280, 720)
                            local w = dragBox.Size.X.Offset
                            local left = dragBox.Position.X.Offset
                            local top = dragBox.Position.Y.Offset
                            local centerX = left + w * 0.5
                            local centerY = top + 23
                            local ax = (centerX < vp.X * 0.35 and 0) or (centerX > vp.X * 0.65 and 1) or 0.5
                            local ay = (centerY < vp.Y * 0.50 and 0) or 1
                            local edgeX = (ax == 0 and left) or (ax == 1 and (left + w)) or centerX
                            local edgeY = (ay == 0 and top) or (top + 46)
                            local xs = math.clamp(math.floor((edgeX / math.max(vp.X, 1)) * 10000 + 0.5) / 10000, 0, 1)
                            local ys = math.clamp(math.floor((edgeY / math.max(vp.Y, 1)) * 10000 + 0.5) / 10000, 0, 1)
                            UpdateSetting(
                                "Notifications_CustomAnchor",
                                { XScale = xs, YScale = ys, AlignX = ax, AlignY = ay }
                            )
                            UpdateSetting("Notifications_OffsetX", 0)
                            UpdateSetting("Notifications_OffsetY", 0)
                            UpdateSetting("Notifications_Placement", "Custom")
                            if Hypnosis.Setters["Notifications_OffsetX"] then
                                pcall(Hypnosis.Setters["Notifications_OffsetX"], 0)
                            end
                            if Hypnosis.Setters["Notifications_OffsetY"] then
                                pcall(Hypnosis.Setters["Notifications_OffsetY"], 0)
                            end
                            if Hypnosis.Setters["Notifications_Placement"] then
                                pcall(Hypnosis.Setters["Notifications_Placement"], "Custom")
                            end
                            if Hypnosis.SyncNotificationSettings then
                                Hypnosis.SyncNotificationSettings()
                            end
                        end
                    end)
                )
                return dragBox
            end

