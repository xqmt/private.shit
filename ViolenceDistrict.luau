            end
        end)
        local lastKillerScourgeCheck = 0
        local cachedKillerHasScourge = false

        local function checkKillerHasScourge()
            local now = os.clock()
            if now - lastKillerScourgeCheck < 3.0 then
                return cachedKillerHasScourge
            end
            lastKillerScourgeCheck = now
            for _, p in ipairs(Players:GetPlayers()) do
                local char = p.Character
                if
                    char
                    and (
                        char:FindFirstChild("King's Scourge", true)
                        or (
                            p.Team
                            and string.find(string.lower(p.Team.Name), "killer")
                            and p:FindFirstChild("King's Scourge", true)
                        )
                    )
                then
                    cachedKillerHasScourge = true
                    return true
                end
            end
            cachedKillerHasScourge = false
            return false
        end
        local lastHighProgGenCheck = 0
        local cachedNearHighProgGen = false

        local function isGenModelHighProgress(desc, rootPos)
            if not isGeneratorModel(desc) then
                return false
            end
            local pos = getPosition(desc)
            if pos and (pos - rootPos).Magnitude <= 15 then
                local prog = desc:GetAttribute("RepairProgress") or desc:GetAttribute("Progress")
                if not prog then
                    local c = desc:FindFirstChild("RepairProgress") or desc:FindFirstChild("Progress")
                    if c and c:IsA("ValueBase") then
                        prog = c.Value
                    end
                end
                local n = tonumber(prog)
                if n and (n >= 80 or (n <= 1.01 and n >= 0.80)) then
                    return true
                end
            end
            return false
        end

        local function isNearHighProgressGen()
            local now = os.clock()
            if now - lastHighProgGenCheck < 0.25 then
                return cachedNearHighProgGen
            end
            lastHighProgGenCheck = now
            local char = LocalPlayer and LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then
                cachedNearHighProgGen = false
                return false
            end
            local map = workspace:FindFirstChild("Map")
                or workspace:FindFirstChild("CurrentMap")
                or workspace:FindFirstChild("map")
            if not map then
                cachedNearHighProgGen = false
                return false
            end
            local rootPos = root.Position
            local sharedGens = (Hypnosis._CachedMap == map) and Hypnosis._CachedGenerators
            if sharedGens then
                for _, gen in ipairs(sharedGens) do
                    if isGenModelHighProgress(gen, rootPos) then
                        cachedNearHighProgGen = true
                        return true
                    end
                end
            else
                for _, desc in ipairs(map:GetDescendants()) do
                    if isGenModelHighProgress(desc, rootPos) then
                        cachedNearHighProgGen = true
                        return true
                    end
                end
            end
            cachedNearHighProgGen = false
            return false
        end

        local function isKingsScourgeEngaged()
            if isKingsScourgeActive then
                if os.clock() - kingsScourgeStartTime < 25 then
                    return true
                else
                    isKingsScourgeActive = false
                end
            end
            if (cachedKillerHasScourge or checkKillerHasScourge()) and isNearHighProgressGen() then
                return true
            end
            return false
        end
        local isInputHeld = false
