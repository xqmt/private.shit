        end

        local function isOwnConnection(fn)
            if not ownScriptEnv or type(fn) ~= "function" then
                return false
            end
            local okEnv, fEnv = pcall(getfenv, fn)
            return okEnv and fEnv == ownScriptEnv
        end
        local canaryTarget = nil
        local canarySeen = false
        local vimWatchKey = nil
        local vimWatchType = nil
        local vimWatchSeen = false
        table.insert(
            Hypnosis.Connections,
            UserInputService.InputBegan:Connect(function(inputObj, gpe)
                if Hypnosis._Unloaded then
                    return
                end
                if canaryTarget and inputObj == canaryTarget then
                    canarySeen = true
                elseif not gpe and inputObj then
                    if vimWatchKey and inputObj.KeyCode == vimWatchKey then
                        vimWatchSeen = true
                    elseif vimWatchType and inputObj.UserInputType == vimWatchType then
                        vimWatchSeen = true
