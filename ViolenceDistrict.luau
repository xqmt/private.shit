            end
            if #tier2Hl > 1 then
                table.sort(tier2Hl, vaultCtx.CompareDist)
            end
            vaultCtx.RefreshExtHl()
            local occupiedHls = math.max(vaultCtx.ExtActiveCount or 0, vaultCtx.NoAuraCount or 0)
            local maxEngineHighlights = math.clamp(29 - occupiedHls, 0, 26)
            local activeHighlightCount = 0
            for i = 1, #tier1Hl do
                if activeHighlightCount >= maxEngineHighlights then
                    break
                end
                grantedHl[tier1Hl[i]] = true
                activeHighlightCount = activeHighlightCount + 1
            end
            for i = 1, #tier2Hl do
                if activeHighlightCount >= maxEngineHighlights then
                    break
                end
                grantedHl[tier2Hl[i]] = true
                activeHighlightCount = activeHighlightCount + 1
            end
            local hlEnableQueue = vaultCtx.HlEnable
            local hlEnableCount = 0
            for _, entry in pairs(TagPool) do
                if entry.Alpha > 0.01 then
                    local wantsHl = (entry.HighlightEnabled == true)
                        and (entry.Adornee ~= nil)
                        and (entry.Adornee.Parent ~= nil)
                        and (entry.Alpha > 0.1)
                    local targetHlEnabled = wantsHl and (entry.Highlight ~= nil) and (grantedHl[entry] == true)
                    local hlTarget = entry.HlAdornee or entry.Adornee
                    if targetHlEnabled and (not hlTarget or not hlTarget.Parent) then
                        targetHlEnabled = false
                    end
                    local baseFillColor = entry.FillColor or entry.HighlightColor or Color3.fromRGB(255, 255, 255)
                    local finalOutlineColor = entry.OutlineColor or Color3.fromRGB(255, 255, 255)
                    local baseFillTrans = math.clamp(entry.FillTrans or entry.HighlightTrans or 0.5, 0, 1)
                    local targetFillTrans = 1 - (entry.Alpha * (1 - baseFillTrans))
                    local baseOutlineTrans = math.clamp(entry.OutlineTrans or 0.0, 0, 1)
                    local targetOutlineTrans = 1 - (entry.Alpha * (1 - baseOutlineTrans))
                    if targetHlEnabled and entry.Highlight then
                        hlEnableCount = hlEnableCount + 1
                        hlEnableQueue[hlEnableCount] = entry
                        entry._PendHlTarget = hlTarget
                        entry._PendFillColor = baseFillColor
                        entry._PendOutlineColor = finalOutlineColor
                        entry._PendFillTrans = targetFillTrans
                        entry._PendOutlineTrans = targetOutlineTrans
                    elseif entry.Highlight then
                        if entry.LastHlEnabled then
                            entry.Highlight.Enabled = false
                            entry.LastHlEnabled = false
                        end
                        if entry.LastHlAdornee ~= nil then
                            entry.Highlight.Adornee = nil
                            entry.LastHlAdornee = nil
                        end
                    end
                    if entry.IsVault then
                        local useFallback = wantsHl and not targetHlEnabled
                        vaultCtx.ApplyBoxes(
                            entry,
                            useFallback,
                            baseFillColor,
                            finalOutlineColor,
                            targetFillTrans,
                            targetOutlineTrans
                        )
                    end
                end
            end
            for i = 1, hlEnableCount do
                local entry = hlEnableQueue[i]
                local hl = entry.Highlight
                local hlTarget = entry._PendHlTarget
                local baseFillColor = entry._PendFillColor
                local finalOutlineColor = entry._PendOutlineColor
                local targetFillTrans = entry._PendFillTrans
                local targetOutlineTrans = entry._PendOutlineTrans
                if entry.LastHlAdornee ~= hlTarget then
                    hl.Adornee = hlTarget
                    entry.LastHlAdornee = hlTarget
                end
                if entry.LastFillColor ~= baseFillColor then
                    hl.FillColor = baseFillColor
                    entry.LastFillColor = baseFillColor
                end
                if entry.LastOutlineColor ~= finalOutlineColor then
                    hl.OutlineColor = finalOutlineColor
                    entry.LastOutlineColor = finalOutlineColor
                end
                if math.abs(entry.LastFillTrans - targetFillTrans) > 0.02 or entry.Alpha == 1.0 then
                    hl.FillTransparency = targetFillTrans
                    entry.LastFillTrans = targetFillTrans
                end
                if math.abs(entry.LastOutlineTrans - targetOutlineTrans) > 0.02 or entry.Alpha == 1.0 then
                    hl.OutlineTransparency = targetOutlineTrans
                    entry.LastOutlineTrans = targetOutlineTrans
                end
                if not entry.LastHlEnabled then
                    hl.Enabled = true
                    entry.LastHlEnabled = true
                end
                hlEnableQueue[i] = nil
            end
            for i = 1, #deadTagIds do
                local deadId = deadTagIds[i]
                local deadEntry = TagPool[deadId]
                if deadEntry then
                    if deadEntry.Highlight then
                        pcall(function()
                            deadEntry.Highlight.Enabled = false
                            deadEntry.Highlight.Adornee = nil
                            deadEntry.Highlight:Destroy()
                        end)
                    end
                    if deadEntry.Label then
                        pcall(function()
                            deadEntry.Label:Destroy()
                        end)
                    end
                    if deadEntry.FallbackBoxes then
                        for j = 1, #deadEntry.FallbackBoxes do
                            local b = deadEntry.FallbackBoxes[j]
                            if b then
                                pcall(function()
                                    b.Visible = false
                                    b.Adornee = nil
                                    b:Destroy()
                                end)
                            end
                        end
                    end
                    TagPool[deadId] = nil
                end
            end
        end)
    end

    function Hypnosis.InitEnvironmentOverrides()
        local Lighting = game:GetService("Lighting")
        local isApplyingEnvLighting = false
        local isApplyingFov = false
        local origCameraFov = (workspace.CurrentCamera and workspace.CurrentCamera.FieldOfView) or 70
        local origLighting = {
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            Brightness = Lighting.Brightness,
            ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart,
            FogColor = Lighting.FogColor,
            GlobalShadows = Lighting.GlobalShadows,
            ExposureCompensation = Lighting.ExposureCompensation,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        }
        local origAtmosphere = {}

        local function registerAtmosphere(obj)
            if obj and obj:IsA("Atmosphere") and not origAtmosphere[obj] then
                origAtmosphere[obj] = {
                    Density = obj.Density,
                    Offset = obj.Offset,
                    Haze = obj.Haze,
                    Glare = obj.Glare,
                    Color = obj.Color,
                    Decay = obj.Decay,
                }
            end
        end
        local origGameCC = {}
        local customCC = Lighting:FindFirstChild("MinimalistUI_CC")
        if not customCC then
            customCC = Instance.new("ColorCorrectionEffect")
            customCC.Name = "MinimalistUI_CC"
            customCC.Enabled = false
            customCC.Parent = Lighting
        end

        local function registerGameCC(obj)
            if obj and obj:IsA("ColorCorrectionEffect") and obj ~= customCC and not origGameCC[obj] then
                origGameCC[obj] = {
                    Brightness = obj.Brightness,
                    Contrast = obj.Contrast,
                    Saturation = obj.Saturation,
                    TintColor = obj.TintColor,
                    Enabled = obj.Enabled,
                }
            end
        end
        local origDof = {}

        local function registerDof(obj)
            if obj and obj:IsA("DepthOfFieldEffect") and not origDof[obj] then
                origDof[obj] = {
                    Enabled = obj.Enabled,
                    FarIntensity = obj.FarIntensity,
                    NearIntensity = obj.NearIntensity,
                    InFocusRadius = obj.InFocusRadius,
                    FocusDistance = obj.FocusDistance,
                }
            end
        end

        local function scanLightingAndCamera()
            for _, desc in ipairs(Lighting:GetDescendants()) do
                registerAtmosphere(desc)
                registerGameCC(desc)
                registerDof(desc)
            end
            local cam = workspace.CurrentCamera or Camera
            if cam then
                for _, desc in ipairs(cam:GetDescendants()) do
                    registerGameCC(desc)
                    registerDof(desc)
                end
            end
        end
        scanLightingAndCamera()
        local origMaxZoom = LocalPlayer and LocalPlayer.CameraMaxZoomDistance or 128
        local origMinZoom = LocalPlayer and LocalPlayer.CameraMinZoomDistance or 0.5

        local function isFullBrightActive()
            return (Hypnosis.Settings["Environment Overrides_Enabled"] == true)
                and (
                    Hypnosis.Settings["Environment Overrides_Full Bright"] == true
                    or Hypnosis.Settings["Full Bright"] == true
                )
        end

        local function isNoFogActive()
            return (Hypnosis.Settings["Environment Overrides_Enabled"] == true)
                and (Hypnosis.Settings["Environment Overrides_No Fog"] == true or Hypnosis.Settings["No Fog"] == true)
        end

        local function isNoDofActive()
            return (Hypnosis.Settings["Environment Overrides_Enabled"] == true)
                and (
                    Hypnosis.Settings["Environment Overrides_No Depth of Field (DOF)"] == true
                    or Hypnosis.Settings["No Depth of Field (DOF)"] == true
                )
        end

        local function isEnvFovActive()
            if Hypnosis.Settings["Environment Overrides_Enabled"] ~= true then
                return false
            end
            if Hypnosis.Settings["Environment Overrides_FOV_Enabled"] == false then
                return false
            end
            return true
        end
        Hypnosis.IsEnvFovActive = isEnvFovActive

        local function getTargetFov()
            local fovVal = Hypnosis.Settings["Environment Overrides_Field of View"]
            if fovVal == nil then
                fovVal = Hypnosis.Settings["Field of View"]
            end
            if fovVal == nil then
                fovVal = 96
            end
            return math.clamp(tonumber(fovVal) or 96, 40, 120)
        end
        local lightChangedConn = Lighting.Changed:Connect(function(prop)
            if isApplyingEnvLighting or Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local fb = isFullBrightActive()
            local nf = isNoFogActive()
            if
                prop == "Ambient"
                or prop == "OutdoorAmbient"
                or prop == "Brightness"
                or prop == "ClockTime"
                or prop == "GlobalShadows"
                or prop == "ExposureCompensation"
                or prop == "EnvironmentDiffuseScale"
                or prop == "EnvironmentSpecularScale"
            then
                if not fb then
                    pcall(function()
                        origLighting[prop] = Lighting[prop]
                    end)
                end
            elseif prop == "FogEnd" or prop == "FogStart" then
                if not fb and not nf then
                    pcall(function()
                        origLighting[prop] = Lighting[prop]
                    end)
                end
            end
        end)
        table.insert(Hypnosis.Connections, lightChangedConn)
        local lightDescConn = Lighting.DescendantAdded:Connect(function(desc)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            registerAtmosphere(desc)
            registerGameCC(desc)
            registerDof(desc)
        end)
        table.insert(Hypnosis.Connections, lightDescConn)

        function Hypnosis.UpdateColorCorrection(on)
            if not customCC or not customCC.Parent then
                customCC = Lighting:FindFirstChild("MinimalistUI_CC") or Instance.new("ColorCorrectionEffect")
                customCC.Name = "MinimalistUI_CC"
                customCC.Parent = Lighting
            end
            if on then
                local br = tonumber(Hypnosis.Settings["Color Correction_Brightness"])
                if br == nil then
                    br = -0.05
                end
                local ct = tonumber(Hypnosis.Settings["Color Correction_Contrast"])
                if ct == nil then
                    ct = 0.15
                end
                local sat = tonumber(Hypnosis.Settings["Color Correction_Saturation"])
                if sat == nil then
                    sat = -0.70
                end
                local tint = Hypnosis.Settings["Color Correction_Tint Color"]
                if type(tint) == "table" and #tint >= 3 then
                    tint = Color3.new(tint[1], tint[2], tint[3])
                elseif typeof(tint) ~= "Color3" then
                    tint = Color3.fromRGB(255, 255, 255)
                end
                customCC.Brightness = math.clamp(br, -1, 1)
                customCC.Contrast = math.clamp(ct, -1, 1)
                customCC.Saturation = math.clamp(sat, -1, 1)
                customCC.TintColor = tint
                customCC.Enabled = true
                for cc, props in pairs(origGameCC) do
                    if cc and cc.Parent and cc ~= customCC then
                        cc.Enabled = false
                    end
                end
            else
                customCC.Enabled = false
                for cc, props in pairs(origGameCC) do
                    if cc and cc.Parent and cc ~= customCC then
                        cc.Brightness = props.Brightness
                        cc.Contrast = props.Contrast
                        cc.Saturation = props.Saturation
                        cc.TintColor = props.TintColor
                        cc.Enabled = props.Enabled
                    end
                end
            end
        end

        function Hypnosis.UpdateAtmosphere(on)
            local a = Lighting:FindFirstChildOfClass("Atmosphere")
            if on then
                if not a then
                    a = Instance.new("Atmosphere", Lighting)
                end
                registerAtmosphere(a)
                local col = Hypnosis.Settings["Atmosphere_Color"]
                if type(col) == "table" and #col >= 3 then
                    col = Color3.new(col[1], col[2], col[3])
                elseif typeof(col) ~= "Color3" then
                    col = Color3.fromRGB(200, 200, 220)
                end
                local dec = Hypnosis.Settings["Atmosphere_Decay"]
                if type(dec) == "table" and #dec >= 3 then
                    dec = Color3.new(dec[1], dec[2], dec[3])
                elseif typeof(dec) ~= "Color3" then
                    dec = Color3.fromRGB(120, 120, 140)
                end
                local gl = tonumber(Hypnosis.Settings["Atmosphere_Glare"]) or 0.17
                local hz = tonumber(Hypnosis.Settings["Atmosphere_Haze"]) or 10.00
                local den = tonumber(Hypnosis.Settings["Atmosphere_Density"]) or 0.51
                local off = tonumber(Hypnosis.Settings["Atmosphere_Offset"]) or 0.00
                a.Color = col
                a.Decay = dec
                a.Glare = gl
                a.Haze = hz
                a.Density = den
                a.Offset = off
            else
                local hasRestored = false
                for child, props in pairs(origAtmosphere) do
                    if child and child.Parent then
                        child.Color = props.Color
                        child.Decay = props.Decay
                        child.Glare = props.Glare
                        child.Haze = props.Haze
                        child.Density = props.Density
                        child.Offset = props.Offset
                        hasRestored = true
                    end
                end
                pcall(function()
                    local defFogStart = (
                        origLighting.FogStart
                        and origLighting.FogStart < 2000
                        and origLighting.FogStart
                    ) or 0
                    local defFogEnd = (origLighting.FogEnd and origLighting.FogEnd < 10000 and origLighting.FogEnd)
                        or 600
                    Lighting.FogStart = defFogStart
                    Lighting.FogEnd = defFogEnd
                    Lighting.FogColor = origLighting.FogColor or Color3.fromRGB(130, 135, 145)
                    if a and not hasRestored then
                        a.Density = 0.35
                        a.Haze = 2.0
                        a.Glare = 0.0
                        a.Color = Color3.fromRGB(190, 195, 205)
                        a.Decay = Color3.fromRGB(100, 105, 115)
                    end
                end)
            end
        end
        local trackedFocus = nil
        local trackedVelocity = Vector3.zero
        local visualShift = Vector3.zero
        local lastTargetFocus = nil
        local lastTargetTime = os.clock()

        local function restoreCleanCameraMatrix(cam)
            if not cam then
                return
            end
            local cf = cam.CFrame
            if cf.X == cf.X and cf.Y == cf.Y and cf.Z == cf.Z then
                local r = cf.RightVector
                local u = cf.UpVector
                if r.Magnitude > 0.01 and u.Magnitude > 0.01 then
                    cam.CFrame = CFrame.fromMatrix(cf.Position, r.Unit, u.Unit)
                end
            end
        end

        local function restoreLightingProperties(restoreFb, restoreFog, restoreDof)
            isApplyingEnvLighting = true
            pcall(function()
                if restoreFb then
                    Lighting.Ambient = origLighting.Ambient
                    Lighting.OutdoorAmbient = origLighting.OutdoorAmbient
                    Lighting.Brightness = origLighting.Brightness
                    Lighting.ClockTime = origLighting.ClockTime
                    Lighting.GlobalShadows = origLighting.GlobalShadows
                    Lighting.ExposureCompensation = origLighting.ExposureCompensation
                    Lighting.EnvironmentDiffuseScale = origLighting.EnvironmentDiffuseScale
                    Lighting.EnvironmentSpecularScale = origLighting.EnvironmentSpecularScale
                    if Hypnosis.Settings["Color Correction_Enabled"] ~= true then
                        for cc, props in pairs(origGameCC) do
                            if cc and cc.Parent and cc ~= customCC then
                                cc.Brightness = props.Brightness
                                cc.Contrast = props.Contrast
                                cc.Saturation = props.Saturation
                                cc.TintColor = props.TintColor
                                cc.Enabled = props.Enabled
                            end
                        end
                    end
                end
                if restoreFog then
                    Lighting.FogEnd = origLighting.FogEnd
                    Lighting.FogStart = origLighting.FogStart
                end
                if
                    (restoreFb or restoreFog)
                    and not isFullBrightActive()
                    and not isNoFogActive()
                    and Hypnosis.Settings["Atmosphere_Enabled"] ~= true
                then
                    for child, props in pairs(origAtmosphere) do
                        if child and child.Parent then
                            child.Density = props.Density
                            child.Offset = props.Offset
                            child.Haze = props.Haze
                            child.Glare = props.Glare
                            child.Color = props.Color
                            child.Decay = props.Decay
                        end
                    end
                end
                if restoreDof then
                    for dof, props in pairs(origDof) do
                        if dof and dof.Parent then
                            dof.Enabled = props.Enabled
                            dof.FarIntensity = props.FarIntensity
                            dof.NearIntensity = props.NearIntensity
                            dof.InFocusRadius = props.InFocusRadius
                            dof.FocusDistance = props.FocusDistance
                        end
                    end
                end
            end)
            isApplyingEnvLighting = false
        end
        local lastEnvState = false
        local lastFullBright = false
        local lastNoFog = false
        local lastInfZoom = false
        local lastNoDof = false
        local lastFovActive = false
        local lastAspectActive = false
        local zoomBaselineCaptured = false
        Hypnosis.RestoreEnvironment = function()
            local cam = workspace.CurrentCamera or Camera
            if cam then
                if lastFovActive then
                    isApplyingFov = true
                    pcall(function()
                        cam.FieldOfView = origCameraFov or 70
                    end)
                    isApplyingFov = false
                    lastFovActive = false
                end
                if lastAspectActive then
                    restoreCleanCameraMatrix(cam)
                    lastAspectActive = false
                end
            end
            restoreLightingProperties(true, true, true)
            if customCC then
                customCC.Enabled = false
            end
            if lastInfZoom and LocalPlayer then
                pcall(function()
                    LocalPlayer.CameraMaxZoomDistance = origMaxZoom
                    LocalPlayer.CameraMinZoomDistance = origMinZoom
                end)
                lastInfZoom = false
                zoomBaselineCaptured = false
            end
            if visualShift and visualShift.Magnitude > 0.001 then
                pcall(function()
                    if cam then
                        cam.CFrame = cam.CFrame - visualShift
                        cam.Focus = cam.Focus - visualShift
                    end
                end)
            end
            visualShift = Vector3.zero
            trackedFocus = nil
            trackedVelocity = Vector3.zero
            lastTargetFocus = nil
        end
        local STIFFNESS_BIND_NAME = "Hypnosis_CameraStiffness"
        pcall(function()
            RunService:UnbindFromRenderStep(STIFFNESS_BIND_NAME)
        end)
        RunService:BindToRenderStep(STIFFNESS_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local frameDt = math.clamp(dt, 0.001, 0.05)
            local cam = workspace.CurrentCamera or Camera
            if not cam or cam.CameraType == Enum.CameraType.Scriptable then
                trackedFocus = nil
                trackedVelocity = Vector3.zero
                visualShift = Vector3.zero
                return
            end
            local isEnvOn = (Hypnosis.Settings["Environment Overrides_Enabled"] == true)
            local isStiffOn = (Hypnosis.Settings["Environment Overrides_Camera Stiffness_Enabled"] == true)
                or (Hypnosis.Settings["Environment Overrides_Camera Stiffness Adjustment"] == true)
            local camStiff = isEnvOn and isStiffOn
            local stiffnessVal = tonumber(Hypnosis.Settings["Environment Overrides_Camera Stiffness_Value"])
                or tonumber(Hypnosis.Settings["Environment Overrides_Camera Stiffness"])
                or 0.50
            if stiffnessVal > 1.0 then
                stiffnessVal = math.clamp(stiffnessVal / 20.0, 0.00, 1.00)
            end
            local s = math.clamp(stiffnessVal, 0.00, 1.00)
            local character = LocalPlayer and LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if not character or not rootPart or not humanoid or humanoid.Health <= 0 then
                trackedFocus = nil
                trackedVelocity = Vector3.zero
                visualShift = Vector3.zero
                return
            end
            local rawFocus = cam.Focus.Position
            local now = os.clock()
            local charSpeed = 0
            if lastTargetFocus and lastTargetTime then
                local timeDelta = math.max(now - lastTargetTime, 0.001)
                local moveDisplacement = Vector3.new(rawFocus.X - lastTargetFocus.X, 0, rawFocus.Z - lastTargetFocus.Z)
                charSpeed = moveDisplacement.Magnitude / timeDelta
            end
            lastTargetFocus = rawFocus
            lastTargetTime = now
            if not trackedFocus or (trackedFocus - rawFocus).Magnitude > 25.0 then
                trackedFocus = rawFocus
                trackedVelocity = Vector3.zero
                visualShift = Vector3.zero
                return
            end
            if not camStiff or s >= 0.999 then
                if visualShift.Magnitude > 0.001 then
                    local decay = math.exp(-28.0 * frameDt)
                    visualShift = visualShift * decay
                    trackedFocus = rawFocus + visualShift
                    trackedVelocity = Vector3.zero
                    cam.CFrame = cam.CFrame + visualShift
                    cam.Focus = cam.Focus + visualShift
                else
                    visualShift = Vector3.zero
                    trackedFocus = rawFocus
                    trackedVelocity = Vector3.zero
                end
                return
            end
            local u = 1.00 - s
            local baseMaxLag = 7.5 * math.pow(u, 1.10)
            local effectiveMaxLag = baseMaxLag
            local currentOffset = Vector3.new(trackedFocus.X - rawFocus.X, 0, trackedFocus.Z - rawFocus.Z)
            local isMoving = charSpeed > 1.2 or humanoid.MoveDirection.Magnitude > 0.05
            local pursuitOmega
            if isMoving then
                pursuitOmega = math.clamp(32.0 / math.max(effectiveMaxLag, 0.5), 4.5, 45.0)
            else
                pursuitOmega = 14.0
            end
            local h = pursuitOmega * frameDt
            local expTerm = math.exp(-h)
            local c1 = (1 + h) * expTerm
            local c2 = frameDt * expTerm
            local c3 = -pursuitOmega * h * expTerm
            local c4 = (1 - h) * expTerm
            local newOffset = currentOffset * c1 + trackedVelocity * c2
            local newVel = currentOffset * c3 + trackedVelocity * c4
            local offsetDist = newOffset.Magnitude
            if offsetDist > effectiveMaxLag and offsetDist > 0.001 then
                local radialDir = newOffset / offsetDist
                newOffset = radialDir * effectiveMaxLag
                local radialV = newVel:Dot(radialDir)
                if radialV > 0 then
                    newVel = newVel - radialDir * radialV
                end
            end
            trackedVelocity = Vector3.new(newVel.X, 0, newVel.Z)
            trackedFocus = Vector3.new(rawFocus.X + newOffset.X, rawFocus.Y, rawFocus.Z + newOffset.Z)
            visualShift = trackedFocus - rawFocus
            cam.CFrame = cam.CFrame + visualShift
            cam.Focus = cam.Focus + visualShift
        end)
        local boundFovCam = nil
        local boundFovConn = nil
        local boundCamDescConn = nil

        local function bindCameraSignals(cam)
            if cam == boundFovCam then
                return
            end
            if boundFovConn then
                pcall(function()
                    boundFovConn:Disconnect()
                end)
                boundFovConn = nil
            end
            if boundCamDescConn then
                pcall(function()
                    boundCamDescConn:Disconnect()
                end)
                boundCamDescConn = nil
            end
            boundFovCam = cam
            if not cam then
                return
            end
            for _, desc in ipairs(cam:GetDescendants()) do
                registerGameCC(desc)
                registerDof(desc)
            end
            boundCamDescConn = cam.DescendantAdded:Connect(function(desc)
                if Hypnosis._Unloaded or Hypnosis._Teleporting then
                    return
                end
                registerGameCC(desc)
                registerDof(desc)
            end)
            boundFovConn = cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
                if isApplyingFov or Hypnosis._Unloaded or Hypnosis._Teleporting then
                    return
                end
                if isEnvFovActive() then
                    local targetFov = getTargetFov()
                    if math.abs(cam.FieldOfView - targetFov) > 0.01 then
                        isApplyingFov = true
                        cam.FieldOfView = targetFov
                        isApplyingFov = false
                    end
                else
                    local cur = cam.FieldOfView
                    if cur and cur >= 40 and cur <= 120 then
                        origCameraFov = cur
                    end
                end
            end)
        end
        bindCameraSignals(workspace.CurrentCamera or Camera)
        local FULLBRIGHT_AMBIENT = Color3.fromRGB(195, 195, 195)
        local lastScanTick = 0
        pcall(function()
            RunService:UnbindFromRenderStep("Hypnosis_EnvCamera")
        end)
        RunService:BindToRenderStep("Hypnosis_EnvCamera", Enum.RenderPriority.Camera.Value + 10, function()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local cam = workspace.CurrentCamera or Camera
            if not cam then
                return
            end
            if cam ~= boundFovCam then
                bindCameraSignals(cam)
            end
            if lastAspectActive then
                restoreCleanCameraMatrix(cam)
            end
            local isEnabled = (Hypnosis.Settings["Environment Overrides_Enabled"] == true)
            local now = tick()
            if isEnabled and (now - lastScanTick > 5.0) then
                lastScanTick = now
                scanLightingAndCamera()
            end
            local fovActive = isEnvFovActive()
            if fovActive then
                local fovVal = getTargetFov()
                if math.abs(cam.FieldOfView - fovVal) > 0.01 then
                    isApplyingFov = true
                    cam.FieldOfView = fovVal
                    isApplyingFov = false
                end
                lastFovActive = true
            elseif lastFovActive then
                lastFovActive = false
                isApplyingFov = true
                cam.FieldOfView = origCameraFov or 70
                isApplyingFov = false
            end
            if isEnabled then
                local fullBright = isFullBrightActive()
                local noFog = isNoFogActive()
                if fullBright then
                    isApplyingEnvLighting = true
                    if Lighting.Ambient ~= FULLBRIGHT_AMBIENT then
                        Lighting.Ambient = FULLBRIGHT_AMBIENT
                    end
                    if Lighting.OutdoorAmbient ~= FULLBRIGHT_AMBIENT then
                        Lighting.OutdoorAmbient = FULLBRIGHT_AMBIENT
                    end
                    if Lighting.Brightness ~= 2 then
                        Lighting.Brightness = 2
                    end
                    if Lighting.ClockTime ~= 14 then
                        Lighting.ClockTime = 14
                    end
                    if Lighting.GlobalShadows ~= false then
                        Lighting.GlobalShadows = false
                    end
                    if Lighting.ExposureCompensation < 0 then
                        Lighting.ExposureCompensation = 0
                    end
                    if Lighting.EnvironmentDiffuseScale ~= 0 then
                        Lighting.EnvironmentDiffuseScale = 0
                    end
                    if Lighting.EnvironmentSpecularScale ~= 0 then
                        Lighting.EnvironmentSpecularScale = 0
                    end
                    if not noFog and Lighting.FogEnd < 100000 then
                        Lighting.FogEnd = 100000
                    end
                    if Hypnosis.Settings["Atmosphere_Enabled"] ~= true then
                        for child in pairs(origAtmosphere) do
                            if child and child.Parent then
                                if child.Density ~= 0 then
                                    child.Density = 0
                                end
                                if child.Haze ~= 0 then
                                    child.Haze = 0
                                end
                                if child.Glare ~= 0 then
                                    child.Glare = 0
                                end
                            end
                        end
                    end
                    if Hypnosis.Settings["Color Correction_Enabled"] ~= true then
                        for cc in pairs(origGameCC) do
                            if cc and cc.Parent and cc ~= customCC and cc.Enabled then
                                if cc.Brightness < 0 then
                                    cc.Brightness = 0
                                end
                                if cc.TintColor.R < 0.75 or cc.TintColor.G < 0.75 or cc.TintColor.B < 0.75 then
                                    cc.TintColor = Color3.fromRGB(255, 255, 255)
                                end
                            end
                        end
                    end
                    isApplyingEnvLighting = false
                    lastFullBright = true
                elseif lastFullBright then
                    lastFullBright = false
                    restoreLightingProperties(true, not noFog, false)
                end
                if noFog then
                    isApplyingEnvLighting = true
                    if Lighting.FogEnd ~= 1000000 then
                        Lighting.FogEnd = 1000000
                    end
                    if Lighting.FogStart ~= 0 then
                        Lighting.FogStart = 0
                    end
                    if Hypnosis.Settings["Atmosphere_Enabled"] ~= true then
                        for child in pairs(origAtmosphere) do
                            if child and child.Parent then
                                if child.Density ~= 0 then
                                    child.Density = 0
                                end
                                if child.Haze ~= 0 then
                                    child.Haze = 0
                                end
                                if child.Glare ~= 0 then
                                    child.Glare = 0
                                end
                            end
                        end
                    end
                    isApplyingEnvLighting = false
                    lastNoFog = true
                elseif lastNoFog then
                    lastNoFog = false
                    restoreLightingProperties(false, true, false)
                end
                local infZoom = isSettingActive("Environment Overrides", "Infinite Zoom")
                if infZoom and LocalPlayer then
                    if not zoomBaselineCaptured then
                        zoomBaselineCaptured = true
                        if LocalPlayer.CameraMaxZoomDistance < 100000 then
                            origMaxZoom = LocalPlayer.CameraMaxZoomDistance
                        end
                        origMinZoom = LocalPlayer.CameraMinZoomDistance
                    end
                    if LocalPlayer.CameraMaxZoomDistance < 100000 then
                        LocalPlayer.CameraMaxZoomDistance = 1000000
                        LocalPlayer.CameraMinZoomDistance = 0.5
                    end
                    lastInfZoom = true
                elseif lastInfZoom and LocalPlayer then
                    lastInfZoom = false
                    zoomBaselineCaptured = false
                    LocalPlayer.CameraMaxZoomDistance = origMaxZoom
                    LocalPlayer.CameraMinZoomDistance = origMinZoom
                end
                local noDof = isNoDofActive()
                if noDof then
                    for dof in pairs(origDof) do
                        if dof and dof.Parent and dof.Enabled then
                            dof.Enabled = false
                            dof.FarIntensity = 0
                            dof.NearIntensity = 0
                        end
                    end
                    lastNoDof = true
                elseif lastNoDof then
                    lastNoDof = false
                    restoreLightingProperties(false, false, true)
                end
                lastEnvState = true
            elseif lastEnvState then
                lastEnvState = false
                lastFullBright = false
                lastNoFog = false
                lastNoDof = false
                restoreLightingProperties(true, true, true)
                if lastInfZoom and LocalPlayer then
                    lastInfZoom = false
                    zoomBaselineCaptured = false
                    LocalPlayer.CameraMaxZoomDistance = origMaxZoom
                    LocalPlayer.CameraMinZoomDistance = origMinZoom
                end
            end
        end)
        pcall(function()
            RunService:UnbindFromRenderStep("Hypnosis_AspectRatio")
        end)
        RunService:BindToRenderStep("Hypnosis_AspectRatio", Enum.RenderPriority.Camera.Value + 20, function()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local cam = workspace.CurrentCamera or Camera
            if not cam then
                return
            end
            local isEnabled = (Hypnosis.Settings["Environment Overrides_Enabled"] == true)
            if not isEnabled then
                if lastAspectActive then
                    lastAspectActive = false
                    restoreCleanCameraMatrix(cam)
                end
                return
            end
            local aspectVal = Hypnosis.Settings["Environment Overrides_Aspect Ratio"]
            if aspectVal == nil then
                aspectVal = Hypnosis.Settings["Aspect Ratio"]
            end
            aspectVal = tonumber(aspectVal) or 1.0
            if math.abs(aspectVal - 1.0) > 0.01 then
                local cf = cam.CFrame
                if cf.X == cf.X and cf.Y == cf.Y and cf.Z == cf.Z then
                    local r = cf.RightVector
                    local u = cf.UpVector
                    if r.Magnitude > 0.01 and u.Magnitude > 0.01 then
                        local cleanCF = CFrame.fromMatrix(cf.Position, r.Unit, u.Unit)
                        local scaleY = math.clamp(aspectVal, 0.1, 3.0)
                        cam.CFrame = cleanCF * CFrame.new(0, 0, 0, 1, 0, 0, 0, scaleY, 0, 0, 0, 1)
                        lastAspectActive = true
                    end
                end
            elseif lastAspectActive then
                lastAspectActive = false
                restoreCleanCameraMatrix(cam)
            end
        end)
    end

    function Hypnosis.InitOverlays()
        local OverlaysContainer = Instance.new("Folder")
        OverlaysContainer.Name = "HypnosisOverlays"
        OverlaysContainer.Parent = ScreenGui
        Hypnosis.OverlaysContainer = OverlaysContainer

        local function makeDraggable(frame, extraHandle, posKey)
            Hypnosis.MakeDraggableHud(frame, extraHandle, { PosKey = posKey })
        end

        local function createCard(name, size, pos)
            local card = nil
            pcall(function()
                card = Instance.new("CanvasGroup")
                card.GroupTransparency = 1
            end)
            if not card then
                card = Instance.new("Frame")
            end
            card.Name = name
            card.Size = size
            card.Position = pos
            card.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
            card.BackgroundTransparency = 0.15
            card.BorderSizePixel = 0
            card.ZIndex = 5
            card.Visible = false
            card.Parent = OverlaysContainer
            local corner = Instance.new("UICorner", card)
            corner.CornerRadius = UDim.new(0, 5)
            local stroke = Instance.new("UIStroke", card)
            stroke.Color = Color3.fromRGB(255, 255, 255)
            stroke.Transparency = 0.92
            stroke.Thickness = 1
            return card
        end

        local function fadeCard(card, show)
            if show then
                card.Visible = true
                pcall(function()
                    Tween(card, { GroupTransparency = 0 }, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                end)
            else
                pcall(function()
                    local tw =
                        Tween(card, { GroupTransparency = 1 }, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                    tw.Completed:Connect(function()
                        if card.GroupTransparency >= 0.95 then
                            card.Visible = false
                        end
                    end)
                end)
                if not pcall(function()
                    return card.GroupTransparency
                end) then
                    card.Visible = false
                end
            end
        end

        local function formatKeyName(keyName)
            if not keyName or keyName == "" or keyName == "None" or keyName == "Unknown" then
                return "None"
            end
            local map = {
                RightShift = "R-Shift",
                LeftShift = "L-Shift",
                RightControl = "R-Ctrl",
                LeftControl = "L-Ctrl",
                RightAlt = "R-Alt",
                LeftAlt = "L-Alt",
                Return = "Enter",
                Escape = "Esc",
                Backquote = "~",
                CapsLock = "Caps",
                Backspace = "Bksp",
                Delete = "Del",
                Insert = "Ins",
                PageUp = "PgUp",
                PageDown = "PgDn",
            }
            return map[keyName] or keyName
        end
        local crosshairFrame = Instance.new("Frame", OverlaysContainer)
        crosshairFrame.Name = "CustomCrosshair"
        crosshairFrame.Size = UDim2.new(0, 0, 0, 0)
        crosshairFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        crosshairFrame.AnchorPoint = Vector2.new(0.5, 0.5)
        crosshairFrame.BackgroundTransparency = 1
        crosshairFrame.ZIndex = 4
        crosshairFrame.Visible = false
        local crossDot = Instance.new("Frame", crosshairFrame)
        crossDot.Name = "Dot"
        crossDot.BorderSizePixel = 0
        crossDot.AnchorPoint = Vector2.new(0.5, 0.5)
        local crossTop = Instance.new("Frame", crosshairFrame)
        crossTop.Name = "LineTop"
        crossTop.BorderSizePixel = 0
        crossTop.AnchorPoint = Vector2.new(0.5, 1)
        local crossBottom = Instance.new("Frame", crosshairFrame)
        crossBottom.Name = "LineBottom"
        crossBottom.BorderSizePixel = 0
        crossBottom.AnchorPoint = Vector2.new(0.5, 0)
        local crossLeft = Instance.new("Frame", crosshairFrame)
        crossLeft.Name = "LineLeft"
        crossLeft.BorderSizePixel = 0
        crossLeft.AnchorPoint = Vector2.new(1, 0.5)
        local crossRight = Instance.new("Frame", crosshairFrame)
        crossRight.Name = "LineRight"
        crossRight.BorderSizePixel = 0
        crossRight.AnchorPoint = Vector2.new(0, 0.5)
        local crosshairAlpha = 0.0

        local function updateCrosshair(dt)
            local isEnabled = Hypnosis.Settings["Custom Crosshair_Enabled"] == true
            local targetAlpha = isEnabled and 1.0 or 0.0
            crosshairAlpha = crosshairAlpha + (targetAlpha - crosshairAlpha) * math.clamp((dt or 0.016) * 14, 0, 1)
            if crosshairAlpha <= 0.005 then
                crosshairFrame.Visible = false
                return
            end
            crosshairFrame.Visible = true
            local cam = workspace.CurrentCamera or Camera
            local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
            local cx = math.floor(vp.X * 0.5)
            local cy = math.floor(vp.Y * 0.5)
            crosshairFrame.Position = UDim2.new(0, cx, 0, cy)
            local showDot = isSettingActive("Custom Crosshair", "Center Dot")
            local tShape = isSettingActive("Custom Crosshair", "T-Shape (No Top)")
            local length = tonumber(Hypnosis.Settings["Custom Crosshair_Crosshair Length"]) or 8
            local thickness = tonumber(Hypnosis.Settings["Custom Crosshair_Crosshair Thickness"]) or 2
            local gap = tonumber(Hypnosis.Settings["Custom Crosshair_Crosshair Gap"]) or 4
            local transVal = tonumber(Hypnosis.Settings["Custom Crosshair_Crosshair Transparency"]) or 0
            local baseTrans = math.clamp(transVal / 100, 0, 1)
            local effectiveTrans = (1 - crosshairAlpha) + (crosshairAlpha * baseTrans)
            local color = Color3.fromRGB(255, 255, 255)
            local cv = Hypnosis.Settings["Custom Crosshair_Crosshair Color_Color"]
            if typeof(cv) == "Color3" then
                color = cv
            elseif type(cv) == "table" and #cv >= 3 then
                color = Color3.new(cv[1], cv[2], cv[3])
            end
            crossDot.Visible = showDot
            crossDot.Size = UDim2.new(0, thickness, 0, thickness)
            crossDot.Position = UDim2.new(0, 0, 0, 0)
            crossDot.BackgroundColor3 = color
            crossDot.BackgroundTransparency = effectiveTrans
            crossTop.Visible = not tShape
            crossTop.Size = UDim2.new(0, thickness, 0, length)
            crossTop.Position = UDim2.new(0, 0, 0, -gap)
            crossTop.BackgroundColor3 = color
            crossTop.BackgroundTransparency = effectiveTrans
            crossBottom.Visible = true
            crossBottom.Size = UDim2.new(0, thickness, 0, length)
            crossBottom.Position = UDim2.new(0, 0, 0, gap)
            crossBottom.BackgroundColor3 = color
            crossBottom.BackgroundTransparency = effectiveTrans
            crossLeft.Visible = true
            crossLeft.Size = UDim2.new(0, length, 0, thickness)
            crossLeft.Position = UDim2.new(0, -gap, 0, 0)
            crossLeft.BackgroundColor3 = color
            crossLeft.BackgroundTransparency = effectiveTrans
            crossRight.Visible = true
            crossRight.Size = UDim2.new(0, length, 0, thickness)
            crossRight.Position = UDim2.new(0, gap, 0, 0)
            crossRight.BackgroundColor3 = color
            crossRight.BackgroundTransparency = effectiveTrans
        end
        local specCard = createCard("SpectatorOverlay", UDim2.new(0, 175, 0, 30), UDim2.new(1, -195, 0, 60))
        local specHeader = Instance.new("Frame", specCard)
