            if mainPart and mainPart:IsA("BasePart") and mainPart.Transparency < 0.5 then
                return true
            end
            for _, desc in ipairs(container:GetDescendants()) do
                if desc:IsA("BasePart") and desc.Transparency < 0.5 then
                    return true
                end
            end
            return false
        end

