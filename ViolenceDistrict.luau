        local function noModifierDown()
            return false
        end
        local cachedKeybindsCfg = nil

        local function getKeybindsConfig()
            if cachedKeybindsCfg ~= nil then
                return cachedKeybindsCfg or nil
            end
            local ok, res = pcall(function()
                local rep = game:GetService("ReplicatedStorage")
                local mod = rep:FindFirstChild("Modules")
                local surv = mod and mod:FindFirstChild("Survivors")
                local kc = surv and surv:FindFirstChild("KeybindsConfig")
                if kc then
                    return require(kc)
                end
            end)
            if ok and type(res) == "table" then
                cachedKeybindsCfg = res
                return res
            end
            cachedKeybindsCfg = false
            return nil
        end
        local MOUSE_BIND_INDEX = { MouseButton1 = 0, MouseButton2 = 1, MouseButton3 = 2 }
        local MOUSE_BIND_ENUM = {
            MouseButton1 = Enum.UserInputType.MouseButton1,
            MouseButton2 = Enum.UserInputType.MouseButton2,
            MouseButton3 = Enum.UserInputType.MouseButton3,
        }
        local bindEntryCache = {}

        local function makeBindEntry(rawVal)
            local keyStr = nil
            if typeof(rawVal) == "EnumItem" then
                if rawVal.EnumType == Enum.KeyCode and rawVal ~= Enum.KeyCode.Unknown then
                    keyStr = rawVal.Name
                elseif rawVal.EnumType == Enum.UserInputType and MOUSE_BIND_INDEX[rawVal.Name] ~= nil then
                    keyStr = rawVal.Name
                end
            elseif type(rawVal) == "string" and rawVal ~= "" then
                keyStr = rawVal
            end
            if not keyStr then
                return nil
            end
            local cached = bindEntryCache[keyStr]
            if cached ~= nil then
                return cached or nil
            end
            local mouseIdx = MOUSE_BIND_INDEX[keyStr]
            if mouseIdx ~= nil then
                local uiType = MOUSE_BIND_ENUM[keyStr]
                local entry = {
                    name = keyStr,
                    kind = "Mouse",
                    keyCode = Enum.KeyCode.Unknown,
                    userInputType = uiType,
                    mouseBtn = mouseIdx,
                    fakeInput = {
                        KeyCode = Enum.KeyCode.Unknown,
                        UserInputType = uiType,
                        UserInputState = Enum.UserInputState.Begin,
                        Position = Vector3.zero,
                        Delta = Vector3.zero,
                        IsModifierKeyDown = noModifierDown,
                    },
                }
                bindEntryCache[keyStr] = entry
                return entry
            end
            local okKc, kc = pcall(function()
                return Enum.KeyCode[keyStr]
            end)
            if okKc and typeof(kc) == "EnumItem" and kc ~= Enum.KeyCode.Unknown then
                local isPad = (string.sub(keyStr, 1, 6) == "Button")
                    or (string.sub(keyStr, 1, 4) == "DPad")
                    or (string.sub(keyStr, 1, 10) == "Thumbstick")
                local uiType = isPad and Enum.UserInputType.Gamepad1 or Enum.UserInputType.Keyboard
                local entry = {
                    name = keyStr,
                    kind = isPad and "Pad" or "Key",
                    keyCode = kc,
                    userInputType = uiType,
                    fakeInput = {
                        KeyCode = kc,
                        UserInputType = uiType,
                        UserInputState = Enum.UserInputState.Begin,
                        Position = Vector3.zero,
                        Delta = Vector3.zero,
                        IsModifierKeyDown = noModifierDown,
                    },
                }
                bindEntryCache[keyStr] = entry
                return entry
            end
            bindEntryCache[keyStr] = false
            return nil
        end

        local function resolveSkillCheckBinds(includePad)
            local binds = {}
            local seen = {}

            local function addRaw(rawVal)
                local entry = makeBindEntry(rawVal)
                if entry and not seen[entry.name] then
                    seen[entry.name] = true
                    table.insert(binds, entry)
                end
            end
            local cfg = getKeybindsConfig()
            if cfg and type(cfg.getRaw) == "function" then
                local okRaw, rawKb = pcall(cfg.getRaw, "skillcheck")
                if okRaw and rawKb then
                    addRaw(rawKb)
                end
            end
            if LocalPlayer then
                addRaw(LocalPlayer:GetAttribute("kb_skillcheck"))
            end
            if cfg and cfg.Keybinds and cfg.Keybinds.skillcheck then
                local b = cfg.Keybinds.skillcheck
                if typeof(b) == "EnumItem" or type(b) == "string" then
                    addRaw(b)
                elseif type(b) == "table" then
                    for _, k in pairs(b) do
                        addRaw(k)
                    end
                end
            end
            addRaw("Space")
            if includePad then
                if cfg and type(cfg.getPadRaw) == "function" then
                    local okPad, rawPad = pcall(cfg.getPadRaw, "skillcheck")
                    if okPad and rawPad then
                        addRaw(rawPad)
                    end
                end
                if LocalPlayer then
                    addRaw(LocalPlayer:GetAttribute("pad_skillcheck"))
                end
                addRaw("ButtonL1")
                addRaw("ButtonX")
            end
            return binds
        end

        local function selectMatchingBinds(binds)
            local cfg = getKeybindsConfig()
            local matchesFn = (cfg and type(cfg.matches) == "function") and cfg.matches or nil
            if not matchesFn then
                return binds, false
            end
            local matched = {}
            for _, entry in ipairs(binds) do
                local ok, hit = pcall(matchesFn, "skillcheck", entry.fakeInput)
                if ok and hit then
                    table.insert(matched, entry)
                end
            end
            if #matched > 0 then
                return matched, true
            end
            return binds, false
        end
        local isKingsScourgeActive = false
        local kingsScourgeStartTime = 0
        pcall(function()
            local rep = game:GetService("ReplicatedStorage")
            local rem = rep:FindFirstChild("Remotes")
            local kp = rem and rem:FindFirstChild("KillerPerks")
            local ks = kp and kp:FindFirstChild("kingscourge")
            if ks then
