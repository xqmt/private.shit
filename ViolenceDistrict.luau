        local function startDrag(entry, input)
            if not entry or not entry.Element then
                return
            end
            local dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
            local startDragOffsetX = entry.DragOffsetX or 0
            local startDragOffsetY = entry.DragOffsetY or 0
            if Hypnosis.GuiChanger.SelectionBox then
                Hypnosis.GuiChanger.SelectionBox.BackgroundTransparency = 0.65
                local stroke = Hypnosis.GuiChanger.SelectionBox:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Thickness = 1.8
                end
            end
            if Hypnosis.GuiChanger.ActionToolbar then
                Hypnosis.GuiChanger.ActionToolbar.Visible = false
            end
            if Hypnosis.GuiChanger.HoverBox then
                Hypnosis.GuiChanger.HoverBox.Visible = false
            end
            local moveConn = nil
            local endConn = nil
            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if not Hypnosis.GuiChanger.MoveMode or not isGuiChangerEnabled() then
                    if moveConn then
                        moveConn:Disconnect()
                        moveConn = nil
                    end
                    if endConn then
                        endConn:Disconnect()
                        endConn = nil
                    end
                    return
                end
                if
                    (
                        moveInput.UserInputType == Enum.UserInputType.MouseMovement
                        and input.UserInputType == Enum.UserInputType.MouseButton1
                    )
                    or (moveInput.UserInputType == Enum.UserInputType.Touch and moveInput == input)
                then
                    local deltaX = moveInput.Position.X - dragStartPos.X
                    local deltaY = moveInput.Position.Y - dragStartPos.Y
                    local snapEnabled = Hypnosis.Settings["GUI Changer_Snap To Grid (10px)"]
                    if snapEnabled ~= false then
                        local grid = Hypnosis.GuiChanger.SnapGrid or 10
                        deltaX = math.floor((deltaX + (grid / 2)) / grid) * grid
                        deltaY = math.floor((deltaY + (grid / 2)) / grid) * grid
                    end
                    entry.DragOffsetX = startDragOffsetX + deltaX
                    entry.DragOffsetY = startDragOffsetY + deltaY
                    applyTransform(entry)
                    updateSelectionBox(entry)
                end
            end)
            endConn = UserInputService.InputEnded:Connect(function(endInput)
                if
                    (
                        endInput.UserInputType == Enum.UserInputType.MouseButton1
                        and input.UserInputType == Enum.UserInputType.MouseButton1
                    ) or (endInput.UserInputType == Enum.UserInputType.Touch and endInput == input)
                then
                    if moveConn then
                        moveConn:Disconnect()
                        moveConn = nil
                    end
                    if endConn then
                        endConn:Disconnect()
                        endConn = nil
                    end
                    if Hypnosis.GuiChanger.SelectionBox then
                        Hypnosis.GuiChanger.SelectionBox.BackgroundTransparency = 0.88
                        local stroke = Hypnosis.GuiChanger.SelectionBox:FindFirstChildOfClass("UIStroke")
                        if stroke then
                            stroke.Thickness = 1.2
                        end
                    end
                    updateSelectionBox(entry)
                end
            end)
        end
        local lastHoverCheck = 0

        local function updateHover(mousePos)
            if not Hypnosis.GuiChanger.MoveMode or not isGuiChangerEnabled() then
                return
            end
            local now = tick()
            if (now - lastHoverCheck) < 0.04 then
                return
            end
            lastHoverCheck = now
            if
                isPointInGui(mousePos, MainFrame)
                or isPointInGui(mousePos, MobileButton)
                or (Hypnosis.IsPointOverMobileKeybinds and Hypnosis.IsPointOverMobileKeybinds(mousePos))
                or isPointInGui(mousePos, Hypnosis.ColorPickerOverlay)
                or isPointInGui(mousePos, Hypnosis.GuiChanger.Toolbar)
                or isPointInGui(mousePos, Hypnosis.GuiChanger.ActionToolbar)
                or isPointInGui(mousePos, Hypnosis.GuiChanger.HiddenDrawer)
            then
                if Hypnosis.GuiChanger.HoverBox then
                    Hypnosis.GuiChanger.HoverBox.Visible = false
                end
                return
            end
            local target = getElementAtPosition(mousePos)
            if target and target ~= Hypnosis.GuiChanger.SelectedEntry and target.Element and target.Element.Parent then
                local hBox = Hypnosis.GuiChanger.HoverBox
                if not hBox or not hBox.Parent then
                    hBox = Instance.new("Frame", gcContainer)
                    hBox.Name = "HoverBox"
                    hBox.BackgroundTransparency = 1
                    hBox.BorderSizePixel = 0
                    hBox.ZIndex = 999992
                    local hC = Instance.new("UICorner", hBox)
