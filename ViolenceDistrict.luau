                    updateNotifContainerBounds()
                    bindViewportResize()
                end)
            )
        end
        local activeNotifs = {}
        local notifSequence = 0

        local function isNotifVisibleAllowed()
            if Hypnosis._Unloaded then
                return false
            end
            local settings = Hypnosis.Settings or {}
            if settings["Notifications_Enabled"] == false then
                return false
            end
            if
                settings["Notifications_OnlyWhenMenuOpen"] == true
                and Hypnosis.MainFrame
                and not Hypnosis.MainFrame.Visible
            then
                return false
            end
            return true
        end

        local function clearActiveNotifs()
            for i = #activeNotifs, 1, -1 do
                local entry = activeNotifs[i]
                if entry and entry.Dismiss then
                    pcall(entry.Dismiss, true)
                elseif entry and entry.Frame and entry.Frame.Parent then
                    pcall(function()
                        entry.Frame:Destroy()
                    end)
                    table.remove(activeNotifs, i)
                end
            end
        end

        local function syncNotifVisibility()
            local allowed = isNotifVisibleAllowed()
            if NotifContainer and NotifContainer.Parent then
                NotifContainer.Visible = allowed
            end
            local settings = Hypnosis.Settings or {}
            if settings["Notifications_Enabled"] == false then
                clearActiveNotifs()
            end
            return allowed
        end
        Hypnosis.SyncNotificationVisibility = syncNotifVisibility

        local function getNotifOpacityTargets()
            local settings = Hypnosis.Settings or {}
            local rawTrans = math.clamp((tonumber(settings["Notifications_Transparency"]) or 5) / 100, 0, 0.85)
            local strokeTrans = math.clamp(rawTrans + 0.17, 0.12, 0.90)
            local accentTrans = math.clamp(rawTrans, 0.05, 0.75)
            local textTrans = math.clamp(rawTrans * 0.45, 0, 0.65)
            local bodyTrans = math.clamp(rawTrans * 0.50 + 0.06, 0.06, 0.72)
            local showProgress = (settings["Notifications_ShowProgress"] ~= false)
            return rawTrans, strokeTrans, accentTrans, textTrans, bodyTrans, showProgress
        end

        local function getNotifSlideOffsets()
            if currentNotifSlide == "Left" then
                return UDim2.new(0.5, -22, 0.5, 0), UDim2.new(0.5, -18, 0.5, 0)
            elseif currentNotifSlide == "Top" then
                return UDim2.new(0.5, 0, 0.5, -14), UDim2.new(0.5, 0, 0.5, -12)
            elseif currentNotifSlide == "Bottom" then
                return UDim2.new(0.5, 0, 0.5, 14), UDim2.new(0.5, 0, 0.5, 12)
            end
            return UDim2.new(0.5, 22, 0.5, 0), UDim2.new(0.5, 18, 0.5, 0)
        end
        local NOTIF_ACCENTS = {
            success = Color3.fromRGB(74, 222, 128),
            warning = Color3.fromRGB(245, 178, 66),
            error = Color3.fromRGB(239, 92, 102),
        }

        local function normalizeNotifType(notifType)
            local t = string.lower(tostring(notifType or "info"))
            if t == "warn" or t == "warning" then
                return "warning"
            end
            if t == "err" or t == "error" or t == "danger" then
                return "error"
            end
            if t == "ok" or t == "success" then
                return "success"
            end
            return "info"
        end

        local function normalizeNotificationArgs(title, message, notifType, duration)
            local rawType = notifType
            local rawMsg = message
            if rawType == nil and type(rawMsg) == "string" then
                local maybeKind = string.lower(rawMsg)
                if
                    maybeKind == "info"
                    or maybeKind == "success"
                    or maybeKind == "warning"
                    or maybeKind == "warn"
                    or maybeKind == "error"
                    or maybeKind == "err"
                then
                    rawType = maybeKind
                    rawMsg = tostring(title or "")
                    title = "Status"
                end
            end
            local cleanTitle = tostring((title ~= nil and title ~= "") and title or "Notification")
            local cleanMessage = tostring(rawMsg or "")
            local cleanKind = normalizeNotifType(rawType)
            local settings = Hypnosis.Settings or {}
            local prefDur = tonumber(settings["Notifications_Duration"])
            local cleanDuration = math.clamp(tonumber(duration) or prefDur or 3.2, 0.8, 15.0)
            return cleanTitle, cleanMessage, cleanKind, cleanDuration
        end

        local function resolveNotifVisualColors(kind)
            local accent = NOTIF_ACCENTS[kind] or Palette.Accent
            local bg = Palette.WindowBg:Lerp(Palette.ModuleBg, 0.55)
            local stroke = Palette.Border:Lerp(accent, kind == "info" and 0.30 or 0.38)
            local bodyText = Palette.TextDim:Lerp(Palette.TextActive, 0.34)
            return bg, stroke, accent, bodyText
        end

        local function measureToastMessageHeight(msgText, textWidth)
            if msgText == "" then
                return 0
            end
            if TextService then
                local ok, bounds = pcall(function()
                    return TextService:GetTextSize(msgText, 10, Enum.Font.GothamMedium, Vector2.new(textWidth, 160))
                end)
                if ok and bounds then
                    return math.clamp(math.ceil(bounds.Y) + 2, 14, 72)
                end
            end
            local charsPerLine = math.max(18, math.floor(textWidth / 5.4))
            local lineCount = math.max(1, math.ceil(#msgText / charsPerLine))
            return math.clamp(lineCount * 14, 14, 72)
        end
        ThemeHook(function()
            for i = 1, #activeNotifs do
                local entry = activeNotifs[i]
                if entry and entry.ApplyTheme then
                    pcall(entry.ApplyTheme)
                end
            end
        end)

        function Hypnosis.SyncNotificationSettings(enforceVisibility)
            updateNotifContainerBounds()
            if enforceVisibility then
                syncNotifVisibility()
            end
            local settings = Hypnosis.Settings or {}
            local maxVis = math.clamp(math.floor((tonumber(settings["Notifications_MaxVisible"]) or 4) + 0.5), 1, 8)
            while #activeNotifs > maxVis do
                local oldest = table.remove(activeNotifs, 1)
                if oldest and oldest.Dismiss then
                    pcall(oldest.Dismiss, true)
                elseif oldest and oldest.Frame and oldest.Frame.Parent then
                    pcall(function()
                        oldest.Frame:Destroy()
                    end)
                end
            end
            for i = 1, #activeNotifs do
                local entry = activeNotifs[i]
                if entry and entry.ApplyAppearance then
                    pcall(entry.ApplyAppearance)
                end
            end
        end
        showNotification = function(title, message, notifType, duration, replaceTag)
            if not syncNotifVisibility() then
                return
            end
            local cleanTitle, cleanMessage, cleanKind, cleanDuration =
                normalizeNotificationArgs(title, message, notifType, duration)
            updateNotifContainerBounds()
            if replaceTag ~= nil then
                for i = #activeNotifs, 1, -1 do
                    local existing = activeNotifs[i]
                    if existing and existing.Tag == replaceTag then
                        if existing.Dismiss then
                            pcall(existing.Dismiss, true)
                        else
                            table.remove(activeNotifs, i)
                        end
                    end
                end
            end
            local settings = Hypnosis.Settings or {}
            local maxVis = math.clamp(math.floor((tonumber(settings["Notifications_MaxVisible"]) or 4) + 0.5), 1, 8)
            while #activeNotifs >= maxVis do
                local oldest = table.remove(activeNotifs, 1)
                if oldest and oldest.Dismiss then
                    oldest.Dismiss(true)
                elseif oldest and oldest.Frame and oldest.Frame.Parent then
                    pcall(function()
                        oldest.Frame:Destroy()
                    end)
                end
            end
            notifSequence = notifSequence + 1
            Hypnosis._NotifCount = (Hypnosis._NotifCount or 0) + 1
            local cardWidth = NotifContainer.Size.X.Offset
            local hasMsg = (cleanMessage ~= "")
            local textAreaWidth = math.max(120, cardWidth - 44)
            local msgHeight = hasMsg and measureToastMessageHeight(cleanMessage, textAreaWidth) or 0
            local slotHeight = hasMsg and (39 + msgHeight) or 34
            local cardBgCol, strokeCol, accentCol, bodyCol = resolveNotifVisualColors(cleanKind)
            local enterPos, exitPos = getNotifSlideOffsets()
            local bgTrans, strokeTrans, accentTrans, textTrans, bodyTrans, showProgress = getNotifOpacityTargets()
            local ToastSlot = Instance.new("Frame")
            ToastSlot.Name = "ToastSlot"
            ToastSlot.LayoutOrder = notifSequence
            ToastSlot.Size = UDim2.new(1, 0, 0, slotHeight)
            ToastSlot.BackgroundTransparency = 1
            ToastSlot.BorderSizePixel = 0
            ToastSlot.ClipsDescendants = false
            ToastSlot.ZIndex = 201
            ToastSlot.Parent = NotifContainer
            local ToastCard = Instance.new("Frame", ToastSlot)
            ToastCard.Name = "ToastCard"
            ToastCard.AnchorPoint = Vector2.new(0.5, 0.5)
            ToastCard.Size = UDim2.new(1, 0, 1, 0)
            ToastCard.Position = enterPos
            ToastCard.BackgroundColor3 = cardBgCol
            ToastCard.BackgroundTransparency = 1
            ToastCard.BorderSizePixel = 0
            ToastCard.ZIndex = 202
            local cardScale = Instance.new("UIScale", ToastCard)
