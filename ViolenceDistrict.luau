    function Hypnosis._SafeHookNamecall(callback)
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            return false, nil
        end
        local oldFn = nil

        local function proxy(self, ...)
            if checkcaller and checkcaller() then
                return oldFn(self, ...)
            end
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return oldFn(self, ...)
            end
            return callback(oldFn, self, ...)
        end
        local hookClosure = proxy
        if type(newcclosure) == "function" then
            local okWrap, wrapped = pcall(newcclosure, proxy)
            if okWrap and type(wrapped) == "function" then
                hookClosure = wrapped
            end
        end
        local okHook = pcall(function()
            oldFn = hookmetamethod(game, "__namecall", hookClosure)
        end)
        if okHook and type(oldFn) == "function" then
            return true, oldFn
        end
        return false, nil
    end
