            pooledHideByPrefix.K = globalHideText or (isSettingActive("Killer ESP", "Hide Text") == true)
            pooledHideByPrefix.S = globalHideText or (isSettingActive("Survivor ESP", "Hide Text") == true)
            pooledHideByPrefix.ME = globalHideText or (isSettingActive("Me ESP", "Hide Text") == true)
            pooledHideByPrefix.G = globalHideText or (isSettingActive("Generator ESP", "Hide Text") == true)
            pooledHideByPrefix.EG = globalHideText or (isSettingActive("Exit Gate ESP", "Hide Text") == true)
            pooledHideByPrefix.P = globalHideText or (isSettingActive("Pallet ESP", "Hide Text") == true)
            pooledHideByPrefix.H = globalHideText or (isSettingActive("Hook ESP", "Hide Text") == true)
