        local function computeNotifLayoutMetrics()
            local cam = workspace.CurrentCamera or Camera
            local vp = cam and cam.ViewportSize or ViewportSize or Vector2.new(1280, 720)
            local mobileMode = getIsMobile() or vp.X < 640
            local width = mobileMode and math.clamp(math.floor(vp.X - 32), 228, 272) or 284
            local settings = Hypnosis.Settings or {}
            local placement = tostring(settings["Notifications_Placement"] or "Bottom Right")
            local ox = tonumber(settings["Notifications_OffsetX"]) or 0
            local oy = tonumber(settings["Notifications_OffsetY"]) or 0
            local custom = settings["Notifications_CustomAnchor"]
            if placement == "Custom" and type(custom) == "table" then
                local ax = tonumber(custom.AlignX)
                if ax ~= 0 and ax ~= 0.5 and ax ~= 1 then
                    ax = 1
                end
                local ay = (tonumber(custom.AlignY) == 0) and 0 or 1
                local xs = math.clamp(tonumber(custom.XScale) or 0.98, 0, 1)
                local ys = math.clamp(tonumber(custom.YScale) or 0.95, 0, 1)
                local hAlign = (ax == 0 and Enum.HorizontalAlignment.Left)
                    or (ax == 1 and Enum.HorizontalAlignment.Right)
                    or Enum.HorizontalAlignment.Center
                local vAlign = (ay == 0) and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom
                local slide = (ax == 0 and "Left") or (ax == 1 and "Right") or ((ay == 0) and "Top" or "Bottom")
                return width, Vector2.new(ax, ay), UDim2.new(xs, ox, ys, oy), hAlign, vAlign, slide, vp
            end
            local preset = NOTIF_PLACEMENT_PRESETS[placement] or NOTIF_PLACEMENT_PRESETS["Bottom Right"]
            local marginY = preset.my
            if preset.ay == 1 and mobileMode then
                marginY = -84
            end
            local pos = UDim2.new(preset.sx, preset.mx + ox, preset.sy, marginY + oy)
            return width, Vector2.new(preset.ax, preset.ay), pos, preset.hAlign, preset.vAlign, preset.slide, vp
        end
        local NotifContainer = Instance.new("Frame")
