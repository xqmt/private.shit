                end
            end)
        )

        local function isGuiObjVisible(obj)
            local cur = obj
            while cur and not cur:IsA("PlayerGui") do
                if cur:IsA("GuiObject") and not cur.Visible then
                    return false
                elseif cur:IsA("LayerCollector") and not cur.Enabled then
                    return false
                end
                cur = cur.Parent
            end
            return cur ~= nil
        end

        local function isMobileClientMode()
            local plat = LocalPlayer and LocalPlayer:GetAttribute("platform")
            if plat == "Mobile" then
                return true
            elseif plat == "PC" or plat == "Console" then
                return activePromptGui ~= nil and activePromptGui.Name == "SkillCheckPromptGui-mob"
            end
