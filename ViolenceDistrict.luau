        local function createHitCatcher()
            if Hypnosis.GuiChanger.HitCatcher and Hypnosis.GuiChanger.HitCatcher.Parent then
                return Hypnosis.GuiChanger.HitCatcher
            end
            local hc = Instance.new("Frame", gcContainer)
            hc.Name = "HitCatcher"
            hc.Size = UDim2.new(0, 0, 0, 0)
            hc.BackgroundTransparency = 1
            hc.ZIndex = 1
            hc.Active = false
            hc.Visible = false
            if not gcInputBeganConn then
                gcInputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if input.KeyCode == Enum.KeyCode.Escape then
                        if Hypnosis.GuiChanger.MoveMode then
                            Hypnosis.SetGuiMoveMode(false)
                            syncMoveModeUiSetting(false)
                            showNotification(
                                "HUD Layout Locked",
                                "Interactive move mode exited via Escape key.",
                                "Info",
                                2.2
                            )
                            return
                        end
                    end
                    if
                        input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch
                    then
                        if not isGuiChangerEnabled() or not Hypnosis.GuiChanger.MoveMode then
                            return
                        end
                        if gameProcessed then
                            return
                        end
                        local clickPos = Vector2.new(input.Position.X, input.Position.Y)
                        if isPointOverHypnosisUi(clickPos) then
                            return
                        end
                        if MainFrame and MainFrame.Visible and isPointInGui(clickPos, MainFrame) then
                            return
                        end
                        scanPlayerGui()
                        local target = getElementAtPosition(clickPos)
                        if target then
                            selectElement(target)
                            if Hypnosis.Settings["GUI Changer_Lock Dragging"] then
                                showNotification(
                                    "HUD Locked",
                                    "Unlock dragging in the GUI Changer menu to reposition.",
                                    "Warning",
                                    2.2
                                )
                                return
                            end
                            startDrag(target, input)
                        else
                            deselectElement()
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, gcInputBeganConn)
            end
            if not gcInputChangedConn then
                gcInputChangedConn = UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        if not isGuiChangerEnabled() or not Hypnosis.GuiChanger.MoveMode then
                            return
                        end
                        local pos = Vector2.new(input.Position.X, input.Position.Y)
                        if
                            not isPointOverHypnosisUi(pos)
                            and not (MainFrame and MainFrame.Visible and isPointInGui(pos, MainFrame))
                        then
                            updateHover(pos)
                        elseif Hypnosis.GuiChanger.HoverBox then
                            Hypnosis.GuiChanger.HoverBox.Visible = false
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, gcInputChangedConn)
            end
            Hypnosis.GuiChanger.HitCatcher = hc
            return hc
        end

