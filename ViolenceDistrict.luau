            local function trackExtHl(inst)
                if not inst or not inst:IsA("Highlight") then
                    return
                end
                if EspContainer and inst:IsDescendantOf(EspContainer) then
                    return
                end
                if vaultCtx.ExtHlSet[inst] then
                    return
                end
                local cEn = inst:GetPropertyChangedSignal("Enabled"):Connect(function()
                    vaultCtx.ExtHlDirty = true
                end)
                local cAd = inst:GetPropertyChangedSignal("Adornee"):Connect(function()
                    vaultCtx.ExtHlDirty = true
                end)
                local cAnc = inst.AncestryChanged:Connect(function()
                    if not inst.Parent or (EspContainer and inst:IsDescendantOf(EspContainer)) then
                        untrackExtHl(inst)
                    else
                        vaultCtx.ExtHlDirty = true
                    end
                end)
                vaultCtx.ExtHlSet[inst] = { cEn, cAd, cAnc }
                vaultCtx.ExtHlDirty = true
            end

            local function attachRootWatcher(root)
                if not root or watchedGuiParents[root] then
                    return
                end
                watchedGuiParents[root] = true
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("Highlight") then
                        trackExtHl(d)
                    end
                end
                table.insert(extWatchConns, root.DescendantAdded:Connect(trackExtHl))
                table.insert(
                    extWatchConns,
                    root.DescendantRemoving:Connect(function(d)
                        if vaultCtx.ExtHlSet[d] then
                            untrackExtHl(d)
                        end
                    end)
                )
            end

            function vaultCtx.RefreshExtHl()
                if not vaultCtx.ExtHlDirty then
                    return
                end
                local list = vaultCtx.ExtActiveList
                table.clear(list)
                local n = 0
                for hl in pairs(vaultCtx.ExtHlSet) do
                    if not hl or not hl.Parent or (EspContainer and hl:IsDescendantOf(EspContainer)) then
                        untrackExtHl(hl)
                    elseif hl.Enabled == true then
                        n = n + 1
                        list[n] = hl
                    end
                end
                vaultCtx.ExtActiveCount = n
                vaultCtx.ExtHlDirty = false
            end

            function vaultCtx.HasConflictingExtHighlight(vl)
                local count = vaultCtx.ExtActiveCount or 0
                if count == 0 or not vl then
                    return false
                end
                local list = vaultCtx.ExtActiveList
                for i = 1, count do
                    local hl = list[i]
                    if hl and hl.Parent and hl.Enabled == true then
                        local isChild = hl:IsDescendantOf(vl)
                        if (not isChild) or vaultCtx.PersistentExtHls[hl] then
                            local target = hl.Adornee
                            if not target then
                                target = hl.Parent
                            end
                            if target and target ~= workspace and target ~= cachedMap then
                                if target == vl or target:IsDescendantOf(vl) then
                                    return true
                                elseif
                                    vl:IsDescendantOf(target) and (target:IsA("Model") or target:IsA("BasePart"))
                                then
                                    return true
                                end
                            end
                        end
                    end
                end
                return false
            end
            attachRootWatcher(workspace)
            local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pg then
                attachRootWatcher(pg)
            elseif LocalPlayer then
                table.insert(
                    extWatchConns,
                    LocalPlayer.ChildAdded:Connect(function(ch)
                        if ch and ch:IsA("PlayerGui") then
                            attachRootWatcher(ch)
                        end
                    end)
                )
            end
            local cleanupConn = EspContainer.AncestryChanged:Connect(function()
                if not EspContainer.Parent then
                    for i = 1, #extWatchConns do
                        pcall(function()
                            extWatchConns[i]:Disconnect()
                        end)
                    end
                    table.clear(extWatchConns)
                    for hl in pairs(vaultCtx.ExtHlSet) do
                        untrackExtHl(hl)
                    end
                end
            end)
            table.insert(extWatchConns, cleanupConn)
            for i = 1, #extWatchConns do
                table.insert(Hypnosis.Connections, extWatchConns[i])
            end
        end

        local function registerMapObject(desc)
            if not desc or not desc.Parent then
                return
            end
            local name = desc.Name
            local lowerName = string.lower(name)
            if desc:IsA("Model") and name == "Generator" then
                if not watchedGenAttrs[desc] then
                    watchedGenAttrs[desc] = true
                    local attrConn = desc:GetAttributeChangedSignal("RepairProgress"):Connect(function()
                        if desc.Parent and isGeneratorModel(desc) then
                            if not table.find(cachedGenerators, desc) then
                                table.insert(cachedGenerators, desc)
                            end
                        else
                            for i = #cachedGenerators, 1, -1 do
                                if cachedGenerators[i] == desc then
                                    table.remove(cachedGenerators, i)
                                    break
                                end
                            end
                        end
                    end)
                    table.insert(mapConnections, attrConn)
                end
                if isGeneratorModel(desc) and not table.find(cachedGenerators, desc) then
                    table.insert(cachedGenerators, desc)
                end
            end
            if name == "ExitLever" then
                if not table.find(cachedGates, desc) then
                    table.insert(cachedGates, desc)
                end
            end
            local isPallet = false
            local parentName = desc.Parent and string.lower(desc.Parent.Name) or ""
            local hasHitbox = desc:FindFirstChild("hitbox")
                or desc:FindFirstChild("Hitbox")
                or desc:FindFirstChild("HitBox")
            if parentName == "pallets" then
                if hasHitbox or name == "Newpallet" or lowerName == "newpallet" or desc:IsA("Model") then
                    isPallet = true
                end
            elseif
                hasHitbox
                and (name == "Newpallet" or lowerName == "newpallet" or string.find(lowerName, "pallet", 1, true))
            then
                if not string.find(lowerName, "crate", 1, true) then
                    isPallet = true
                end
            elseif (name == "hitbox" or lowerName == "hitbox") and desc.Parent and desc.Parent:IsA("Model") then
                local pModel = desc.Parent
                local pLower = string.lower(pModel.Name)
                local pParentLower = pModel.Parent and string.lower(pModel.Parent.Name) or ""
                if pParentLower == "pallets" or string.find(pLower, "pallet", 1, true) then
                    if not string.find(pLower, "crate", 1, true) then
                        if not table.find(cachedPallets, pModel) then
                            table.insert(cachedPallets, pModel)
                        end
                    end
                end
            end
            if isPallet and not string.find(lowerName, "crate", 1, true) then
                if not table.find(cachedPallets, desc) then
                    table.insert(cachedPallets, desc)
                end
            end
            if name == "Hook" and (desc:FindFirstChild("HookPoint") or desc:IsA("Model")) then
                if not table.find(cachedHooks, desc) then
                    table.insert(cachedHooks, desc)
                end
            end
            local vaultContainer = resolveVaultContainer(desc)
            if vaultContainer then
                addVaultContainer(vaultContainer)
            end
            local isPumpkin = false
            if desc.Parent and (desc.Parent.Name == "Pumpkins" or string.lower(desc.Parent.Name) == "pumpkins") then
                isPumpkin = true
            elseif string.find(lowerName, "pumpkin") then
                isPumpkin = true
            elseif name == "Pumpkins" or lowerName == "pumpkins" then
                for _, child in ipairs(desc:GetChildren()) do
                    registerMapObject(child)
                end
            end
            if isPumpkin and not (name == "Pumpkins" or lowerName == "pumpkins") then
                if not table.find(cachedPumpkins, desc) then
                    table.insert(cachedPumpkins, desc)
                end
            end
            local isZombie = false
            if hasFootstepVolume(desc) then
                isZombie = true
            elseif string.find(lowerName, "^scp") or string.find(lowerName, "zombie") then
                isZombie = true
            end
            if isZombie and (desc:IsA("Model") or desc:IsA("BasePart") or desc:IsA("Folder")) then
                if not table.find(cachedZombies, desc) then
                    table.insert(cachedZombies, desc)
                end
            end
            local isBearTrap = false
            pcall(function()
                if CollectionService:HasTag(desc, "BearTrap") then
                    isBearTrap = true
                end
            end)
            if not isBearTrap then
                if name == "BearTrap" or lowerName == "beartrap" or string.find(lowerName, "beartrap") then
                    isBearTrap = true
                elseif desc:GetAttribute("Armed") ~= nil or desc:GetAttribute("Triggered") ~= nil then
                    isBearTrap = true
                end
            end
            if isBearTrap and (desc:IsA("Model") or desc:IsA("BasePart")) then
                local parent = desc.Parent
                if
                    not (
                        parent
                        and (
                            parent.Name == "BearTrap"
                            or string.find(string.lower(parent.Name), "beartrap")
                            or parent:GetAttribute("Armed") ~= nil
                        )
                    )
                then
                    if not table.find(cachedBearTraps, desc) then
                        table.insert(cachedBearTraps, desc)
                    end
                end
            end
        end

        local function unregisterMapObject(desc)
            for i = #cachedGenerators, 1, -1 do
                if cachedGenerators[i] == desc then
                    table.remove(cachedGenerators, i)
                    break
                end
            end
            for i = #cachedGates, 1, -1 do
                if cachedGates[i] == desc then
                    table.remove(cachedGates, i)
                    break
                end
            end
            for i = #cachedPallets, 1, -1 do
                if cachedPallets[i] == desc then
                    table.remove(cachedPallets, i)
                    break
                end
            end
            for i = #cachedHooks, 1, -1 do
                if cachedHooks[i] == desc then
                    table.remove(cachedHooks, i)
                    break
                end
            end
            removeVaultContainer(desc)
            for i = #cachedZombies, 1, -1 do
                if cachedZombies[i] == desc then
                    table.remove(cachedZombies, i)
                    break
                end
            end
            for i = #cachedPumpkins, 1, -1 do
                if cachedPumpkins[i] == desc then
                    table.remove(cachedPumpkins, i)
                    break
                end
            end
            for i = #cachedBearTraps, 1, -1 do
                if cachedBearTraps[i] == desc then
                    table.remove(cachedBearTraps, i)
                    break
                end
            end
        end

        local function rebuildMapCache()
            for _, c in ipairs(mapConnections) do
                pcall(function()
                    c:Disconnect()
                end)
            end
            mapConnections = {}
            Hypnosis.MapConnections = mapConnections
            table.clear(watchedGenAttrs)
            cachedGenerators = {}
            cachedGates = {}
            cachedPallets = {}
            cachedHooks = {}
            cachedVaults = {}
            cachedVaultSet = {}
            table.clear(watchedVaults)
            table.clear(vaultInfoCache)
            cachedZombies = {}
            cachedPumpkins = {}
            cachedBearTraps = {}
            Hypnosis._CachedGenerators = cachedGenerators
            cachedMap = nil
            Hypnosis._CachedMap = nil

            local function scanSubtree(root)
                if not root then
                    return
                end
                registerMapObject(root)
                for _, desc in ipairs(root:GetDescendants()) do
                    registerMapObject(desc)
                end
            end
            pcall(function()
                for _, bt in ipairs(CollectionService:GetTagged("BearTrap")) do
                    registerMapObject(bt)
                end
            end)

            local function isTopWorkspaceContainer(ch)
                if not ch then
                    return false
                end
                local chName = ch.Name
                return (ch:IsA("Model") and chName == "Generator")
                    or chName == "Generator"
                    or chName == "generator"
                    or chName == "Generators"
                    or chName == "generators"
                    or chName == "newGenerators"
                    or chName == "newgenerators"
                    or chName == "NewGenerators"
                    or chName == "Pumpkins"
                    or chName == "pumpkins"
                    or chName == "BearTraps"
                    or chName == "beartraps"
                    or chName == "BearTrap"
            end
            for _, child in ipairs(workspace:GetChildren()) do
                if isTopWorkspaceContainer(child) then
                    scanSubtree(child)
                    table.insert(mapConnections, child.DescendantAdded:Connect(registerMapObject))
                    table.insert(mapConnections, child.DescendantRemoving:Connect(unregisterMapObject))
                elseif
                    child.Name == "BearTrap"
                    or string.find(string.lower(child.Name), "beartrap")
                    or child:GetAttribute("Armed") ~= nil
                then
                    registerMapObject(child)
                end
            end
            local wsChildConn = workspace.ChildAdded:Connect(function(ch)
                if not ch then
                    return
                end
                local chName = ch.Name
                if chName == "Map" or chName == "CurrentMap" or chName == "map" then
                    task.defer(rebuildMapCache)
                elseif isTopWorkspaceContainer(ch) then
                    scanSubtree(ch)
                    table.insert(mapConnections, ch.DescendantAdded:Connect(registerMapObject))
                    table.insert(mapConnections, ch.DescendantRemoving:Connect(unregisterMapObject))
                end
            end)
            local wsRemConn = workspace.ChildRemoved:Connect(function(ch)
                if not ch then
                    return
                end
                if ch == cachedMap then
                    task.defer(rebuildMapCache)
                elseif isTopWorkspaceContainer(ch) then
                    unregisterMapObject(ch)
                    for _, desc in ipairs(ch:GetDescendants()) do
                        unregisterMapObject(desc)
                    end
                end
            end)
            table.insert(mapConnections, wsChildConn)
            table.insert(mapConnections, wsRemConn)
            local map = workspace:FindFirstChild("Map")
                or workspace:FindFirstChild("CurrentMap")
                or workspace:FindFirstChild("map")
            if map then
                cachedMap = map
                Hypnosis._CachedMap = map
                scanSubtree(map)
                local addConn = map.DescendantAdded:Connect(registerMapObject)
                local remConn = map.DescendantRemoving:Connect(unregisterMapObject)
                table.insert(mapConnections, addConn)
                table.insert(mapConnections, remConn)
            end
            pcall(function()
                local csAdd = CollectionService:GetInstanceAddedSignal("BearTrap"):Connect(registerMapObject)
                local csRem = CollectionService:GetInstanceRemovedSignal("BearTrap"):Connect(unregisterMapObject)
                table.insert(mapConnections, csAdd)
                table.insert(mapConnections, csRem)
            end)
            pcall(function()
                local vaultTags = { "vaultbox", "window", "VaultPoint" }
                for _, tagName in ipairs(vaultTags) do
                    for _, inst in ipairs(CollectionService:GetTagged(tagName)) do
                        registerMapObject(inst)
                    end
                    local tAdd = CollectionService:GetInstanceAddedSignal(tagName):Connect(registerMapObject)
                    local tRem = CollectionService:GetInstanceRemovedSignal(tagName):Connect(function(inst)
                        if cachedVaultSet[inst] and not isContainerWindowVault(inst) then
                            removeVaultContainer(inst)
                        end
                    end)
                    table.insert(mapConnections, tAdd)
                    table.insert(mapConnections, tRem)
                end
                vaultCtx.NoAuraCount = #CollectionService:GetTagged("NoAura")
                local naAdd = CollectionService:GetInstanceAddedSignal("NoAura"):Connect(function()
                    vaultCtx.NoAuraCount = #CollectionService:GetTagged("NoAura")
                end)
                local naRem = CollectionService:GetInstanceRemovedSignal("NoAura"):Connect(function()
                    vaultCtx.NoAuraCount = #CollectionService:GetTagged("NoAura")
                end)
                table.insert(mapConnections, naAdd)
                table.insert(mapConnections, naRem)
            end)
            Hypnosis.MapConnections = mapConnections
        end
        rebuildMapCache()
        local pooledActiveIds = {}
        local pooledActiveTracerIds = {}
        local pooledTracerTargets = {}
        local pooledSub1 = {}
        local pooledSub2 = {}
        local pooledDetails = {}
        local pooledHideByPrefix = {}
        local pooledSeenChars = {}
        local botCtx = { SurvBots = {}, KillerBots = {} }
        do
            local survBots = botCtx.SurvBots
            local killerBots = botCtx.KillerBots
            local survSet = {}
            local killerSet = {}
            local botIds = setmetatable({}, { __mode = "k" })
            local nextBotId = 0
            local botDirty = true
            local lastBotSync = 0
            local botConns = {}
            local watchedFolders = setmetatable({}, { __mode = "k" })

            function botCtx.GetId(model)
                local id = botIds[model]
                if not id then
                    nextBotId = nextBotId + 1
                    id = tostring(nextBotId)
                    botIds[model] = id
                end
                return id
            end

            function botCtx.GetDisplayName(model)
                if not model then
                    return "Bot"
                end
                local hum = model:FindFirstChildOfClass("Humanoid")
                local dn = hum and hum.DisplayName
                if type(dn) == "string" and dn ~= "" then
                    return dn
                end
                local attr = model:GetAttribute("DisplayName")
                if type(attr) == "string" and attr ~= "" then
                    return attr
                end
                return model.Name
            end

            local function isKillerModel(model)
                if not model or not model:IsA("Model") then
                    return false
                end
                if
                    model:GetAttribute("Role") == "Killer"
                    or model:GetAttribute("IsKiller") == true
                    or model:GetAttribute("Killer") == true
                then
                    return true
                end
                local mkAttr = model:GetAttribute("MorphedKiller")
                if
                    (mkAttr ~= nil and mkAttr ~= false)
                    or model:FindFirstChild("MorphedKiller") ~= nil
                    or model:FindFirstChild("KillerScript") ~= nil
                    or model:FindFirstChild("KillerRoot") ~= nil
                then
                    return true
                end
                if hasTagSafe(model, "Killer") or hasTagSafe(model, "KillerBot") then
                    return true
                end
                return false
            end

            local function isBotCandidate(model, wantKiller, requireExplicitBot)
                if not model or not model.Parent or not model:IsA("Model") then
                    return false
                end
                if not model:IsDescendantOf(workspace) then
                    return false
                end
                local lobbyFolder = workspace:FindFirstChild("Lobby")
                if lobbyFolder and (model == lobbyFolder or model:IsDescendantOf(lobbyFolder)) then
                    return false
                end
                if LocalPlayer and model == LocalPlayer.Character then
                    return false
                end
                if Players:GetPlayerFromCharacter(model) ~= nil then
                    return false
                end
                local isK = isKillerModel(model)
                if wantKiller then
                    if not isK then
                        return false
                    end
                else
                    if isK then
                        return false
                    end
                    if requireExplicitBot then
                        local isRoundEntity = (model:GetAttribute("RoundBot") == true)
                            or (model:GetAttribute("BotId") ~= nil)
                            or (model:GetAttribute("BotNetId") ~= nil)
                            or (model:GetAttribute("PlayingRound") == true)
                            or hasTagSafe(model, "PlayingRound")
                            or (model:FindFirstChild("BotAnimate") ~= nil)
                            or (model:FindFirstChild("SurvivorScript") ~= nil)
                            or (model:FindFirstChild("SurvivorRoot") ~= nil)
                        if not isRoundEntity then
                            return false
                        end
                    end
                end
                if
                    model:GetAttribute("IsDead") == true
                    or model:GetAttribute("Dead") == true
                    or model:GetAttribute("Escaped") == true
                then
                    return false
                end
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    return false
                end
                if not hum and not wantKiller and not hasTagSafe(model, "SurvivorBot") then
                    return false
                end
                return true
            end

            local function rebuildBots()
                table.clear(survBots)
                table.clear(killerBots)
                for k in pairs(survSet) do
                    survSet[k] = nil
                end
                for k in pairs(killerSet) do
                    killerSet[k] = nil
                end
                pcall(function()
                    for _, inst in ipairs(CollectionService:GetTagged("SurvivorBot")) do
                        if not survSet[inst] and isBotCandidate(inst, false, false) then
                            survSet[inst] = true
                            survBots[#survBots + 1] = inst
                        end
                    end
                end)
                pcall(function()
                    for _, inst in ipairs(CollectionService:GetTagged("Survivor")) do
                        if not survSet[inst] and isBotCandidate(inst, false, true) then
                            survSet[inst] = true
                            survBots[#survBots + 1] = inst
                        end
                    end
                end)
                pcall(function()
                    for _, inst in ipairs(CollectionService:GetTagged("Killer")) do
                        if not killerSet[inst] and isBotCandidate(inst, true, false) then
                            killerSet[inst] = true
                            killerBots[#killerBots + 1] = inst
                        end
                    end
                end)
                pcall(function()
                    for _, inst in ipairs(CollectionService:GetTagged("KillerBot")) do
                        if not killerSet[inst] and isBotCandidate(inst, true, false) then
                            killerSet[inst] = true
                            killerBots[#killerBots + 1] = inst
                        end
                    end
                end)
                local kFolder = workspace:FindFirstChild("Killers")
                if kFolder then
                    if not watchedFolders[kFolder] then
                        watchedFolders[kFolder] = true
                        local fc1 = kFolder.ChildAdded:Connect(function()
                            botDirty = true
                        end)
                        local fc2 = kFolder.ChildRemoved:Connect(function()
                            botDirty = true
                        end)
                        botConns[#botConns + 1] = fc1
                        botConns[#botConns + 1] = fc2
                        table.insert(Hypnosis.Connections, fc1)
                        table.insert(Hypnosis.Connections, fc2)
                    end
                    for _, ch in ipairs(kFolder:GetChildren()) do
                        if not killerSet[ch] and isBotCandidate(ch, true, false) then
                            killerSet[ch] = true
                            killerBots[#killerBots + 1] = ch
                        end
                    end
                end
            end

            local function markBotDirty()
                botDirty = true
            end
            local botTags = { "SurvivorBot", "Survivor", "Killer", "KillerBot" }
            pcall(function()
                for _, tagName in ipairs(botTags) do
                    local cAdd = CollectionService:GetInstanceAddedSignal(tagName):Connect(markBotDirty)
                    local cRem = CollectionService:GetInstanceRemovedSignal(tagName):Connect(markBotDirty)
                    botConns[#botConns + 1] = cAdd
                    botConns[#botConns + 1] = cRem
                end
            end)
            local pRemBotConn = Players.PlayerRemoving:Connect(function()
                botDirty = true
                task.delay(0.25, markBotDirty)
                task.delay(1.0, markBotDirty)
            end)
            botConns[#botConns + 1] = pRemBotConn
            local ancBotConn = EspContainer.AncestryChanged:Connect(function()
                if not EspContainer.Parent then
                    for i = 1, #botConns do
                        pcall(function()
                            botConns[i]:Disconnect()
                        end)
                    end
                    table.clear(botConns)
                end
            end)
            botConns[#botConns + 1] = ancBotConn
            for i = 1, #botConns do
                table.insert(Hypnosis.Connections, botConns[i])
            end

            function botCtx.SyncIfNeeded(now)
                if botDirty or (now - lastBotSync) >= 1.0 then
                    botDirty = false
                    lastBotSync = now
                    rebuildBots()
                end
            end
        end

        local function clearDict(t)
            for k in pairs(t) do
                t[k] = nil
            end
        end
        local lastMapCheck = 0
        pcall(function()
            RunService:UnbindFromRenderStep("Hypnosis_EspRender")
        end)
        RunService:BindToRenderStep("Hypnosis_EspRender", Enum.RenderPriority.Camera.Value + 15, function(dt)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            Camera = workspace.CurrentCamera or Camera
            if not Camera then
                return
            end
            local now = tick()
            if now - lastMapCheck > 2.0 then
                lastMapCheck = now
                local currentMap = workspace:FindFirstChild("Map")
                    or workspace:FindFirstChild("CurrentMap")
                    or workspace:FindFirstChild("map")
                if currentMap ~= cachedMap then
                    rebuildMapCache()
                end
            end
            local masterActive = isMasterSwitchEnabled()
            if not masterActive then
                for _, t in pairs(TracerPool) do
                    if t.Visible then
                        t.Visible = false
                    end
                end
                local allClean = true
                for tagId, entry in pairs(TagPool) do
                    if entry.Alpha > 0.005 then
                        allClean = false
                        entry.TargetAlpha = 0.0
                        entry.Alpha = entry.Alpha + (0.0 - entry.Alpha) * math.clamp(dt * 14, 0, 1)
                        if entry.Alpha > 0.01 then
                            if not entry.LastVisible then
                                entry.Label.Visible = true
                                entry.LastVisible = true
                            end
                            entry.Label.TextTransparency = 1 - entry.Alpha
                            entry.Label.TextStrokeTransparency = 1 - (entry.Alpha * 0.7)
                        else
                            if entry.LastVisible then
                                entry.Label.Visible = false
                                entry.LastVisible = false
                            end
                            if entry.Highlight and entry.LastHlEnabled then
                                entry.Highlight.Enabled = false
                                entry.Highlight.Adornee = nil
                                entry.LastHlEnabled = false
                                entry.LastHlAdornee = nil
                            end
                            vaultCtx.HideBoxes(entry)
                            entry.Alpha = 0.0
                        end
                    else
                        if entry.Alpha ~= 0.0 then
                            entry.Alpha = 0.0
                        end
                        if entry.LastVisible then
                            entry.Label.Visible = false
                            entry.LastVisible = false
                        end
                        if entry.Highlight and entry.LastHlEnabled then
                            entry.Highlight.Enabled = false
                            entry.Highlight.Adornee = nil
                            entry.LastHlEnabled = false
                            entry.LastHlAdornee = nil
                        end
                        vaultCtx.HideBoxes(entry)
                    end
                end
                return
            end
            local camCF = Camera and Camera.CFrame or CFrame.new()
            local camPos = camCF.Position
            local camLook = camCF.LookVector
            botCtx.SyncIfNeeded(now)
            clearDict(pooledActiveIds)
            local activeIds = pooledActiveIds
            local activeFont = getEspFont()
            local killerEspEnabled = Hypnosis.Settings["Killer ESP_Enabled"] == true
            if killerEspEnabled then
                local killerShowDist = isSettingActive("Killer ESP", "View Distance")
                local killerShowArch = isSettingActive("Killer ESP", "View Killer")
                local killerShowName = isSettingActive("Killer ESP", "View Name")
                local killerHighlight = isSettingActive("Killer ESP", "Highlight Silhouette")
                local killerFillColor = getFillColor("Killer ESP")
                local killerFillTrans = getFillTrans("Killer ESP")
                local killerOutlineColor = getOutlineColor("Killer ESP")
                local killerOutlineTrans = getOutlineTrans("Killer ESP")
                local killerTextColor = getTextColor("Killer ESP")
                local killerStrokeColor = getTextStrokeColor("Killer ESP")
                local killerName = killerShowName and getCustomName("Killer ESP", "Killer") or ""

                local function drawKillerTarget(id, char, isBot)
                    if not char or pooledSeenChars[char] then
                        return
                    end
                    local pos = getPosition(char)
                    if not pos then
                        return
                    end
                    pooledSeenChars[char] = true
                    activeIds[id] = true
                    local entry = getOrCreateTag(id)
                    entry.IsTempBot = isBot == true
                    local toPos = pos - camPos
                    local forwardDist = toPos.X * camLook.X + toPos.Y * camLook.Y + toPos.Z * camLook.Z
                    local distSq = toPos.X * toPos.X + toPos.Y * toPos.Y + toPos.Z * toPos.Z
                    entry.Adornee = char
                    entry.HighlightEnabled = killerHighlight
                    entry.FillColor = killerFillColor
                    entry.FillTrans = killerFillTrans
                    entry.OutlineColor = killerOutlineColor
                    entry.OutlineTrans = killerOutlineTrans
                    entry.HighlightColor = killerFillColor
                    entry.HighlightTrans = killerFillTrans
                    entry.TextColor = killerTextColor
                    entry.TextStrokeColor = killerStrokeColor
                    entry.TeamType = "Killer"
                    if forwardDist > 0 and distSq > 1 and distSq <= 12250000 then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(pos + Vector3.new(0, 1.5, 0))
                        if onScreen then
                            local dist = math.sqrt(distSq)
                            entry.Distance = dist
                            entry.TargetAlpha = 1.0
                            if entry.LastScreenX ~= screenPos.X or entry.LastScreenY ~= screenPos.Y then
                                entry.Label.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                                entry.LastScreenX = screenPos.X
                                entry.LastScreenY = screenPos.Y
                            end
                            if entry.LastFont ~= activeFont then
                                entry.Label.Font = activeFont
                                entry.LastFont = activeFont
                            end
                            local arch = killerShowArch and getKillerArchetype(char) or nil
                            local tag = ""
                            if killerShowName then
                                tag = (killerShowArch and arch) and ("[" .. killerName .. ": " .. arch .. "]")
                                    or ("[" .. killerName .. "]")
                            elseif killerShowArch and arch then
                                tag = "[" .. arch .. "]"
                            end
                            local distText = killerShowDist and ("[" .. tostring(math.floor(dist * 0.28)) .. "m]") or ""
                            local newText = tag
                            if distText ~= "" then
                                newText = (newText ~= "") and (newText .. "\n" .. distText) or distText
                            end
                            if entry.LastText ~= newText then
                                entry.Label.Text = newText
                                entry.LastText = newText
                            end
                        else
                            entry.TargetAlpha = 0.0
                        end
                    else
                        entry.TargetAlpha = 0.0
                    end
                end
                clearDict(pooledSeenChars)
                for _, p in ipairs(Players:GetPlayers()) do
                    if isKiller(p) and p ~= LocalPlayer then
                        local char = p.Character or workspace:FindFirstChild(p.Name)
                        drawKillerTarget("K_" .. p.Name, char, false)
                    end
                end
                for _, bot in ipairs(botCtx.KillerBots) do
                    if bot and bot.Parent and not pooledSeenChars[bot] then
                        local bHum = bot:FindFirstChildOfClass("Humanoid")
                        if not bHum or bHum.Health > 0 then
                            drawKillerTarget("K_BOT_" .. botCtx.GetId(bot), bot, true)
                        end
                    end
                end
            end
            local survEspEnabled = Hypnosis.Settings["Survivor ESP_Enabled"] == true
            local survUseHealthColors = isSettingActive("Survivor ESP", "Health State Colors")
            local survHealthyColor =
                toColor3(Hypnosis.Settings["Survivor ESP_Healthy Color_Color"], Color3.fromRGB(110, 235, 140))
            local survInjuredColor =
                toColor3(Hypnosis.Settings["Survivor ESP_Injured Color_Color"], Color3.fromRGB(255, 110, 95))
            if survEspEnabled then
                local survShowDist = isSettingActive("Survivor ESP", "View Distance")
                local survShowHooks = isSettingActive("Survivor ESP", "Hooks")
                local survShowState = isSettingActive("Survivor ESP", "View State")
                local survShowItem = isSettingActive("Survivor ESP", "View Item")
                local survShowSurvElo = isSettingActive("Survivor ESP", "View Survivor Elo")
                local survShowKillElo = isSettingActive("Survivor ESP", "View Killer Elo")
                local survHighlight = isSettingActive("Survivor ESP", "Highlight Silhouette")
                local survFillColor = getFillColor("Survivor ESP")
                local survFillTrans = getFillTrans("Survivor ESP")
                local survOutlineColor = getOutlineColor("Survivor ESP")
                local survOutlineTrans = getOutlineTrans("Survivor ESP")
                local survTextColor = getTextColor("Survivor ESP")
                local survStrokeColor = getTextStrokeColor("Survivor ESP")
                local survName = getCustomName("Survivor ESP", "Survivor")

                local function drawSurvivorTarget(id, char, rawDisplayName, pObj)
                    if not char or pooledSeenChars[char] then
                        return
                    end
                    local pos = getPosition(char)
                    if not pos then
                        return
                    end
                    pooledSeenChars[char] = true
                    activeIds[id] = true
                    local entry = getOrCreateTag(id)
                    entry.IsTempBot = (pObj == nil)
                    local toPos = pos - camPos
