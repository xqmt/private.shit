        local function getElementAtPosition(screenPos)
            local candidates = {}
            local curCat = Hypnosis.GuiChanger.ActiveCategory or "All"
            for elem, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                if elem and elem.Parent and elem.Visible then
                    local sGui = elem:FindFirstAncestorOfClass("ScreenGui")
                    if not sGui or sGui.Enabled ~= false then
                        local absPos = elem.AbsolutePosition
                        local absSize = elem.AbsoluteSize
                        if
                            absSize.X >= 6
                            and absSize.Y >= 6
                            and screenPos.X >= absPos.X
                            and screenPos.X <= (absPos.X + absSize.X)
                            and screenPos.Y >= absPos.Y
                            and screenPos.Y <= (absPos.Y + absSize.Y)
                        then
                            local depth = 0
                            local cur = elem
                            while cur and cur ~= workspace and not cur:IsA("PlayerGui") do
                                depth = depth + 1
                                cur = cur.Parent
                            end
                            local area = absSize.X * absSize.Y
                            local catMatch = (curCat == "All" or entry.Category == curCat)
                            table.insert(candidates, {
                                Entry = entry,
                                Area = area,
                                Depth = depth,
                                ZIndex = elem.ZIndex or 1,
                                CatMatch = catMatch,
                            })
                        end
                    end
                end
            end
            if #candidates == 0 then
                return nil
            end
            table.sort(candidates, function(a, b)
                if a.CatMatch ~= b.CatMatch then
                    return a.CatMatch == true
                end
                if math.abs(a.Area - b.Area) > 40 then
                    return a.Area < b.Area
                end
                if a.Depth ~= b.Depth then
                    return a.Depth > b.Depth
                end
                return a.ZIndex > b.ZIndex
            end)
            return candidates[1].Entry
        end
