        local function getVaultVisualInfo(vl)
            local info = vaultInfoCache[vl]
            if info then
                return info
            end
            local visibleParts = {}
            local childHighlights = {}
            local bottomPart = nil
            local inviswallPart = nil
            local triggerPart = nil
            local anyPart = nil

            local function inspectPart(p)
                if not p:IsA("BasePart") then
                    return
                end
                if not anyPart then
                    anyPart = p
                end
                local ln = string.lower(p.Name)
                if ln == "bottom" then
                    if not bottomPart then
                        bottomPart = p
                    end
                    table.insert(visibleParts, 1, p)
                    return
                elseif ln == "inviswall" then
                    if not inviswallPart then
                        inviswallPart = p
                    end
                    return
                elseif ln == "vaulttrigger" or ln == "leapvaulttrigger" or ln == "vaultpointinuse" then
                    if not triggerPart then
                        triggerPart = p
                    end
                    return
                end
                if not isNonHighlightVaultPartName(ln) then
                    table.insert(visibleParts, p)
                end
            end
            if vl:IsA("BasePart") then
                inspectPart(vl)
            end
            for _, d in ipairs(vl:GetDescendants()) do
                if d:IsA("BasePart") then
                    inspectPart(d)
                elseif d:IsA("Highlight") then
                    table.insert(childHighlights, d)
                end
            end
            local fallbackParts = {}
            if #visibleParts > 0 then
                for i = 1, math.min(#visibleParts, 6) do
                    table.insert(fallbackParts, visibleParts[i])
                end
            elseif bottomPart then
                table.insert(fallbackParts, bottomPart)
            elseif inviswallPart then
                table.insert(fallbackParts, inviswallPart)
            elseif triggerPart then
                table.insert(fallbackParts, triggerPart)
            elseif anyPart then
                table.insert(fallbackParts, anyPart)
            end
            local posPart = bottomPart or visibleParts[1] or triggerPart or inviswallPart or anyPart
            info = {
                bottomPart = bottomPart,
                visibleParts = visibleParts,
                fallbackParts = fallbackParts,
                childHighlights = childHighlights,
                posPart = posPart,
            }
            vaultInfoCache[vl] = info
            return info
        end

        local function hideFallbackBoxes(entry)
            if not entry or not entry.FallbackBoxes or not entry.LastFallbackVis then
                return
            end
            for i = 1, #entry.FallbackBoxes do
                local box = entry.FallbackBoxes[i]
                if box then
                    box.Visible = false
                    box.Adornee = nil
                end
            end
            entry.LastFallbackVis = false
        end

        local function applyVaultFallbackBoxes(
            entry,
            active,
            fillColor,
            outlineColor,
            targetFillTrans,
            targetOutlineTrans
        )
            if not active or not entry.FallbackParts or #entry.FallbackParts == 0 then
                hideFallbackBoxes(entry)
                return
            end
            local boxes = entry.FallbackBoxes
            if not boxes then
                boxes = {}
                entry.FallbackBoxes = boxes
            end
            local useCol = fillColor
            local useTrans = targetFillTrans
            if targetFillTrans >= 0.96 and targetOutlineTrans < 0.96 then
                useCol = outlineColor
                useTrans = targetOutlineTrans
            end
            useTrans = math.clamp(useTrans, 0, 1)
            local activeCount = 0
            local maxBoxes = math.min(#entry.FallbackParts, 6)
            for i = 1, maxBoxes do
                local part = entry.FallbackParts[i]
                if part and part.Parent and part:IsA("BasePart") then
                    activeCount = activeCount + 1
                    local box = boxes[activeCount]
                    if not box then
                        box = Instance.new("BoxHandleAdornment")
                        box.Name = "VaultBox_" .. tostring(activeCount)
                        box.AlwaysOnTop = true
                        box.ZIndex = 2
                        box.Visible = false
                        box.Parent = VaultBoxContainer
                        boxes[activeCount] = box
                    end
                    if box.Adornee ~= part then
                        box.Adornee = part
                    end
                    if box.Size ~= part.Size then
                        box.Size = part.Size
                    end
                    if box.Color3 ~= useCol then
                        box.Color3 = useCol
                    end
                    if math.abs(box.Transparency - useTrans) > 0.02 or entry.Alpha == 1.0 then
                        box.Transparency = useTrans
                    end
                    if not box.Visible then
                        box.Visible = true
                    end
                end
            end
            for i = activeCount + 1, #boxes do
                local box = boxes[i]
                if box and box.Visible then
                    box.Visible = false
                    box.Adornee = nil
                end
            end
            entry.LastFallbackVis = activeCount > 0
        end
        vaultCtx.GetObjId = getVaultObjId
