    local function computeKillerArchetype(char)
        if not char then
            return "Killer"
        end
        local p = Players:GetPlayerFromCharacter(char)
        if not p and char.Parent == workspace then
            p = Players:FindFirstChild(char.Name)
        end
        if p then
            local selK = p:GetAttribute("SelectedKiller")
            if selK and tostring(selK) ~= "" then
                local skLower = tostring(selK):lower()
                if skLower:find("abyss", 1, true) then
                    return "Abysswalker"
                elseif skLower:find("veil", 1, true) then
                    return "Veil"
                elseif skLower:find("slasher", 1, true) then
                    return "Slasher"
                elseif skLower:find("butcher", 1, true) then
                    return "Butcher"
                elseif skLower:find("cure", 1, true) then
                    return "Cure"
                elseif skLower:find("masked", 1, true) then
                    return "Masked"
                elseif skLower:find("stalker", 1, true) then
                    return "Stalker"
                elseif skLower:find("hidden", 1, true) then
                    return "Hidden"
                end
                for _, kKey in ipairs({
                    "Abysswalker",
                    "Veil",
                    "Slasher",
                    "Butcher",
                    "Cure",
                    "Masked",
                    "Stalker",
                    "Hidden",
                    "Killer",
                }) do
                    if string.lower(kKey) == skLower then
                        return kKey
                    end
                end
                return tostring(selK)
            end
        end
        local cName = char.Name:lower()
        if cName:find("abyss", 1, true) then
            return "Abysswalker"
        elseif cName:find("veil", 1, true) then
            return "Veil"
        elseif cName:find("slasher", 1, true) then
            return "Slasher"
        elseif cName:find("butcher", 1, true) then
            return "Butcher"
        elseif cName:find("cure", 1, true) then
            return "Cure"
        elseif cName:find("masked", 1, true) then
            return "Masked"
        elseif cName:find("stalker", 1, true) then
            return "Stalker"
        elseif cName:find("hidden", 1, true) then
            return "Hidden"
        end
        local mk = char:FindFirstChild("MorphedKiller")
        if mk then
            if mk:IsA("StringValue") and mk.Value ~= "" then
                local val = mk.Value:lower()
                if val:find("abyss", 1, true) then
                    return "Abysswalker"
                elseif val:find("veil", 1, true) then
                    return "Veil"
                elseif val:find("slasher", 1, true) then
                    return "Slasher"
                elseif val:find("butcher", 1, true) then
                    return "Butcher"
                elseif val:find("cure", 1, true) then
                    return "Cure"
                elseif val:find("masked", 1, true) then
                    return "Masked"
                elseif val:find("stalker", 1, true) then
                    return "Stalker"
                elseif val:find("hidden", 1, true) then
                    return "Hidden"
                end
                for _, kKey in ipairs({
                    "Abysswalker",
                    "Veil",
                    "Slasher",
                    "Butcher",
                    "Cure",
                    "Masked",
                    "Stalker",
                    "Hidden",
                    "Killer",
                }) do
                    if string.lower(kKey) == val then
                        return kKey
                    end
                end
                return mk.Value
            end
            local children = mk:GetChildren()
            for _, c in ipairs(children) do
                local cn = c.Name:lower()
                if cn:find("abyss", 1, true) then
                    return "Abysswalker"
                elseif cn:find("veil", 1, true) then
                    return "Veil"
                elseif cn:find("slasher", 1, true) then
                    return "Slasher"
                elseif cn:find("butcher", 1, true) then
                    return "Butcher"
                elseif cn:find("cure", 1, true) then
                    return "Cure"
                elseif cn:find("masked", 1, true) then
                    return "Masked"
                elseif cn:find("stalker", 1, true) then
                    return "Stalker"
                elseif cn:find("hidden", 1, true) then
                    return "Hidden"
                end
                if c:IsA("Model") or c:IsA("Folder") or c:IsA("Configuration") or c:IsA("StringValue") then
                    return c.Name
                end
            end
            if #children > 0 then
                return children[1].Name
            end
        end
        local archAttr = char:GetAttribute("KillerType")
            or char:GetAttribute("Archetype")
            or char:GetAttribute("Killer")
            or char:GetAttribute("Character")
            or char:GetAttribute("KillerName")
            or char:GetAttribute("Morph")
            or char:GetAttribute("SelectedKiller")
        if archAttr and tostring(archAttr) ~= "" then
            local aVal = tostring(archAttr):lower()
            if aVal:find("abyss", 1, true) then
                return "Abysswalker"
            elseif aVal:find("veil", 1, true) then
                return "Veil"
            elseif aVal:find("slasher", 1, true) then
                return "Slasher"
            elseif aVal:find("butcher", 1, true) then
                return "Butcher"
            elseif aVal:find("cure", 1, true) then
