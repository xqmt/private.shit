                local tracerCount = 0

                local function pushTracerTarget(tid, tpos, tcol)
                    tracerCount = tracerCount + 1
                    local slot = pooledTracerTargets[tracerCount]
                    if not slot then
                        slot = {}
                        pooledTracerTargets[tracerCount] = slot
                    end
                    slot.Id = tid
                    slot.Pos = tpos
                    slot.Color = tcol
                end
                if targetIdx == 1 or targetIdx == 2 or targetIdx == 3 then
