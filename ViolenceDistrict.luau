        local function solveTrueBallisticAim(camPos, targetPos, targetVelocity, projectileSpeed)
            local g = SpearConfig.GravityY
            local v = math.max(10, projectileSpeed)
            local spawnOffset = SpearConfig.SpawnOffset
            local rawDelta = targetPos - camPos
            local launchDir = (rawDelta.Magnitude > 1e-4) and rawDelta.Unit or Vector3.new(0, 0, -1)
            local p0 = camPos + launchDir * spawnOffset
            local t = math.clamp((targetPos - p0).Magnitude / v, 0.01, 2.0)
            local leadPos = targetPos
            for _ = 1, 4 do
                leadPos = targetPos + targetVelocity * t
                p0 = camPos + launchDir * spawnOffset
                local diff = leadPos - p0
                if diff.Magnitude < 1e-4 then
                    break
                end
                local x = Vector3.new(diff.X, 0, diff.Z).Magnitude
                local y = diff.Y
                if x < 0.001 then
                    launchDir = diff.Unit
                    t = math.clamp(math.abs(y) / v, 0.01, 2.0)
                else
                    local v2 = v * v
                    local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
                    if disc >= 0 then
                        local tanTheta = (v2 - math.sqrt(disc)) / (g * x)
                        local cosTheta = 1 / math.sqrt(1 + tanTheta * tanTheta)
                        local sinTheta = tanTheta * cosTheta
                        local dirXZ = Vector3.new(diff.X, 0, diff.Z) / x
                        launchDir = dirXZ * cosTheta + Vector3.new(0, sinTheta, 0)
                        t = math.clamp(x / math.max(1e-4, v * cosTheta), 0.01, 2.0)
                    else
                        launchDir = diff.Unit
                        t = math.clamp(diff.Magnitude / v, 0.01, 2.0)
                    end
                end
            end
            return launchDir, leadPos, t
        end

        local function selectTargetInFOV(fovRadius)
            if not Camera then
                return nil
            end
            local vp = Camera.ViewportSize
            local center = Vector2.new(vp.X / 2, vp.Y / 2)
            local bestTarget = nil
            local bestDist = math.huge
            local prevChar = SilentAimState.ActiveTarget and SilentAimState.ActiveTarget.char
            local prevCandidate = nil
            local prevDist = math.huge
            for _, t in ipairs(activeTargets) do
                local headPos = t.head and t.head.Position or t.rootPos
                local sp, onScreen = Camera:WorldToViewportPoint(headPos)
                if onScreen and sp.Z > 0 then
                    local screenPos = Vector2.new(sp.X, sp.Y)
                    local fovDist = (screenPos - center).Magnitude
                    if fovDist <= fovRadius then
                        if prevChar and t.char == prevChar then
                            prevCandidate = t
                            prevDist = fovDist
                        end
                        if fovDist < bestDist then
                            bestDist = fovDist
                            bestTarget = t
                        end
                    end
                end
            end
            if prevCandidate and prevDist <= (bestDist + 18) then
                return prevCandidate
            end
            return bestTarget
        end
        local SPEAR_DIR_KEYS = {
            "Direction",
            "direction",
            "Dir",
            "dir",
            "LookVector",
            "lookVector",
            "lookVec",
            "LookVec",
            "AimDir",
            "aimDir",
        }
        local SPEAR_VEL_KEYS = { "Velocity", "velocity", "Vel", "vel" }
        local SPEAR_CF_KEYS = { "CFrame", "cframe" }

        local function rewriteSpearthrowArgs(args, targetDir)
            local replaced = false
            for i = 1, #args do
                local v = args[i]
                if type(v) == "table" then
                    for _, dk in ipairs(SPEAR_DIR_KEYS) do
                        if v[dk] ~= nil then
                            v[dk] = targetDir
                            replaced = true
                        end
                    end
                    for _, vk in ipairs(SPEAR_VEL_KEYS) do
                        local vv = v[vk]
                        if typeof(vv) == "Vector3" then
                            v[vk] = targetDir * vv.Magnitude
                            replaced = true
                        end
                    end
                    for _, ck in ipairs(SPEAR_CF_KEYS) do
                        local cv = v[ck]
                        if typeof(cv) == "CFrame" then
                            v[ck] = CFrame.lookAt(cv.Position, cv.Position + targetDir)
                            replaced = true
                        end
                    end
                elseif typeof(v) == "Vector3" then
                    local mag = v.Magnitude
                    if mag > 0.1 and math.abs(mag - 1.0) <= 0.15 then
                        args[i] = targetDir
                        replaced = true
                    end
                end
            end
            if not replaced then
                for i = 1, #args do
                    local v = args[i]
                    if typeof(v) == "CFrame" then
                        args[i] = CFrame.lookAt(v.Position, v.Position + targetDir)
                        replaced = true
                    end
                end
            end
            if not replaced then
                local camPos = Camera and Camera.CFrame.Position
                local char = LocalPlayer and LocalPlayer.Character
                local rootPart = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
                local rootPos = rootPart and rootPart.Position
                for i = 1, #args do
                    local v = args[i]
                    if typeof(v) == "Vector3" then
                        local isOrigin = (camPos and (v - camPos).Magnitude < 30)
                            or (rootPos and (v - rootPos).Magnitude < 30)
                        if not isOrigin then
                            args[i] = (v.Magnitude > 2.0) and (targetDir * v.Magnitude) or targetDir
                            replaced = true
                            break
                        end
                    end
                end
            end
            if not replaced and type(args[1]) == "table" then
                args[1].Direction = targetDir
            end
        end
        local veilHookInstalled = false

        local function ensureVeilNamecallHook()
            if veilHookInstalled or Hypnosis._VeilHookInstalled then
                return
            end
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local veilRemotes = remotes and remotes:FindFirstChild("Killers") and remotes.Killers:FindFirstChild("Veil")
            local Spearthrow = veilRemotes and veilRemotes:FindFirstChild("Spearthrow")
            local SpearState = veilRemotes and veilRemotes:FindFirstChild("SpearState")
            local okHook = Hypnosis._SafeHookNamecall(function(oldNamecall, self, ...)
                local method = getnamecallmethod()
                if (method ~= "FireServer" and method ~= "fireServer") or typeof(self) ~= "Instance" then
                    return oldNamecall(self, ...)
                end
                local rName = self.Name
                if rName == "KingScourgeHit" then
                    if
                        isInActiveGameTeam(LocalPlayer)
                        and not isKiller(LocalPlayer)
                        and (Hypnosis.Settings["Auto Skill Check_Enabled"] == true or Hypnosis.Settings["Auto Skill Check Engine_Enabled"] == true)
                        and (Hypnosis.Settings["Auto Skill Check_During Kings Scourge"] ~= false)
                    then
                        local args = { ... }
                        if args[2] == "fail" then
                            args[2] = "success"
                        end
                        return oldNamecall(self, (table.unpack or unpack)(args))
                    end
                    return oldNamecall(self, ...)
                elseif self == SpearState or rName == "SpearState" then
                    local args = { ... }
                    local action = type(args[1]) == "string" and args[1]:lower() or nil
                    if action == "charge" or action == "start" then
                        local startTs = tonumber(args[3]) or tonumber(args[2]) or workspace:GetServerTimeNow()
                        ChargeState.RemoteCharging = true
                        ChargeState.RemoteChargeStartTime = startTs
                        ChargeState.IsCharging = true
                        ChargeState.ChargeStartTime = startTs
                        ChargeState.CurrentChargeDuration = SpearConfig.MinChargeTime
                        ChargeState.MaxChargeReached = false
                    elseif action == "cancel" or action == "stop" or action == "end" then
                        ChargeState.RemoteCharging = false
                        ChargeState.RemoteChargeStartTime = 0
                        ChargeState.IsCharging = false
                        ChargeState.ChargeStartTime = 0
                        ChargeState.MaxChargeReached = false
                        ChargeState.CurrentChargeDuration = SpearConfig.FullChargeTime
                    end
                    return oldNamecall(self, (table.unpack or unpack)(args))
                elseif self == Spearthrow or rName == "Spearthrow" then
                    local args = { ... }
                    ChargeState.RemoteCharging = false
                    ChargeState.RemoteChargeStartTime = 0
                    ChargeState.IsCharging = false
                    ChargeState.ChargeStartTime = 0
                    ChargeState.MaxChargeReached = false
                    ChargeState.CurrentChargeDuration = SpearConfig.FullChargeTime
                    local silentActive = (Hypnosis.Settings["Veil_Enabled"] == true)
                        and (isSettingActive("Veil", "Spear Silent Aim") == true)
                    if silentActive then
                        local targetDir = getBestRedirectDir()
                        if targetDir then
                            rewriteSpearthrowArgs(args, targetDir)
                            SilentAimState.RecentThrowDir = targetDir
                            SilentAimState.RecentThrowTime = tick()
                            SilentAimState.LastValidLaunchDir = nil
                            SilentAimState.LastValidTarget = nil
                        end
                    end
                    return oldNamecall(self, (table.unpack or unpack)(args))
                end
                return oldNamecall(self, ...)
            end)
            if okHook then
                veilHookInstalled = true
                Hypnosis._VeilHookInstalled = true
            end
        end

        local function getTrajColor()
            local cv = Hypnosis.Settings["Veil_Trajectory Color_Color"]
            if typeof(cv) == "Color3" then
                return cv
            end
            if type(cv) == "table" and #cv >= 3 then
                return Color3.new(cv[1], cv[2], cv[3])
            end
            return Color3.fromRGB(215, 225, 235)
        end

        local function getOnTargetColor()
            local cv = Hypnosis.Settings["Veil_On-Target Color_Color"]
            if typeof(cv) == "Color3" then
                return cv
            end
            if type(cv) == "table" and #cv >= 3 then
                return Color3.new(cv[1], cv[2], cv[3])
            end
            return Color3.fromRGB(255, 55, 60)
        end
        local hasRenderedVisuals = false

        local function clearTrajectoryOnly()
            if hasRenderedVisuals then
                hasRenderedVisuals = false
                for i = 1, SpearConfig.SegmentsCount do
                    localSegments[i].Transparency = 1
                    localSegments[i].CFrame = CFrame.new(0, -99999, 0)
                end
                hitMarkerBall.Transparency = 1
            end
        end

        local function clearVeilVisuals(resetTargetState)
            if fovFrame.Visible then
                fovFrame.Visible = false
            end
            if crossContainer.Visible then
                crossContainer.Visible = false
            end
            clearTrajectoryOnly()
            if resetTargetState then
                SilentAimState.ActiveTarget = nil
                SilentAimState.CalculatedLaunchDir = nil
            end
        end
        local veilConn = RunService.RenderStepped:Connect(function(dtFrame)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local mainEnabled = (Hypnosis.Settings["Veil_Enabled"] == true)

            local char = LocalPlayer and LocalPlayer.Character
            local spearInHand = mainEnabled and isSpearInHand(char) or false
            local isVeilRole = mainEnabled and (isKiller(LocalPlayer) or spearInHand or isVeilCharacter(char)) or false
            local inActiveMatch = isInActiveGameTeam(LocalPlayer)
            if not veilHookInstalled then
                local autoSkillEnabled = (Hypnosis.Settings["Auto Skill Check_Enabled"] == true)
                    or (Hypnosis.Settings["Auto Skill Check Engine_Enabled"] == true)
                if isVeilRole or (inActiveMatch and autoSkillEnabled and not isKiller(LocalPlayer)) then
                    ensureVeilNamecallHook()
                end
            end
            if not mainEnabled then
                clearVeilVisuals(true)
                return
            end
            if isVeilRole then
                ensureNativeSpearMath()
                ensureProjectilePredictHook()
            end
            local silentActive = isSettingActive("Veil", "Spear Silent Aim") == true
            local trajActive = isSettingActive("Veil", "3D Spear Trajectory") == true
            local noclipActive = isSettingActive("Veil", "Noclip Trajectory") == true
            local showFov = isSettingActive("Veil", "Show FOV Circle") == true
            local fovRadius = tonumber(Hypnosis.Settings["Veil_Silent Aim FOV"]) or 140
            local trajColor = getTrajColor()
            local onTargetColor = getOnTargetColor()
            local cam = workspace.CurrentCamera or Camera
            Camera = cam
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local cx = math.floor(vp.X * 0.5)
            local cy = math.floor(vp.Y * 0.5)
            if not char or not spearInHand or not Camera then
                clearVeilVisuals(true)
                return
            end
            if showFov and silentActive then
                fovFrame.Visible = true
                fovFrame.Position = UDim2.new(0, cx, 0, cy)
                fovFrame.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
                fovStroke.Color = (SilentAimState.ActiveTarget ~= nil) and onTargetColor
                    or Color3.fromRGB(255, 255, 255)
                fovStroke.Transparency = 0.65
            else
                fovFrame.Visible = false
            end
            updateActiveTargets(char)
            local _, chargeDuration = updateChargeState(char)
            local currentSpeed = math.clamp(chargeDuration * SpearConfig.Speed, 1, SpearConfig.Speed)
            local target = nil
            if silentActive then
                target = selectTargetInFOV(fovRadius)
            end
            SilentAimState.ActiveTarget = target
            if target and target.head then
                local sp, onScreen = Camera:WorldToViewportPoint(target.head.Position)
                if onScreen and sp.Z > 0 then
                    crossContainer.Visible = true
                    crossContainer.Position = UDim2.new(0, sp.X, 0, sp.Y)
                    crossRotation = (crossRotation + dtFrame * 180) % 360
                    crossContainer.Rotation = crossRotation
                else
                    crossContainer.Visible = false
                end
                local camPos = Camera.CFrame.Position
                local targetVel = target.root and (target.root.AssemblyLinearVelocity or target.root.Velocity)
                    or target.velocity
                    or Vector3.new()
                local launchDir, leadPos, flightT =
                    solveTrueBallisticAim(camPos, target.head.Position, targetVel, currentSpeed)
                SilentAimState.CalculatedLaunchDir = launchDir
                SilentAimState.PredictedHitPos = leadPos
                SilentAimState.FlightTime = flightT
                SilentAimState.LastValidLaunchDir = launchDir
                SilentAimState.LastValidTarget = target
                SilentAimState.LastValidTime = tick()
            else
                crossContainer.Visible = false
                SilentAimState.CalculatedLaunchDir = nil
                SilentAimState.PredictedHitPos = nil
            end
            if not trajActive then
                clearTrajectoryOnly()
                return
            end
            local camCF = Camera.CFrame
            local aimDirection = camCF.LookVector
            local origin = camCF.Position + aimDirection * SpearConfig.SpawnOffset
            local velocity = aimDirection * currentSpeed
            local gravity = SpearConfig.Gravity
            local dt = SpearConfig.StepDt
            local count = SpearConfig.SegmentsCount
            localPathPoints[1] = origin
            for i = 1, count do
                local t = i * dt
                localPathPoints[i + 1] = origin + velocity * t + 0.5 * gravity * (t * t)
            end
            local hitConfirmed = (silentActive and target ~= nil)
            local hitPosition = nil
            local hitStepIndex = count
            for step = 1, count do
                local p1 = localPathPoints[step]
                local p2 = localPathPoints[step + 1]
                local dir = p2 - p1
                local segLen = dir.Magnitude
                if segLen > 0.0001 then
                    local uDir = dir / segLen
                    for _, tInfo in ipairs(activeTargets) do
                        local toRoot = tInfo.rootPos - p1
                        local proj = toRoot:Dot(uDir)
                        if proj >= -3 and proj <= segLen + 3 then
                            local closest = p1 + uDir * math.clamp(proj, 0, segLen)
                            local dist = (tInfo.rootPos - closest).Magnitude
                            if dist <= 8.5 then
                                local bestT = 1
                                local hitPart = nil
                                for _, part in ipairs(tInfo.parts) do
                                    local tSlab = testOBB(p1, dir, part.CFrame, part.Size)
                                    if tSlab and tSlab < bestT then
                                        bestT = tSlab
                                        hitPart = part
                                    end
                                end
                                if hitPart then
                                    hitConfirmed = true
                                    hitPosition = p1 + dir * bestT
                                    hitStepIndex = step
                                    break
                                end
                            end
                        end
                    end
                    if hitConfirmed and hitPosition then
                        break
                    end
                end
            end
            if not noclipActive and not hitPosition then
                cachedFilter[1] = char
                cachedFilter[2] = Camera
                cachedFilter[3] = trajFolder
                cachedFilter[4] = trailFolder
                localRayParams.FilterDescendantsInstances = cachedFilter
                for i = 1, count do
                    local p1 = localPathPoints[i]
                    local p2 = localPathPoints[i + 1]
                    local ray = workspace:Raycast(p1, p2 - p1, localRayParams)
                    if ray then
                        local inst = ray.Instance
                        if inst and inst.CanCollide and inst.Transparency < 0.95 then
                            hitPosition = ray.Position
                            hitStepIndex = i
                            break
                        end
                    end
                end
            end
            hasRenderedVisuals = true
            local activeColor = hitConfirmed and onTargetColor or trajColor
            local activeTransparency = hitConfirmed and 0.32 or 0.45
            for i = 1, count do
                local p = localSegments[i]
                if i <= hitStepIndex then
                    local p1 = localPathPoints[i]
                    local p2 = (i == hitStepIndex and hitPosition) or localPathPoints[i + 1]
                    if p2 then
                        local disp = p2 - p1
                        local segLen = disp.Magnitude
                        if segLen > 0.001 then
                            p.Size = Vector3.new(SpearConfig.StripThickness, SpearConfig.StripThickness, segLen)
                            p.CFrame = CFrame.lookAt(p1 + disp * 0.5, p2)
                            p.Color = activeColor
                            p.Transparency = activeTransparency
                        else
                            p.Transparency = 1
                        end
                    else
                        p.Transparency = 1
                    end
                else
                    p.Transparency = 1
                    p.CFrame = CFrame.new(0, -99999, 0)
                end
            end
            local markerPos = hitPosition or (noclipActive and localPathPoints[count + 1] or nil)
            if markerPos then
                hitMarkerBall.Position = markerPos
                hitMarkerBall.Color = activeColor
                hitMarkerBall.Size = hitConfirmed and Vector3.new(0.32, 0.32, 0.32) or Vector3.new(0.24, 0.24, 0.24)
                hitMarkerBall.Transparency = activeTransparency
            else
                hitMarkerBall.Transparency = 1
            end
        end)
        table.insert(Hypnosis.Connections, veilConn)
    end

    function Hypnosis.InitGuiChanger()
        if Hypnosis.GuiChangerContainer and Hypnosis.GuiChangerContainer.Parent then
            pcall(function()
                Hypnosis.GuiChangerContainer:Destroy()
            end)
        end
        Hypnosis.GuiChanger = {
            Tracked = {},
            HiddenList = {},
            SelectedEntry = nil,
            HoverEntry = nil,
            ActiveCategory = "All",
            MoveMode = false,
            OutlinesVisible = true,
            SnapGrid = 10,
            CategoryOffsets = {
                ["All"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
                ["Item Slot"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
                ["Objectives"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
                ["Stamina Bar"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
                ["Health / State"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
                ["Controls"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
                ["Team Status"] = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 },
            },
            Toolbar = nil,
            SelectionBox = nil,
            HoverBox = nil,
            ActionToolbar = nil,
            HiddenDrawer = nil,
            HitCatcher = nil,
            Container = nil,
            Connections = {},
        }

        local function isGuiChangerEnabled()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return false
            end
            return (Hypnosis.Settings["GUI Changer_Enabled"] == true)
        end
        local gcContainer = Instance.new("ScreenGui")
        gcContainer.Name = "Hypnosis_GuiChangerContainer"
        gcContainer.ResetOnSpawn = false
        gcContainer.DisplayOrder = 999900
        gcContainer.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gcContainer.IgnoreGuiInset = false
        gcContainer.Enabled = false
        if typeof(gethui) == "function" then
            pcall(function()
                gcContainer.Parent = gethui()
            end)
        end
        if not gcContainer.Parent then
            pcall(function()
                gcContainer.Parent = CoreGui
            end)
        end
        if not gcContainer.Parent then
            local pgFallback = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pgFallback then
                pcall(function()
                    gcContainer.Parent = pgFallback
                end)
            end
        end
        Hypnosis.GuiChangerContainer = gcContainer
        Hypnosis.GuiChanger.Container = gcContainer

        local function isBlacklistedGui(gui)
            if not gui then
                return true
            end
            if
                gui == Hypnosis.ScreenGui
                or gui == Hypnosis.GuiChangerContainer
                or gui == Hypnosis.OverlaysContainer
                or gui == Hypnosis.EspContainer
            then
                return true
            end
            if Hypnosis.ScreenGui and gui:IsDescendantOf(Hypnosis.ScreenGui) then
                return true
            end
            if gcContainer and gui:IsDescendantOf(gcContainer) then
                return true
            end
            if gui:FindFirstAncestorOfClass("BillboardGui") or gui:FindFirstAncestorOfClass("SurfaceGui") then
                return true
            end
            local cur = gui
            while cur and cur ~= game and not cur:IsA("PlayerGui") do
                local name = cur.Name:lower()
                if
                    name:find("hypnosis")
                    or name:find("coregui")
                    or name:find("chat")
                    or name:find("freecam")
                    or name:find("robloxgui")
                    or name:find("devtools")
                    or name:find("console")
                    or name:find("prompt")
                    or name:find("skillcheck")
                    or name:find("loading")
                    or name:find("teleport")
                    or name:find("transition")
                    or name:find("cutscene")
                    or name:find("fade")
                    or name:find("touchgui")
                then
                    return true
                end
                cur = cur.Parent
            end
            return false
        end

        local function isFullScreenWrapper(guiObj)
            if not guiObj or not guiObj:IsA("GuiObject") then
                return false
            end
            if guiObj.Size.X.Scale >= 0.85 and guiObj.Size.Y.Scale >= 0.85 then
                return true
            end
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            if vp.X > 0 and vp.Y > 0 then
                local as = guiObj.AbsoluteSize
                if as.X >= (vp.X * 0.85) and as.Y >= (vp.Y * 0.85) then
                    return true
                end
            end
            return false
        end

        local function isLayoutManaged(guiObj)
            local p = guiObj and guiObj.Parent
            if not p then
                return false
            end
            if
                p:FindFirstChildOfClass("UIListLayout")
                or p:FindFirstChildOfClass("UIGridLayout")
                or p:FindFirstChildOfClass("UITableLayout")
                or p:FindFirstChildOfClass("UIPageLayout")
            then
                return true
            end
            return false
        end

        local function isEligibleHudWidget(guiObj)
            if not guiObj or not guiObj:IsA("GuiObject") or guiObj:IsA("UIComponent") then
                return false
            end
            if isBlacklistedGui(guiObj) then
                return false
            end
            if isLayoutManaged(guiObj) then
                return false
            end
            if isFullScreenWrapper(guiObj) then
                return false
            end
            local parent = guiObj.Parent
            if not parent then
                return false
            end
            if parent:IsA("ScreenGui") then
                return not isBlacklistedGui(parent)
            end
            if parent:IsA("GuiObject") and isFullScreenWrapper(parent) then
                local grandParent = parent.Parent
                if grandParent and grandParent:IsA("ScreenGui") and not isBlacklistedGui(grandParent) then
                    return true
                end
                if grandParent and grandParent:IsA("GuiObject") and isFullScreenWrapper(grandParent) then
                    local ggp = grandParent.Parent
                    if ggp and ggp:IsA("ScreenGui") and not isBlacklistedGui(ggp) then
                        return true
                    end
                end
            end
            return false
        end

        local function classifyElement(guiObj)
            local cur = guiObj
            while cur and cur ~= workspace and not cur:IsA("PlayerGui") do
                local name = cur.Name:lower()
                if
                    name:find("item")
                    or name:find("slot")
                    or name:find("inventory")
                    or name:find("tool")
                    or name:find("activeitem")
                    or name:find("ability")
                    or name:find("power")
                    or name:find("weapon")
                then
                    return "Item Slot"
                elseif
                    name:find("gen")
                    or name:find("generator")
                    or name:find("objective")
                    or name:find("progress")
                    or name:find("motor")
                    or name:find("machine")
                    or name:find("repair")
                then
                    return "Objectives"
                elseif
                    name:find("stamina")
                    or name:find("sprint")
                    or name:find("energy")
                    or name:find("run")
                    or name:find("exhaust")
                then
                    return "Stamina Bar"
                elseif
                    name:find("health")
                    or name:find("state")
                    or name:find("heart")
                    or name:find("terror")
                    or name:find("bleed")
                    or name:find("downed")
                    or name:find("wounded")
                    or name:find("injury")
                    or name:find("status")
                    or name:find("damage")
                then
                    return "Health / State"
                elseif
                    name:find("control")
                    or name:find("mob")
                    or name:find("touch")
                    or name:find("button")
                    or name:find("dpad")
                    or name:find("action")
                    or name:find("crouch")
                    or name:find("vault")
                then
                    return "Controls"
                elseif
                    name:find("team")
                    or name:find("survivor")
                    or name:find("teammate")
                    or name:find("playerlist")
                    or name:find("allies")
                    or name:find("party")
                    or name:find("portrait")
                    or name:find("spectate")
                then
                    return "Team Status"
                end
                cur = cur.Parent
            end
            return "Other"
        end

        local function isPointInGui(point, guiObj)
            if not guiObj or not guiObj.Parent or not guiObj.Visible then
                return false
            end
            local p = guiObj.AbsolutePosition
            local s = guiObj.AbsoluteSize
            if point.X >= p.X and point.X <= (p.X + s.X) and point.Y >= p.Y and point.Y <= (p.Y + s.Y) then
                return true
            end
            local mLoc = UserInputService:GetMouseLocation()
            if mLoc.X >= p.X and mLoc.X <= (p.X + s.X) and mLoc.Y >= p.Y and mLoc.Y <= (p.Y + s.Y) then
                return true
            end
            local ok, inset = pcall(function()
                return game:GetService("GuiService"):GetGuiInset()
            end)
            if ok and inset then
                local mAdj = mLoc - inset
                if mAdj.X >= p.X and mAdj.X <= (p.X + s.X) and mAdj.Y >= p.Y and mAdj.Y <= (p.Y + s.Y) then
                    return true
                end
            end
            return false
        end

        local function isPointOverHypnosisUi(pos)
            if isPointInGui(pos, MainFrame) then
                return true
            end
            if isPointInGui(pos, MobileButton) then
                return true
            end
            if Hypnosis.IsPointOverMobileKeybinds and Hypnosis.IsPointOverMobileKeybinds(pos) then
                return true
            end
            if isPointInGui(pos, Hypnosis.ColorPickerOverlay) then
                return true
            end
            if isPointInGui(pos, Hypnosis.GuiChanger.Toolbar) then
                return true
            end
            if isPointInGui(pos, Hypnosis.GuiChanger.ActionToolbar) then
                return true
            end
            if isPointInGui(pos, Hypnosis.GuiChanger.HiddenDrawer) then
                return true
            end
            return false
        end

        local function revertEntry(entry)
            if not entry then
                return
            end
            local elem = entry.Element
            if elem and elem.Parent and entry.WasModifiedByUs then
                if entry.AppliedOffsetX ~= 0 or entry.AppliedOffsetY ~= 0 then
                    local ox, oy = entry.AppliedOffsetX, entry.AppliedOffsetY
                    entry.AppliedOffsetX = 0
                    entry.AppliedOffsetY = 0
                    pcall(function()
                        local curPos = elem.Position
                        elem.Position =
                            UDim2.new(curPos.X.Scale, curPos.X.Offset - ox, curPos.Y.Scale, curPos.Y.Offset - oy)
                    end)
                end
                if entry.WasHiddenByUs then
                    entry.WasHiddenByUs = false
                    pcall(function()
                        elem.Visible = true
                    end)
                end
                if entry.UIScaleObj then
                    local sc = entry.UIScaleObj
                    entry.UIScaleObj = nil
                    pcall(function()
                        sc.Scale = 1.0
                        sc:Destroy()
                    end)
                end
                entry.AppliedScale = 1.0
                if entry.AppliedTransDelta and entry.AppliedTransDelta ~= 0 then
                    local dt = entry.AppliedTransDelta
                    entry.AppliedTransDelta = 0
                    pcall(function()
                        if elem:IsA("CanvasGroup") then
                            elem.GroupTransparency = math.clamp(elem.GroupTransparency - dt, 0, 1)
                        elseif entry.BaseTransparency ~= nil then
                            elem.BackgroundTransparency = entry.BaseTransparency
                        end
                    end)
                    entry.BaseTransparency = nil
                end
            else
                entry.AppliedOffsetX = 0
                entry.AppliedOffsetY = 0
                entry.WasHiddenByUs = false
                entry.AppliedScale = 1.0
                entry.AppliedTransDelta = 0
                entry.BaseTransparency = nil
                if entry.UIScaleObj then
                    local sc = entry.UIScaleObj
                    entry.UIScaleObj = nil
                    pcall(function()
                        sc:Destroy()
                    end)
                end
            end
            entry.WasModifiedByUs = false
        end

        local function applyTransform(entry)
            if not entry or not entry.Element or not entry.Element.Parent then
                return
            end
            if isLayoutManaged(entry.Element) then
                return
            end
            if not isGuiChangerEnabled() then
                if entry.WasModifiedByUs then
                    revertEntry(entry)
                end
                return
            end
            local cat = entry.Category or "Other"
            local catOffset = Hypnosis.GuiChanger.CategoryOffsets[cat]
                or { X = 0, Y = 0, Scale = 1.0, Transparency = 0 }
            local allOffset = Hypnosis.GuiChanger.CategoryOffsets["All"]
                or { X = 0, Y = 0, Scale = 1.0, Transparency = 0 }
            local totalOffsetX = (entry.DragOffsetX or 0) + (catOffset.X or 0) + (allOffset.X or 0)
            local totalOffsetY = (entry.DragOffsetY or 0) + (catOffset.Y or 0) + (allOffset.Y or 0)
            local totalScale = (catOffset.Scale or 1.0) * (allOffset.Scale or 1.0)
            local totalTrans = math.clamp((catOffset.Transparency or 0) + (allOffset.Transparency or 0), 0, 0.9)
            local hasAnyTransform = (totalOffsetX ~= 0)
                or (totalOffsetY ~= 0)
                or (math.abs(totalScale - 1.0) > 0.01)
                or (totalTrans > 0.001)
                or (entry.IsHidden == true)
            if not hasAnyTransform then
                if entry.WasModifiedByUs then
                    revertEntry(entry)
                end
                return
            end
            local elem = entry.Element
            local dx = totalOffsetX - (entry.AppliedOffsetX or 0)
            local dy = totalOffsetY - (entry.AppliedOffsetY or 0)
            if dx ~= 0 or dy ~= 0 then
                entry.AppliedOffsetX = totalOffsetX
                entry.AppliedOffsetY = totalOffsetY
                entry.WasModifiedByUs = true
                pcall(function()
                    local curPos = elem.Position
                    elem.Position =
                        UDim2.new(curPos.X.Scale, curPos.X.Offset + dx, curPos.Y.Scale, curPos.Y.Offset + dy)
                end)
            end
            if entry.IsHidden then
                entry.WasHiddenByUs = true
                entry.WasModifiedByUs = true
                if elem.Visible then
                    pcall(function()
                        elem.Visible = false
                    end)
                end
            elseif entry.WasHiddenByUs then
                entry.WasHiddenByUs = false
                pcall(function()
                    elem.Visible = true
                end)
            end
            if math.abs(totalScale - 1.0) > 0.01 then
                if not entry.UIScaleObj or not entry.UIScaleObj.Parent then
                    local sc = elem:FindFirstChild("Hypnosis_UIScale") or Instance.new("UIScale")
                    sc.Name = "Hypnosis_UIScale"
                    sc.Parent = elem
                    entry.UIScaleObj = sc
                end
                entry.UIScaleObj.Scale = totalScale
                entry.AppliedScale = totalScale
                entry.WasModifiedByUs = true
            elseif entry.UIScaleObj then
                local sc = entry.UIScaleObj
                entry.UIScaleObj = nil
                entry.AppliedScale = 1.0
                pcall(function()
                    sc.Scale = 1.0
                    sc:Destroy()
                end)
            end
            if totalTrans > 0.001 then
                pcall(function()
                    if elem:IsA("CanvasGroup") then
                        local prevDelta = entry.AppliedTransDelta or 0
                        local base = math.clamp(elem.GroupTransparency - prevDelta, 0, 1)
                        local target = math.clamp(base + totalTrans, 0, 0.95)
                        elem.GroupTransparency = target
                        entry.AppliedTransDelta = target - base
                        entry.WasModifiedByUs = true
                    elseif elem.BackgroundTransparency < 0.99 then
                        if entry.BaseTransparency == nil then
                            entry.BaseTransparency = elem.BackgroundTransparency
                        end
                        local target = math.clamp(entry.BaseTransparency + totalTrans, 0, 0.95)
                        elem.BackgroundTransparency = target
                        entry.AppliedTransDelta = target - entry.BaseTransparency
                        entry.WasModifiedByUs = true
                    end
                end)
            elseif entry.AppliedTransDelta and entry.AppliedTransDelta ~= 0 then
                local dt = entry.AppliedTransDelta
                entry.AppliedTransDelta = 0
                pcall(function()
                    if elem:IsA("CanvasGroup") then
                        elem.GroupTransparency = math.clamp(elem.GroupTransparency - dt, 0, 1)
                    elseif entry.BaseTransparency ~= nil then
                        elem.BackgroundTransparency = entry.BaseTransparency
                    end
                end)
                entry.BaseTransparency = nil
            end
        end

        local function registerElement(guiObj, forcedCat, allowManualParent)
            if not guiObj or not guiObj:IsA("GuiObject") or guiObj:IsA("UIComponent") then
                return nil
            end
            if isBlacklistedGui(guiObj) then
                return nil
            end
            if isLayoutManaged(guiObj) then
                return nil
            end
            if not allowManualParent and not isEligibleHudWidget(guiObj) then
                return nil
            end
            local existing = Hypnosis.GuiChanger.Tracked[guiObj]
            if existing then
                return existing
            end
            local entry = {
                Element = guiObj,
                Category = forcedCat or classifyElement(guiObj),
                DragOffsetX = 0,
                DragOffsetY = 0,
                AppliedOffsetX = 0,
                AppliedOffsetY = 0,
                AppliedScale = 1.0,
                AppliedTransDelta = 0,
                BaseTransparency = nil,
                IsHidden = false,
                WasHiddenByUs = false,
                WasModifiedByUs = false,
                UIScaleObj = nil,
                AncestryConn = nil,
            }
            Hypnosis.GuiChanger.Tracked[guiObj] = entry
            entry.AncestryConn = guiObj.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    if entry.AncestryConn then
                        entry.AncestryConn:Disconnect()
                        entry.AncestryConn = nil
