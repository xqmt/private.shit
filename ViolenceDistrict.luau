        local function refreshConfigsUI()
            local active = ConfigManager.Active or "DEFAULT"
            cfgNameLbl.Text = active:upper()
            if survBindVal then
                survBindVal.Text = (ConfigManager.SurvivorConfig or "Default"):upper()
            end
            if killBindVal then
                killBindVal.Text = (ConfigManager.KillerConfig or "Default"):upper()
            end
            local count = 0
            for _ in pairs(ConfigManager.Configs) do
                count = count + 1
            end
            rowProfilesVal.Text = tostring(count) .. (count == 1 and " Profile" or " Profiles")
            for _, ch in ipairs(listScroll:GetChildren()) do
                if ch:IsA("GuiObject") then
                    ch:Destroy()
                end
            end
            configItemRefs = {}
            local names = {}
            for k in pairs(ConfigManager.Configs) do
                table.insert(names, k)
            end
            table.sort(names, function(a, b)
                if a == ConfigManager.Active then
                    return true
                end
                if b == ConfigManager.Active then
                    return false
                end
                return a < b
            end)
            local bs = ScaleState.Button or 1
            local rowH = math.floor(24 * bs + 0.5)
            local nameSz = math.clamp(math.floor(10 * (0.8 + 0.2 * bs) + 0.5), 9, 14)
            local tagSz = math.clamp(math.floor(9 * (0.8 + 0.2 * bs) + 0.5), 8, 13)
            for _, cfgName in ipairs(names) do
                local isAct = (cfgName == ConfigManager.Active)
                local item = Instance.new("TextButton", listScroll)
                item.Size = UDim2.new(1, -4, 0, rowH)
                item.BackgroundColor3 = isAct and Palette.HoverBg or Palette.ButtonBg
                item.BorderSizePixel = 0
                item.AutoButtonColor = false
