                local listHeight = math.clamp(sLayout.AbsoluteContentSize.Y + 8, 20, math.floor(110 * bs + 0.5))
                scroll.Size = UDim2.new(1, -4, 0, listHeight)
                frame.Size = UDim2.new(1, -16, 0, hdrH + 4 + listHeight)
            else
                frame.Size = UDim2.new(1, -16, 0, hdrH)
            end
        end)
        RegisterSetting(settingKey, currentChoice, function(v)
            currentChoice = tostring(v)
            selectedLbl.Text = Italic(currentChoice)
            if onSelectCallback then
                onSelectCallback(currentChoice, false)
            end
        end)
        return frame
