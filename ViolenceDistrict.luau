        local function updateSpectators()
            local isEnabled = Hypnosis.Settings["Spectator List Overlay_Enabled"] == true
            if not isEnabled then
                if specCard.Visible then
                    fadeCard(specCard, false)
                end
                return
            end
            local showWhenEmpty = isSettingActive("Spectator List Overlay", "Show When Empty")
            local showHeader = isSettingActive("Spectator List Overlay", "Show Title Header")
            specHeader.Visible = showHeader
            specDivider.Visible = showHeader
            specList.Position = showHeader and UDim2.new(0, 8, 0, 26) or UDim2.new(0, 8, 0, 8)
            local spectators = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if not isKiller(p) and not isSurvivor(p) then
                    table.insert(spectators, p)
                end
            end
            if #spectators == 0 then
                if showWhenEmpty then
                    emptySpecLabel.Visible = true
                    for _, rowData in ipairs(specRows) do
                        rowData.Row.Visible = false
                    end
                    local targetSize = showHeader and UDim2.new(0, 175, 0, 46) or UDim2.new(0, 175, 0, 28)
                    if specCard.Size ~= targetSize then
                        Tween(specCard, { Size = targetSize }, 0.2, Enum.EasingStyle.Quad)
                    end
                    if not specCard.Visible or (specCard:IsA("CanvasGroup") and specCard.GroupTransparency > 0.05) then
                        fadeCard(specCard, true)
                    end
                else
                    if specCard.Visible then
                        fadeCard(specCard, false)
                    end
                end
            else
                emptySpecLabel.Visible = false
                for idx, sp in ipairs(spectators) do
                    local rowData = specRows[idx]
                    if not rowData then
                        local row = Instance.new("Frame", specList)
                        row.Name = "SpecRow_" .. tostring(idx)
                        row.Size = UDim2.new(1, 0, 0, 16)
                        row.BackgroundTransparency = 1
                        row.BorderSizePixel = 0
                        local nameLbl = Instance.new("TextLabel", row)
                        nameLbl.Size = UDim2.new(1, -44, 1, 0)
                        nameLbl.Position = UDim2.new(0, 2, 0, 0)
                        nameLbl.BackgroundTransparency = 1
                        nameLbl.Font = Enum.Font.GothamMedium
                        nameLbl.TextColor3 = Color3.fromRGB(240, 240, 240)
                        nameLbl.TextSize = 9
                        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                        local statusLbl = Instance.new("TextLabel", row)
                        statusLbl.Size = UDim2.new(0, 40, 1, 0)
                        statusLbl.Position = UDim2.new(1, -40, 0, 0)
                        statusLbl.BackgroundTransparency = 1
                        statusLbl.Font = Enum.Font.GothamMedium
                        statusLbl.Text = "Watching"
                        statusLbl.TextColor3 = Color3.fromRGB(136, 136, 136)
                        statusLbl.TextSize = 9
                        statusLbl.TextXAlignment = Enum.TextXAlignment.Right
                        rowData = { Row = row, Label = nameLbl, Status = statusLbl }
                        specRows[idx] = rowData
                    end
                    rowData.Row.Visible = true
                    if rowData.Label.Text ~= sp.DisplayName then
                        rowData.Label.Text = sp.DisplayName
                    end
                end
                for i = #spectators + 1, #specRows do
                    specRows[i].Row.Visible = false
                end
                local baseH = showHeader and 30 or 14
                local targetSize = UDim2.new(0, 175, 0, baseH + (#spectators * 19))
                if specCard.Size ~= targetSize then
                    Tween(specCard, { Size = targetSize }, 0.2, Enum.EasingStyle.Quad)
                end
                if not specCard.Visible or (specCard:IsA("CanvasGroup") and specCard.GroupTransparency > 0.05) then
                    fadeCard(specCard, true)
                end
            end
        end

