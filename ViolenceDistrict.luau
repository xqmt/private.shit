    function UI._SetupKeybindButton(cfg)
        local bindKeyStr = (type(cfg.DefaultBind) == "string" and cfg.DefaultBind ~= "") and cfg.DefaultBind or "None"
        local bindBtn = Instance.new("TextButton", cfg.Parent)
        bindBtn.Size = UDim2.new(0, 42, 1, 0)
        bindBtn.Position = UDim2.new(1, -45, 0, 0)
        bindBtn.BackgroundTransparency = 1
        bindBtn.Font = Enum.Font.GothamMedium
        bindBtn.RichText = true
        bindBtn.TextColor3 = Palette.KeybindText
        bindBtn.TextSize = 9
        bindBtn.TextXAlignment = Enum.TextXAlignment.Right
        local parsedKey = Enum.KeyCode.Unknown
        if bindKeyStr ~= "None" then
            pcall(function()
                parsedKey = Enum.KeyCode[bindKeyStr]
            end)
        end
        local isListening = false
        local listenConn = nil
        local pressSeq = 0
        local suppressClickOnce = false

        local function setListening(active)
            if active == isListening then
                return
            end
            isListening = active
            if active then
                Hypnosis._ListeningBindCount = (Hypnosis._ListeningBindCount or 0) + 1
            else
                Hypnosis._ListeningBindCount = math.max(0, (Hypnosis._ListeningBindCount or 1) - 1)
            end
        end
        local bindData = {
            Name = cfg.BindName,
            DisplayName = cfg.DisplayName,
            SettingKey = cfg.SettingKey,
            Key = parsedKey,
            MobPinned = false,
            Toggle = cfg.Toggle,
            GetActive = cfg.GetActive,
        }

        local function refreshBindVisual()
            if not bindBtn or not bindBtn.Parent then
                return
            end
            if isListening then
                bindBtn.Text = Italic("[...]")
                bindBtn.TextColor3 = Palette.Accent
            elseif bindData.MobPinned then
                if bindKeyStr == "None" then
                    bindBtn.Text = Italic("[Mob]")
                else
                    bindBtn.Text = Italic("[" .. bindKeyStr .. "|M]")
                end
                bindBtn.TextColor3 = Palette.Accent
            else
                bindBtn.Text = Italic("[" .. bindKeyStr .. "]")
                bindBtn.TextColor3 = Palette.KeybindText
            end
        end
        bindData.RefreshBindVisual = refreshBindVisual
        table.insert(Hypnosis.RegisteredKeybinds, bindData)
        refreshBindVisual()
        RegisterSetting(cfg.SettingKey .. "_Bind", bindKeyStr, function(v)
            bindKeyStr = (type(v) == "string" and v ~= "") and v or "None"
            local pk = Enum.KeyCode.Unknown
            if bindKeyStr ~= "None" then
                pcall(function()
                    pk = Enum.KeyCode[bindKeyStr]
                end)
            end
            bindData.Key = pk
            refreshBindVisual()
            if cfg.OnBindSet then
                pcall(cfg.OnBindSet, pk)
            end
            if Hypnosis.RebuildMobileKeybinds then
                pcall(Hypnosis.RebuildMobileKeybinds)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end)
        RegisterSetting(cfg.SettingKey .. "_MobBind", false, function(v)
            bindData.MobPinned = (v == true)
            refreshBindVisual()
            if Hypnosis.RebuildMobileKeybinds then
                pcall(Hypnosis.RebuildMobileKeybinds)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end)

        local function resetToNone()
            if listenConn then
                listenConn:Disconnect()
                listenConn = nil
            end
            setListening(false)
            bindData.Key = Enum.KeyCode.Unknown
            bindData.MobPinned = false
            bindKeyStr = "None"
            refreshBindVisual()
            UpdateSetting(cfg.SettingKey .. "_Bind", "None")
            UpdateSetting(cfg.SettingKey .. "_MobBind", false)
            if cfg.AltBindKey then
                UpdateSetting(cfg.AltBindKey, "None")
            end
            if cfg.OnBindSet then
                pcall(cfg.OnBindSet, nil)
            end
            if Hypnosis.RebuildMobileKeybinds then
                pcall(Hypnosis.RebuildMobileKeybinds)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end
        bindBtn.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            pressSeq = pressSeq + 1
            local mySeq = pressSeq
            local isDown = true
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDown = false
                end
            end)
            task.delay(0.55, function()
                if isDown and pressSeq == mySeq and (bindData.MobPinned or bindKeyStr ~= "None" or isListening) then
                    suppressClickOnce = true
                    resetToNone()
                    showNotification(
                        "Keybind",
                        tostring(cfg.DisplayName or cfg.BindName) .. " bind cleared.",
                        "info",
                        1.5
                    )
                end
            end)
        end)
        bindBtn.MouseButton2Click:Connect(resetToNone)
        bindBtn.MouseButton1Click:Connect(function()
            if suppressClickOnce then
                suppressClickOnce = false
                return
            end
            if Hypnosis.Settings["Mobile Keybinds_TapToPin"] == true then
                if listenConn then
                    listenConn:Disconnect()
                    listenConn = nil
                end
                setListening(false)
                bindData.MobPinned = not bindData.MobPinned
                UpdateSetting(cfg.SettingKey .. "_MobBind", bindData.MobPinned)
                if bindData.MobPinned and Hypnosis.Settings["Mobile Keybinds_Enabled"] ~= true then
                    UpdateSetting("Mobile Keybinds_Enabled", true)
                    if Hypnosis.Setters["Mobile Keybinds_Enabled"] then
                        pcall(Hypnosis.Setters["Mobile Keybinds_Enabled"], true)
                    end
                end
                refreshBindVisual()
                if Hypnosis.RebuildMobileKeybinds then
                    pcall(Hypnosis.RebuildMobileKeybinds)
                end
                if Hypnosis.RefreshFeatureOverlays then
                    pcall(Hypnosis.RefreshFeatureOverlays)
                end
                return
            end
            if isListening then
                resetToNone()
                return
            end
            setListening(true)
            refreshBindVisual()
            if listenConn then
                listenConn:Disconnect()
            end
            listenConn = UserInputService.InputBegan:Connect(function(input)
                local isKey = input.UserInputType == Enum.UserInputType.Keyboard
                local isPad = input.UserInputType.Name:find("Gamepad")
                if isKey or isPad then
                    if listenConn then
                        listenConn:Disconnect()
                        listenConn = nil
                    end
                    setListening(false)
                    if
                        input.KeyCode == Enum.KeyCode.Backspace
                        or input.KeyCode == Enum.KeyCode.Delete
                        or input.KeyCode == Enum.KeyCode.Escape
                        or input.KeyCode == Enum.KeyCode.ButtonSelect
                        or input.KeyCode == Enum.KeyCode.ButtonB
                    then
                        resetToNone()
                    elseif input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
                        bindData.Key = input.KeyCode
                        bindKeyStr = input.KeyCode.Name
                        refreshBindVisual()
                        UpdateSetting(cfg.SettingKey .. "_Bind", bindKeyStr)
                        if cfg.AltBindKey then
                            UpdateSetting(cfg.AltBindKey, bindKeyStr)
                        end
                        if cfg.OnBindSet then
                            pcall(cfg.OnBindSet, input.KeyCode)
                        end
                        if Hypnosis.RebuildMobileKeybinds then
                            pcall(Hypnosis.RebuildMobileKeybinds)
                        end
                        if Hypnosis.RefreshFeatureOverlays then
                            pcall(Hypnosis.RefreshFeatureOverlays)
                        end
                    else
                        resetToNone()
                    end
                end
            end)
        end)
        return bindBtn, bindData
    end

    function UI.createFunctionModule(
        parent,
        titleText,
        defaultBind,
        onToggleCallback,
        onBindSet,
        defaultExpanded,
        initialEnabled,
        hideArrow
    )
        local modFrame = Instance.new("Frame", parent)
        modFrame.Name = "Mod_" .. titleText
        modFrame.Size = UDim2.new(1, 0, 0, 22)
        modFrame.BackgroundColor3 = Palette.ModuleBg
        modFrame.BackgroundTransparency = 1
        modFrame.BorderSizePixel = 0
        modFrame.ClipsDescendants = true
        ThemeBind(modFrame, "BackgroundColor3", "ModuleBg")
        local mC = Instance.new("UICorner", modFrame)
        mC.CornerRadius = UDim.new(0, 5)
        local mStroke = Instance.new("UIStroke", modFrame)
        mStroke.Color = Palette.Border
        mStroke.Thickness = 1
        mStroke.Transparency = 1
        ThemeBind(mStroke, "Color", "Border")
        local header = Instance.new("Frame", modFrame)
        header.Size = UDim2.new(1, 0, 0, 20)
        header.BackgroundTransparency = 1
        local arrow = nil
        local arrowHitbox = nil
        if not hideArrow then
            arrow = Instance.new("TextLabel", header)
            arrow.Size = UDim2.new(0, 12, 1, 0)
            arrow.Position = UDim2.new(0, 3, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Font = Enum.Font.GothamMedium
            arrow.Text = "▶"
            arrow.TextColor3 = Palette.TextMuted
            arrow.TextSize = 7
            arrowHitbox = Instance.new("TextButton", header)
            arrowHitbox.Size = UDim2.new(0, 20, 0, 20)
            arrowHitbox.Position = UDim2.new(0, 0, 0, 0)
            arrowHitbox.BackgroundTransparency = 1
            arrowHitbox.Text = ""
        end
        local isEnabled = (initialEnabled == true)
        local isExpanded = (defaultExpanded == true) and not hideArrow
        local isPremMod = false

        local function getModuleTitleDisplay()
            return Italic(titleText)
        end
        local titleBtn = Instance.new("TextButton", header)
        titleBtn.Size = hideArrow and UDim2.new(1, -55, 1, 0) or UDim2.new(1, -69, 1, 0)
        titleBtn.Position = hideArrow and UDim2.new(0, 6, 0, 0) or UDim2.new(0, 20, 0, 0)
        titleBtn.BackgroundTransparency = 1
        titleBtn.Font = Enum.Font.GothamMedium
        titleBtn.RichText = true
        titleBtn.Text = getModuleTitleDisplay()
        Hypnosis._PremiumBadgeButtons = Hypnosis._PremiumBadgeButtons or {}
        table.insert(Hypnosis._PremiumBadgeButtons, { Btn = titleBtn, GetText = getModuleTitleDisplay })
        titleBtn.TextColor3 = isEnabled and Palette.Accent or Palette.TextMuted
        titleBtn.TextSize = 10
        titleBtn.TextXAlignment = Enum.TextXAlignment.Left
        local bindBtn, bindData
        local toggleModuleFn = function(forced)
            local targetState = forced ~= nil and forced or not isEnabled

            isEnabled = targetState
            Tween(titleBtn, { TextColor3 = isEnabled and Palette.Accent or Palette.TextMuted }, 0.12)
            UpdateSetting(titleText .. "_Enabled", isEnabled)
            if onToggleCallback then
                onToggleCallback(isEnabled)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end
        bindBtn, bindData = UI._SetupKeybindButton({
            Parent = header,
            BindName = titleText,
            SettingKey = titleText,
            DefaultBind = defaultBind,
            OnBindSet = onBindSet,
            Toggle = toggleModuleFn,
            GetActive = function()
                return isEnabled
            end,
        })
        if Hypnosis.RegisteredModules then
            local visPage = Hypnosis.TabPages and Hypnosis.TabPages["Visuals"]
            local isVisualCard = (visPage and parent and parent:IsDescendantOf(visPage)) == true
            table.insert(Hypnosis.RegisteredModules, {
                Name = titleText,
                SettingKey = titleText .. "_Enabled",
                BindData = bindData,
                GetActive = function()
                    return isEnabled
                end,
                IsVisual = isVisualCard,
            })
        end
        RegisterSetting(titleText .. "_Enabled", isEnabled, function(v)
            isEnabled = v
            titleBtn.TextColor3 = isEnabled and Palette.Accent or Palette.TextMuted
            if onToggleCallback then
                pcall(onToggleCallback, isEnabled)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end)
        local content = Instance.new("Frame", modFrame)
        content.Size = UDim2.new(1, -12, 0, 0)
        content.Position = UDim2.new(0, 6, 0, 22)
        content.BackgroundTransparency = 1
        content.Visible = isExpanded
        local layout = Instance.new("UIListLayout", content)
        layout.Padding = UDim.new(0, 4)
        if isExpanded then
            arrow.Rotation = 90
            mStroke.Transparency = 0
            modFrame.BackgroundTransparency = 0
            modFrame.Size = UDim2.new(1, 0, 0, 50)
        end

        local function getModHdrH()
            return math.floor(20 * (ScaleState.Toggle or 1) + 0.5)
        end
        ThemeHook(function()
            if arrow then
                arrow.TextColor3 = Palette.TextMuted
            end
            titleBtn.TextColor3 = isEnabled and Palette.Accent or Palette.TextMuted
            if bindData and bindData.RefreshBindVisual then
                bindData.RefreshBindVisual()
            end
        end)
        ScaleHook("toggle", function(ts)
            local hdrH = math.floor(20 * ts + 0.5)
            local hitW = math.floor(20 * ts + 0.5)
            local bindW = math.floor(42 * (0.8 + 0.2 * ts) + 0.5)
            local leftOff = hideArrow and 6 or math.max(20, hitW)
            header.Size = UDim2.new(1, 0, 0, hdrH)
            if arrow and arrowHitbox then
                arrow.TextSize = math.clamp(math.floor(7 * ts + 0.5), 7, 11)
                arrowHitbox.Size = UDim2.new(0, hitW, 0, hdrH)
            end
            bindBtn.Size = UDim2.new(0, bindW, 1, 0)
            bindBtn.Position = UDim2.new(1, -(bindW + 3), 0, 0)
            bindBtn.TextSize = math.clamp(math.floor(9 * (0.75 + 0.25 * ts) + 0.5), 8, 13)
            titleBtn.Position = UDim2.new(0, leftOff, 0, 0)
            titleBtn.Size = UDim2.new(1, -(leftOff + bindW + 7), 1, 0)
            titleBtn.TextSize = math.clamp(math.floor(10 * (0.75 + 0.25 * ts) + 0.5), 9, 15)
            content.Position = UDim2.new(0, 6, 0, hdrH + 2)
            modFrame.Size = UDim2.new(1, 0, 0, isExpanded and (layout.AbsoluteContentSize.Y + hdrH + 8) or (hdrH + 2))
        end)

        local function toggleExpand()
            if hideArrow then
                return
            end
            isExpanded = not isExpanded
            content.Visible = isExpanded
            local hdrH = getModHdrH()
            Tween(arrow, { Rotation = isExpanded and 90 or 0 }, 0.15)
            Tween(mStroke, { Transparency = isExpanded and 0 or 1 }, 0.15)
            Tween(modFrame, {
                BackgroundTransparency = isExpanded and 0 or 1,
                Size = UDim2.new(1, 0, 0, isExpanded and (layout.AbsoluteContentSize.Y + hdrH + 8) or (hdrH + 2)),
            }, 0.15)
        end
        titleBtn.MouseButton1Click:Connect(function()
            bindData.Toggle()
        end)
        if not hideArrow then
            titleBtn.MouseButton2Click:Connect(toggleExpand)
            if arrowHitbox then
                arrowHitbox.MouseButton1Click:Connect(toggleExpand)
            end
        end
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if isExpanded then
                local hdrH = getModHdrH()
                Tween(modFrame, { Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + hdrH + 8) }, 0.1)
            end
        end)
        return content, modFrame
    end

    function UI.addTextToggle(parent, labelText, defaultState, callback, customKey, defaultBind)
        local row = Instance.new("Frame", parent)
        row.Size = UDim2.new(1, 0, 0, 20)
        row.BackgroundTransparency = 1
        local hasBind = (defaultBind ~= nil)
        local btn = Instance.new("TextButton", row)
        btn.Size = UDim2.new(1, hasBind and -68 or -20, 1, 0)
        btn.Position = UDim2.new(0, 20, 0, 0)
        btn.BackgroundTransparency = 1
        btn.Font = Enum.Font.GothamMedium
        btn.RichText = true
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextSize = 10
        btn.Text = Italic(labelText)
        local isAct = (defaultState == true)
        btn.TextColor3 = isAct and Palette.Accent or Palette.TextMuted
        local bindBtnRef = nil
        local prefix = (parent and parent.Parent and parent.Parent.Name:match("^Mod_(.+)"))
        local settingKey = customKey or (prefix and (prefix .. "_" .. labelText)) or labelText
        local isPremText = false

        local function getToggleText()
            return Italic(labelText)
        end
        btn.Text = getToggleText()
        Hypnosis._PremiumBadgeButtons = Hypnosis._PremiumBadgeButtons or {}
        table.insert(Hypnosis._PremiumBadgeButtons, { Btn = btn, GetText = getToggleText })
        RegisterSetting(settingKey, isAct, function(v)
            isAct = v
            btn.TextColor3 = isAct and Palette.Accent or Palette.TextMuted
            if callback then
                pcall(callback, isAct)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end)
        if Hypnosis.Settings[labelText] == nil then
            Hypnosis.Settings[labelText] = isAct
        end

        local function triggerToggle(forced)
            local targetState = forced ~= nil and forced or not isAct

            isAct = targetState
            Tween(btn, { TextColor3 = isAct and Palette.Accent or Palette.TextMuted }, 0.12)
            UpdateSetting(settingKey, isAct)
            UpdateSetting(labelText, isAct)
            if isAct and prefix and prefix ~= "GUI Changer" and Hypnosis.Settings[prefix .. "_Enabled"] == false then
                UpdateSetting(prefix .. "_Enabled", true)
                if Hypnosis.Setters[prefix .. "_Enabled"] then
                    pcall(Hypnosis.Setters[prefix .. "_Enabled"], true)
                end
            end
            if callback then
                callback(isAct)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
        end
        btn.MouseButton1Click:Connect(function()
            triggerToggle()
        end)
        local bindDataRef = nil
        if hasBind then
            bindBtnRef, bindDataRef = UI._SetupKeybindButton({
                Parent = row,
                BindName = settingKey,
                DisplayName = labelText,
                SettingKey = settingKey,
                AltBindKey = labelText .. "_Bind",
                DefaultBind = defaultBind,
                Toggle = triggerToggle,
                GetActive = function()
                    return isAct
                end,
            })
        end
        ThemeHook(function()
            btn.TextColor3 = isAct and Palette.Accent or Palette.TextMuted
            if bindDataRef and bindDataRef.RefreshBindVisual then
                bindDataRef.RefreshBindVisual()
            end
        end)
        ScaleHook("toggle", function(ts)
            row.Size = UDim2.new(1, 0, 0, math.floor(20 * ts + 0.5))
            btn.TextSize = math.clamp(math.floor(10 * (0.75 + 0.25 * ts) + 0.5), 9, 15)
            if bindBtnRef then
                local bindW = math.floor(42 * (0.8 + 0.2 * ts) + 0.5)
                bindBtnRef.Size = UDim2.new(0, bindW, 1, 0)
                bindBtnRef.Position = UDim2.new(1, -(bindW + 3), 0, 0)
                bindBtnRef.TextSize = math.clamp(math.floor(9 * (0.75 + 0.25 * ts) + 0.5), 8, 13)
                btn.Size = UDim2.new(1, -(24 + bindW), 1, 0)
            end
        end)
        return row
    end

    function UI.addInlineChoices(parent, items, defaultIndex, callback, customKey)
        local row = Instance.new("Frame", parent)
        row.Size = UDim2.new(1, 0, 0, 16)
        row.BackgroundTransparency = 1
        local l = Instance.new("UIListLayout", row)
        l.FillDirection = Enum.FillDirection.Horizontal
        l.Padding = UDim.new(0, 8)
        local activeIdx = defaultIndex or 1
        local btnRefs = {}
        local choiceKey = customKey or ("Choice_" .. table.concat(items, "_"))
        RegisterSetting(choiceKey, activeIdx, function(v)
            activeIdx = math.clamp(v, 1, #items)
            for idx, ref in ipairs(btnRefs) do
                ref.TextColor3 = (idx == activeIdx) and Palette.Accent or Palette.TextMuted
            end
            if callback then
                callback(items[activeIdx], activeIdx)
            end
        end)
        for i, name in ipairs(items) do
            local b = Instance.new("TextButton", row)
            b.Size = UDim2.new(0, 0, 1, 0)
            b.AutomaticSize = Enum.AutomaticSize.X
            b.BackgroundTransparency = 1
            b.Font = Enum.Font.GothamMedium
            b.RichText = true
            b.Text = Italic(name)
            b.TextSize = 10
            b.TextColor3 = (i == activeIdx) and Palette.Accent or Palette.TextMuted
            table.insert(btnRefs, b)
            b.MouseButton1Click:Connect(function()
                activeIdx = i
                for idx, ref in ipairs(btnRefs) do
                    Tween(ref, { TextColor3 = (idx == activeIdx) and Palette.Accent or Palette.TextMuted }, 0.12)
                end
                UpdateSetting(choiceKey, i)
                if callback then
                    callback(name, i)
                end
            end)
        end
        ThemeHook(function()
