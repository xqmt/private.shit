            elseif aVal:find("masked", 1, true) then
                return "Masked"
            elseif aVal:find("stalker", 1, true) then
                return "Stalker"
            elseif aVal:find("hidden", 1, true) then
                return "Hidden"
            end
            return tostring(archAttr)
        end
        if
            char:GetAttribute("AbysswalkerSlashViewmodelLevel") ~= nil
            or char:GetAttribute("DarkSeverance") ~= nil
            or char:GetAttribute("AbyssalBurst") ~= nil
        then
            return "Abysswalker"
        end
        if
            char:GetAttribute("PierceWall") ~= nil
            or char:GetAttribute("ThroughTheVeil") ~= nil
            or char:GetAttribute("InVeil") ~= nil
        then
            return "Veil"
        end
        if char:GetAttribute("LakeMist") ~= nil or char:GetAttribute("Pursuit") ~= nil then
            return "Slasher"
        end
        if char:GetAttribute("PlacingTrap") ~= nil or char:GetAttribute("ChainThrow") ~= nil then
            return "Butcher"
        end
        if char:GetAttribute("FlaskLandAt") ~= nil or char:GetAttribute("corpsecharge") ~= nil then
            return "Cure"
        end
        if char:GetAttribute("Mask") ~= nil then
            return "Masked"
        end
        if char:GetAttribute("Stage") ~= nil or char:GetAttribute("StalkerMode") ~= nil then
            return "Stalker"
        end
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Tool") or desc:IsA("Model") or desc:IsA("Folder") or desc:IsA("Animation") then
                local dLower = desc.Name:lower()
                if dLower:find("spear", 1, true) or dLower:find("harpoon", 1, true) or dLower:find("veil", 1, true) then
                    return "Veil"
                elseif dLower:find("severance", 1, true) or dLower:find("abyss", 1, true) then
                    return "Abysswalker"
                elseif dLower:find("machete", 1, true) or dLower:find("lakemist", 1, true) then
                    return "Slasher"
                elseif dLower:find("cleaver", 1, true) or dLower:find("beartrap", 1, true) then
                    return "Butcher"
                elseif dLower:find("syringe", 1, true) or dLower:find("flask", 1, true) then
                    return "Cure"
                elseif dLower:find("richard", 1, true) then
                    return "Masked"
                end
            end
        end
        local rep = game:GetService("ReplicatedStorage")
        local rem = rep:FindFirstChild("Remotes")
        local kRem = rem and rem:FindFirstChild("Killers")
        if kRem then
            if
                kRem:FindFirstChild("Veil")
                and (char:FindFirstChild("SpearState", true) or char:FindFirstChild("Spearthrow", true))
            then
                return "Veil"
            elseif kRem:FindFirstChild("Abysswalker") then
                return "Abysswalker"
            end
        end
        return "Killer"
    end

    local function getKillerArchetype(char)
        if not char then
            return "Killer"
        end
        local now = os.clock()
        local cached = killerArchCache[char]
        local exp = killerArchExpire[char]
        if cached and exp and now < exp then
            return cached
        end
        local arch = computeKillerArchetype(char)
        killerArchCache[char] = arch
        killerArchExpire[char] = now + (arch == "Killer" and 0.75 or 2.0)
        return arch
    end

    local function getPlayerState(char)
        if not char then
            return "Unknown"
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local maxHp = hum and hum.MaxHealth or 100
        local hp = hum and hum.Health or 100
        local isFull = (hp >= maxHp - 0.5)
        local knockedVal = char:FindFirstChild("Knocked")
        local isKnocked = false
        if knockedVal then
            if typeof(knockedVal) == "Instance" and (knockedVal:IsA("BoolValue") or knockedVal:IsA("ValueBase")) then
                isKnocked = knockedVal.Value == true
            else
                isKnocked = not not knockedVal
            end
        elseif char:GetAttribute("Knocked") ~= nil then
            isKnocked = char:GetAttribute("Knocked") == true
        end
        if isFull then
            return "Healed"
        elseif isKnocked then
            return "Knocked"
        else
            return "Injured"
        end
    end

