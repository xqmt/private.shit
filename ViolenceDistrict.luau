            pooledHideByPrefix.PK = globalHideText or (isSettingActive("Pumpkin ESP", "Hide Text") == true)
            pooledHideByPrefix.BT = globalHideText or (isSettingActive("Bear Trap ESP", "Hide Text") == true)
            local tier1Hl = vaultCtx.Tier1Hl
