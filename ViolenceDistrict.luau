                MsgLbl.TextWrapped = true
                MsgLbl.TextXAlignment = Enum.TextXAlignment.Left
                MsgLbl.TextYAlignment = Enum.TextYAlignment.Top
                MsgLbl.ZIndex = 203
            end
            local ProgressTrack = Instance.new("Frame", ToastCard)
            ProgressTrack.Size = UDim2.new(1, -20, 0, 2)
            ProgressTrack.Position = UDim2.new(0, 10, 1, -6)
            ProgressTrack.BackgroundColor3 = Palette.Border
            ProgressTrack.BackgroundTransparency = 1
            ProgressTrack.BorderSizePixel = 0
            ProgressTrack.Visible = showProgress
            ProgressTrack.ZIndex = 203
            local ptCorner = Instance.new("UICorner", ProgressTrack)
            ptCorner.CornerRadius = UDim.new(1, 0)
            local ProgressBar = Instance.new("Frame", ProgressTrack)
            ProgressBar.Size = UDim2.new(1, 0, 1, 0)
            ProgressBar.Position = UDim2.new(0, 0, 0, 0)
            ProgressBar.BackgroundColor3 = accentCol
            ProgressBar.BackgroundTransparency = 1
            ProgressBar.BorderSizePixel = 0
            ProgressBar.Visible = showProgress
            ProgressBar.ZIndex = 204
            local pbCorner = Instance.new("UICorner", ProgressBar)
            pbCorner.CornerRadius = UDim.new(1, 0)
            local isDismissed = false
            local isHovered = false
            local notifEntry = {
                Frame = ToastSlot,
                Tag = replaceTag,
                ApplyTheme = function()
                    if isDismissed or not ToastSlot.Parent then
                        return
                    end
                    local nBg, nStroke, nAccent, nBody = resolveNotifVisualColors(cleanKind)
                    ToastCard.BackgroundColor3 = nBg
                    tStroke.Color = isHovered and nStroke:Lerp(nAccent, 0.35) or nStroke
                    AccentBar.BackgroundColor3 = nAccent
                    TitleLbl.TextColor3 = Palette.TextActive
                    CloseGlyph.TextColor3 = isHovered and Palette.TextActive or Palette.TextMuted
                    if MsgLbl then
                        MsgLbl.TextColor3 = nBody
                    end
                    ProgressTrack.BackgroundColor3 = Palette.Border
                    ProgressBar.BackgroundColor3 = nAccent
                end,
                ApplyAppearance = function()
                    if isDismissed or not ToastSlot.Parent then
                        return
                    end
                    local nBgT, nStrokeT, nAccT, nTxtT, nBodyT, nShowProg = getNotifOpacityTargets()
                    ToastCard.BackgroundTransparency = nBgT
                    tStroke.Transparency = isHovered and 0.05 or nStrokeT
                    AccentBar.BackgroundTransparency = nAccT
                    TitleLbl.TextTransparency = nTxtT
                    CloseGlyph.TextTransparency = math.clamp(nTxtT + 0.40, 0.40, 0.78)
                    if MsgLbl then
                        MsgLbl.TextTransparency = nBodyT
                    end
                    ProgressTrack.Visible = nShowProg
                    ProgressBar.Visible = nShowProg
                    ProgressTrack.BackgroundTransparency = math.clamp(nBgT + 0.50, 0.45, 0.92)
                    ProgressBar.BackgroundTransparency = math.clamp(nAccT + 0.10, 0.15, 0.85)
                end,
            }

            local function dismissToast(instant)
                if isDismissed then
                    return
                end
                isDismissed = true
                for i = #activeNotifs, 1, -1 do
                    if activeNotifs[i] == notifEntry then
                        table.remove(activeNotifs, i)
                        break
                    end
                end
                if instant or not ToastSlot.Parent then
                    pcall(function()
                        ToastSlot:Destroy()
                    end)
                    return
                end
                local _, targetExitPos = getNotifSlideOffsets()
                Tween(
                    ToastCard,
                    { Position = targetExitPos, BackgroundTransparency = 1 },
                    0.18,
                    Enum.EasingStyle.Cubic,
                    Enum.EasingDirection.In
                )
                Tween(cardScale, { Scale = 0.96 }, 0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.In)
                Tween(tStroke, { Transparency = 1 }, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                Tween(AccentBar, { BackgroundTransparency = 1 }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                Tween(TitleLbl, { TextTransparency = 1 }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                Tween(CloseGlyph, { TextTransparency = 1 }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                if MsgLbl then
                    Tween(MsgLbl, { TextTransparency = 1 }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                end
                Tween(
                    ProgressTrack,
                    { BackgroundTransparency = 1 },
                    0.14,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.In
                )
                Tween(ProgressBar, { BackgroundTransparency = 1 }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                task.wait(0.16)
                if ToastSlot and ToastSlot.Parent then
                    ToastSlot.ClipsDescendants = true
                    local col = Tween(
                        ToastSlot,
                        { Size = UDim2.new(1, 0, 0, 0) },
                        0.15,
                        Enum.EasingStyle.Quart,
                        Enum.EasingDirection.Out
                    )
                    pcall(function()
                        col.Completed:Wait()
                    end)
                    pcall(function()
                        ToastSlot:Destroy()
                    end)
                end
            end
            notifEntry.Dismiss = dismissToast
            table.insert(activeNotifs, notifEntry)
            local dismissBtn = Instance.new("TextButton", ToastCard)
            dismissBtn.Size = UDim2.new(1, 0, 1, 0)
            dismissBtn.BackgroundTransparency = 1
            dismissBtn.Text = ""
            dismissBtn.ZIndex = 205
            dismissBtn.MouseEnter:Connect(function()
                if isDismissed then
                    return
                end
                isHovered = true
                local _, hStroke, hAccent = resolveNotifVisualColors(cleanKind)
                Tween(tStroke, { Color = hStroke:Lerp(hAccent, 0.35), Transparency = 0.05 }, 0.12)
                Tween(CloseGlyph, { TextColor3 = Palette.TextActive, TextTransparency = 0.05 }, 0.12)
            end)
            dismissBtn.MouseLeave:Connect(function()
                if isDismissed then
                    return
                end
                isHovered = false
                local _, hStroke = resolveNotifVisualColors(cleanKind)
                local _, curStrokeT, _, curTxtT = getNotifOpacityTargets()
                Tween(tStroke, { Color = hStroke, Transparency = curStrokeT }, 0.12)
                Tween(CloseGlyph, {
                    TextColor3 = Palette.TextMuted,
                    TextTransparency = math.clamp(curTxtT + 0.40, 0.40, 0.78),
                }, 0.12)
            end)
            dismissBtn.MouseButton1Click:Connect(function()
                task.spawn(dismissToast, false)
            end)
            Tween(
                ToastCard,
                { Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = bgTrans },
                0.24,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.Out
            )
            Tween(cardScale, { Scale = 1.0 }, 0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            Tween(tStroke, { Transparency = strokeTrans }, 0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            Tween(
                AccentBar,
                { BackgroundTransparency = accentTrans },
                0.22,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            )
            Tween(TitleLbl, { TextTransparency = textTrans }, 0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            Tween(
                CloseGlyph,
                { TextTransparency = math.clamp(textTrans + 0.40, 0.40, 0.78) },
                0.20,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            )
            if MsgLbl then
                Tween(MsgLbl, { TextTransparency = bodyTrans }, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            end
            Tween(
                ProgressTrack,
                { BackgroundTransparency = math.clamp(bgTrans + 0.50, 0.45, 0.92) },
                0.20,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            )
