            "ENABLED FEATURES",
            UDim2.new(0, 18, 0, 140),
            "UI_Pos_EnabledFeaturesOverlay",
            "None Enabled",
            192
        )
        local IGNORED_FEATURE_NAMES = {
            ["Enabled Features Overlay"] = true,
            ["Keybinds Overlay"] = true,
            ["Hotkey Overlay"] = true,
            ["Notifications"] = true,
            ["Mobile Keybinds"] = true,
            ["ESP Text Font"] = true,
            ["Master Switch"] = true,
        }
        local VISUAL_CARD_LOOKUP = {}
        local pooledHkEntries = {}
        local pooledEfEntries = {}
        local pooledSeenNames = {}

        local function updateHotkeys()
            local kbOverlayOn = (Hypnosis.Settings["Keybinds Overlay_Enabled"] == true)
                or (Hypnosis.Settings["Hotkey Overlay_Enabled"] == true)
            local isParryHk = (
                Hypnosis.Settings["Auto Parry_Enabled"] == true
                and isSettingActive("Auto Parry", "Parry Cooldown Overlay") == true
                and tonumber(Hypnosis.Settings["Auto Parry_Overlay Type"]) == 2
            )
            local isFlowHk = (
                Hypnosis.Settings["Flowstate_Enabled"] == true
                and isSettingActive("Flowstate", "Cooldown Overlay") == true
                and tonumber(Hypnosis.Settings["Flowstate_Overlay Type"]) == 2
            )
            if not (kbOverlayOn or isParryHk or isFlowHk) then
                if hotkeyState.Card.Visible then
                    hotkeyState.LastTargetSize = nil
                    fadeCard(hotkeyState.Card, false)
                end
                return
            end
            local showUnbound = (Hypnosis.Settings["Keybinds Overlay_Show Unbound / Inactive"] == true)
                or (Hypnosis.Settings["Hotkey Overlay_Show Unbound / Inactive"] == true)
            local showHeader = (Hypnosis.Settings["Keybinds Overlay_Show Title Header"] ~= false)
                and (Hypnosis.Settings["Hotkey Overlay_Show Title Header"] ~= false)
            local highlightAct = Hypnosis.Settings["Keybinds Overlay_Highlight Active State"] ~= false
            local includeMenu = Hypnosis.Settings["Keybinds Overlay_Include Menu Key"] ~= false
            table.clear(pooledHkEntries)
            local entries = pooledHkEntries
            if kbOverlayOn and includeMenu then
                local menuKeyRaw = (Hypnosis.MenuToggleKey and Hypnosis.MenuToggleKey ~= Enum.KeyCode.Unknown)
                        and Hypnosis.MenuToggleKey.Name
                    or (Hypnosis.Settings["Menu_ToggleKey"] or "K")
                local menuVis = MainFrame and MainFrame.Visible or false
                table.insert(entries, {
                    Name = "Menu",
                    BadgeText = formatKeyName(menuKeyRaw),
                    BadgeColor = Color3.fromRGB(150, 150, 156),
                    NameColor = Color3.fromRGB(245, 245, 250),
                    NameTrans = menuVis and 0.0 or 0.58,
                    ShowDot = highlightAct,
                    DotColor = menuVis and Palette.Accent or Color3.fromRGB(70, 70, 76),
                })
            end
            for _, bind in ipairs(Hypnosis.RegisteredKeybinds or {}) do
                local rawKey = (bind.Key and bind.Key ~= Enum.KeyCode.Unknown) and bind.Key.Name or "None"
                local cleanKey = formatKeyName(rawKey)
                if bind.MobPinned then
                    cleanKey = (cleanKey ~= "None") and (cleanKey .. "|M") or "MOB"
                end
                local bName = bind.DisplayName or bind.Name
                local isAct = false
                if bind.GetActive then
                    isAct = (bind.GetActive() == true)
                else
                    isAct = (Hypnosis.Settings[bind.Name .. "_Enabled"] == true)
                        or (Hypnosis.Settings[bind.Name] == true)
                        or (bind.DisplayName and Hypnosis.Settings[bind.DisplayName] == true)
                end
                local isParryEntry = (bName == "Auto Parry")
                local isFlowEntry = (bName == "Flowstate")
                if isParryEntry and isParryHk then
                    local stText = Hypnosis.ParryLiveStatus or "READY"
                    local stColor = Hypnosis.ParryLiveColor or Color3.fromRGB(255, 255, 255)
                    local badge = (cleanKey ~= "None") and (cleanKey .. " [" .. tostring(stText) .. "]")
                        or ("[" .. tostring(stText) .. "]")
                    table.insert(entries, {
                        Name = bName,
                        BadgeText = badge,
                        BadgeColor = stColor,
                        NameColor = highlightAct and Palette.Accent or Color3.fromRGB(255, 255, 255),
                        NameTrans = 0.0,
                        ShowDot = highlightAct,
                        DotColor = Palette.Accent,
                    })
                elseif isFlowEntry and isFlowHk then
                    local stText = Hypnosis.FlowstateLiveStatus or "READY"
                    local stColor = Hypnosis.FlowstateLiveColor or Color3.fromRGB(255, 255, 255)
                    local badge = (cleanKey ~= "None") and (cleanKey .. " [" .. tostring(stText) .. "]")
                        or ("[" .. tostring(stText) .. "]")
                    table.insert(entries, {
                        Name = bName,
                        BadgeText = badge,
                        BadgeColor = stColor,
                        NameColor = highlightAct and Palette.Accent or Color3.fromRGB(255, 255, 255),
                        NameTrans = 0.0,
                        ShowDot = highlightAct,
                        DotColor = Palette.Accent,
                    })
                elseif kbOverlayOn then
                    if cleanKey ~= "None" or showUnbound then
                        table.insert(entries, {
                            Name = bName,
                            BadgeText = cleanKey,
                            BadgeColor = isAct and Palette.Accent:Lerp(Color3.fromRGB(215, 215, 220), 0.35)
                                or Color3.fromRGB(136, 136, 142),
                            NameColor = (isAct and highlightAct) and Palette.Accent or Color3.fromRGB(245, 245, 250),
                            NameTrans = isAct and 0.0 or 0.62,
                            ShowDot = highlightAct,
                            DotColor = isAct and Palette.Accent or Color3.fromRGB(68, 68, 74),
                        })
                    end
                end
            end
            renderListOverlayCard(hotkeyState, entries, showHeader, showUnbound)
        end

        local function buildModuleBadgeText(mod)
            local keyText = nil
            if mod.BindData then
                local k = mod.BindData.Key
                if k and k ~= Enum.KeyCode.Unknown then
                    keyText = formatKeyName(k.Name)
                elseif mod.BindData.MobPinned then
                    keyText = "MOB"
                end
            end
            local extra = nil
            if mod.Name == "Speed Boost" then
                local sbMult = tonumber(Hypnosis.Settings["Speed Boost_Speed Multiplier"]) or 1.35
                extra = string.format("%.2f", sbMult):gsub("%.?0+$", "") .. "x"
            elseif mod.Name == "Flowstate" and Hypnosis.FlowstateLiveStatus then
                extra = tostring(Hypnosis.FlowstateLiveStatus)
            elseif mod.Name == "Auto Parry" and Hypnosis.ParryLiveStatus then
                extra = tostring(Hypnosis.ParryLiveStatus)
            elseif mod.Name == "Break Pallet/Generator Speed" then
                extra = string.format(
                    "%.2gx",
                    tonumber(Hypnosis.Settings["Break Pallet/Generator Speed_Speed Multiplier"]) or 2.5
                )
            end
            if keyText and extra then
                return keyText .. " | " .. extra
            elseif extra then
                return extra
            elseif keyText then
                return keyText
            end
            return "ON"
        end

        local function updateEnabledFeatures()
            if Hypnosis.Settings["Enabled Features Overlay_Enabled"] ~= true then
                if featuresState.Card.Visible then
                    featuresState.LastTargetSize = nil
                    fadeCard(featuresState.Card, false)
                end
                return
            end
            local showVisuals = Hypnosis.Settings["Enabled Features Overlay_Show Visuals"] ~= false
            local showSubToggles = Hypnosis.Settings["Enabled Features Overlay_Show SubToggles"] ~= false
            local showInfo = Hypnosis.Settings["Enabled Features Overlay_Show Info"] ~= false
            local showHeader = Hypnosis.Settings["Enabled Features Overlay_Show Title Header"] ~= false
            local showWhenEmpty = Hypnosis.Settings["Enabled Features Overlay_Show When Empty"] == true
            local masterOn = isMasterSwitchEnabled()
            table.clear(VISUAL_CARD_LOOKUP)
            table.clear(pooledEfEntries)
            table.clear(pooledSeenNames)
            local entries = pooledEfEntries
            local seenNames = pooledSeenNames
            for _, mod in ipairs(Hypnosis.RegisteredModules or {}) do
                VISUAL_CARD_LOOKUP[mod.Name] = mod.IsVisual
                if not IGNORED_FEATURE_NAMES[mod.Name] then
                    if (not mod.IsVisual) or (showVisuals and masterOn) then
                        local isModOn = (mod.GetActive and mod.GetActive() == true)
                            or (Hypnosis.Settings[mod.SettingKey] == true)
                        if isModOn and not seenNames[mod.Name] then
                            seenNames[mod.Name] = true
                            table.insert(entries, {
                                Name = mod.Name,
                                BadgeText = showInfo and buildModuleBadgeText(mod) or "",
                                BadgeColor = Palette.Accent:Lerp(Color3.fromRGB(205, 205, 210), 0.35),
                                NameColor = Color3.fromRGB(248, 248, 252),
                                NameTrans = 0.0,
                                ShowDot = true,
                                DotColor = Palette.Accent,
                            })
                        end
                    end
                end
            end
            if showSubToggles then
                for _, bind in ipairs(Hypnosis.RegisteredKeybinds or {}) do
                    if bind.DisplayName and bind.SettingKey then
                        local parentPrefix = bind.SettingKey:match("^(.+)_[^_]+$")
                        local parentEnabled = not (
                            parentPrefix and Hypnosis.Settings[parentPrefix .. "_Enabled"] == false
                        )
                        if parentEnabled and (not parentPrefix or not IGNORED_FEATURE_NAMES[parentPrefix]) then
                            local parentIsVisual = parentPrefix and VISUAL_CARD_LOOKUP[parentPrefix] == true
                            if (not parentIsVisual) or (showVisuals and masterOn) then
                                local isSubOn = (bind.GetActive and bind.GetActive() == true)
                                    or (Hypnosis.Settings[bind.SettingKey] == true)
                                if isSubOn then
                                    local hasKey = (bind.Key and bind.Key ~= Enum.KeyCode.Unknown) or bind.MobPinned
                                    local isVaultMode = (parentPrefix == "Vault Settings")
                                    if hasKey or isVaultMode then
                                        local dispName = bind.DisplayName
                                        if seenNames[dispName] and parentPrefix then
                                            dispName = parentPrefix .. ": " .. dispName
                                        end
                                        if not seenNames[dispName] then
                                            seenNames[dispName] = true
                                            local subBadge = ""
                                            if showInfo then
                                                if bind.Key and bind.Key ~= Enum.KeyCode.Unknown then
                                                    subBadge = formatKeyName(bind.Key.Name)
                                                elseif bind.MobPinned then
                                                    subBadge = "MOB"
                                                else
                                                    subBadge = "ON"
                                                end
                                            end
                                            table.insert(entries, {
                                                Name = dispName,
                                                BadgeText = subBadge,
                                                BadgeColor = Color3.fromRGB(165, 165, 172),
                                                NameColor = Color3.fromRGB(228, 228, 234),
                                                NameTrans = 0.0,
                                                ShowDot = true,
                                                DotColor = Palette.Accent,
                                            })
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            renderListOverlayCard(featuresState, entries, showHeader, showWhenEmpty)
        end

        function Hypnosis.RefreshFeatureOverlays()
            pcall(updateHotkeys)
            pcall(updateEnabledFeatures)
        end
        local lastRole = nil

        local function checkRoleAutoSwitch()
            if not ConfigManager.AutoRoleSwitch then
                return
            end
            if not LocalPlayer then
                return
            end
            local role = nil
            if isKiller(LocalPlayer) then
                role = "Killer"
            elseif isSurvivor(LocalPlayer) then
                role = "Survivor"
            end
            if role and role ~= lastRole then
                lastRole = role
                local targetConfig = (role == "Killer") and ConfigManager.KillerConfig or ConfigManager.SurvivorConfig
                if targetConfig and targetConfig ~= "" and targetConfig ~= ConfigManager.Active then
                    if ConfigManager.Configs[targetConfig] then
                        ConfigManager.ApplyConfig(targetConfig)
                        showNotification(
                            "Roles Config",
                            "Auto-loaded " .. role .. " config '" .. targetConfig .. "'.",
                            "info"
                        )
                        if Hypnosis.RefreshConfigsUI then
                            pcall(Hypnosis.RefreshConfigsUI)
                        elseif refreshConfigsUI then
                            pcall(refreshConfigsUI)
                        end
                    end
                end
            end
        end
        if LocalPlayer then
            local teamSigConn = LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
                task.wait(0.2)
                checkRoleAutoSwitch()
            end)
            local charSigConn = LocalPlayer.CharacterAdded:Connect(function()
                task.wait(0.5)
                checkRoleAutoSwitch()
            end)
            table.insert(Hypnosis.Connections, teamSigConn)
            table.insert(Hypnosis.Connections, charSigConn)
        end
        local lastIntervalUpdate = 0
        local overlayConn = RunService.RenderStepped:Connect(function(dt)
            updateCrosshair(dt)
            local now = tick()
            local isParryHk = (
                Hypnosis.Settings["Auto Parry_Enabled"] == true
                and isSettingActive("Auto Parry", "Parry Cooldown Overlay") == true
                and tonumber(Hypnosis.Settings["Auto Parry_Overlay Type"]) == 2
            )
            local isFlowHk = (
                Hypnosis.Settings["Flowstate_Enabled"] == true
                and isSettingActive("Flowstate", "Cooldown Overlay") == true
                and tonumber(Hypnosis.Settings["Flowstate_Overlay Type"]) == 2
            )
            local interval = (isParryHk or isFlowHk) and 0.05 or 0.25
            if now - lastIntervalUpdate >= interval then
                lastIntervalUpdate = now
                updateSpectators()
                updateHotkeys()
                updateEnabledFeatures()
                checkRoleAutoSwitch()
            end
        end)
        table.insert(Hypnosis.Connections, overlayConn)
    end

    function Hypnosis.InitPerformanceOptimization()
        local origPerfState = {}
        local isPerfActive = false
        local lastFps = nil

        local function applyFpsCap(fps)
            local target = math.clamp(tonumber(fps) or 144, 15, 360)
            if setfpscap and lastFps ~= target then
                lastFps = target
                pcall(setfpscap, target)
            end
        end
        applyFpsCap(144)

        local function optimizePart(obj, smoothPlastic, noShadows, noEmitters)
            if not obj or not obj.Parent then
                return
            end
            if LocalPlayer and LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then
                return
            end
            if obj:IsA("BasePart") then
                if not origPerfState[obj] then
                    origPerfState[obj] = {
                        Material = obj.Material,
                        CastShadow = obj.CastShadow,
                        Reflectance = obj.Reflectance,
                    }
                end
                if smoothPlastic and obj.Material ~= Enum.Material.SmoothPlastic then
                    obj.Material = Enum.Material.SmoothPlastic
                end
                if noShadows and obj.CastShadow then
                    obj.CastShadow = false
                end
                if obj.Reflectance ~= 0 then
                    obj.Reflectance = 0
                end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                if not origPerfState[obj] then
                    origPerfState[obj] = { Transparency = obj.Transparency }
                end
                if smoothPlastic and obj.Transparency ~= 1 then
                    obj.Transparency = 1
                end
            elseif
                obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Smoke")
                or obj:IsA("Fire")
                or obj:IsA("Sparkles")
                or obj:IsA("Beam")
            then
                if not origPerfState[obj] then
                    origPerfState[obj] = { Enabled = obj.Enabled }
                end
                if noEmitters and obj.Enabled then
                    obj.Enabled = false
                end
            elseif
                obj:IsA("PostEffect")
                or obj:IsA("BloomEffect")
                or obj:IsA("BlurEffect")
                or obj:IsA("SunRaysEffect")
                or obj:IsA("ColorCorrectionEffect")
            then
                if not origPerfState[obj] then
                    origPerfState[obj] = { Enabled = obj.Enabled }
                end
                if obj.Enabled then
                    obj.Enabled = false
                end
            end
        end

        local function restoreAllPerformance()
            for obj, props in pairs(origPerfState) do
                if obj and obj.Parent then
                    pcall(function()
                        if props.Material ~= nil then
                            obj.Material = props.Material
                        end
                        if props.CastShadow ~= nil then
                            obj.CastShadow = props.CastShadow
                        end
                        if props.Reflectance ~= nil then
                            obj.Reflectance = props.Reflectance
                        end
                        if props.Transparency ~= nil then
                            obj.Transparency = props.Transparency
                        end
                        if props.Enabled ~= nil then
                            obj.Enabled = props.Enabled
                        end
                    end)
                end
            end
            table.clear(origPerfState)
            pcall(function()
                local terrain = workspace:FindFirstChildOfClass("Terrain")
                if terrain then
                    terrain.WaterWaveSize = 0.15
                    terrain.WaterWaveSpeed = 10
                    terrain.WaterReflectance = 1
                    terrain.WaterTransparency = 1
                end
            end)
        end
        Hypnosis.RestorePerformance = restoreAllPerformance
        local descAddedConn = workspace.DescendantAdded:Connect(function(desc)
            if isPerfActive then
                local smoothPlastic = isSettingActive("Performance Mode & Max FPS Cap", "Smooth Plastic Textures")
                local noShadows = isSettingActive("Performance Mode & Max FPS Cap", "Disable Shadows & CastShadow")
                local noEmitters = isSettingActive("Performance Mode & Max FPS Cap", "Disable Particles & Emitters")
                optimizePart(desc, smoothPlastic, noShadows, noEmitters)
            end
        end)
        table.insert(Hypnosis.Connections, descAddedConn)
        local perfConn = RunService.RenderStepped:Connect(function()
            local modEnabled = Hypnosis.Settings["Performance Mode & Max FPS Cap_Enabled"] == true
            local targetFps = tonumber(Hypnosis.Settings["Performance Mode & Max FPS Cap_Max FPS Cap"]) or 144
            if targetFps ~= lastFps then
                applyFpsCap(targetFps)
            end
            local perfActive = modEnabled
                and (isSettingActive("Performance Mode & Max FPS Cap", "Performance Mode (Low Graphics)") == true)
            if not perfActive and not isPerfActive then
                return
            end
            if perfActive then
                if not isPerfActive then
                    isPerfActive = true
                    local smoothPlastic = isSettingActive("Performance Mode & Max FPS Cap", "Smooth Plastic Textures")
                    local noShadows = isSettingActive("Performance Mode & Max FPS Cap", "Disable Shadows & CastShadow")
                    local noEmitters = isSettingActive("Performance Mode & Max FPS Cap", "Disable Particles & Emitters")
                    local lowWater = isSettingActive("Performance Mode & Max FPS Cap", "Low Water Detail")
                    pcall(function()
                        settings().Rendering.QualityLevel = 1
                    end)
                    pcall(function()
                        Lighting.GlobalShadows = false
                    end)
                    if lowWater then
                        pcall(function()
                            local terrain = workspace:FindFirstChildOfClass("Terrain")
                            if terrain then
                                terrain.WaterWaveSize = 0
                                terrain.WaterWaveSpeed = 0
                                terrain.WaterReflectance = 0
                                terrain.WaterTransparency = 0
                            end
                        end)
                    end
                    for _, desc in ipairs(workspace:GetDescendants()) do
                        optimizePart(desc, smoothPlastic, noShadows, noEmitters)
                    end
                    for _, desc in ipairs(Lighting:GetDescendants()) do
                        optimizePart(desc, smoothPlastic, noShadows, noEmitters)
                    end
                end
            else
                if isPerfActive then
                    isPerfActive = false
                    restoreAllPerformance()
                end
            end
        end)
        table.insert(Hypnosis.Connections, perfConn)
    end

    function Hypnosis.InitCharacterCustomization()
        local origCharProps = {}
        local isCustomized = false

        local function restoreCharacter()
            for part, props in pairs(origCharProps) do
                if part and part.Parent then
                    pcall(function()
                        part.Color = props.Color
                        part.Material = props.Material
                        part.Transparency = props.Transparency
                    end)
                end
            end
            table.clear(origCharProps)
            isCustomized = false
        end
        Hypnosis.RestoreCharacter = restoreCharacter
        local custMaterials = {
            [1] = Enum.Material.SmoothPlastic,
            [2] = Enum.Material.Neon,
            [3] = Enum.Material.ForceField,
            [4] = Enum.Material.Glass,
        }
        local charConn = RunService.RenderStepped:Connect(function()
            if isKiller(LocalPlayer) then
                if isCustomized then
                    restoreCharacter()
                end
                return
            end
            local customizerEnabled = Hypnosis.Settings["Player Customizer_Enabled"] == true
            if not customizerEnabled and not isCustomized then
                return
            end
            local char = LocalPlayer and (LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name))
            if not char then
                return
            end
            if customizerEnabled then
                isCustomized = true
                local isRainbow = isSettingActive("Player Customizer", "Rainbow") == true
                local transVal = tonumber(Hypnosis.Settings["Player Customizer_Body Transparency"]) or 0
                local trans = math.clamp(transVal / 100, 0, 1)
                local matIdx = Hypnosis.Settings["Choice_SmoothPlastic_Neon_ForceField_Glass"] or 1
                local chosenMat = custMaterials[matIdx] or Enum.Material.SmoothPlastic
                local affectAcc = isSettingActive("Player Customizer", "Apply To Accessories")
                local finalColor
                if isRainbow then
                    local speed = tonumber(Hypnosis.Settings["Player Customizer_Rainbow Speed"]) or 5
                    local hue = (tick() * (speed / 5)) % 1
                    finalColor = Color3.fromHSV(hue, 0.9, 1.0)
                else
                    finalColor = Color3.fromRGB(255, 255, 255)
                    local cv = Hypnosis.Settings["Player Customizer_Body Color Tint_Color"]
                    if typeof(cv) == "Color3" then
                        finalColor = cv
                    elseif type(cv) == "table" and #cv >= 3 then
                        finalColor = Color3.new(cv[1], cv[2], cv[3])
                    end
                end
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("BasePart") then
                        local lName = child.Name:lower()
                        if
                            child.Name ~= "HumanoidRootPart"
                            and child.Name ~= "RootPart"
                            and not child.Name:find("Root")
                            and not lName:find("inter")
                            and not lName:find("hitbox")
                            and not lName:find("collider")
                            and not lName:find("sensor")
                            and not lName:find("prompt")
                        then
                            if not origCharProps[child] then
                                origCharProps[child] = {
                                    Color = child.Color,
                                    Material = child.Material,
                                    Transparency = child.Transparency,
                                }
                            end
                            child.Color = finalColor
                            child.Material = chosenMat
                            child.Transparency = trans
                        end
                    elseif affectAcc and child:IsA("Accessory") then
                        local handle = child:FindFirstChildWhichIsA("BasePart")
                        if handle and handle.Name ~= "HumanoidRootPart" then
                            if not origCharProps[handle] then
                                origCharProps[handle] = {
                                    Color = handle.Color,
                                    Material = handle.Material,
                                    Transparency = handle.Transparency,
                                }
                            end
                            handle.Color = finalColor
                            handle.Material = chosenMat
                            handle.Transparency = trans
                        end
                    end
                end
            else
                if isCustomized then
                    restoreCharacter()
                end
            end
        end)
        table.insert(Hypnosis.Connections, charConn)
        if LocalPlayer then
            local charAddedConn = LocalPlayer.CharacterAdded:Connect(function()
                table.clear(origCharProps)
                isCustomized = false
            end)
            table.insert(Hypnosis.Connections, charAddedConn)
        end
    end

    function Hypnosis.InitAutoParry()
        if Hypnosis.ParryRing and Hypnosis.ParryRing.Parent then
            pcall(function()
                Hypnosis.ParryRing:Destroy()
            end)
        end
        if Hypnosis.ParryOverlay and Hypnosis.ParryOverlay.Parent then
            pcall(function()
                Hypnosis.ParryOverlay:Destroy()
            end)
        end
        if Hypnosis.ParryOverlayKeybinds and Hypnosis.ParryOverlayKeybinds.Parent then
            pcall(function()
                Hypnosis.ParryOverlayKeybinds:Destroy()
            end)
        end
        local VirtualInputManager = nil
        pcall(function()
            VirtualInputManager = game:GetService("VirtualInputManager")
        end)
        local radiusAdornment = Instance.new("CylinderHandleAdornment")
        radiusAdornment.Name = "Hypnosis_AutoParryRadius"
        radiusAdornment.Height = 0.08
        radiusAdornment.Color3 = Color3.fromRGB(255, 255, 255)
        radiusAdornment.Transparency = 1
        radiusAdornment.ZIndex = 5
        radiusAdornment.AlwaysOnTop = false
        radiusAdornment.Visible = false
        radiusAdornment.Parent = Camera
