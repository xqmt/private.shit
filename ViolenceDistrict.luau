                                entry.Label.TextTransparency = targetTextTrans
                                entry.LastTextTrans = targetTextTrans
                            end
                            local targetStrokeTrans = 1 - (entry.Alpha * 0.7)
                            if math.abs(entry.LastStrokeTrans - targetStrokeTrans) > 0.015 or entry.Alpha == 1.0 then
                                entry.Label.TextStrokeTransparency = targetStrokeTrans
                                entry.LastStrokeTrans = targetStrokeTrans
                            end
