                    badgeLbl.Position = UDim2.new(1, -74, 0, 0)
                    badgeLbl.BackgroundTransparency = 1
                    badgeLbl.Font = Enum.Font.GothamMedium
                    badgeLbl.TextColor3 = Color3.fromRGB(136, 136, 136)
                    badgeLbl.TextSize = 9
                    badgeLbl.TextXAlignment = Enum.TextXAlignment.Right
                    badgeLbl.TextTruncate = Enum.TextTruncate.AtEnd
                    rowData = {
                        Row = row,
                        Dot = dot,
                        NameLabel = nameLbl,
                        BadgeLabel = badgeLbl,
                        LastTrans = nil,
                    }
                    state.Rows[idx] = rowData
                end
                rowData.Row.Visible = true
                local useDot = (item.ShowDot == true)
                if rowData.Dot.Visible ~= useDot then
                    rowData.Dot.Visible = useDot
                end
                local nameX = useDot and 9 or 2
                local badgeText = item.BadgeText or ""
                local badgeW = (badgeText ~= "") and 74 or 0
                local targetNamePos = UDim2.new(0, nameX, 0, 0)
                local targetNameSize = UDim2.new(1, -(nameX + (badgeW > 0 and (badgeW + 4) or 2)), 1, 0)
                if rowData.NameLabel.Position ~= targetNamePos then
                    rowData.NameLabel.Position = targetNamePos
                end
                if rowData.NameLabel.Size ~= targetNameSize then
                    rowData.NameLabel.Size = targetNameSize
                end
                local dotCol = item.DotColor or Palette.Accent
                if rowData.Dot.BackgroundColor3 ~= dotCol then
                    rowData.Dot.BackgroundColor3 = dotCol
                end
                if rowData.NameLabel.Text ~= item.Name then
                    rowData.NameLabel.Text = item.Name
                end
                local nameCol = item.NameColor or Color3.fromRGB(255, 255, 255)
