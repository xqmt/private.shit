        overlayBar.Position = UDim2.new(0.5, -80, 0.84, 0)
        overlayBar.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
        overlayBar.BackgroundTransparency = 0.15
        overlayBar.BorderSizePixel = 0
        overlayBar.ZIndex = 6
        overlayBar.Visible = false
        overlayBar.Parent = ScreenGui
        Hypnosis.ParryOverlay = overlayBar
        local barCorner = Instance.new("UICorner", overlayBar)
        barCorner.CornerRadius = UDim.new(0, 5)
        local barStroke = Instance.new("UIStroke", overlayBar)
        barStroke.Color = Color3.fromRGB(255, 255, 255)
        barStroke.Transparency = 0.90
        barStroke.Thickness = 1
        local barTitleLbl = Instance.new("TextLabel", overlayBar)
        barTitleLbl.Size = UDim2.new(1, -70, 0, 14)
        barTitleLbl.Position = UDim2.new(0, 8, 0, 6)
        barTitleLbl.BackgroundTransparency = 1
