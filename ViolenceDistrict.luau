    function ConfigManager.PersistToDisk()
        pcall(function()
            if writefile then
                ensureStorageFolder()
                local configsToSave = ConfigManager.Configs
                if
                    Hypnosis._AwaitingStartupAuth
                    and Hypnosis.IsPremium ~= true
                    and ConfigManager._PendingPremiumConfigs
                then
                    local merged = {}
                    for cfgName, cfgTbl in pairs(ConfigManager.Configs) do
                        if type(cfgTbl) == "table" then
                            local copyTbl = {}
                            for k, v in pairs(cfgTbl) do
                                copyTbl[k] = v
                            end
                            local pendTbl = ConfigManager._PendingPremiumConfigs[cfgName]
                            if type(pendTbl) == "table" then
                                for pk, pv in pairs(pendTbl) do
                                    if pv == true then
                                        copyTbl[pk] = true
                                    end
                                end
                            end
                            merged[cfgName] = copyTbl
                        else
                            merged[cfgName] = cfgTbl
                        end
                    end
                    configsToSave = merged
                end
                local payload = { Active = ConfigManager.Active, Configs = configsToSave }
                writefile(CONFIGS_FILE, game:GetService("HttpService"):JSONEncode(payload))
                writefile(
                    CONFIG_FILE,
                    game:GetService("HttpService")
                        :JSONEncode({ ActiveConfig = ConfigManager.Active, SavedAt = os.time and os.time() or tick() })
                )
            end
        end)
    end

    function ConfigManager.LoadFromDisk()
        ConfigManager._PendingPremiumConfigs = {}
        pcall(function()
            local read = readfile or (syn and syn.readfile)
            local isf = isfile or (syn and syn.isfile)
            if read and isf and isf(CONFIGS_FILE) then
                local raw = read(CONFIGS_FILE)
                local parsed = game:GetService("HttpService"):JSONDecode(raw)
                if parsed and parsed.Configs and type(parsed.Configs) == "table" then
                    ConfigManager.Configs = parsed.Configs
                    if parsed.Active and ConfigManager.Configs[parsed.Active] then
                        ConfigManager.Active = parsed.Active
                    end
                end
            end
        end)
        for cfgName, cfgTbl in pairs(ConfigManager.Configs) do
            if type(cfgTbl) == "table" then
                if cfgTbl["Auto Parry_Bind"] == "E" then
                    cfgTbl["Auto Parry_Bind"] = "None"
                end
                for k, v in pairs(cfgTbl) do
                    if Hypnosis.IsBlockedHudPosKey and Hypnosis.IsBlockedHudPosKey(k) then
                        cfgTbl[k] = nil
                    end
                end
            end
        end
        if not ConfigManager.Configs["Default"] then
            ConfigManager.Configs["Default"] = {}
        end
        if not ConfigManager.Configs[ConfigManager.Active] then
            ConfigManager.Active = "Default"
        end
    end
    do
        local BLOCKED_POS_KEYS = { ["UI_Pos_MobileButton"] = true, ["UI_Pos_MainFrame"] = true }
        Hypnosis._SavedHudPositions = Hypnosis._SavedHudPositions or {}

        local function serializeHudUDim2(pos)
            if typeof(pos) ~= "UDim2" then
                return nil
            end
            return {
                XScale = math.floor(pos.X.Scale * 10000 + 0.5) / 10000,
                XOffset = math.floor(pos.X.Offset + 0.5),
                YScale = math.floor(pos.Y.Scale * 10000 + 0.5) / 10000,
                YOffset = math.floor(pos.Y.Offset + 0.5),
            }
        end

        local function parseSavedHudUDim2(val)
            if type(val) ~= "table" then
                return nil
            end
            local xs = tonumber(val.XScale)
            local xo = tonumber(val.XOffset)
            local ys = tonumber(val.YScale)
            local yo = tonumber(val.YOffset)
            if xs and xo and ys and yo then
                return UDim2.new(xs, xo, ys, yo)
            end
            return nil
        end

        local function resolveHudDefaultPos(defaultPos)
            if type(defaultPos) == "function" then
                local ok, res = pcall(defaultPos)
                if ok and typeof(res) == "UDim2" then
                    return res
                end
                return nil
            elseif typeof(defaultPos) == "UDim2" then
                return defaultPos
            end
            return nil
        end

        function Hypnosis.IsBlockedHudPosKey(key)
            return type(key) == "string" and BLOCKED_POS_KEYS[key] == true
        end

        function Hypnosis.IsDynamicPosKey(key)
            if type(key) ~= "string" then
                return false
            end
            return key:sub(-7) == "_MobPos" or key:sub(1, 7) == "UI_Pos_"
        end

        function Hypnosis.RegisterSavedPosition(posKey, frame, defaultPos)
            if not posKey or BLOCKED_POS_KEYS[posKey] or not frame then
                return
            end
            local defPos = defaultPos or frame.Position
            Hypnosis._SavedHudPositions[posKey] = { Key = posKey, Frame = frame, DefaultPos = defPos }
            local activeCfg = ConfigManager.Active and ConfigManager.Configs[ConfigManager.Active]
            local savedRaw = (activeCfg and activeCfg[posKey]) or Hypnosis.Settings[posKey]
            local savedUdim = parseSavedHudUDim2(savedRaw)
            if savedUdim then
                Hypnosis.Settings[posKey] = serializeHudUDim2(savedUdim)
                frame.Position = savedUdim
            end
        end

        function Hypnosis.SyncHudPositionsToSettings()
            for posKey in pairs(BLOCKED_POS_KEYS) do
                Hypnosis.Settings[posKey] = nil
            end
            for posKey, info in pairs(Hypnosis._SavedHudPositions) do
                if not BLOCKED_POS_KEYS[posKey] and info.Frame and info.Frame.Parent then
                    local packed = serializeHudUDim2(info.Frame.Position)
                    if packed then
                        Hypnosis.Settings[posKey] = packed
                    end
                end
            end
        end

        function Hypnosis.ApplySavedHudPositions()
            for posKey in pairs(BLOCKED_POS_KEYS) do
                Hypnosis.Settings[posKey] = nil
            end
            for posKey, info in pairs(Hypnosis._SavedHudPositions) do
                if not BLOCKED_POS_KEYS[posKey] and info.Frame and info.Frame.Parent then
                    local savedUdim = parseSavedHudUDim2(Hypnosis.Settings[posKey])
                    if savedUdim then
                        info.Frame.Position = savedUdim
                    else
                        local defUdim = resolveHudDefaultPos(info.DefaultPos)
                        if defUdim then
                            info.Frame.Position = defUdim
                        end
                    end
                end
            end
        end

        function Hypnosis.MakeDraggableHud(frame, extraHandle, opts)
            if not frame then
                return
            end
            local posKey = opts and opts.PosKey or nil
            if posKey and BLOCKED_POS_KEYS[posKey] then
                posKey = nil
            end
            local canBegin = opts and opts.CanBegin or nil
            local isDragging = false
            local activeInput = nil
            local dragStart, startPos = nil, nil
            local hasMoved = false

            local function finishDrag()
                if not isDragging then
                    return
                end
                isDragging = false
                activeInput = nil
                if hasMoved and posKey and not BLOCKED_POS_KEYS[posKey] then
                    local packed = serializeHudUDim2(frame.Position)
                    if packed then
                        UpdateSetting(posKey, packed)
                    end
                end
            end

            local function onInputBegan(input)
                if
                    input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch
                then
                    return
                end
                if canBegin and not canBegin(input) then
                    return
                end
                isDragging = true
                activeInput = input
                dragStart = input.Position
                startPos = frame.Position
                hasMoved = false
                input.Changed:Connect(function()
                    if input == activeInput and input.UserInputState == Enum.UserInputState.End then
                        finishDrag()
                    end
                end)
            end
            frame.InputBegan:Connect(onInputBegan)
            if extraHandle then
                extraHandle.InputBegan:Connect(onInputBegan)
            end
            local dragConn = UserInputService.InputChanged:Connect(function(input)
                if not isDragging or not activeInput then
                    return
                end
                if activeInput.UserInputType == Enum.UserInputType.Touch then
                    if input.UserInputType ~= Enum.UserInputType.Touch or input ~= activeInput then
                        return
                    end
                elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
                    return
                end
                local delta = input.Position - dragStart
                if delta.Magnitude > 1 then
                    hasMoved = true
                end
                frame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end)
            table.insert(Hypnosis.Connections, dragConn)
        end
    end

    function ConfigManager.SaveActive(silent)
        if not ConfigManager.Active then
