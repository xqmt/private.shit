        local selectedPlayer = LocalPlayer

        local function refreshDossier()
            if not selectedPlayer or not selectedPlayer.Parent then
                selectedPlayer = LocalPlayer
            end
            if not selectedPlayer then
                return
            end
            pcall(function()
                if cdSub and cdSub.Parent then
                    cdSub.Text = tostring(selectedPlayer.DisplayName or "")
                        .. " (@"
                        .. tostring(selectedPlayer.Name or "")
                        .. ")"
                end
                local char = selectedPlayer.Character or (workspace and workspace:FindFirstChild(selectedPlayer.Name))
                local killer = (isKiller and isKiller(selectedPlayer)) or false
                if dossierLabels["Role"] then
                    if killer then
                        local arch = (getKillerArchetype and getKillerArchetype(char)) or "Killer"
                        dossierLabels["Role"].Text = "Killer (" .. tostring(arch) .. ")"
                        dossierLabels["Role"].TextColor3 = Palette.Accent
                    else
                        dossierLabels["Role"].Text = "Survivor"
                        dossierLabels["Role"].TextColor3 = Palette.TextActive
                    end
                end
                if dossierLabels["State"] then
                    local st = (getPlayerState and getPlayerState(char)) or "Unknown"
                    dossierLabels["State"].Text = tostring(st)
                end
                if dossierLabels["SurvElo"] then
                    dossierLabels["SurvElo"].Text = (getSurvivorElo and tostring(getSurvivorElo(selectedPlayer)))
                        or "N/A"
                end
                if dossierLabels["KillElo"] then
                    dossierLabels["KillElo"].Text = (getKillerElo and tostring(getKillerElo(selectedPlayer))) or "N/A"
                end
                if dossierLabels["Item"] then
                    dossierLabels["Item"].Text = (getPlayerItem and tostring(getPlayerItem(selectedPlayer))) or "None"
                end
                if dossierLabels["Gears"] then
                    dossierLabels["Gears"].Text = (getGears and tostring(getGears(selectedPlayer))) or "0"
                end
                if dossierLabels["Screws"] then
                    dossierLabels["Screws"].Text = (getScrews and tostring(getScrews(selectedPlayer))) or "0"
                end
                if dossierLabels["Chance"] then
                    dossierLabels["Chance"].Text = (getKillerChance and tostring(getKillerChance(selectedPlayer)))
                        or "0%"
                end
                if dossierLabels["Hooks"] then
                    dossierLabels["Hooks"].Text = (getPlayerHooks and tostring(getPlayerHooks(char))) or "0"
                end
            end)
        end
        local playerBtnRefs = {}

        local function syncPlayerListAppearance()
            local bs = ScaleState.Button or 1
            local rowH = math.floor(22 * bs + 0.5)
            local txtSz = math.clamp(math.floor(10 * (0.8 + 0.2 * bs) + 0.5), 9, 14)
            for _, entry in ipairs(playerBtnRefs) do
                if entry.Btn and entry.Btn.Parent then
                    local isSel = (entry.Player == selectedPlayer)
                    entry.Btn.Size = UDim2.new(1, -2, 0, rowH)
                    entry.Btn.BackgroundColor3 = isSel and Palette.HoverBg or Palette.ButtonBg
                    entry.Stroke.Color = isSel and Palette.BorderActive or Palette.Border
                    entry.NameLbl.TextColor3 = isSel and Palette.TextActive or Palette.ButtonText
                    entry.NameLbl.TextSize = txtSz
                    entry.TagLbl.TextColor3 = entry.IsKiller and Palette.Accent or Palette.TextMuted
                end
            end
        end

        local function refreshPlayerList()
            for _, child in ipairs(playerScroll:GetChildren()) do
                if child:IsA("TextButton") or child:IsA("Frame") then
                    child:Destroy()
                end
            end
            playerBtnRefs = {}
            local bs = ScaleState.Button or 1
            local rowH = math.floor(22 * bs + 0.5)
            local txtSz = math.clamp(math.floor(10 * (0.8 + 0.2 * bs) + 0.5), 9, 14)
            local players = Players:GetPlayers()
            for idx, p in ipairs(players) do
                local isSel = (p == selectedPlayer)
                local pIsKiller = isKiller(p)
                local btn = Instance.new("TextButton", playerScroll)
                btn.Name = "PItem_" .. p.Name
                btn.Size = UDim2.new(1, -2, 0, rowH)
                btn.BackgroundColor3 = isSel and Palette.HoverBg or Palette.ButtonBg
                btn.BorderSizePixel = 0
                btn.AutoButtonColor = false
                btn.Text = ""
                btn.LayoutOrder = idx
                local bC = Instance.new("UICorner", btn)
                bC.CornerRadius = UDim.new(0, 3)
                local bStroke = Instance.new("UIStroke", btn)
                bStroke.Color = isSel and Palette.BorderActive or Palette.Border
                bStroke.Thickness = 1
                local nameLbl = Instance.new("TextLabel", btn)
                nameLbl.Size = UDim2.new(1, -64, 1, 0)
                nameLbl.Position = UDim2.new(0, 8, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Font = Enum.Font.GothamBold
                nameLbl.RichText = true
                nameLbl.Text = p.DisplayName
                nameLbl.TextColor3 = isSel and Palette.TextActive or Palette.ButtonText
                nameLbl.TextSize = txtSz
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                local tagLbl = Instance.new("TextLabel", btn)
                tagLbl.Size = UDim2.new(0, 56, 1, 0)
                tagLbl.Position = UDim2.new(1, -58, 0, 0)
                tagLbl.BackgroundTransparency = 1
                tagLbl.Font = Enum.Font.GothamBold
                tagLbl.RichText = true
                tagLbl.Text = pIsKiller and "[Killer]" or "[Survivor]"
                tagLbl.TextColor3 = pIsKiller and Palette.Accent or Palette.TextMuted
                tagLbl.TextSize = 8
                tagLbl.TextXAlignment = Enum.TextXAlignment.Right
                table.insert(playerBtnRefs, {
                    Player = p,
                    IsKiller = pIsKiller,
                    Btn = btn,
                    Stroke = bStroke,
                    NameLbl = nameLbl,
                    TagLbl = tagLbl,
                })
                btn.MouseButton1Click:Connect(function()
                    selectedPlayer = p
                    syncPlayerListAppearance()
                    refreshDossier()
                end)
            end
        end
        ThemeHook(function()
            syncPlayerListAppearance()
            pcall(refreshDossier)
        end)
        ScaleHook("button", function()
            syncPlayerListAppearance()
        end)
        pcall(refreshPlayerList)
        pcall(refreshDossier)
        local pAddConn = Players.PlayerAdded:Connect(function()
            task.wait(0.5)
            refreshPlayerList()
            refreshDossier()
        end)
        local pRemConn = Players.PlayerRemoving:Connect(function(rp)
            if selectedPlayer == rp then
                selectedPlayer = LocalPlayer
            end
            refreshPlayerList()
            refreshDossier()
        end)
        table.insert(Hypnosis.Connections, pAddConn)
        table.insert(Hypnosis.Connections, pRemConn)
    end

