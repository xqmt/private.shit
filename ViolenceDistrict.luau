            end
            lastKillerScanTick = now
            table.clear(cachedKillers)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local isK = isKiller(p)
                    if not isK then
                        if p:GetAttribute("Role") == "Killer" or p:GetAttribute("IsKiller") == true then
                            isK = true
                        elseif
                            p.Character
                            and (
                                p.Character:GetAttribute("Role") == "Killer"
                                or p.Character:GetAttribute("IsKiller") == true
                                or p.Character:GetAttribute("MorphedKiller") ~= nil
                            )
                        then
                            isK = true
                        end
                    end
                    if not isK then
                        local team = p.Team
                        if team then
                            local tName = team.Name:lower()
                            if
                                tName:find("killer")
                                or tName:find("slasher")
                                or tName:find("hunter")
                                or tName:find("monster")
                            then
                                isK = true
                            end
                        end
                    end
                    if isK and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        table.insert(cachedKillers, p.Character)
                    end
                end
            end
            if #cachedKillers == 0 then
                local kFolder = workspace:FindFirstChild("Killers")
                if kFolder then
                    for _, child in ipairs(kFolder:GetChildren()) do
                        if
                            child:IsA("Model")
                            and child:FindFirstChildOfClass("Humanoid")
                            and child:FindFirstChild("HumanoidRootPart")
                        then
                            table.insert(cachedKillers, child)
                        end
                    end
                end
            end
            if #cachedKillers == 0 then
                for _, c in ipairs(workspace:GetChildren()) do
                    if c:IsA("Model") and c ~= LocalPlayer.Character then
                        local isK = false
                        if
                            c:FindFirstChild("MorphedKiller")
                            or c:GetAttribute("MorphedKiller")
                            or (CollectionService and CollectionService:HasTag(c, "Killer"))
                        then
                            isK = true
                        else
                            local cName = c.Name:lower()
                            if
                                cName == "killer"
                                or string.find(cName, "slasher")
                                or string.find(cName, "veil")
                                or string.find(cName, "stalker")
                                or string.find(cName, "masked")
                                or string.find(cName, "abysswalker")
                            then
                                isK = true
                            end
                        end
                        if isK and c:FindFirstChildOfClass("Humanoid") and c:FindFirstChild("HumanoidRootPart") then
                            table.insert(cachedKillers, c)
                        end
                    end
                end
            end
            return cachedKillers
        end
