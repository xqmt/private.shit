                    if entry.TargetAlpha == 1.0 and entry.Alpha > 0.95 then
                        entry.Alpha = 1.0
                    elseif entry.TargetAlpha == 0.0 and entry.Alpha < 0.05 then
                        entry.Alpha = 0.0
                    end
                    if entry.Alpha > 0.01 then
                        local pref = entry.Prefix
                        local hideThisText = globalHideText
                            or (entry.LabelOnScreen == false)
                            or (pref ~= "" and pooledHideByPrefix[pref] == true)
                        if hideThisText then
