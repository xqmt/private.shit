        local function resolveRemotes()
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local items = remotes and remotes:FindFirstChild("Items")
                local dagger = items
                    and (items:FindFirstChild("Parrying Dagger") or items:FindFirstChild("ParryingDagger"))
                if dagger then
                    parryRemote = dagger:FindFirstChild("parry")
                    parryResultRemote = dagger:FindFirstChild("parryResult")
                end
                local mechanics = remotes and remotes:FindFirstChild("Mechanics")
                if mechanics then
                    slowRemote = mechanics:FindFirstChild("Slow")
                end
            end)
            if not parryRemote then
                for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
                    if desc.Name == "parry" and desc:IsA("RemoteEvent") then
                        parryRemote = desc
                        break
                    end
                end
            end
            if not parryResultRemote then
                for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
                    if desc.Name == "parryResult" and desc:IsA("RemoteEvent") then
                        parryResultRemote = desc
                        break
                    end
                end
            end
            if not slowRemote then
                for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
                    if desc.Name == "Slow" and (desc:IsA("RemoteEvent") or desc:IsA("BindableEvent")) then
                        slowRemote = desc
                        break
                    end
                end
            end
        end
        resolveRemotes()

        local function hookParryResult()
            pcall(function()
                if not parryResultRemote or not parryResultRemote.Parent then
                    resolveRemotes()
                end
                if parryResultRemote then
                    local resConn = parryResultRemote.OnClientEvent:Connect(
                        function(success, cd, permanent, cleared, targetChar)
                            if targetChar and targetChar ~= LocalPlayer.Character then
                                return
                            end
                            if cleared == true then
                                isPermanentCooldown = false
                                isParryOnCooldown = false
                                isParryResolving = false
                                cooldownEndTime = 0
                            elseif permanent == true then
                                isPermanentCooldown = true
                                isParryOnCooldown = true
                                isParryResolving = false
                                cooldownEndTime = math.huge
                            else
                                isPermanentCooldown = false
                                local cdNum = tonumber(cd)
                                if cdNum and cdNum > 0 then
                                    maxCooldownReceived = cdNum
                                    isParryOnCooldown = true
                                    isParryResolving = false
                                    cooldownEndTime = tick() + cdNum
                                else
                                    isParryResolving = false
                                    isParryOnCooldown = false
                                    cooldownEndTime = 0
                                end
                            end
                        end
                    )
                    table.insert(Hypnosis.Connections, resConn)
                end
            end)
        end
        hookParryResult()

