        local function getParryingDagger(char)
            if not char then
                return nil
            end
            local tool = char:FindFirstChild("Parrying Dagger")
                or char:FindFirstChild("ParryingDagger")
                or char:FindFirstChild("Parry Dagger")
            if not tool then
                local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                tool = bp
                    and (
                        bp:FindFirstChild("Parrying Dagger")
                        or bp:FindFirstChild("ParryingDagger")
                        or bp:FindFirstChild("Parry Dagger")
                    )
            end
            if not tool then
                for _, item in ipairs(char:GetChildren()) do
                    if
                        item:IsA("Tool")
                        and (string.find(item.Name:lower(), "parry") or string.find(item.Name:lower(), "dagger"))
                    then
                        tool = item
                        break
                    end
                end
            end
            if not tool then
                local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, item in ipairs(bp:GetChildren()) do
                        if
                            item:IsA("Tool")
                            and (string.find(item.Name:lower(), "parry") or string.find(item.Name:lower(), "dagger"))
                        then
                            tool = item
                            break
                        end
                    end
                end
            end
            return tool
        end

        local function canParry(myChar, myHum, myHrp)
            if not myChar or not myHum or not myHrp or myHum.Health <= 0 then
                return false
            end
            if isParryResolving then
                return false
            end
            if isPermanentCooldown then
                return false
            end
            if isParryOnCooldown and tick() < cooldownEndTime then
                return false
            end
            if (tick() - lastParryTick) < 0.95 then
                return false
            end
            if CollectionService and CollectionService:HasTag(myChar, "Silenced") then
                return false
            end
            if
                myChar:GetAttribute("Trapped")
                or LocalPlayer:GetAttribute("IsDead")
                or myChar:GetAttribute("IsCarried")
                or myChar:GetAttribute("IsHooked")
            then
                return false
            end
            local checkInteract = myChar:FindFirstChild("CheckInterractable")
            if checkInteract then
                for _, act in ipairs({
                    "isVaulting",
                    "isSliding",
                    "isDroppingPallet",
                    "isRepairing",
                    "isHealing",
                    "isUnhooking",
                    "isExiting",
                }) do
                    if checkInteract:GetAttribute(act) == true then
                        return false
                    end
                end
            end
            return true
        end

        local function executeParry(myChar, myHum, myHrp, targetKillerPos)
            lastParryTick = tick()
            isParryResolving = true
            local daggerTool = getParryingDagger(myChar)
            if daggerTool and daggerTool.Parent ~= myChar then
                daggerTool.Parent = myChar
                if myHum then
                    pcall(function()
                        myHum:EquipTool(daggerTool)
                    end)
                end
            end
            if targetKillerPos and myHrp then
                pcall(function()
                    local flatLook = Vector3.new(targetKillerPos.X, myHrp.Position.Y, targetKillerPos.Z)
                    myHrp.CFrame = CFrame.lookAt(myHrp.Position, flatLook)
                end)
            end
            if typeof(getgc) == "function" then
                pcall(function()
                    for _, obj in ipairs(getgc(true)) do
                        if
                            type(obj) == "table"
                            and type(obj.Parry) == "function"
                            and (rawget(obj, "parryEvent") or rawget(obj, "daggerFolder") or rawget(obj, "tool"))
                        then
                            obj.isParryResolving = false
                            obj.isParryOnCooldown = false
                            obj.isParryLocked = false
                            pcall(obj.Parry, obj)
                            break
                        end
                    end
                end)
            end
            if isSettingActive("Network Desync", "Sync On Action / Parry") then
                if Hypnosis.ResyncDesyncPosition then
                    Hypnosis.ResyncDesyncPosition()
                end
            end
            pcall(function()
                local pRemote = parryRemote
                if not pRemote or not pRemote.Parent then
                    resolveRemotes()
                    pRemote = parryRemote
                end
                if pRemote then
                    pRemote:FireServer(myChar)
                end
                if slowRemote then
                    pcall(function()
                        slowRemote:Fire(0, 1, 0)
                    end)
                end
            end)
            if Hypnosis.ResyncDesyncSilent and isSettingActive("Network Desync", "Sync On Action / Parry") ~= false then
                pcall(Hypnosis.ResyncDesyncSilent)
            end
            pcall(function()
                if daggerTool and daggerTool:IsA("Tool") then
                    daggerTool:Activate()
                end
                local animator = myHum and myHum:FindFirstChildOfClass("Animator")
                if animator and daggerTool then
                    local animId = daggerTool:GetAttribute("useanim") or "109133187196613"
                    local cleanId = string.match(tostring(animId), "%d+") or "109133187196613"
                    local anim = Instance.new("Animation")
                    anim.AnimationId = "rbxassetid://" .. cleanId
                    local track = animator:LoadAnimation(anim)
                    track.Priority = Enum.AnimationPriority.Action4
                    track:Play(0.05, 1, 1)
                end
            end)
            pcall(function()
                local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                local mobGui = pGui and pGui:FindFirstChild("Survivor-mob")
                if mobGui then
                    local controls = mobGui:FindFirstChild("Controls") or mobGui
                    for _, item in ipairs(controls:GetDescendants()) do
                        local iName = item.Name:lower()
                        if item:IsA("GuiButton") and (iName:find("parry") or iName:find("dagger")) then
                            local centerPos = item.AbsolutePosition + (item.AbsoluteSize / 2)
                            local clickInput = {
                                UserInputType = Enum.UserInputType.MouseButton1,
                                UserInputState = Enum.UserInputState.End,
                                KeyCode = Enum.KeyCode.Unknown,
                                Position = Vector3.new(centerPos.X, centerPos.Y, 0),
                                Delta = Vector3.zero,
                            }
                            pcall(function()
                                firesignal(item.MouseButton1Down, centerPos.X, centerPos.Y)
                            end)
                            pcall(function()
                                firesignal(item.MouseButton1Click)
                            end)
                            pcall(function()
                                firesignal(item.Activated, clickInput, 1)
                            end)
                            pcall(function()
                                item.MouseButton1Down:Fire(centerPos.X, centerPos.Y)
                            end)
                            pcall(function()
                                item.MouseButton1Click:Fire()
                            end)
                        end
                    end
                end
            end)
            pcall(function()
                if VirtualInputManager and UserInputService.GamepadEnabled then
                    for _, btn in ipairs({ Enum.KeyCode.ButtonR1, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonY }) do
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, btn, false, game)
                            task.delay(0.04, function()
                                pcall(function()
                                    VirtualInputManager:SendKeyEvent(false, btn, false, game)
                                end)
                            end)
                        end)
                    end
                end
            end)
            pcall(function()
                local cas = game:GetService("ContextActionService")
                for _, actName in ipairs({ "item", "Item", "parry", "Parry", "Dagger", "dagger" }) do
                    pcall(function()
                        cas:CallFunction(actName, Enum.UserInputState.Begin, nil)
                        task.delay(0.04, function()
                            pcall(function()
                                cas:CallFunction(actName, Enum.UserInputState.End, nil)
                            end)
                        end)
                    end)
                end
            end)
