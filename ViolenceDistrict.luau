            local isVisualActive = isSettingActive("Auto Parry", "View Parry Radius") == true
            local inRangeVisual = isSettingActive("Auto Parry", "View Radius In-Range") == true
            local faceCheck = isSettingActive("Auto Parry", "Face Directional Check") == true
            local showOverlay = isSettingActive("Auto Parry", "Parry Cooldown Overlay") == true
            local overlayType = tonumber(Hypnosis.Settings["Auto Parry_Overlay Type"]) or 1
            local maxAngle = tonumber(Hypnosis.Settings["Auto Parry_Directional Angle"]) or 80
            local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
            local myHum = myChar and myChar:FindFirstChildWhichIsA("Humanoid")
            local isAlive = myChar and myHrp and myHum and (myHum.Health > 0)
            if not isAlive and (isPermanentCooldown or isParryOnCooldown or isParryResolving) then
