        local signalFixesThisFrame = 0

        local function isUiCursorNeeded()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return false
            end
            if MainFrame and MainFrame.Visible then
                return true
            end
            if Hypnosis.ColorPickerOverlay and Hypnosis.ColorPickerOverlay.Parent then
                return true
            end
            if Hypnosis.GuiChanger and Hypnosis.GuiChanger.MoveMode == true then
                return true
            end
            return false
        end

        local function isGameplayMouseLockNeeded()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return false
            end
            if isUiCursorNeeded() then
                return false
            end
            if GuiService and GuiService.MenuIsOpen then
                return false
            end
            if UserInputService:GetFocusedTextBox() ~= nil then
                return false
            end
            local cam = workspace.CurrentCamera
            if cam and cam.CameraType == Enum.CameraType.Scriptable then
                return false
            end
            if not isInActiveGameTeam(LocalPlayer) then
                return false
            end
            local char = LocalPlayer and LocalPlayer.Character
            if not char or not char.Parent then
                return false
            end
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if not hum or hum.Health <= 0 then
                return false
            end
            if
                LocalPlayer:GetAttribute("Spectating") == true
                or LocalPlayer:GetAttribute("Escaped") == true
                or char:GetAttribute("Escaped") == true
            then
                return false
            end
            return true
        end

        local function hasCustomCrosshairMouseIcon()
            local okUis, uisIcon = pcall(function()
                return UserInputService.MouseIcon
            end)
            if okUis and type(uisIcon) == "string" and uisIcon ~= "" then
                return true
            end
            if cachedPlayerMouse then
                local okM, mIcon = pcall(function()
                    return cachedPlayerMouse.Icon
                end)
                if okM and type(mIcon) == "string" and mIcon ~= "" then
                    return true
                end
            end
            return false
        end

        local function shouldUseModalUnlock()
            if isInActiveGameTeam(LocalPlayer) then
                return true
            end
            if LocalPlayer and LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson then
                return true
            end
            return false
        end

        local function applyUnlockedState()
            local useModal = shouldUseModalUnlock()
            if modalUnlockBtn and modalUnlockBtn.Parent then
                modalUnlockBtn.Modal = useModal
                if modalUnlockBtn.Visible ~= useModal then
                    modalUnlockBtn.Visible = useModal
                end
            end
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if not UserInputService.MouseIconEnabled then
                UserInputService.MouseIconEnabled = true
            end
        end

        local function enforceUnlockedCursor()
            if isSettingMouse then
                return
            end
            isSettingMouse = true
            pcall(applyUnlockedState)
            isSettingMouse = false
        end
        local pendingForceHideIcon = false

        local function applyLockedState()
            if modalUnlockBtn and modalUnlockBtn.Parent then
                modalUnlockBtn.Modal = false
                if modalUnlockBtn.Visible then
                    modalUnlockBtn.Visible = false
                end
            end
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            end
            if UserInputService.MouseIconEnabled then
                if pendingForceHideIcon or not hasCustomCrosshairMouseIcon() then
                    UserInputService.MouseIconEnabled = false
                end
            end
        end

        local function enforceGameplayLock(forceHideIcon)
            if isSettingMouse then
                return
            end
            isSettingMouse = true
            pendingForceHideIcon = (forceHideIcon == true)
            pcall(applyLockedState)
            isSettingMouse = false
        end

        local function applyNeutralState()
            if modalUnlockBtn and modalUnlockBtn.Parent then
                modalUnlockBtn.Modal = false
                if modalUnlockBtn.Visible then
                    modalUnlockBtn.Visible = false
                end
            end
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if not UserInputService.MouseIconEnabled then
                UserInputService.MouseIconEnabled = true
            end
        end

        local function enforceNeutralCursor()
            if isSettingMouse then
                return
            end
            isSettingMouse = true
            pcall(applyNeutralState)
            isSettingMouse = false
        end
        Hypnosis._SyncMouseImpl = function()
            isMobile = getIsMobile()
            if isMobile or Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            if isUiCursorNeeded() then
                wasUiUnlockActive = true
                wasGameplayLockActive = false
                local useModal = shouldUseModalUnlock()
                if
                    (
                        modalUnlockBtn
                        and modalUnlockBtn.Parent
                        and (modalUnlockBtn.Visible ~= useModal or modalUnlockBtn.Modal ~= useModal)
                    )
                    or UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default
                    or not UserInputService.MouseIconEnabled
                then
                    enforceUnlockedCursor()
                end
                return
            end
            if modalUnlockBtn and modalUnlockBtn.Parent and (modalUnlockBtn.Visible or modalUnlockBtn.Modal) then
                pcall(function()
                    modalUnlockBtn.Modal = false
                    modalUnlockBtn.Visible = false
                end)
            end
            if isGameplayMouseLockNeeded() then
                local forceHide = wasUiUnlockActive
                    or not wasGameplayLockActive
                    or (UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter)
                wasUiUnlockActive = false
                wasGameplayLockActive = true
                if
                    UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter
                    or (UserInputService.MouseIconEnabled and (forceHide or not hasCustomCrosshairMouseIcon()))
                then
                    enforceGameplayLock(forceHide)
                end
                return
            end
            if wasUiUnlockActive or wasGameplayLockActive then
                wasUiUnlockActive = false
                wasGameplayLockActive = false
                if not (GuiService and GuiService.MenuIsOpen) then
                    enforceNeutralCursor()
                end
            end
        end
        pcall(function()
            RunService:UnbindFromRenderStep("Hypnosis_MouseSyncPre")
        end)
        pcall(function()
            RunService:UnbindFromRenderStep("Hypnosis_MouseSync")
        end)
        RunService:BindToRenderStep("Hypnosis_MouseSync", Enum.RenderPriority.Camera.Value + 5, function()
            signalFixesThisFrame = 0
            isMobile = getIsMobile()
            if isMobile or Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            pcall(Hypnosis._SyncMouseImpl)
        end)
        local mbConn = UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
            if isMobile or isSettingMouse or Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            if signalFixesThisFrame >= 2 then
                return
            end
            if isUiCursorNeeded() then
                if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                    signalFixesThisFrame = signalFixesThisFrame + 1
                    wasUiUnlockActive = true
                    wasGameplayLockActive = false
                    enforceUnlockedCursor()
                end
            elseif isGameplayMouseLockNeeded() then
                if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                    signalFixesThisFrame = signalFixesThisFrame + 1
                    wasUiUnlockActive = false
                    wasGameplayLockActive = true
                    enforceGameplayLock(true)
                end
            end
        end)
        table.insert(Hypnosis.Connections, mbConn)
        local miConn = UserInputService:GetPropertyChangedSignal("MouseIconEnabled"):Connect(function()
            if isMobile or isSettingMouse or Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            if signalFixesThisFrame >= 2 then
                return
            end
            if isUiCursorNeeded() then
                if not UserInputService.MouseIconEnabled then
                    signalFixesThisFrame = signalFixesThisFrame + 1
                    wasUiUnlockActive = true
                    wasGameplayLockActive = false
                    enforceUnlockedCursor()
                end
            elseif isGameplayMouseLockNeeded() then
                if UserInputService.MouseIconEnabled and not hasCustomCrosshairMouseIcon() then
                    signalFixesThisFrame = signalFixesThisFrame + 1
                    wasUiUnlockActive = false
                    wasGameplayLockActive = true
                    enforceGameplayLock(true)
                end
            end
        end)
        table.insert(Hypnosis.Connections, miConn)
        if GuiService then
            pcall(function()
                table.insert(Hypnosis.Connections, GuiService.MenuOpened:Connect(syncMouseBehavior))
                table.insert(Hypnosis.Connections, GuiService.MenuClosed:Connect(syncMouseBehavior))
            end)
        end
    end
    MainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
        if not MainFrame.Visible then
            local focused = UserInputService:GetFocusedTextBox()
            if focused and ScreenGui and focused:IsDescendantOf(ScreenGui) then
                pcall(function()
                    focused:ReleaseFocus()
                end)
            end
            if Hypnosis.CloseColorPicker then
                pcall(Hypnosis.CloseColorPicker)
            end
        end
        syncMouseBehavior()
        if Hypnosis.SyncNotificationVisibility then
            pcall(Hypnosis.SyncNotificationVisibility)
        end
    end)
    if LocalPlayer then
        pcall(function()
            LocalPlayer:GetPropertyChangedSignal("Team"):Connect(syncMouseBehavior)
            LocalPlayer:GetPropertyChangedSignal("CameraMode"):Connect(syncMouseBehavior)
            LocalPlayer.CharacterAdded:Connect(function()
                task.defer(syncMouseBehavior)
            end)
        end)
    end
    syncMouseBehavior()
    MobileButton.MouseButton1Click:Connect(function()
        if Hypnosis._MobBtnDragged then
            Hypnosis._MobBtnDragged = false
            return
        end
        MainFrame.Visible = not MainFrame.Visible
        syncMouseBehavior()
    end)
    local menuToggleKey = Enum.KeyCode.K
    Hypnosis.MenuToggleKey = menuToggleKey
    local menuKeyButtons = {}
    local isRebindingMenuKey = false

    local function setMenuToggleKey(newKeyCode)
        local keyName = "K"
        local keyCode = Enum.KeyCode.K
        if typeof(newKeyCode) == "string" then
            pcall(function()
                keyCode = Enum.KeyCode[newKeyCode]
            end)
            keyName = newKeyCode
        elseif typeof(newKeyCode) == "EnumItem" then
            keyCode = newKeyCode
            keyName = newKeyCode.Name
        end
        Hypnosis.MenuToggleKey = keyCode
        menuToggleKey = keyCode
        Hypnosis.Settings["Menu_ToggleKey"] = keyName
        if ConfigManager.Active and ConfigManager.Configs[ConfigManager.Active] then
            ConfigManager.Configs[ConfigManager.Active]["Menu_ToggleKey"] = keyName
        end
        if ConfigManager.AutoSave then
            pcall(ConfigManager.PersistToDisk)
        end
        for _, btn in ipairs(menuKeyButtons) do
            if btn and btn.Parent then
                btn.Text = Italic(keyName)
            end
        end
    end
    Hypnosis.SetMenuToggleKey = setMenuToggleKey

    local function startMenuRebind(sourceBtn)
        if isRebindingMenuKey then
            isRebindingMenuKey = false
            local cur = Hypnosis.MenuToggleKey or Enum.KeyCode.K
            if sourceBtn then
                sourceBtn.Text = Italic(cur.Name)
            end
            return
        end
        isRebindingMenuKey = true
        if sourceBtn then
            sourceBtn.Text = Italic("...")
        end
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            local isKey = input.UserInputType == Enum.UserInputType.Keyboard
            local isPad = input.UserInputType.Name:find("Gamepad")
            if isKey or isPad then
                if conn then
                    conn:Disconnect()
                    conn = nil
                end
                isRebindingMenuKey = false
                if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
                    local cur = Hypnosis.MenuToggleKey or Enum.KeyCode.K
                    if sourceBtn then
                        sourceBtn.Text = Italic(cur.Name)
                    end
                elseif
                    input.KeyCode == Enum.KeyCode.Backspace
                    or input.KeyCode == Enum.KeyCode.Delete
                    or input.KeyCode == Enum.KeyCode.ButtonSelect
                then
                    setMenuToggleKey(Enum.KeyCode.K)
                elseif input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
                    setMenuToggleKey(input.KeyCode)
                else
                    local cur = Hypnosis.MenuToggleKey or Enum.KeyCode.K
                    if sourceBtn then
                        sourceBtn.Text = Italic(cur.Name)
                    end
                end
            end
        end)
    end
    local pcToggleConn = UserInputService.InputBegan:Connect(function(input)
        if isRebindingMenuKey or (Hypnosis._ListeningBindCount or 0) > 0 then
            return
        end
        if UserInputService:GetFocusedTextBox() then
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType.Name:find("Gamepad") then
            local targetKey = Hypnosis.MenuToggleKey or menuToggleKey or Enum.KeyCode.K
            if
                input.KeyCode == targetKey
                or (targetKey == Enum.KeyCode.RightShift and input.KeyCode == Enum.KeyCode.Insert)
            then
                MainFrame.Visible = not MainFrame.Visible
                syncMouseBehavior()
            end
            for _, bindData in ipairs(Hypnosis.RegisteredKeybinds or {}) do
                if bindData.Key == input.KeyCode and bindData.Toggle then
                    if Hypnosis.InvokeKeybindToggle then
                        Hypnosis.InvokeKeybindToggle(bindData)
                    else
                        bindData.Toggle()
                    end
                end
            end
        end
    end)
    table.insert(Hypnosis.Connections, pcToggleConn)
    do
        local MobileKeybindsContainer = Instance.new("Frame")
        MobileKeybindsContainer.Name = "HypnosisMobileKeybinds"
        MobileKeybindsContainer.Size = UDim2.new(1, 0, 1, 0)
        MobileKeybindsContainer.Position = UDim2.new(0, 0, 0, 0)
        MobileKeybindsContainer.BackgroundTransparency = 1
        MobileKeybindsContainer.BorderSizePixel = 0
        MobileKeybindsContainer.ZIndex = 115
        MobileKeybindsContainer.Parent = ScreenGui
        Hypnosis.MobileKeybindsContainer = MobileKeybindsContainer
        local activeEntriesById = {}
        local SHORT_KEY_MAP = {
            LeftShift = "LSH",
            RightShift = "RSH",
            LeftControl = "LCT",
            RightControl = "RCT",
            LeftAlt = "LAL",
            RightAlt = "RAL",
            BackSlash = "\\",
            Backquote = "`",
            ButtonL1 = "L1",
            ButtonR1 = "R1",
            ButtonL2 = "L2",
            ButtonR2 = "R2",
            ButtonX = "X",
            ButtonY = "Y",
            ButtonA = "A",
            ButtonB = "B",
            Space = "SPC",
        }

        local function formatCompactKeyBadge(keyName)
            if not keyName or keyName == "None" or keyName == "Unknown" then
                return "M"
            end
            return SHORT_KEY_MAP[keyName] or (#keyName <= 4 and keyName:upper() or keyName:sub(1, 3):upper())
        end

        local function formatMobileBtnTitle(name)
            local clean = tostring(name or "Key")
            clean = clean:gsub(" Engine$", ""):gsub(" & Max FPS Cap", "")
            if #clean > 16 then
                clean = clean:sub(1, 15) .. "."
            end
            return clean
        end

        local function getMobViewportSize()
            local cam = workspace.CurrentCamera or Camera
            return (cam and cam.ViewportSize) or Vector2.new(1280, 720)
        end

        local function parseSavedMobFrac(raw)
            if type(raw) ~= "string" or raw == "" then
                return nil, nil
            end
            local sx, sy = raw:match("^([%d%.%-]+),([%d%.%-]+)$")
            local fx, fy = tonumber(sx), tonumber(sy)
            if fx and fy then
                return math.clamp(fx, 0, 0.98), math.clamp(fy, 0, 0.98)
            end
            return nil, nil
        end

        local function clampMobXY(px, py, btnSize, vp)
            local maxX = math.max(8, vp.X - btnSize - 6)
            local maxY = math.max(8, vp.Y - btnSize - 6)
            return math.clamp(math.floor(px + 0.5), 6, maxX), math.clamp(math.floor(py + 0.5), 6, maxY)
        end

        local function isBindDataCurrentlyActive(bindData)
            if not bindData then
                return false
            end
            if bindData.GetActive then
                local ok, res = pcall(bindData.GetActive)
                if ok then
                    return res == true
                end
            end
            return (Hypnosis.Settings[bindData.Name .. "_Enabled"] == true)
                or (Hypnosis.Settings[bindData.Name] == true)
                or (bindData.DisplayName ~= nil and Hypnosis.Settings[bindData.DisplayName] == true)
        end

        local function shouldShowMobileBind(bindData)
            if Hypnosis.Settings["Mobile Keybinds_Enabled"] ~= true then
                return false
            end
            if not bindData then
                return false
            end
            if bindData.MobPinned == true then
                return true
            end
            local autoShow = Hypnosis.Settings["Mobile Keybinds_AutoShow"]
            if autoShow == nil then
                autoShow = true
            end
            if autoShow and bindData.Key and bindData.Key ~= Enum.KeyCode.Unknown then
                return true
            end
            return false
        end

        local function applyEntryVisuals(entry)
            if not entry or not entry.Button or not entry.Button.Parent then
                return
            end
            local isAct = isBindDataCurrentlyActive(entry.Bind)
            local transpPct = tonumber(Hypnosis.Settings["Mobile Keybinds_ButtonTransparency"]) or 15
            local bgTransp = math.clamp(transpPct / 100, 0, 0.85)
            local keyName = (entry.Bind and entry.Bind.Key and entry.Bind.Key ~= Enum.KeyCode.Unknown)
                    and entry.Bind.Key.Name
                or "None"
            entry.Button.BackgroundColor3 = Palette.SidebarBg
            entry.Button.BackgroundTransparency = bgTransp
            entry.Stroke.Color = isAct and Palette.Accent or Palette.BorderActive
            entry.Stroke.Thickness = isAct and 1.5 or 1
            entry.Label.TextColor3 = isAct and Palette.TextActive or Palette.ButtonText
            entry.StatusBar.BackgroundColor3 = isAct and Palette.Accent or Palette.Divider
            entry.StatusBar.BackgroundTransparency = isAct and 0 or 0.45
            entry.KeyBadge.Text = formatCompactKeyBadge(keyName)
            entry.KeyBadge.TextColor3 = isAct and Palette.Accent or Palette.KeybindText
        end

        local function createMobileKeybindWidget(bindData)
            local btnSize = math.clamp(tonumber(Hypnosis.Settings["Mobile Keybinds_ButtonSize"]) or 46, 34, 72)
            local btn = Instance.new("TextButton")
            btn.Name = "MobBind_" .. tostring(bindData.SettingKey or bindData.Name)
            btn.Size = UDim2.new(0, btnSize, 0, btnSize)
            btn.BackgroundColor3 = Palette.SidebarBg
            btn.BackgroundTransparency = 0.15
            btn.BorderSizePixel = 0
            btn.AutoButtonColor = false
            btn.Text = ""
            btn.ZIndex = 116
            btn.Parent = MobileKeybindsContainer
            local corner = Instance.new("UICorner", btn)
            corner.CornerRadius = UDim.new(0, 7)
            local stroke = Instance.new("UIStroke", btn)
            stroke.Color = Palette.BorderActive
            stroke.Thickness = 1
            local kBadge = Instance.new("TextLabel", btn)
            kBadge.Name = "Badge"
            kBadge.Size = UDim2.new(1, -6, 0, 10)
            kBadge.Position = UDim2.new(0, 3, 0, 3)
            kBadge.BackgroundTransparency = 1
            kBadge.Font = Enum.Font.RobotoMono
            kBadge.Text = "M"
            kBadge.TextSize = 8
            kBadge.TextXAlignment = Enum.TextXAlignment.Right
            kBadge.ZIndex = 117
            local lbl = Instance.new("TextLabel", btn)
            lbl.Name = "Title"
            lbl.Size = UDim2.new(1, -8, 1, -18)
            lbl.Position = UDim2.new(0, 4, 0, 11)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.GothamBold
            lbl.Text = formatMobileBtnTitle(bindData.DisplayName or bindData.Name)
            lbl.TextWrapped = true
            lbl.TextSize = math.clamp(math.floor(btnSize * 0.2 + 0.5), 8, 13)
            lbl.LineHeight = 0.92
            lbl.ZIndex = 117
            local bar = Instance.new("Frame", btn)
            bar.Name = "StatusBar"
            bar.Size = UDim2.new(0.55, 0, 0, 2)
            bar.Position = UDim2.new(0.225, 0, 1, -4)
            bar.BorderSizePixel = 0
            bar.ZIndex = 117
            local barCorner = Instance.new("UICorner", bar)
            barCorner.CornerRadius = UDim.new(1, 0)
            local entry = {
                Button = btn,
                Stroke = stroke,
                Label = lbl,
                KeyBadge = kBadge,
                StatusBar = bar,
                Bind = bindData,
                SizePx = btnSize,
            }
            local pressMoveConn = nil
            local isPressing = false
            local wasDragged = false
            local dragStartPos, startAbsX, startAbsY = nil, 0, 0
            btn.InputBegan:Connect(function(input)
                if
                    input.UserInputType ~= Enum.UserInputType.Touch
                    and input.UserInputType ~= Enum.UserInputType.MouseButton1
                then
                    return
                end
                if pressMoveConn then
                    pressMoveConn:Disconnect()
                    pressMoveConn = nil
                end
                isPressing = true
                wasDragged = false
                dragStartPos = input.Position
                local curSize = entry.SizePx or btnSize
                local vp = getMobViewportSize()
                local cx, cy = clampMobXY(btn.Position.X.Offset, btn.Position.Y.Offset, curSize, vp)
                startAbsX, startAbsY = cx, cy
                pressMoveConn = UserInputService.InputChanged:Connect(function(chg)
                    if not isPressing then
                        return
                    end
                    if
                        chg.UserInputType ~= Enum.UserInputType.Touch
                        and chg.UserInputType ~= Enum.UserInputType.MouseMovement
                    then
                        return
                    end
                    if chg.UserInputType == Enum.UserInputType.Touch and chg ~= input then
                        return
                    end
                    local delta = chg.Position - dragStartPos
                    if delta.Magnitude > 8 and Hypnosis.Settings["Mobile Keybinds_LockPositions"] ~= true then
                        wasDragged = true
                        local liveVp = getMobViewportSize()
                        local nx, ny =
                            clampMobXY(startAbsX + delta.X, startAbsY + delta.Y, entry.SizePx or btnSize, liveVp)
                        btn.Position = UDim2.new(0, nx, 0, ny)
                    end
                end)
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End and isPressing then
                        isPressing = false
                        if pressMoveConn then
                            pressMoveConn:Disconnect()
                            pressMoveConn = nil
                        end
                        if wasDragged then
                            local liveVp = getMobViewportSize()
                            local settingId = (bindData.SettingKey or bindData.Name) .. "_MobPos"
                            local fx = math.clamp(btn.Position.X.Offset / math.max(1, liveVp.X), 0, 0.98)
                            local fy = math.clamp(btn.Position.Y.Offset / math.max(1, liveVp.Y), 0, 0.98)
                            UpdateSetting(settingId, string.format("%.4f,%.4f", fx, fy))
                        else
                            if bindData.Toggle then
                                if Hypnosis.InvokeKeybindToggle then
                                    Hypnosis.InvokeKeybindToggle(bindData)
                                else
                                    bindData.Toggle()
                                end
                            end
                            applyEntryVisuals(entry)
                        end
                    end
                end)
            end)
            applyEntryVisuals(entry)
            return entry
        end

        function Hypnosis.SyncMobileKeybindStates()
            for _, entry in pairs(activeEntriesById) do
                applyEntryVisuals(entry)
            end
        end

        function Hypnosis.RefreshAllBindButtons()
            for _, bindData in ipairs(Hypnosis.RegisteredKeybinds or {}) do
                if bindData.RefreshBindVisual then
                    pcall(bindData.RefreshBindVisual)
                end
            end
        end

        function Hypnosis.RebuildMobileKeybinds()
            local showUi = isMobile or (Hypnosis.Settings["Mobile Keybinds_Enabled"] == true)
            if MobileButton and MobileButton.Parent then
                MobileButton.Visible = showUi
            end
            local btnSize = math.clamp(tonumber(Hypnosis.Settings["Mobile Keybinds_ButtonSize"]) or 46, 34, 72)
            local vp = getMobViewportSize()
            local wantedIds = {}
            local slotIdx = 0
            local gap = 8
            local step = btnSize + gap
            local startY = math.max(48, math.floor(vp.Y * 0.18))
            local maxPerCol = math.max(2, math.floor((vp.Y - startY - 24) / step))
            for _, bindData in ipairs(Hypnosis.RegisteredKeybinds or {}) do
                local id = bindData.SettingKey or bindData.Name
                if shouldShowMobileBind(bindData) and not wantedIds[id] then
                    wantedIds[id] = true
                    slotIdx = slotIdx + 1
                    local entry = activeEntriesById[id]
                    if not entry or not entry.Button or not entry.Button.Parent then
                        entry = createMobileKeybindWidget(bindData)
                        activeEntriesById[id] = entry
                    end
                    entry.Bind = bindData
                    entry.SizePx = btnSize
                    entry.Button.Size = UDim2.new(0, btnSize, 0, btnSize)
                    entry.Label.TextSize = math.clamp(math.floor(btnSize * 0.2 + 0.5), 8, 13)
                    entry.Label.Text = formatMobileBtnTitle(bindData.DisplayName or bindData.Name)
                    local posKey = id .. "_MobPos"
                    local fx, fy = parseSavedMobFrac(Hypnosis.Settings[posKey])
                    local px, py
                    if fx and fy then
                        px, py = clampMobXY(fx * vp.X, fy * vp.Y, btnSize, vp)
                    else
                        local col = math.floor((slotIdx - 1) / maxPerCol)
                        local row = (slotIdx - 1) % maxPerCol
                        local rawX = vp.X - btnSize - 14 - (col * step)
                        local rawY = startY + (row * step)
                        px, py = clampMobXY(rawX, rawY, btnSize, vp)
                    end
                    entry.Button.Position = UDim2.new(0, px, 0, py)
                    applyEntryVisuals(entry)
                end
            end
            for id, entry in pairs(activeEntriesById) do
                if not wantedIds[id] then
