        local prefix = (parent and parent.Parent and parent.Parent.Name:match("^Mod_(.+)"))
        local settingKey = customKey or (prefix and (prefix .. "_" .. labelText)) or labelText

        local function getDropdownMetrics()
            local bs = ScaleState.Button or 1
            local hdrH = math.floor(22 * bs + 0.5)
            local itemH = math.floor(18 * bs + 0.5)
            local txtSz = math.clamp(math.floor(9 * (0.8 + 0.2 * bs) + 0.5), 9, 14)
            return bs, hdrH, itemH, txtSz
        end

        local function populateItems()
            for _, child in ipairs(scroll:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
            local _, hdrH, itemH, txtSz = getDropdownMetrics()
            local items = (type(getItemsFunc) == "function") and getItemsFunc()
                or (type(getItemsFunc) == "table" and getItemsFunc or {})
            for _, item in ipairs(items) do
                local itemStr = tostring(item)
                local itemBtn = Instance.new("TextButton", scroll)
                itemBtn.Size = UDim2.new(1, -4, 0, itemH)
                itemBtn.BackgroundColor3 = (itemStr == currentChoice) and Palette.BorderActive or Palette.ModuleBg
                itemBtn.BackgroundTransparency = (itemStr == currentChoice) and 0.5 or 0.8
                itemBtn.BorderSizePixel = 0
                itemBtn.Font = Enum.Font.GothamMedium
                itemBtn.RichText = true
                itemBtn.Text = "  " .. itemStr
                itemBtn.TextColor3 = (itemStr == currentChoice) and Palette.TextActive or Palette.TextMuted
                itemBtn.TextSize = txtSz
                itemBtn.TextXAlignment = Enum.TextXAlignment.Left
                local ibC = Instance.new("UICorner", itemBtn)
                ibC.CornerRadius = UDim.new(0, 2)
                itemBtn.MouseEnter:Connect(function()
                    if itemStr ~= currentChoice then
                        Tween(itemBtn, { BackgroundTransparency = 0.4, TextColor3 = Palette.TextActive }, 0.1)
                    end
                end)
                itemBtn.MouseLeave:Connect(function()
                    if itemStr ~= currentChoice then
                        Tween(itemBtn, { BackgroundTransparency = 0.8, TextColor3 = Palette.TextMuted }, 0.1)
                    end
                end)
                itemBtn.MouseButton1Click:Connect(function()
                    currentChoice = itemStr
                    selectedLbl.Text = Italic(itemStr)
                    isExpanded = false
                    local _, curHdrH = getDropdownMetrics()
                    Tween(arrow, { Rotation = 0, ImageColor3 = Palette.TextMuted }, 0.12)
                    Tween(frame, { Size = UDim2.new(1, -16, 0, curHdrH) }, 0.15)
                    UpdateSetting(settingKey, itemStr)
                    if onSelectCallback then
                        onSelectCallback(itemStr, true)
                    end
                end)
            end
