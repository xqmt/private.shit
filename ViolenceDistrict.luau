    function Hypnosis.SetUIScale(scaleVal)
        local num = tonumber(scaleVal) or 1.0
        if num > 3.0 then
            num = num / 100.0
        end
        num = math.clamp(math.floor(num * 100 + 0.5) / 100, 0.50, 1.50)
        local oldScale = MainUIScale.Scale
        if math.abs(num - oldScale) > 0.001 then
            local pos = MainFrame.Position
