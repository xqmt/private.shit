        local function renderListOverlayCard(state, entries, showHeader, showWhenEmpty)
            local card = state.Card
            state.Header.Visible = showHeader
            state.Divider.Visible = showHeader
            state.List.Position = showHeader and UDim2.new(0, 8, 0, 26) or UDim2.new(0, 8, 0, 8)
            if #entries == 0 then
                if showWhenEmpty then
                    state.EmptyLabel.Visible = true
                    for _, rowData in ipairs(state.Rows) do
                        rowData.Row.Visible = false
                    end
                    local targetSize = showHeader and UDim2.new(0, state.Width, 0, 46)
                        or UDim2.new(0, state.Width, 0, 28)
                    if state.LastTargetSize ~= targetSize then
                        state.LastTargetSize = targetSize
                        Tween(card, { Size = targetSize }, 0.2, Enum.EasingStyle.Quad)
                    end
                    if not card.Visible or (card:IsA("CanvasGroup") and card.GroupTransparency > 0.05) then
                        fadeCard(card, true)
                    end
                elseif card.Visible then
                    state.LastTargetSize = nil
                    fadeCard(card, false)
                end
                return
            end
            state.EmptyLabel.Visible = false
            for idx, item in ipairs(entries) do
                local rowData = state.Rows[idx]
                if not rowData then
                    local row = Instance.new("Frame", state.List)
