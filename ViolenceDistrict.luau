        local function collectMobileCheckButtons(allowHiddenFallback)
            local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
            if not pg then
                return {}
            end
            local btns, seen = {}, {}

            local function tryAdd(inst, requireVisible)
                if
                    inst
                    and not seen[inst]
                    and inst:IsA("GuiObject")
                    and ((not requireVisible) or isGuiObjVisible(inst))
                then
                    seen[inst] = true
                    table.insert(btns, inst)
                end
            end

            local function tryAddBranch(root, requireVisible)
                if not root then
                    return
                end
                if root:IsA("GuiButton") then
                    tryAdd(root, requireVisible)
                end
                for _, desc in ipairs(root:GetDescendants()) do
                    if desc:IsA("GuiButton") then
                        tryAdd(desc, requireVisible)
                    end
                end
                if not root:IsA("GuiButton") then
                    tryAdd(root, requireVisible)
                end
            end
            local names = activeIsTrapSkill and { "beartrapfreeyourself", "check", "skillcheck", "SkillCheck" }
                or { "check", "skillcheck", "SkillCheck", "beartrapfreeyourself" }
            local mobGui = pg:FindFirstChild("Survivor-mob")
            local mobGuiActive = mobGui and ((not mobGui:IsA("LayerCollector")) or mobGui.Enabled)
            local controls = mobGui and mobGui:FindFirstChild("Controls")
            local action = (controls and controls:FindFirstChild("action"))
                or (mobGui and mobGui:FindFirstChild("action", true))
            if mobGui and mobGuiActive then
                if action then
                    tryAdd(action, true)
                    for _, nm in ipairs(names) do
                        tryAddBranch(action:FindFirstChild(nm), true)
                    end
                end
                for _, nm in ipairs(names) do
                    tryAddBranch(mobGui:FindFirstChild(nm, true), true)
                end
            end
            if activePromptGui and activePromptGui.Parent then
                for _, desc in ipairs(activePromptGui:GetDescendants()) do
                    if desc:IsA("GuiButton") then
                        tryAdd(desc, true)
                    end
                end
            end
            if #btns == 0 and allowHiddenFallback and mobGui and mobGuiActive then
                if action then
                    tryAdd(action, false)
                    for _, nm in ipairs(names) do
                        tryAddBranch(action:FindFirstChild(nm), false)
                    end
                end
                for _, nm in ipairs(names) do
                    tryAddBranch(mobGui:FindFirstChild(nm, true), false)
                end
            end
            return btns
        end

        local function hasSkillCheckUpvalue(fn, cfg, depth, visited)
            if type(fn) ~= "function" or depth > 2 then
                return false
            end
            if visited[fn] then
                return false
            end
            visited[fn] = true
            if depth == 0 and getfenv then
                local eOk, fEnv = pcall(getfenv, fn)
                local scr = eOk and type(fEnv) == "table" and rawget(fEnv, "script") or nil
                if typeof(scr) == "Instance" and string.find(string.lower(scr.Name), "skillcheck") then
                    return true
                end
            end
            local getup = (typeof(getupvalues) == "function" and getupvalues)
                or (debug and typeof(debug.getupvalues) == "function" and debug.getupvalues)
            if not getup then
                return false
            end
            local ok, upvs = pcall(getup, fn)
            if not ok or type(upvs) ~= "table" then
                return false
            end
            for _, v in pairs(upvs) do
                if
                    (activeCheckObj and v == activeCheckObj)
                    or (activeLineObj and v == activeLineObj)
                    or (activeGoalObj and v == activeGoalObj)
                    or (activeTrapGoalObj and v == activeTrapGoalObj)
                    or (activeTrapPerfectObj and v == activeTrapPerfectObj)
                    or (activePromptGui and v == activePromptGui)
                    or (cfg and v == cfg)
                then
                    return true
                elseif
                    typeof(v) == "Instance"
                    and v:IsA("RemoteEvent")
                    and string.find(string.lower(v.Name), "skill")
                then
                    return true
                elseif depth < 2 and type(v) == "function" then
                    if hasSkillCheckUpvalue(v, cfg, depth + 1, visited) then
                        return true
                    end
                end
            end
            return false
        end

        local function isSkillCheckConn(conn)
            local fn = conn and conn.Function
            if type(fn) ~= "function" then
                return false
            end
            return hasSkillCheckUpvalue(fn, getKeybindsConfig(), 0, {})
        end

        local function fireSignalChannel(signalObj, skipOwnEnv, forceFireSignal, directOnly, ...)
            if not signalObj then
                return false, false
            end
            local dispatched = false
            local matchedDirect = false
            if typeof(getconnections) == "function" then
                local ok, conns = pcall(getconnections, signalObj)
                if ok and type(conns) == "table" then
                    local directConns, otherConns = {}, {}
                    for _, conn in ipairs(conns) do
                        if conn and (conn.Enabled ~= false) and (conn.Connected ~= false) then
                            local fn = conn.Function
                            if not (skipOwnEnv and isOwnConnection(fn)) then
                                if isSkillCheckConn(conn) then
                                    table.insert(directConns, conn)
                                elseif not directOnly then
                                    table.insert(otherConns, conn)
                                end
                            end
                        end
                    end

                    local function invokeConnList(list, markDirect, ...)
                        for _, conn in ipairs(list) do
                            if isCheckConsumed() then
                                return true
                            end
                            local fn = conn.Function
                            local connCalled = false
                            if type(fn) == "function" and not (forceFireSignal and conn.Fire) then
                                if pcall(fn, ...) then
                                    connCalled = true
                                    dispatched = true
                                    if markDirect then
                                        matchedDirect = true
                                    end
                                end
                            end
                            if not connCalled and conn.Fire then
                                if pcall(conn.Fire, conn, ...) then
                                    dispatched = true
                                    if markDirect then
                                        matchedDirect = true
                                    end
                                end
                            end
                        end
                        return false
                    end
                    if invokeConnList(directConns, true, ...) then
                        return true, true
                    end
                    if not directOnly and not matchedDirect then
                        if invokeConnList(otherConns, false, ...) then
                            return true, false
                        end
                    end
                end
            end
            if
                not directOnly
                and (forceFireSignal or not dispatched)
                and not matchedDirect
                and not isCheckConsumed()
                and typeof(firesignal) == "function"
            then
                if pcall(firesignal, signalObj, ...) then
                    dispatched = true
                end
            end
            return dispatched, matchedDirect
        end

        local function dispatchInputBegan(entries, isVerifiedMatch, forceRetry)
            local dispatchedAny = false
            local limit = isVerifiedMatch and 1 or #entries
            for idx = 1, limit do
                local entry = entries[idx]
                local fakeInput = entry and entry.fakeInput
                if fakeInput then
                    if not forceRetry and isCheckConsumed() then
                        return true
                    end
                    local sigDelivered = false
                    if typeof(firesignal) == "function" then
                        canaryTarget = fakeInput
                        canarySeen = false
                        local okSig = pcall(firesignal, UserInputService.InputBegan, fakeInput, false)
                        canaryTarget = nil
                        if okSig then
                            dispatchedAny = true
                            if canarySeen then
                                sigDelivered = true
                            end
                        end
                    end
                    if (forceRetry or not sigDelivered) and typeof(getconnections) == "function" then
                        local okConns, conns = pcall(getconnections, UserInputService.InputBegan)
                        if okConns and type(conns) == "table" then
                            for _, conn in ipairs(conns) do
                                if not forceRetry and isCheckConsumed() then
                                    return true
                                end
                                if conn and (conn.Enabled ~= false) and (conn.Connected ~= false) then
                                    local fn = conn.Function
                                    if not isOwnConnection(fn) then
                                        local fired = false
                                        if forceRetry then
                                            if type(fn) == "function" and pcall(fn, fakeInput, false) then
                                                fired = true
                                            elseif conn.Fire and pcall(conn.Fire, conn, fakeInput, false) then
                                                fired = true
                                            end
                                        else
                                            if conn.Fire and pcall(conn.Fire, conn, fakeInput, false) then
                                                fired = true
                                            elseif type(fn) == "function" and pcall(fn, fakeInput, false) then
                                                fired = true
                                            end
                                        end
                                        if fired then
                                            dispatchedAny = true
                                        end
                                    end
                                end
                            end
                        end
                    end
                    if isVerifiedMatch then
                        break
                    end
                end
            end
            return dispatchedAny
        end

        local function dispatchMobileButtons(btns, forceRetry)
            btns = btns or collectMobileCheckButtons(isMobileClientMode())
            if #btns == 0 then
                return false, false
            end
            local touchedAny = false
            local matchedAnyDirect = false

            local function tryDirectSignal(sig, ...)
                if not sig or isCheckConsumed() then
                    return false
                end
                local dispatched, matchedDirect = fireSignalChannel(sig, false, forceRetry, true, ...)
                if dispatched then
                    touchedAny = true
                end
                if matchedDirect then
                    matchedAnyDirect = true
                    return true
                end
                return false
            end

            local function tryConnSignal(sig, isCxxSafe, ...)
                if not sig or isCheckConsumed() then
                    return
                end
                local dispatched, matchedDirect =
                    fireSignalChannel(sig, false, (forceRetry and isCxxSafe) or false, false, ...)
                if dispatched then
                    touchedAny = true
                end
                if matchedDirect then
                    matchedAnyDirect = true
                end
            end
            for _, mobBtn in ipairs(btns) do
                if isCheckConsumed() then
                    return true, matchedAnyDirect
                end
                local cPos = mobBtn.AbsolutePosition + (mobBtn.AbsoluteSize * 0.5)
                local px, py = math.floor(cPos.X + 0.5), math.floor(cPos.Y + 0.5)
                local touchInput = {
                    KeyCode = Enum.KeyCode.Unknown,
                    UserInputType = Enum.UserInputType.Touch,
                    UserInputState = Enum.UserInputState.Begin,
                    Position = Vector3.new(cPos.X, cPos.Y, 0),
                    Delta = Vector3.zero,
                    IsModifierKeyDown = noModifierDown,
                }
                local m1DownSig = safeGetSignal(mobBtn, "MouseButton1Down")
                local actSig = safeGetSignal(mobBtn, "Activated")
                local tapSig = safeGetSignal(mobBtn, "TouchTap")
                local m1ClickSig = safeGetSignal(mobBtn, "MouseButton1Click")
                local ibSig = safeGetSignal(mobBtn, "InputBegan")
                local m1UpSig = safeGetSignal(mobBtn, "MouseButton1Up")
                if tryDirectSignal(m1DownSig, px, py) then
                    break
                end
                if tryDirectSignal(actSig, touchInput, 0) then
                    break
                end
                if tryDirectSignal(tapSig, { Vector2.new(cPos.X, cPos.Y) }, false) then
                    break
                end
                if tryDirectSignal(m1ClickSig) then
                    break
                end
                if tryDirectSignal(ibSig, touchInput) then
                    break
                end
                if tryDirectSignal(m1UpSig, px, py) then
                    break
                end
            end
            if (forceRetry or not matchedAnyDirect) and not isCheckConsumed() then
                for _, mobBtn in ipairs(btns) do
                    if isCheckConsumed() then
                        return true, matchedAnyDirect
                    end
                    local cPos = mobBtn.AbsolutePosition + (mobBtn.AbsoluteSize * 0.5)
                    local px, py = math.floor(cPos.X + 0.5), math.floor(cPos.Y + 0.5)
                    local touchInput = {
                        KeyCode = Enum.KeyCode.Unknown,
                        UserInputType = Enum.UserInputType.Touch,
                        UserInputState = Enum.UserInputState.Begin,
                        Position = Vector3.new(cPos.X, cPos.Y, 0),
                        Delta = Vector3.zero,
                        IsModifierKeyDown = noModifierDown,
                    }
                    local mouseInput = {
                        KeyCode = Enum.KeyCode.Unknown,
                        UserInputType = Enum.UserInputType.MouseButton1,
                        UserInputState = Enum.UserInputState.Begin,
                        Position = Vector3.new(cPos.X, cPos.Y, 0),
                        Delta = Vector3.zero,
                        IsModifierKeyDown = noModifierDown,
                    }
                    local actSig = safeGetSignal(mobBtn, "Activated")
                    local tapSig = safeGetSignal(mobBtn, "TouchTap")
                    local m1ClickSig = safeGetSignal(mobBtn, "MouseButton1Click")
                    local m1DownSig = safeGetSignal(mobBtn, "MouseButton1Down")
                    local m1UpSig = safeGetSignal(mobBtn, "MouseButton1Up")
                    local ibSig = safeGetSignal(mobBtn, "InputBegan")
                    if not forceRetry then
                        tryConnSignal(m1DownSig, true, px, py)
                        tryConnSignal(actSig, false, touchInput, 0)
                        tryConnSignal(tapSig, true, { Vector2.new(cPos.X, cPos.Y) }, false)
                        tryConnSignal(m1ClickSig, true)
                        tryConnSignal(ibSig, false, touchInput)
                        tryConnSignal(m1UpSig, true, px, py)
                    elseif forceRetry then
                        tryConnSignal(ibSig, false, mouseInput)
                    end
                    if not isCheckConsumed() and typeof(firesignal) == "function" then
                        if m1DownSig and (forceRetry or not touchedAny) then
                            if pcall(firesignal, m1DownSig, px, py) then
                                touchedAny = true
                            end
                        end
                        if actSig then
                            if pcall(firesignal, actSig) then
                                touchedAny = true
                            end
                        end
                        if forceRetry or not touchedAny then
                            if tapSig then
                                pcall(firesignal, tapSig, { Vector2.new(cPos.X, cPos.Y) }, false)
                            end
                            if m1ClickSig then
                                pcall(firesignal, m1ClickSig)
                            end
                            if m1UpSig then
                                pcall(firesignal, m1UpSig, px, py)
                            end
                        end
                    end
                end
            end
            local touchBtn = nil
            for _, b in ipairs(btns) do
                if b:IsA("GuiButton") and isGuiObjVisible(b) and b.AbsoluteSize.X > 1 and b.AbsoluteSize.Y > 1 then
                    touchBtn = b
                    break
                end
            end
            if not touchBtn then
                for _, b in ipairs(btns) do
                    if isGuiObjVisible(b) and b.AbsoluteSize.X > 1 and b.AbsoluteSize.Y > 1 then
                        touchBtn = b
                        break
                    end
                end
            end
            if touchBtn and (forceRetry or not matchedAnyDirect) and not isCheckConsumed() and VirtualInputManager then
                local cPos = touchBtn.AbsolutePosition + (touchBtn.AbsoluteSize * 0.5)
                local sg = touchBtn:FindFirstAncestorWhichIsA("ScreenGui")
                local inset = Vector2.zero
                if sg and not sg.IgnoreGuiInset and GuiService then
                    local ok, gi = pcall(function()
                        return GuiService:GetGuiInset()
                    end)
                    if ok and gi then
                        inset = gi
                    end
                end
                local sx = math.floor(cPos.X + inset.X + 0.5)
                local sy = math.floor(cPos.Y + inset.Y + 0.5)
                if VirtualInputManager.SendTouchEvent then
                    local tid = forceRetry and 0 or 1
                    if
                        pcall(function()
                            VirtualInputManager:SendTouchEvent(tid, 0, sx, sy)
                            task.delay(0.01, function()
                                pcall(function()
                                    VirtualInputManager:SendTouchEvent(tid, 2, sx, sy)
                                end)
                            end)
                        end)
                    then
                        touchedAny = true
                    end
                end
                if forceRetry and VirtualInputManager.SendMouseButtonEvent then
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(sx, sy, 0, true, game, 1)
                        task.delay(0.01, function()
                            pcall(function()
                                VirtualInputManager:SendMouseButtonEvent(sx, sy, 0, false, game, 1)
                            end)
                        end)
                    end)
                end
            end
            return touchedAny, matchedAnyDirect
        end

        local function triggerSkillCheckInput(forceRetry)
            if isInputHeld then
                releaseInputs()
            end
            isInputHeld = true
            pressGeneration = pressGeneration + 1
            local myGen = pressGeneration
            local padConnected = UserInputService.GamepadEnabled
            local binds = resolveSkillCheckBinds(padConnected)
            local targetEntries, isVerifiedMatch = selectMatchingBinds(binds)
            local mobPlat = isMobileClientMode()
            local mobBtns = collectMobileCheckButtons(mobPlat)
            local hasVisibleMobBtn = false
            for _, b in ipairs(mobBtns) do
                if isGuiObjVisible(b) then
                    hasVisibleMobBtn = true
                    break
                end
            end
            local isMobClient = mobPlat or hasVisibleMobBtn
            if isMobClient then
                local mobDispatched, matchedMobDirect = false, false
                if #mobBtns > 0 then
                    mobDispatched, matchedMobDirect = dispatchMobileButtons(mobBtns, forceRetry)
                end
                if not isCheckConsumed() and not matchedMobDirect then
                    local ibDispatched = dispatchInputBegan(targetEntries, isVerifiedMatch, forceRetry)
                    if
                        not isCheckConsumed()
                        and (forceRetry or (not mobDispatched and not ibDispatched))
                        and VirtualInputManager
                    then
                        for _, entry in ipairs(targetEntries) do
                            if isCheckConsumed() then
                                break
                            end
                            if entry.kind ~= "Mouse" then
                                if
                                    pcall(
                                        VirtualInputManager.SendKeyEvent,
                                        VirtualInputManager,
                                        true,
                                        entry.keyCode,
                                        false,
                                        game
                                    )
                                then
                                    table.insert(heldKeyCodes, entry.keyCode)
                                end
                            end
                        end
                    end
                end
            else
                local vimObservedSync = false
                local wantsVirtualSpace = false
                local dispatchLimit = isVerifiedMatch and 1 or #targetEntries
                for idx = 1, dispatchLimit do
                    local entry = targetEntries[idx]
                    if entry and (padConnected or entry.kind ~= "Pad") then
                        if entry.kind == "Mouse" then
                            if VirtualInputManager and VirtualInputManager.SendMouseButtonEvent then
                                local mp = UserInputService:GetMouseLocation()
                                local mx, my = math.floor(mp.X + 0.5), math.floor(mp.Y + 0.5)
                                vimWatchKey = nil
                                vimWatchType = entry.userInputType
                                vimWatchSeen = false
                                if
                                    pcall(
                                        VirtualInputManager.SendMouseButtonEvent,
                                        VirtualInputManager,
                                        mx,
                                        my,
                                        entry.mouseBtn,
                                        true,
                                        game,
                                        1
                                    )
                                then
                                    table.insert(heldMouseButtons, { x = mx, y = my, btn = entry.mouseBtn })
                                end
                                vimWatchType = nil
                                if vimWatchSeen then
                                    vimObservedSync = true
                                end
                            end
                        else
                            if entry.keyCode == Enum.KeyCode.Space then
                                wantsVirtualSpace = true
                            end
                            if VirtualInputManager then
                                vimWatchKey = entry.keyCode
                                vimWatchType = nil
                                vimWatchSeen = false
                                if
                                    pcall(
                                        VirtualInputManager.SendKeyEvent,
                                        VirtualInputManager,
                                        true,
                                        entry.keyCode,
                                        false,
                                        game
                                    )
                                then
                                    table.insert(heldKeyCodes, entry.keyCode)
                                end
                                vimWatchKey = nil
                                if vimWatchSeen then
                                    vimObservedSync = true
                                end
                            end
                        end
                    end
                end
                if padConnected and VirtualInputManager then
                    if
                        pcall(
                            VirtualInputManager.SendKeyEvent,
                            VirtualInputManager,
                            true,
                            Enum.KeyCode.ButtonX,
                            false,
                            game
                        )
                    then
                        table.insert(heldKeyCodes, Enum.KeyCode.ButtonX)
                    end
                end
                if wantsVirtualSpace and VirtualUser and not vimObservedSync and not isCheckConsumed() then
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:SetKeyDown("0x20")
                        heldVirtualSpace = true
                    end)
                end
                if forceRetry or (not vimObservedSync and not isCheckConsumed()) then
                    dispatchInputBegan(targetEntries, isVerifiedMatch, forceRetry)
                end
                if hasVisibleMobBtn and not isCheckConsumed() then
                    dispatchMobileButtons(mobBtns, forceRetry)
                end
            end
            task.delay(0.015, function()
                if pressGeneration == myGen then
                    releaseInputs()
                end
            end)
        end
        local PROMPT_GUI_NAMES = { "SkillCheckPromptGui", "SkillCheckPromptGui-mob", "SkillCheckPromptGui-con" }
        local cachedPromptGui, cachedCheck, cachedLine, cachedGoal, cachedTrapGoal, cachedTrapPerfect =
            nil, nil, nil, nil, nil, nil

        local function resolvePromptChildren(promptGui)
            if not promptGui then
                return nil
            end
            if promptGui:IsA("LayerCollector") and not promptGui.Enabled then
                return nil
            end
            local check = promptGui:FindFirstChild("Check") or promptGui:FindFirstChild("Check", true)
            if not check then
                return nil
            end
            local line = check:FindFirstChild("Line")
            if not line then
                return nil
            end
            return promptGui,
                check,
                line,
                check:FindFirstChild("Goal"),
                check:FindFirstChild("TrapGoal"),
                check:FindFirstChild("TrapPerfect")
        end

        local function getCheckElements()
            if
                cachedCheck
                and cachedCheck.Parent
                and cachedLine
                and cachedLine.Parent
                and cachedCheck.Visible
                and (not cachedPromptGui or not cachedPromptGui:IsA("LayerCollector") or cachedPromptGui.Enabled)
            then
                return cachedPromptGui, cachedCheck, cachedLine, cachedGoal, cachedTrapGoal, cachedTrapPerfect
            end
            local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
            if not pg then
                return nil
            end
            local fbGui, fbCheck, fbLine, fbGoal, fbTrapGoal, fbTrapPerfect = nil, nil, nil, nil, nil, nil
            for _, guiName in ipairs(PROMPT_GUI_NAMES) do
                local pGui = pg:FindFirstChild(guiName)
                if pGui then
                    local rGui, chk, ln, gl, tGl, tPf = resolvePromptChildren(pGui)
                    if chk and ln then
                        if chk.Visible then
                            cachedPromptGui, cachedCheck, cachedLine, cachedGoal, cachedTrapGoal, cachedTrapPerfect =
                                rGui, chk, ln, gl, tGl, tPf
                            return rGui, chk, ln, gl, tGl, tPf
                        elseif not fbCheck then
                            fbGui, fbCheck, fbLine, fbGoal, fbTrapGoal, fbTrapPerfect = rGui, chk, ln, gl, tGl, tPf
                        end
                    end
                end
            end
            if fbCheck then
                cachedPromptGui, cachedCheck, cachedLine, cachedGoal, cachedTrapGoal, cachedTrapPerfect =
                    fbGui, fbCheck, fbLine, fbGoal, fbTrapGoal, fbTrapPerfect
                return fbGui, fbCheck, fbLine, fbGoal, fbTrapGoal, fbTrapPerfect
            end
            return nil
        end
        local isCheckActive = false
        local currentTargetMode = "Perfect"
        local hasTriggered = false
        local lastGoalAngle = -9999
        local lastWasTrapPerfect = nil
        local lastLineRot = nil
        local lastHitTime = 0
        local retriedAfterTrigger = false
        local prevLineMoving = false
        local prevCycleScourge = false

        local function resetCheckState()
            isCheckActive = false
            hasTriggered = false
            retriedAfterTrigger = false
            prevLineMoving = false
            prevCycleScourge = false
            lastGoalAngle = -9999
            lastWasTrapPerfect = nil
            lastLineRot = nil
            lastHitTime = 0
            activePromptGui = nil
            activeCheckObj = nil
            activeLineObj = nil
            activeGoalObj = nil
            activeTrapGoalObj = nil
            activeTrapPerfectObj = nil
            activeIsTrapSkill = false
            activePrevGoalRot = -9999
            releaseInputs()
        end

        local function rollChance(settingKey, fallbackKey, defaultPct)
            local pct = tonumber(Hypnosis.Settings[settingKey])
            if pct == nil and fallbackKey then
                pct = tonumber(Hypnosis.Settings[fallbackKey])
            end
            if pct == nil then
                pct = defaultPct
            end
            pct = math.clamp(pct, 0, 100)
            if pct <= 0 then
                return "Normal"
            elseif pct >= 100 then
                return "Perfect"
            elseif math.random(1, 100) <= pct then
                return "Perfect"
            end
            return "Normal"
        end

        local function rollMainTargetMode()
            local modeIdx = Hypnosis.Settings["Choice_Perfect_Normal_Custom"] or 1
            if modeIdx == 1 then
                return "Perfect"
            elseif modeIdx == 2 then
                return "Normal"
            end
            return rollChance("Auto Skill Check_Custom Perfect Chance %", "Custom Perfect Chance %", 24)
        end

        local function rollTargetMode(isScourge)
            if isScourge then
                local scourgeIdx = Hypnosis.Settings["Auto Skill Check_Scourge Mode"] or 2
                if scourgeIdx == 1 then
                    return rollMainTargetMode()
                elseif scourgeIdx == 2 then
                    return "Perfect"
                elseif scourgeIdx == 3 then
                    return "Normal"
                else
                    return rollChance("Auto Skill Check_Scourge Perfect Chance %", "Scourge Perfect Chance %", 50)
                end
            end
            return rollMainTargetMode()
        end
        local skillCheckConn = RunService.RenderStepped:Connect(function()
            if Hypnosis._Unloaded then
                return
            end
            if isKiller(LocalPlayer) then
                return
            end
            local isEnabled = Hypnosis.Settings["Auto Skill Check_Enabled"]
            if isEnabled == nil then
                isEnabled = Hypnosis.Settings["Auto Skill Check Engine_Enabled"]
            end
            if not isEnabled then
                if isCheckActive then
                    resetCheckState()
                end
                return
            end
            local promptGui, check, line, goal, trapGoal, trapPerfect = getCheckElements()
            if not check or not check.Visible then
                if isCheckActive then
                    resetCheckState()
                end
                return
            end
            local isTrapSkill = (trapPerfect and trapPerfect.Visible == true) or (trapGoal and trapGoal.Visible == true)
            local isNormalSkill = (goal and goal.Visible == true)
            if not isTrapSkill and not isNormalSkill then
                return
            end
            local currentGoalRot = 0
            local isTrapPerfectOnly = false
            if isTrapSkill then
                local trapTargetObj = (trapPerfect and trapPerfect.Visible and trapPerfect) or trapGoal
                currentGoalRot = trapTargetObj and trapTargetObj.Rotation or 0
                isTrapPerfectOnly = (trapPerfect and trapPerfect.Visible == true)
            else
                currentGoalRot = goal and goal.Rotation or 0
            end
            local isScourge = (not isTrapSkill) and isKingsScourgeEngaged()
            if isScourge and Hypnosis.Settings["Auto Skill Check_During Kings Scourge"] == false then
                if isCheckActive then
                    resetCheckState()
                end
                return
            end
            local currentLineRot = line.Rotation
            local now = os.clock()
            local lineDelta = lastLineRot and math.abs(currentLineRot - lastLineRot) or 0
            local isMovingNow = (lineDelta > 0.25)
            local isNewCycle = false
            if not isCheckActive then
                isNewCycle = true
            elseif math.abs(currentGoalRot - lastGoalAngle) > 0.5 then
                isNewCycle = true
            elseif isTrapSkill and lastWasTrapPerfect ~= nil and isTrapPerfectOnly ~= lastWasTrapPerfect then
                isNewCycle = true
            elseif
                lastLineRot and (currentLineRot < lastLineRot - 35 or (lastLineRot > 120 and currentLineRot < 45))
            then
                isNewCycle = true
            elseif hasTriggered and (now - lastHitTime > 0.08) then
                local circDiff = (currentLineRot - currentGoalRot) % 360
                if
                    circDiff < 85
                    or circDiff > 175
                    or ((isMovingNow or prevLineMoving) and (now - lastHitTime > 0.15))
                then
                    hasTriggered = false
                    retriedAfterTrigger = false
                end
            end
            if isNewCycle then
                isCheckActive = true
                hasTriggered = false
                retriedAfterTrigger = false
                prevCycleScourge = isScourge
                lastGoalAngle = currentGoalRot
                lastWasTrapPerfect = isTrapSkill and isTrapPerfectOnly or nil
                currentTargetMode = rollTargetMode(isScourge)
                releaseInputs()
            elseif isScourge ~= prevCycleScourge and not hasTriggered then
                prevCycleScourge = isScourge
                currentTargetMode = rollTargetMode(isScourge)
            end
            prevLineMoving = isMovingNow
            lastLineRot = currentLineRot
            activePromptGui = promptGui
            activeCheckObj = check
            activeLineObj = line
            activeGoalObj = goal
            activeTrapGoalObj = trapGoal
            activeTrapPerfectObj = trapPerfect
            activeIsTrapSkill = isTrapSkill
            activePrevGoalRot = currentGoalRot
            if not hasTriggered then
                local diff = (currentLineRot - currentGoalRot) % 360
                if isTrapSkill then
                    local wantPerfect = isTrapPerfectOnly or (currentTargetMode == "Perfect")
                    local minHit = wantPerfect and 102.5 or 118.5
                    local maxHit = wantPerfect and 115.8 or 138
                    if
                        (diff >= minHit and diff <= maxHit)
                        or (wantPerfect and not isTrapPerfectOnly and diff > maxHit and diff <= 138)
                    then
                        hasTriggered = true
                        retriedAfterTrigger = false
                        lastHitTime = now
                        lastGoalAngle = currentGoalRot
                        pcall(triggerSkillCheckInput, false)
                    end
                elseif isScourge then
                    if currentTargetMode == "Normal" then
                        if diff >= 120 and diff <= 152 then
                            hasTriggered = true
                            retriedAfterTrigger = false
                            lastHitTime = now
                            lastGoalAngle = currentGoalRot
                            pcall(triggerSkillCheckInput, false)
                        end
                    elseif (diff >= 106 and diff <= 112) or (diff > 112 and diff <= 152) then
                        hasTriggered = true
                        retriedAfterTrigger = false
                        lastHitTime = now
                        lastGoalAngle = currentGoalRot
                        pcall(triggerSkillCheckInput, false)
                    end
                else
                    local minHit = (currentTargetMode == "Perfect") and 104 or 120
                    local maxHit = (currentTargetMode == "Perfect") and 115 or 154
                    if
                        (diff >= minHit and diff <= maxHit)
                        or (currentTargetMode == "Perfect" and diff > maxHit and diff <= 156)
                    then
                        hasTriggered = true
                        retriedAfterTrigger = false
                        lastHitTime = now
                        lastGoalAngle = currentGoalRot
                        pcall(triggerSkillCheckInput, false)
                    end
                end
            elseif
                not retriedAfterTrigger
                and not isTrapSkill
                and not isScourge
                and prevLineMoving
                and (now - lastHitTime >= 0.025)
                and (now - lastHitTime < 0.095)
            then
                local circDiff = (currentLineRot - currentGoalRot) % 360
                if circDiff >= 102 and circDiff <= 159 then
                    retriedAfterTrigger = true
                    lastHitTime = now
                    pcall(triggerSkillCheckInput, true)
                end
            end
        end)
        table.insert(Hypnosis.Connections, skillCheckConn)
    end

    local function isMasterSwitchEnabled()
        local s = Hypnosis.Settings["Master Switch_Enabled"]
        if s == nil then
            return true
        end
        return s == true
    end

    local function getCustomName(moduleName, defaultName)
        local v = Hypnosis.Settings[moduleName .. "_Custom Name"]
        if type(v) == "string" and v ~= "" then
            return v
        end
        return defaultName or ""
    end

    local function toColor3(v, defaultColor)
        if typeof(v) == "Color3" then
            return v
        elseif type(v) == "table" and #v >= 3 then
            local r = tonumber(v[1]) or 1
            local g = tonumber(v[2]) or 1
            local b = tonumber(v[3]) or 1
            if r > 1 or g > 1 or b > 1 then
                return Color3.fromRGB(r, g, b)
            else
                return Color3.new(r, g, b)
            end
        end
        return defaultColor
    end

    local function getTextColor(moduleName)
        local v = Hypnosis.Settings[moduleName .. "_Text Color_Color"]
        return toColor3(v, Color3.fromRGB(255, 255, 255))
    end

    local function getTextStrokeColor(moduleName)
        local v = Hypnosis.Settings[moduleName .. "_Text Stroke Color_Color"]
        return toColor3(v, Color3.fromRGB(0, 0, 0))
    end

    local function getFillColor(moduleName)
        local v = Hypnosis.Settings[moduleName .. "_Fill Color_Color"]
            or Hypnosis.Settings[moduleName .. "_Highlight Color_Color"]
        return toColor3(v, Color3.fromRGB(255, 255, 255))
    end

    local function getFillTrans(moduleName)
        local v = Hypnosis.Settings[moduleName .. "_Fill Transparency"]
            or Hypnosis.Settings[moduleName .. "_Highlight Transparency"]
        if type(v) == "number" then
            return math.clamp(v / 100, 0, 1)
        end
        return 0.5
    end

    local function getOutlineColor(moduleName)
        local v = Hypnosis.Settings[moduleName .. "_Outline Color_Color"]
        return toColor3(v, Color3.fromRGB(255, 255, 255))
    end

    local function getOutlineTrans(moduleName)
        local v = Hypnosis.Settings[moduleName .. "_Outline Transparency"]
        if type(v) == "number" then
            return math.clamp(v / 100, 0, 1)
        end
        return 0.0
    end
    local getHighlightColor = getFillColor

    local function getHighlightTrans(mod)
        return getFillTrans(mod) * 100
    end

    local function resolveColorByMode(mode, defaultColor, dist, teamType)
        if mode == "White" then
            return Color3.fromRGB(255, 255, 255)
        elseif mode == "Rainbow" then
            local hue = (tick() * 0.25) % 1
            return Color3.fromHSV(hue, 0.85, 1.0)
        elseif mode == "Team" then
            if teamType == "Killer" then
                return Color3.fromRGB(240, 240, 240)
            elseif teamType == "Survivor" then
                return Color3.fromRGB(150, 150, 150)
            elseif teamType == "Objective" then
                return Color3.fromRGB(200, 200, 200)
            else
                return Color3.fromRGB(180, 180, 180)
            end
        elseif mode == "Fade" then
            local t = math.clamp((dist or 40) / 250, 0, 1)
            local r = math.floor(255 - (t * 140) + 0.5)
            return Color3.fromRGB(r, r, r)
        end
        return defaultColor or Color3.fromRGB(255, 255, 255)
    end

    function Hypnosis.InitEsp()
        local EspContainer = Instance.new("Folder")
        EspContainer.Name = "HypnosisEsp"
        EspContainer.Parent = ScreenGui
        Hypnosis.EspContainer = EspContainer
        local TagPool = {}
        Hypnosis.TagPool = TagPool
        Hypnosis.MapConnections = {}
        local TracerContainer = Instance.new("Folder", EspContainer)
        TracerContainer.Name = "Tracers"
        local TracerPool = {}
        local VaultBoxContainer = Instance.new("Folder", EspContainer)
        VaultBoxContainer.Name = "VaultBoxes"

        local function getOrCreateTracer(id)
            local t = TracerPool[id]
            if not t then
                local f = Instance.new("Frame")
                f.Name = "Tracer_" .. tostring(id)
                f.AnchorPoint = Vector2.new(0.5, 0.5)
                f.BorderSizePixel = 0
                f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                f.BackgroundTransparency = 0.3
                f.ZIndex = 1
                f.Visible = false
                f.Parent = TracerContainer
                TracerPool[id] = f
                t = f
            end
            return t
        end

        local function getOrCreateTag(id)
            local entry = TagPool[id]
            if not entry then
                local label = Instance.new("TextLabel")
                label.Name = "Tag_" .. tostring(id)
                label.Size = UDim2.new(0, 240, 0, 50)
                label.AnchorPoint = Vector2.new(0.5, 0.5)
                label.BackgroundTransparency = 1
                label.BorderSizePixel = 0
                label.Font = getEspFont()
                label.TextSize = 10
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                label.TextStrokeTransparency = 0.4
                label.RichText = true
                label.Visible = false
                label.ZIndex = 2
                label.Parent = EspContainer
                local highlight = nil
                pcall(function()
                    highlight = Instance.new("Highlight")
                    highlight.Name = "Highlight_" .. tostring(id)
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.FillColor = Color3.fromRGB(255, 255, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.0
                    highlight.Enabled = false
                    highlight.Parent = EspContainer
                end)
                entry = {
                    Label = label,
                    Highlight = highlight,
                    Alpha = 0.0,
                    TargetAlpha = 0.0,
                    Adornee = nil,
                    HighlightEnabled = false,
                    FillColor = Color3.fromRGB(255, 255, 255),
                    FillTrans = 0.5,
                    OutlineColor = Color3.fromRGB(255, 255, 255),
