        end
        return false
    end

    local function isInActiveGameTeam(player)
        local p = player or LocalPlayer
        if not p then
            return false
        end
        if p.Team then
            local tLower = string.lower(p.Team.Name)
            if
                string.find(tLower, "lobby", 1, true)
                or string.find(tLower, "spectat", 1, true)
                or string.find(tLower, "intermission", 1, true)
                or string.find(tLower, "menu", 1, true)
                or string.find(tLower, "neutral", 1, true)
            then
                return false
            end
            if
                string.find(tLower, "survivor", 1, true)
                or string.find(tLower, "killer", 1, true)
                or string.find(tLower, "slasher", 1, true)
            then
                return true
            end
        end
        local teamObj = p:FindFirstChild("Team")
        if teamObj then
            if teamObj:IsA("Team") then
                local tn = string.lower(teamObj.Name)
                if string.find(tn, "lobby", 1, true) or string.find(tn, "spectat", 1, true) then
                    return false
                end
                if
                    string.find(tn, "survivor", 1, true)
                    or string.find(tn, "killer", 1, true)
                    or string.find(tn, "slasher", 1, true)
                then
                    return true
                end
            elseif teamObj:IsA("ValueBase") then
                local tv = string.lower(tostring(teamObj.Value))
                if string.find(tv, "lobby", 1, true) or string.find(tv, "spectat", 1, true) then
                    return false
                end
                if
                    string.find(tv, "survivor", 1, true)
                    or string.find(tv, "killer", 1, true)
                    or string.find(tv, "slasher", 1, true)
                then
                    return true
                end
            elseif
                teamObj:FindFirstChild("Survivors")
                or teamObj:FindFirstChild("Survivor")
                or teamObj:FindFirstChild("Killer")
                or teamObj:FindFirstChild("Killers")
            then
                return true
            end
        end
        local char = p.Character
        if char and char.Parent then
            if
                char:FindFirstChild("CheckInterractable")
                or char:FindFirstChild("SurvivorScript")
                or char:FindFirstChild("SurvivorRoot")
                or char:FindFirstChild("MorphedKiller")
                or char:FindFirstChild("KillerScript")
                or char:FindFirstChild("KillerRoot")
            then
                return true
            end
            local roleAttr = char:GetAttribute("Role") or p:GetAttribute("Role")
            if roleAttr == "Killer" or roleAttr == "Survivor" or char:GetAttribute("IsKiller") == true then
                return true
            end
        end
        return false
    end
