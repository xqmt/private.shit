        }

        local function ensureNativeSpearMath()
            if NativeSpearMath then
                return NativeSpearMath
            end
            local now = os.clock()
            if (now - lastSpearMathAttempt) < 1.0 then
                return nil
            end
            lastSpearMathAttempt = now
            local ok, mod = pcall(function()
                local mods = ReplicatedStorage:FindFirstChild("Modules")
                local killers = mods and mods:FindFirstChild("Killers")
                local veil = killers and killers:FindFirstChild("Veil")
                local spearMath = veil and veil:FindFirstChild("SpearMath")
                if spearMath then
                    return require(spearMath)
                end
                return nil
            end)
            if ok and type(mod) == "table" then
                NativeSpearMath = mod
                if type(mod.Speed) == "number" and mod.Speed > 10 then
                    SpearConfig.Speed = mod.Speed
                end
                if typeof(mod.Gravity) == "Vector3" and math.abs(mod.Gravity.Y) > 1 then
                    SpearConfig.Gravity = mod.Gravity
                    SpearConfig.GravityY = math.abs(mod.Gravity.Y)
                elseif type(mod.Gravity) == "number" and math.abs(mod.Gravity) > 1 then
                    SpearConfig.GravityY = math.abs(mod.Gravity)
                    SpearConfig.Gravity = Vector3.new(0, -SpearConfig.GravityY, 0)
                end
                if type(mod.SpawnOffset) == "number" and mod.SpawnOffset >= 0 then
                    SpearConfig.SpawnOffset = mod.SpawnOffset
                end
                if type(mod.MinChargeTime) == "number" and mod.MinChargeTime > 0 then
                    SpearConfig.MinChargeTime = mod.MinChargeTime
                end
                local fullT = mod.FullChargeTime or mod.MaxChargeTime
                if type(fullT) == "number" and fullT > SpearConfig.MinChargeTime then
                    SpearConfig.FullChargeTime = fullT
                end
            end
            return NativeSpearMath
        end
        local HIT_BODY_PARTS = {
            "Head",
            "Torso",
            "UpperTorso",
            "LowerTorso",
            "Left Arm",
            "Right Arm",
            "Left Leg",
            "Right Leg",
        }
        local AXES = { "X", "Y", "Z" }

        local function testOBB(orig, dir, cf, size)
            local v1 = cf:PointToObjectSpace(orig)
            local v2 = cf:VectorToObjectSpace(dir)
            local tMin = 0
            local tMax = 1
            for i = 1, 3 do
                local axis = AXES[i]
                local v3 = v1[axis]
                local v4 = v2[axis]
                local v5 = size[axis] * 0.5
                if math.abs(v4) < 1e-08 then
                    if v3 < -v5 or v3 > v5 then
                        return nil
                    end
                else
                    local v6 = (-v5 - v3) / v4
                    local v7 = (v5 - v3) / v4
                    if v7 < v6 then
                        local tmp = v7
                        v7 = v6
                        v6 = tmp
                    end
                    tMin = math.max(tMin, v6)
                    tMax = math.min(tMax, v7)
                    if tMax < tMin then
                        return nil
                    end
                end
            end
            return tMin
        end
