        local pGuiDescConn = nil

        local function disconnectPlayerGuiWatcher()
            if pGuiDescConn then
                pcall(function()
                    pGuiDescConn:Disconnect()
                end)
                pGuiDescConn = nil
            end
        end

        local function connectPlayerGuiWatcher()
            disconnectPlayerGuiWatcher()
            if not isGuiChangerEnabled() then
                return
            end
            local pGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if not pGui then
                return
            end
            pGuiDescConn = pGui.DescendantAdded:Connect(function(desc)
                if not isGuiChangerEnabled() then
                    return
                end
                task.defer(function()
                    if not isGuiChangerEnabled() then
                        return
                    end
                    if not desc or not desc.Parent then
                        return
                    end
                    if desc:IsA("ScreenGui") then
                        scanScreenGuiWidgets(desc)
                        for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                            applyTransform(entry)
                        end
                    elseif isEligibleHudWidget(desc) then
                        local entry = registerElement(desc)
                        if entry then
                            applyTransform(entry)
                        end
                    end
                end)
            end)
        end

        function Hypnosis.SetGuiMoveMode(enabled)
            if isSyncingMoveUi and Hypnosis.GuiChanger.MoveMode == (enabled == true) then
                return
            end

            if enabled and not isGuiChangerEnabled() then
                showNotification(
                    "GUI Changer Disabled",
                    "Enable GUI Changer first before entering Interactive Move Mode.",
                    "info",
                    2.2
                )
                syncMoveModeUiSetting(false)
                enabled = false
            end
            Hypnosis.GuiChanger.MoveMode = (enabled == true)
            gcContainer.Enabled = (enabled == true)
            if enabled then
                scanPlayerGui()
                createHitCatcher()
                createToolbar()
                createHiddenDrawer()
                if Hypnosis.GuiChanger.Toolbar then
                    Hypnosis.GuiChanger.Toolbar.Visible = true
                end
            else
                deselectElement()
                if Hypnosis.GuiChanger.Toolbar and Hypnosis.GuiChanger.Toolbar.Parent then
                    Hypnosis.GuiChanger.Toolbar.Visible = false
                end
                if Hypnosis.GuiChanger.HiddenDrawer and Hypnosis.GuiChanger.HiddenDrawer.Parent then
                    Hypnosis.GuiChanger.HiddenDrawer.Visible = false
                end
                if Hypnosis.GuiChanger.HoverBox and Hypnosis.GuiChanger.HoverBox.Parent then
                    Hypnosis.GuiChanger.HoverBox.Visible = false
                end
                if Hypnosis.GuiChanger.SelectionBox and Hypnosis.GuiChanger.SelectionBox.Parent then
                    Hypnosis.GuiChanger.SelectionBox.Visible = false
                end
                if Hypnosis.GuiChanger.ActionToolbar and Hypnosis.GuiChanger.ActionToolbar.Parent then
                    Hypnosis.GuiChanger.ActionToolbar.Visible = false
                end
            end
            if Hypnosis.SyncMouseBehavior then
                pcall(Hypnosis.SyncMouseBehavior)
            end
        end

        function Hypnosis.SetGuiTargetCategory(category)
            Hypnosis.GuiChanger.ActiveCategory = category
            if Hypnosis.GuiChanger.Toolbar and Hypnosis.GuiChanger.Toolbar.Parent then
                local statusLbl = Hypnosis.GuiChanger.Toolbar:FindFirstChild("StatusLbl")
                if statusLbl then
                    statusLbl.Text = "Filter: " .. category
                end
            end
        end

        function Hypnosis.SetGuiOutlineVisible(visible)
            Hypnosis.GuiChanger.OutlinesVisible = visible
            if Hypnosis.GuiChanger.SelectionBox then
                Hypnosis.GuiChanger.SelectionBox.Visible = visible
                    and Hypnosis.GuiChanger.MoveMode
                    and (Hypnosis.GuiChanger.SelectedEntry ~= nil)
            end
        end

        function Hypnosis.UnhideAllGuiElements()
            for _, entry in pairs(Hypnosis.GuiChanger.HiddenList) do
                entry.IsHidden = false
                applyTransform(entry)
            end
            table.clear(Hypnosis.GuiChanger.HiddenList)
            updateToolbarCount()
            if updateSelectionBox then
                updateSelectionBox()
            end
            if updateHiddenDrawer then
                updateHiddenDrawer()
            end
            showNotification("All Elements Restored", "All game interface elements are now visible.", "Info", 2.5)
        end

        function Hypnosis.ApplyGuiSliderTransform(transformType, value)
            local cat = Hypnosis.GuiChanger.ActiveCategory or "All"
            local offsets = Hypnosis.GuiChanger.CategoryOffsets[cat]
            if not offsets then
                offsets = { X = 0, Y = 0, Scale = 1.0, Transparency = 0 }
                Hypnosis.GuiChanger.CategoryOffsets[cat] = offsets
            end
            if transformType == "X" then
                offsets.X = value
            elseif transformType == "Y" then
                offsets.Y = value
            elseif transformType == "Scale" then
                offsets.Scale = value
            elseif transformType == "Transparency" then
                offsets.Transparency = value
            end
            if not isGuiChangerEnabled() then
                return
            end
            scanPlayerGui()
            for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                if cat == "All" or entry.Category == cat then
                    applyTransform(entry)
                end
            end
            if Hypnosis.GuiChanger.SelectedEntry then
                updateSelectionBox(Hypnosis.GuiChanger.SelectedEntry)
            end
        end

        local function clearAllTrackedAndRevert()
            for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                revertEntry(entry)
                if entry.AncestryConn then
                    pcall(function()
                        entry.AncestryConn:Disconnect()
                    end)
                    entry.AncestryConn = nil
                end
            end
            table.clear(Hypnosis.GuiChanger.Tracked)
            table.clear(Hypnosis.GuiChanger.HiddenList)
            deselectElement()
            updateToolbarCount()
            if updateHiddenDrawer then
                pcall(updateHiddenDrawer)
            end
        end

        function Hypnosis.ToggleGuiChanger(state)
            if state == true then
                connectPlayerGuiWatcher()
                scanPlayerGui()
                for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                    applyTransform(entry)
                end
                if Hypnosis.Settings["GUI Changer_Interactive Move Mode"] == true then
                    Hypnosis.SetGuiMoveMode(true)
                end
            else
                disconnectPlayerGuiWatcher()
                Hypnosis.SetGuiMoveMode(false)
                syncMoveModeUiSetting(false)
                clearAllTrackedAndRevert()
            end
        end

        function Hypnosis.ResetGuiChanger()
            for _, offsets in pairs(Hypnosis.GuiChanger.CategoryOffsets) do
                offsets.X = 0
                offsets.Y = 0
                offsets.Scale = 1.0
                offsets.Transparency = 0
            end
            for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                entry.DragOffsetX = 0
                entry.DragOffsetY = 0
                entry.IsHidden = false
                revertEntry(entry)
            end
            table.clear(Hypnosis.GuiChanger.HiddenList)
            deselectElement()
            updateToolbarCount()
            if updateHiddenDrawer then
                pcall(updateHiddenDrawer)
            end
            UpdateSetting("GUI Changer_Offset X", 0)
            UpdateSetting("GUI Changer_Offset Y", 0)
            UpdateSetting("GUI Changer_Scale Multiplier", 1.0)
            UpdateSetting("GUI Changer_HUD Transparency", 0)
            if Hypnosis.Setters["GUI Changer_Offset X"] then
                pcall(Hypnosis.Setters["GUI Changer_Offset X"], 0)
            end
            if Hypnosis.Setters["GUI Changer_Offset Y"] then
                pcall(Hypnosis.Setters["GUI Changer_Offset Y"], 0)
            end
            if Hypnosis.Setters["GUI Changer_Scale Multiplier"] then
                pcall(Hypnosis.Setters["GUI Changer_Scale Multiplier"], 1.0)
            end
            if Hypnosis.Setters["GUI Changer_HUD Transparency"] then
                pcall(Hypnosis.Setters["GUI Changer_HUD Transparency"], 0)
            end
            if not Hypnosis._Teleporting and not Hypnosis._Unloaded then
                showNotification(
                    "HUD Positions Reset",
                    "All game interface elements restored to stock positions & visibility.",
                    "Info",
                    3.0
                )
            end
        end
        local lastScanTick = 0

        local function throttledScan()
            if not isGuiChangerEnabled() then
                if Hypnosis.GuiChanger.MoveMode or gcContainer.Enabled then
                    Hypnosis.SetGuiMoveMode(false)
                end
                return
            end
            local now = tick()
            if (now - lastScanTick) < 0.8 then
                return
            end
            lastScanTick = now
            connectPlayerGuiWatcher()
            scanPlayerGui()
            for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                applyTransform(entry)
            end
        end
        if LocalPlayer then
            local charConn = LocalPlayer.CharacterAdded:Connect(function()
                task.delay(1.0, throttledScan)
            end)
            table.insert(Hypnosis.Connections, charConn)
            local childConn = LocalPlayer.ChildAdded:Connect(function(ch)
                if ch and ch:IsA("PlayerGui") and isGuiChangerEnabled() then
                    task.defer(throttledScan)
                end
            end)
            table.insert(Hypnosis.Connections, childConn)
        end
        local cam = workspace.CurrentCamera
        if cam then
            local camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                if Hypnosis.GuiChanger.MoveMode and Hypnosis.GuiChanger.SelectedEntry then
                    updateSelectionBox(Hypnosis.GuiChanger.SelectedEntry)
                end
            end)
            table.insert(Hypnosis.Connections, camConn)
        end
        if isGuiChangerEnabled() then
            connectPlayerGuiWatcher()
            scanPlayerGui()
            for _, entry in pairs(Hypnosis.GuiChanger.Tracked) do
                applyTransform(entry)
            end
        end
    end

    function Hypnosis.InitFakeLagAndDesync()
        if Hypnosis.GhostContainer and Hypnosis.GhostContainer.Parent then
            pcall(function()
                Hypnosis.GhostContainer:Destroy()
            end)
        end
        pcall(function()
            RunService:UnbindFromRenderStep("Hypnosis_DesyncPreCameraRestore")
        end)
        local ghostFolder = Instance.new("Folder")
        ghostFolder.Name = "Hypnosis_NetworkGhostVisualizer"
        pcall(function()
            ghostFolder.Parent = workspace
        end)
        Hypnosis.GhostContainer = ghostFolder

        local function ensureGhostFolder()
            if not ghostFolder or not ghostFolder.Parent then
                ghostFolder = Instance.new("Folder")
                ghostFolder.Name = "Hypnosis_NetworkGhostVisualizer"
                pcall(function()
                    ghostFolder.Parent = workspace
                end)
                Hypnosis.GhostContainer = ghostFolder
            end
            return ghostFolder
        end
        local currentGhostModel = nil
        local currentBillboard = nil
        local billboardText = nil
        local desyncServerCFrame = nil
        local desyncActive = false
        local fakeLagActive = false
        local lastFakeLagTick = tick()
        local lastDesyncStepTick = 0

        local function parseColor3(val, fallback)
            if typeof and typeof(val) == "Color3" then
                return val
            end
            if type(val) == "table" then
                local r = tonumber(val.R or val[1]) or 1
                local g = tonumber(val.G or val[2]) or 1
                local b = tonumber(val.B or val[3]) or 1
                if r > 1 or g > 1 or b > 1 then
                    return Color3.fromRGB(
                        math.clamp(math.floor(r), 0, 255),
                        math.clamp(math.floor(g), 0, 255),
                        math.clamp(math.floor(b), 0, 255)
                    )
                else
                    return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
                end
            end
            return fallback or Color3.fromRGB(255, 255, 255)
        end

        local function getLocalChar()
            local char = LocalPlayer.Character
            if not char then
                return nil, nil, nil
            end
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            local hum = char:FindFirstChildOfClass("Humanoid")
            return char, hrp, hum
        end

        local function destroyGhost()
            if currentGhostModel and currentGhostModel.Parent then
                pcall(function()
                    currentGhostModel:Destroy()
                end)
            end
            currentGhostModel = nil
            if currentBillboard and currentBillboard.Parent then
                pcall(function()
                    currentBillboard:Destroy()
                end)
            end
            currentBillboard = nil
            billboardText = nil
        end

        local function createGhost(char, targetCFrame, rawColor, trans, tagText)
            if not char or not targetCFrame then
                return
            end
            destroyGhost()
            local color = parseColor3(rawColor, Color3.fromRGB(255, 255, 255))
            trans = (type(trans) == "number") and trans or 0.5
            local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if not rootPart then
                return
            end
            local ghost = Instance.new("Model")
            ghost.Name = "Hypnosis_GhostMannequin"
            local dummyHum = Instance.new("Humanoid")
            dummyHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            dummyHum.Parent = ghost
            local currentRootCFrame = rootPart.CFrame
            for _, child in ipairs(char:GetChildren()) do
                if
                    child:IsA("BasePart")
                    and child.Name ~= "HumanoidRootPart"
                    and child.Name ~= "CheckInterractable"
                then
                    local clone = child:Clone()
                    clone.Anchored = true
                    clone.CanCollide = false
                    clone.CanTouch = false
                    clone.CanQuery = false
                    clone.CastShadow = false
                    clone.Transparency = 0.99
                    clone.Color = color
                    clone.Material = Enum.Material.SmoothPlastic
                    clone:SetAttribute("OriginalPartName", child.Name)
                    for _, sub in ipairs(clone:GetChildren()) do
                        if sub:IsA("SpecialMesh") then
                            sub.TextureId = ""
                        else
                            sub:Destroy()
                        end
                    end
                    local offset = currentRootCFrame:ToObjectSpace(child.CFrame)
                    clone.CFrame = targetCFrame * offset
                    clone.Parent = ghost
                elseif child:IsA("Accessory") then
                    local handle = child:FindFirstChild("Handle")
                    if handle and handle:IsA("BasePart") then
                        local clone = handle:Clone()
                        clone.Anchored = true
                        clone.CanCollide = false
                        clone.CanTouch = false
                        clone.CanQuery = false
                        clone.CastShadow = false
                        clone.Transparency = 0.99
                        clone.Color = color
                        clone.Material = Enum.Material.SmoothPlastic
                        clone:SetAttribute("OriginalPartName", handle.Name)
                        for _, sub in ipairs(clone:GetChildren()) do
                            if sub:IsA("SpecialMesh") or sub:IsA("Mesh") then
                                pcall(function()
                                    sub.TextureId = ""
                                end)
                            else
                                sub:Destroy()
                            end
                        end
                        local offset = currentRootCFrame:ToObjectSpace(handle.CFrame)
                        clone.CFrame = targetCFrame * offset
                        clone.Parent = ghost
                    end
                end
            end
            local hl = Instance.new("Highlight")
            hl.Name = "GhostHighlight"
            hl.FillColor = color
            hl.OutlineColor = Color3.fromRGB(240, 240, 240)
            hl.FillTransparency = trans
            hl.OutlineTransparency = 0.2
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = ghost
            hl.Parent = ghost
            ghost.Parent = ensureGhostFolder()
            currentGhostModel = ghost
            local bGui = Instance.new("BillboardGui")
            bGui.Name = "GhostTag"
            bGui.Size = UDim2.new(0, 130, 0, 18)
            bGui.StudsOffset = Vector3.new(0, 3.2, 0)
            bGui.AlwaysOnTop = true
            bGui.Adornee = ghost:FindFirstChild("Head") or ghost:FindFirstChildWhichIsA("BasePart")
            bGui.Parent = ensureGhostFolder()
            currentBillboard = bGui
            local tagFrame = Instance.new("Frame", bGui)
            tagFrame.Size = UDim2.new(1, 0, 1, 0)
            tagFrame.BackgroundColor3 = Palette.WindowBg
            tagFrame.BorderSizePixel = 0
            local tfC = Instance.new("UICorner", tagFrame)
            tfC.CornerRadius = UDim.new(0, 3)
            local tfS = Instance.new("UIStroke", tagFrame)
            tfS.Color = Palette.BorderActive
            tfS.Thickness = 1
            local lbl = Instance.new("TextLabel", tagFrame)
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Ubuntu
            lbl.RichText = true
            lbl.Text = tagText or "<b>[SERVER POSITION]</b>"
            lbl.TextColor3 = Palette.TextActive
            lbl.TextSize = 8
            lbl.TextXAlignment = Enum.TextXAlignment.Center
            billboardText = lbl
        end

        local function updateGhostPosition(targetCFrame, playerPos, tagText, rawColor)
            if currentGhostModel and currentGhostModel.Parent and targetCFrame then
                local color = parseColor3(rawColor, Color3.fromRGB(255, 255, 255))
                local hl = currentGhostModel:FindFirstChildOfClass("Highlight")
                if hl then
                    pcall(function()
                        hl.FillColor = color
                    end)
                end
            end
            if billboardText and tagText then
                billboardText.Text = tagText
            end
        end

        local function resyncToRealPositionSilent()
            local _, myHrp = getLocalChar()
            if myHrp then
                myHrp.Anchored = false
            end
            fakeLagActive = false
            desyncActive = false
            destroyGhost()
            desyncServerCFrame = nil
            lastFakeLagTick = tick()
        end
        Hypnosis.ResyncDesyncSilent = resyncToRealPositionSilent
        local ProximityPromptService = nil
        pcall(function()
            ProximityPromptService = game:GetService("ProximityPromptService")
        end)
        if ProximityPromptService then
            local pBegan = ProximityPromptService.PromptButtonHoldBegan:Connect(resyncToRealPositionSilent)
            local pTrig = ProximityPromptService.PromptTriggered:Connect(resyncToRealPositionSilent)
            table.insert(Hypnosis.Connections, pBegan)
            table.insert(Hypnosis.Connections, pTrig)
        end
        local interactKeyConn = UserInputService.InputBegan:Connect(function(input)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            if UserInputService:GetFocusedTextBox() then
                return
            end
            if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
                resyncToRealPositionSilent()
            end
        end)
        table.insert(Hypnosis.Connections, interactKeyConn)
        local heartbeatConn = RunService.Heartbeat:Connect(function(deltaTime)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local char, myHrp, myHum = getLocalChar()
            local cam = workspace.CurrentCamera
            local inCutscene = cam and cam.CameraType == Enum.CameraType.Scriptable
            if
                not char
                or not myHrp
                or not myHum
                or myHum.Health <= 0
                or not isInActiveGameTeam(LocalPlayer)
                or inCutscene
            then
                if fakeLagActive or desyncActive then
                    myHrp.Anchored = false
                    fakeLagActive = false
                    desyncActive = false
                    destroyGhost()
                end
                return
            end
            local isDesyncSetting = isSettingActive("Network Desync", "Network Desync_Enabled") == true
            local isFakeLagSetting = isSettingActive("Fake Lag", "Fake Lag_Enabled") == true
            if isDesyncSetting then
                if fakeLagActive then
                    fakeLagActive = false
                    destroyGhost()
                end
                local ghostColor =
                    parseColor3(Hypnosis.Settings["Network Desync_Server Ghost Color"], Color3.fromRGB(200, 200, 200))
                local showGhost = isSettingActive("Network Desync", "Visualize Server Position") ~= false
                if not desyncActive then
                    desyncActive = true
                    desyncServerCFrame = myHrp.CFrame
                    myHrp.Anchored = true
                    if showGhost then
                        createGhost(char, desyncServerCFrame, ghostColor, 0.5, "<b>[DESYNC SERVER]</b>")
                    end
                end
                if myHrp.Anchored then
                    local moveDir = myHum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        local speed = myHum.WalkSpeed
                        myHrp.CFrame = myHrp.CFrame + (moveDir * (speed * deltaTime))
                    end
                end
                if showGhost and desyncServerCFrame then
                    local dist = (myHrp.Position - desyncServerCFrame.Position).Magnitude
                    updateGhostPosition(
                        desyncServerCFrame,
                        myHrp.Position,
                        string.format('<b>[DESYNC SERVER]</b> <font color="#737373">(%.1fm)</font>', dist),
                        ghostColor
                    )
                end
            elseif isFakeLagSetting then
                if desyncActive then
                    desyncActive = false
                    destroyGhost()
                end
                local pingMs = tonumber(Hypnosis.Settings["Fake Lag_Simulated Ping"]) or 300
                local delaySec = math.clamp(pingMs / 1000, 0.05, 1.5)
                local ghostColor = parseColor3(Hypnosis.Settings["Fake Lag_Ghost Color"], Color3.fromRGB(255, 255, 255))
                local transSlider = tonumber(Hypnosis.Settings["Fake Lag_Ghost Transparency"]) or 50
                local ghostAlpha = math.clamp(transSlider / 100, 0, 0.95)
                local showGhost = isSettingActive("Fake Lag", "View Last Position") ~= false
                if not fakeLagActive then
                    fakeLagActive = true
                    lastFakeLagTick = tick()
                    desyncServerCFrame = myHrp.CFrame
                    myHrp.Anchored = true
                    if showGhost then
                        createGhost(
                            char,
                            desyncServerCFrame,
                            ghostColor,
                            ghostAlpha,
                            string.format("<b>[FAKE LAG: %dms]</b>", pingMs)
                        )
                    end
                end
                if myHrp.Anchored then
                    local moveDir = myHum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        local speed = myHum.WalkSpeed
                        myHrp.CFrame = myHrp.CFrame + (moveDir * (speed * deltaTime))
                    end
                end
                local now = tick()
                if now - lastFakeLagTick >= delaySec then
                    myHrp.Anchored = false
                    task.wait(0.06)
                    if not myHrp or not myHrp.Parent then
                        return
                    end
                    myHrp.Anchored = true
                    desyncServerCFrame = myHrp.CFrame
                    lastFakeLagTick = tick()
                    if showGhost then
                        createGhost(
                            char,
                            desyncServerCFrame,
                            ghostColor,
                            ghostAlpha,
                            string.format("<b>[FAKE LAG: %dms]</b>", pingMs)
                        )
                    end
                end
                if showGhost and desyncServerCFrame then
                    local dist = (myHrp.Position - desyncServerCFrame.Position).Magnitude
                    updateGhostPosition(
                        desyncServerCFrame,
                        myHrp.Position,
                        string.format('<b>[FAKE LAG: %dms]</b> <font color="#737373">(%.1fm)</font>', pingMs, dist),
                        ghostColor
                    )
                end
            else
                if fakeLagActive or desyncActive then
                    myHrp.Anchored = false
                    fakeLagActive = false
                    desyncActive = false
                    destroyGhost()
                end
            end
        end)
        table.insert(Hypnosis.Connections, heartbeatConn)

        function Hypnosis.ToggleFakeLag(state)
            UpdateSetting("Fake Lag_Enabled", state)
            if not state then
                resyncToRealPositionSilent()
            end
        end

        function Hypnosis.ToggleNetworkDesync(state)
            UpdateSetting("Network Desync_Enabled", state)
            if not state then
                resyncToRealPositionSilent()
            end
        end

        function Hypnosis.ResyncDesyncPosition()
            resyncToRealPositionSilent()
            showNotification("Position Resync", "Character resynchronized to real coordinates.", "success", 1.8)
        end
        Hypnosis.CleanupDesyncAndLag = function()
            resyncToRealPositionSilent()
        end
    end

    function Hypnosis.InitKillerThirdPerson()
        local wasKillerActive = false
        local originalFov = 70
        local defaultDistance = 14
        local defaultOffset = Vector3.new(0, 1.2, 0)
        local defaultFov = 80
        local hasPoppedOutZoom = false
        local cachedParts = {}
        local cachedDecals = {}
        local cachedViewmodelParts = {}

        local function refreshCachedCharParts(char)
            table.clear(cachedParts)
            table.clear(cachedDecals)
            if not char then
                return
            end
            for _, desc in ipairs(char:GetDescendants()) do
                if desc:IsA("BasePart") then
                    table.insert(cachedParts, desc)
                elseif desc:IsA("Decal") then
                    table.insert(cachedDecals, desc)
                end
            end
        end

        local function refreshCachedViewmodels()
            table.clear(cachedViewmodelParts)
            local cam = workspace.CurrentCamera
            if not cam then
                return
            end
            for _, child in ipairs(cam:GetChildren()) do
                if child:IsA("Model") then
                    local cName = child.Name:lower()
                    if cName:find("viewmodel") or cName:find("arms") or cName:find("fp") or cName:find("weapon") then
                        for _, p in ipairs(child:GetDescendants()) do
                            if p:IsA("BasePart") then
                                table.insert(cachedViewmodelParts, p)
                            end
                        end
                    end
                end
            end
        end

        local function getLocalPlayerChar()
            local char = LocalPlayer.Character
            if not char then
                return nil, nil
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            return char, hum, hrp
        end

        local function checkIsKiller(player)
            if not player then
                return false
            end
            return isKiller(player)
        end

        local function isKillerActive()
            local isModEnabled = isSettingActive("Killer Third-Person", "Killer Third-Person_Enabled")
            if not isModEnabled then
                return false
            end
            if not isInActiveGameTeam(LocalPlayer) then
                return false
            end
            local cam = workspace.CurrentCamera
            if cam and cam.CameraType == Enum.CameraType.Scriptable then
                return false
            end
            local char, hum = getLocalPlayerChar()
            if not char or not hum or hum.Health <= 0 then
                return false
            end
            local alwaysActive = isSettingActive("Killer Third-Person", "Always Third-Person")
            if alwaysActive == nil then
                alwaysActive = isSettingActive("Killer Third-Person", "Always In Third-Person")
            end
            if alwaysActive then
                return true
            end
            local autoDetect = isSettingActive("Killer Third-Person", "Auto Detect Killer")
            if autoDetect ~= false then
                return checkIsKiller(LocalPlayer)
            end
            return true
        end

        local function restoreCharacterVisibility()
            for i = 1, #cachedParts do
                local desc = cachedParts[i]
                if desc.Parent then
                    if desc.Name == "Head" or desc.Name:find("Arm") or desc.Name:find("Torso") then
                        desc.LocalTransparencyModifier = 1
                    end
                end
            end
            for i = 1, #cachedViewmodelParts do
                local p = cachedViewmodelParts[i]
                if p.Parent then
                    p.LocalTransparencyModifier = 0
                end
            end
        end

        local function enforceCharacterVisibility()
            if not isSettingActive("Killer Third-Person", "Make Killer Visible") then
                return
            end
            for i = 1, #cachedParts do
                local desc = cachedParts[i]
                if desc.Parent then
                    if desc.LocalTransparencyModifier > 0 then
                        desc.LocalTransparencyModifier = 0
                    end
                    if desc.Name ~= "HumanoidRootPart" and desc.Transparency >= 0.95 then
                        desc.Transparency = 0
                    end
                end
            end
            for i = 1, #cachedDecals do
                local d = cachedDecals[i]
                if d.Parent and d.Transparency >= 0.95 then
                    d.Transparency = 0
                end
            end
            for i = 1, #cachedViewmodelParts do
                local p = cachedViewmodelParts[i]
                if p.Parent and p.LocalTransparencyModifier < 1 then
                    p.LocalTransparencyModifier = 1
                end
            end
        end

        local function restoreCameraToNormal()
            hasPoppedOutZoom = false
            local cam = workspace.CurrentCamera
            local char, hum = getLocalPlayerChar()
            if hum then
                pcall(function()
                    hum.CameraOffset = Vector3.zero
                end)
            end
            local playerIsKiller = checkIsKiller(LocalPlayer)
            if playerIsKiller then
                pcall(function()
                    LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
                    LocalPlayer.CameraMinZoomDistance = 0.5
                    LocalPlayer.CameraMaxZoomDistance = 0.5
                end)
            else
                pcall(function()
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                    LocalPlayer.CameraMinZoomDistance = 0.5
                    LocalPlayer.CameraMaxZoomDistance = 128
                end)
            end
            if cam and cam.CameraType ~= Enum.CameraType.Scriptable then
                pcall(function()
                    cam.CameraType = Enum.CameraType.Custom
                    if hum then
                        cam.CameraSubject = hum
                    end
                    if not (Hypnosis.IsEnvFovActive and Hypnosis.IsEnvFovActive()) then
                        cam.FieldOfView = originalFov
                    end
                end)
            end
            restoreCharacterVisibility()
            wasKillerActive = false
        end

        local function updateCamera()
            local shouldBeActive = isKillerActive()
            local cam = workspace.CurrentCamera
            local char, hum = getLocalPlayerChar()
            if not shouldBeActive then
                if wasKillerActive then
                    restoreCameraToNormal()
                end
                return
            end
            wasKillerActive = true
            if not cam or not char or not hum then
                return
            end
            if cam.CameraType ~= Enum.CameraType.Custom then
                pcall(function()
                    cam.CameraType = Enum.CameraType.Custom
                end)
            end
            if cam.CameraSubject ~= hum then
                pcall(function()
                    cam.CameraSubject = hum
                end)
            end
            if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                pcall(function()
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                end)
            end
            if LocalPlayer.CameraMaxZoomDistance < defaultDistance then
                pcall(function()
                    LocalPlayer.CameraMaxZoomDistance = 128
                end)
            end
            if not hasPoppedOutZoom then
                hasPoppedOutZoom = true
                pcall(function()
                    LocalPlayer.CameraMinZoomDistance = defaultDistance
                    task.delay(0.25, function()
                        if isKillerActive() then
                            LocalPlayer.CameraMinZoomDistance = 0.5
                        end
                    end)
                end)
            end
            if (hum.CameraOffset - defaultOffset).Magnitude > 0.05 then
                hum.CameraOffset = hum.CameraOffset:Lerp(defaultOffset, 0.25)
            else
                hum.CameraOffset = defaultOffset
            end
            if not (Hypnosis.IsEnvFovActive and Hypnosis.IsEnvFovActive()) then
                if math.abs(cam.FieldOfView - defaultFov) > 0.5 then
                    cam.FieldOfView = defaultFov
                end
            end
        end
        RunService:BindToRenderStep("Hypnosis_KillerCameraEnforce", Enum.RenderPriority.Camera.Value - 1, function()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            if not wasKillerActive and not isKillerActive() then
                return
            end
            pcall(updateCamera)
        end)
        RunService:BindToRenderStep("Hypnosis_KillerVisibility", Enum.RenderPriority.Last.Value, function()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            if wasKillerActive then
                enforceCharacterVisibility()
            end
        end)
        local hookedViewmodelCam = nil
        local vmChildAddConn, vmChildRemConn = nil, nil

        local function bindViewmodelCam(cam)
            if not cam or cam == hookedViewmodelCam then
                return
            end
            hookedViewmodelCam = cam
            if vmChildAddConn then
                pcall(function()
                    vmChildAddConn:Disconnect()
                end)
                vmChildAddConn = nil
            end
            if vmChildRemConn then
                pcall(function()
                    vmChildRemConn:Disconnect()
                end)
                vmChildRemConn = nil
            end
            refreshCachedViewmodels()
            vmChildAddConn = cam.ChildAdded:Connect(refreshCachedViewmodels)
            vmChildRemConn = cam.ChildRemoved:Connect(refreshCachedViewmodels)
            table.insert(Hypnosis.Connections, vmChildAddConn)
            table.insert(Hypnosis.Connections, vmChildRemConn)
        end
        pcall(function()
            bindViewmodelCam(workspace.CurrentCamera)
            table.insert(
                Hypnosis.Connections,
                workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
                    bindViewmodelCam(workspace.CurrentCamera)
                end)
            )
        end)

        local function setupCharListeners(newChar)
            refreshCachedCharParts(newChar)
            newChar.DescendantAdded:Connect(function(desc)
                if desc:IsA("BasePart") then
                    table.insert(cachedParts, desc)
                elseif desc:IsA("Decal") then
                    table.insert(cachedDecals, desc)
                end
            end)
            newChar.DescendantRemoving:Connect(function(desc)
                if desc:IsA("BasePart") then
                    for i = #cachedParts, 1, -1 do
                        if cachedParts[i] == desc then
                            table.remove(cachedParts, i)
                            break
                        end
                    end
                elseif desc:IsA("Decal") then
                    for i = #cachedDecals, 1, -1 do
                        if cachedDecals[i] == desc then
                            table.remove(cachedDecals, i)
                            break
                        end
                    end
                end
            end)
        end
        if LocalPlayer.Character then
            setupCharListeners(LocalPlayer.Character)
        end
        local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if wasKillerActive then
                restoreCameraToNormal()
            end
            setupCharListeners(newChar)
            local newHum = newChar:WaitForChild("Humanoid", 3)
            if newHum then
                newHum.Died:Connect(function()
                    if wasKillerActive then
                        restoreCameraToNormal()
                    end
                end)
            end
        end)
        table.insert(Hypnosis.Connections, charAddedConn)
        local curChar, curHum = getLocalPlayerChar()
        if curHum then
            local diedConn = curHum.Died:Connect(function()
                if wasKillerActive then
                    restoreCameraToNormal()
                end
            end)
            table.insert(Hypnosis.Connections, diedConn)
        end

        function Hypnosis.ToggleKillerThirdPerson(state)
            if state then
                local cam = workspace.CurrentCamera
                if cam then
                    originalFov = cam.FieldOfView
                end
                hasPoppedOutZoom = false
                showNotification("Killer Third-Person", "Third-person perspective active for Killer.", "Info", 2.0)
            else
                restoreCameraToNormal()
                showNotification("Killer Third-Person", "Restored standard first-person camera.", "Info", 2.0)
            end
        end

        function Hypnosis.CleanupKillerThirdPerson()
            pcall(function()
                RunService:UnbindFromRenderStep("Hypnosis_KillerCameraEnforce")
            end)
            pcall(function()
                RunService:UnbindFromRenderStep("Hypnosis_KillerVisibility")
            end)
            restoreCameraToNormal()
        end
    end

    function Hypnosis.InitBreakSpeed()
        local activeKillerController = nil
        local lastGcScanTime = 0
        local isScanningGc = false
        local lastGcScanChar = nil
        local gcScanCountForChar = 0
        local cachedIsKiller = false
        local lastKillerCheckTime = 0
        local lastKillerChar = nil

        local function isPlayerActiveKiller()
            local char = LocalPlayer and LocalPlayer.Character
            if not char or not char:FindFirstChild("Humanoid") or not char:FindFirstChild("HumanoidRootPart") then
                cachedIsKiller = false
                return false
            end
            if activeKillerController and activeKillerController.character == char and activeKillerController.state then
                cachedIsKiller = true
                return true
            end
            local now = tick()
            if char == lastKillerChar and (now - lastKillerCheckTime < 0.5) then
                return cachedIsKiller
            end
            lastKillerCheckTime = now
            lastKillerChar = char
            local team = LocalPlayer.Team
            if team then
                local tName = team.Name:lower()
                if tName == "survivors" or tName:find("survivor") or tName:find("spectat") or tName:find("lobby") then
                    cachedIsKiller = false
                    return false
                end
                if tName == "killer" or tName == "killers" or tName:find("killer") or tName:find("slasher") then
                    cachedIsKiller = true
                    return true
                end
            end
            if
                char:GetAttribute("Killer") == true
                or char:GetAttribute("Role") == "Killer"
                or LocalPlayer:GetAttribute("Role") == "Killer"
                or char:FindFirstChild("Machete")
                or char:FindFirstChild("Knife")
                or char:FindFirstChild("Weapon")
                or isKiller(LocalPlayer)
            then
                cachedIsKiller = true
                return true
            end
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pg then
                for _, gui in ipairs(pg:GetChildren()) do
                    if gui:IsA("ScreenGui") then
                        local gName = gui.Name:lower()
                        if
                            not gName:find("survivor")
                            and (
                                string.find(gName, "killer")
                                or string.find(gName, "slasher")
                                or string.find(gName, "stalker")
                                or string.find(gName, "hidden")
                                or string.find(gName, "abyss")
                                or string.find(gName, "cure")
                                or string.find(gName, "veil")
                            )
                        then
                            cachedIsKiller = true
                            return true
                        end
                    end
                end
            end
            cachedIsKiller = false
            return false
        end
        local kConfigPatched = false

        local function applyBreakPalletSpeed(forceScan)
            local myChar = LocalPlayer and LocalPlayer.Character
            local isKiller = isPlayerActiveKiller()
            local pbEnabled = (Hypnosis.Settings["Break Pallet/Generator Speed_Enabled"] == true)
            local pbMult = tonumber(Hypnosis.Settings["Break Pallet/Generator Speed_Speed Multiplier"]) or 2.0
            pbMult = math.clamp(pbMult, 1.0, 10.0)
            if isKiller and myChar then
                if pbEnabled then
                    if myChar:GetAttribute("breakspeed") ~= pbMult then
                        pcall(function()
                            myChar:SetAttribute("breakspeed", pbMult)
                        end)
                    end
                else
                    if myChar:GetAttribute("breakspeed") and myChar:GetAttribute("breakspeed") > 1 then
                        pcall(function()
                            myChar:SetAttribute("breakspeed", 1)
                        end)
                    end
                end
                if pbEnabled or kConfigPatched then
                    pcall(function()
                        local RS = game:GetService("ReplicatedStorage")
                        local killersMod = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Killers")
                        local kConfigMod = killersMod and killersMod:FindFirstChild("KillerConfig")
                        if kConfigMod then
                            local kConfig = require(kConfigMod)
                            if kConfig then
                                if rawget(kConfig, "_origPalletBreakDur") == nil then
                                    rawset(kConfig, "_origPalletBreakDur", kConfig.PALLET_BREAK_DURATION or 2.16)
                                end
                                local origDur = rawget(kConfig, "_origPalletBreakDur") or 2.16
                                if pbEnabled then
                                    kConfig.PALLET_BREAK_DURATION = math.max(0.1, origDur / pbMult)
                                    kConfigPatched = true
                                else
                                    kConfig.PALLET_BREAK_DURATION = origDur
                                    kConfigPatched = false
                                end
                            end
                        end
                    end)
                end
            end
            if not pbEnabled or not isKiller then
                if activeKillerController and type(activeKillerController.palletBreak) == "table" then
                    local pb = activeKillerController.palletBreak
                    local origAnim = rawget(pb, "_origAnimMult") or 1
                    local origDur = rawget(pb, "_origDurMult") or 1
                    pb.animationSpeedMultiplier = origAnim
                    pb.durationSpeedMultiplier = origDur
                end
                return
            end
            if
                activeKillerController
                and activeKillerController.character == myChar
                and type(activeKillerController.palletBreak) == "table"
            then
                local pb = activeKillerController.palletBreak
                if rawget(pb, "_origAnimMult") == nil then
                    rawset(pb, "_origAnimMult", pb.animationSpeedMultiplier or 1)
                    rawset(pb, "_origDurMult", pb.durationSpeedMultiplier or 1)
                end
                local origAnim = rawget(pb, "_origAnimMult") or 1
                local origDur = rawget(pb, "_origDurMult") or 1
                pb.animationSpeedMultiplier = origAnim * pbMult
                pb.durationSpeedMultiplier = origDur * pbMult
                return
            end
            local now = tick()
            if isScanningGc or (not forceScan and (now - lastGcScanTime < 2.5)) then
                return
            end
            lastGcScanTime = now
            isScanningGc = true
            if getgc and myChar then
                pcall(function()
                    local gcList = getgc(true)
                    if not gcList then
                        return
                    end
                    for _, obj in ipairs(gcList) do
                        if type(obj) == "table" then
                            if
                                rawget(obj, "character") == myChar
                                and rawget(obj, "state") ~= nil
                                and rawget(obj, "humanoid") ~= nil
                                and (rawget(obj, "playAnimation") ~= nil or rawget(obj, "playAnimationNoStop") ~= nil)
                            then
                                activeKillerController = obj
                                if obj.humanoid and obj.humanoid.JumpPower ~= 0 then
                                    obj.humanoid.JumpPower = 0
                                end
                                if type(obj.palletBreak) == "table" then
                                    local pb = obj.palletBreak
                                    if rawget(pb, "_origAnimMult") == nil then
                                        rawset(pb, "_origAnimMult", pb.animationSpeedMultiplier or 1)
                                        rawset(pb, "_origDurMult", pb.durationSpeedMultiplier or 1)
                                    end
                                    local origAnim = rawget(pb, "_origAnimMult") or 1
                                    local origDur = rawget(pb, "_origDurMult") or 1
                                    if pbEnabled then
                                        pb.animationSpeedMultiplier = origAnim * pbMult
                                        pb.durationSpeedMultiplier = origDur * pbMult
                                    else
                                        pb.animationSpeedMultiplier = origAnim
                                        pb.durationSpeedMultiplier = origDur
                                    end
                                end
                                break
                            end
                        end
                    end
                    table.clear(gcList)
                end)
            end
            isScanningGc = false
        end
        local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            activeKillerController = nil
            cachedIsKiller = false
            lastKillerChar = nil
            gcScanCountForChar = 0
            lastGcScanChar = newChar
            for _, delayTime in ipairs({ 1.2, 3.0 }) do
                task.delay(delayTime, function()
                    if LocalPlayer and LocalPlayer.Character == newChar and isPlayerActiveKiller() then
                        pcall(applyBreakPalletSpeed, true)
                    end
                end)
            end
        end)
        table.insert(Hypnosis.Connections, charAddedConn)
        task.spawn(function()
            while not Hypnosis._Unloaded and not Hypnosis._Teleporting do
                task.wait(2.5)
                if Hypnosis._Unloaded or Hypnosis._Teleporting then
                    break
                end
                local isEnabled = (Hypnosis.Settings["Break Pallet/Generator Speed_Enabled"] == true)
                if isEnabled and LocalPlayer and LocalPlayer.Character then
                    local char = LocalPlayer.Character
                    if char ~= lastGcScanChar then
                        lastGcScanChar = char
                        gcScanCountForChar = 0
                    end
                    local needsScan = false
                    if
                        not activeKillerController
                        or activeKillerController.character ~= char
                        or not activeKillerController.state
                    then
                        needsScan = true
                    elseif activeKillerController and type(activeKillerController.palletBreak) == "table" then
                        local pb = activeKillerController.palletBreak
                        local mult = tonumber(Hypnosis.Settings["Break Pallet/Generator Speed_Speed Multiplier"]) or 2.0
                        mult = math.clamp(mult, 1.0, 10.0)
                        if pb.durationSpeedMultiplier ~= mult then
                            needsScan = true
                        end
                    end
                    if needsScan and gcScanCountForChar < 3 and isPlayerActiveKiller() then
                        gcScanCountForChar = gcScanCountForChar + 1
                        pcall(applyBreakPalletSpeed, true)
                    end
                end
            end
        end)
        if LocalPlayer.Character and isPlayerActiveKiller() then
            pcall(applyBreakPalletSpeed, true)
        end

        function Hypnosis.ToggleBreakSpeed(state)
            UpdateSetting("Break Pallet/Generator Speed_Enabled", state)
            pcall(applyBreakPalletSpeed, true)
        end

        function Hypnosis.UpdateBreakSpeedMultiplier(val)
            UpdateSetting("Break Pallet/Generator Speed_Speed Multiplier", val)
            pcall(applyBreakPalletSpeed, false)
        end
    end

    function Hypnosis.InitNameSpoofer()
        local trackedLabels = setmetatable({}, { __mode = "k" })
        local labelConnections = setmetatable({}, { __mode = "k" })
        local isUpdatingText = false

        local function isHypnosisUI(obj)
            if not obj then
                return true
            end
            if ScreenGui and (obj == ScreenGui or obj:IsDescendantOf(ScreenGui)) then
                return true
            end
            if
                Hypnosis.GhostContainer
                and (obj == Hypnosis.GhostContainer or obj:IsDescendantOf(Hypnosis.GhostContainer))
            then
                return true
            end
            return false
        end

        local function escapePattern(str)
            if not str or str == "" then
                return ""
            end
            return (str:gsub("([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1"))
        end

        local function makeBoundedPattern(nameStr)
            if not nameStr or #nameStr < 2 then
                return nil
            end
            local trimmed = nameStr:match("^%s*(.-)%s*$")
            if not trimmed or #trimmed < 2 then
                return nil
            end
            local escaped = escapePattern(trimmed)
            local ci = escaped:gsub("%a", function(c)
                return string.format("[%s%s]", c:lower(), c:upper())
            end)
            local startsWord = trimmed:sub(1, 1):match("%w") ~= nil
            local endsWord = trimmed:sub(-1, -1):match("%w") ~= nil
            local pattern = ci
            if startsWord then
                pattern = "%f[%w]" .. pattern
            end
            if endsWord then
                pattern = pattern .. "%f[%W]"
            end
            return pattern
        end

        local function checkIsKiller(player)
            if not player then
                return false
            end
            if isKiller(player) then
                return true
            end
            local char = player.Character
            if char then
                if char:GetAttribute("Role") == "Killer" or char:GetAttribute("IsKiller") == true then
                    return true
                end
                if
                    char:FindFirstChild("MorphedKiller")
                    or char:FindFirstChild("KillerScript")
                    or char:FindFirstChild("KillerRoot")
                then
                    return true
                end
            end
            if player:GetAttribute("Role") == "Killer" or player:GetAttribute("IsKiller") == true then
                return true
            end
            return false
        end

        local function getActiveTargetPatterns()
            local targetMode = Hypnosis.Settings["Spoof Names_Target Category"] or "All"
            local replacement = Hypnosis.Settings["Spoof Names_Spoofed Name"] or "Champion"
            if replacement == "" then
                replacement = "Champion"
            end
            local customInput = Hypnosis.Settings["Spoof Names_Custom Target"] or ""
            local rawNamesList = {}

            local function addPlayerNames(p)
                if not p then
                    return
                end
                if p.Name and #p.Name >= 2 then
                    table.insert(rawNamesList, p.Name)
                end
                if p.DisplayName and #p.DisplayName >= 2 and p.DisplayName ~= p.Name then
                    table.insert(rawNamesList, p.DisplayName)
                end
            end
            if customInput ~= "" and #customInput >= 2 then
                table.insert(rawNamesList, customInput)
            end
            if targetMode == "All" then
                for _, p in ipairs(Players:GetPlayers()) do
                    addPlayerNames(p)
                end
            elseif targetMode == "Killer" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if checkIsKiller(p) then
                        addPlayerNames(p)
                    end
                end
            elseif targetMode == "Survivors" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if not checkIsKiller(p) then
                        addPlayerNames(p)
                    end
                end
            elseif targetMode:find("%(You%)") then
                addPlayerNames(LocalPlayer)
            else
                local matched = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Name:lower() == targetMode:lower() or p.DisplayName:lower() == targetMode:lower() then
                        addPlayerNames(p)
                        matched = true
                        break
                    end
                end
                if not matched and targetMode ~= "" and targetMode ~= "None" and #targetMode >= 2 then
                    table.insert(rawNamesList, targetMode)
                end
            end
            table.sort(rawNamesList, function(a, b)
                return #a > #b
            end)
            local patterns = {}
            local seenPatterns = {}
            for _, nameStr in ipairs(rawNamesList) do
                local pat = makeBoundedPattern(nameStr)
                if pat and not seenPatterns[pat] then
                    seenPatterns[pat] = true
                    table.insert(patterns, pat)
                end
            end
            return patterns, replacement
        end

        local function substituteText(rawText, targetPatterns, replacement)
            if not rawText or rawText == "" or not targetPatterns or #targetPatterns == 0 then
                return rawText
            end
            local result = rawText
            local placeholders = {}
            local tokenCount = 0
            for _, pat in ipairs(targetPatterns) do
                if pat and pat ~= "" then
                    result = result:gsub(pat, function()
                        tokenCount = tokenCount + 1
                        local token = string.format("\1__SPOOF_%d__\1", tokenCount)
                        placeholders[token] = replacement
                        return token
                    end)
                end
            end
            if tokenCount > 0 then
                for token, rep in pairs(placeholders) do
                    result = result:gsub(token, function()
                        return rep
                    end)
                end
            end
            return result
        end

        local function processTextObject(obj, targetPatterns, rep)
            if not obj or not obj.Parent then
                return
            end
            if isHypnosisUI(obj) then
                return
            end
            if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                return
            end
            if not targetPatterns or not rep then
                targetPatterns, rep = getActiveTargetPatterns()
            end
            if not targetPatterns or #targetPatterns == 0 then
                return
            end
            if trackedLabels[obj] == nil then
                trackedLabels[obj] = obj.Text
            end
            local baseline = trackedLabels[obj] or obj.Text
            local targetText = substituteText(baseline, targetPatterns, rep)
            if obj.Text ~= targetText then
                isUpdatingText = true
                pcall(function()
                    obj.Text = targetText
                end)
                isUpdatingText = false
            end
            if not labelConnections[obj] then
                labelConnections[obj] = obj:GetPropertyChangedSignal("Text"):Connect(function()
                    if isUpdatingText then
                        return
                    end
                    if not isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                        return
                    end
                    if isHypnosisUI(obj) then
                        return
                    end
                    local currentText = obj.Text
                    local currentPats, currentRep = getActiveTargetPatterns()
                    if currentRep and currentRep ~= "" and not currentText:find(currentRep, 1, true) then
                        trackedLabels[obj] = currentText
                    end
                    local newTxt = substituteText(trackedLabels[obj] or obj.Text, currentPats, currentRep)
                    if obj.Text ~= newTxt then
                        isUpdatingText = true
                        pcall(function()
                            obj.Text = newTxt
                        end)
                        isUpdatingText = false
                    end
                end)
            end
        end

        local function sweepContainer(container, targetPatterns, rep)
            if not container or isHypnosisUI(container) then
                return
            end
            targetPatterns = targetPatterns or getActiveTargetPatterns()
            pcall(function()
                for _, desc in ipairs(container:GetDescendants()) do
                    if
                        not isHypnosisUI(desc)
                        and (desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox"))
                    then
                        processTextObject(desc, targetPatterns, rep)
                    end
                end
            end)
        end

        local function runFullSweep()
            if not isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                return
            end
            local targetPatterns, rep = getActiveTargetPatterns()
            if not targetPatterns or #targetPatterns == 0 then
                return
            end
            local spoofGui = isSettingActive("Spoof Names", "PlayerGui & In-Game HUD") ~= false
            local spoofTags = isSettingActive("Spoof Names", "Overhead Nametags") ~= false
            local spoofCore = isSettingActive("Spoof Names", "CoreGui Leaderboard") ~= false
            if spoofGui then
                local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                if pg then
                    sweepContainer(pg, targetPatterns, rep)
                end
            end
            if spoofTags then
                pcall(function()
                    for _, p in ipairs(Players:GetPlayers()) do
                        local char = p.Character
                        if char then
                            for _, desc in ipairs(char:GetDescendants()) do
                                if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                                    sweepContainer(desc, targetPatterns, rep)
                                end
                            end
                        end
                    end
                end)
            end
            if spoofCore then
                pcall(function()
                    for _, child in ipairs(CoreGui:GetChildren()) do
                        if not isHypnosisUI(child) then
                            sweepContainer(child, targetPatterns, rep)
                        end
                    end
                end)
            end
        end

        local function restoreAllOriginalTexts()
            isUpdatingText = true
            for obj, origText in pairs(trackedLabels) do
                if obj and obj.Parent and not isHypnosisUI(obj) then
                    pcall(function()
                        obj.Text = origText
                    end)
                end
            end
            isUpdatingText = false
            trackedLabels = setmetatable({}, { __mode = "k" })
        end
        local pgHooked = nil

        local function hookPlayerGui(pg)
            if not pg or pgHooked == pg then
                return
            end
            pgHooked = pg
            local pgConn = pg.DescendantAdded:Connect(function(desc)
                if not isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                    return
                end
                if isSettingActive("Spoof Names", "PlayerGui & In-Game HUD") == false then
                    return
                end
                if isHypnosisUI(desc) then
                    return
                end
                if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                    task.defer(function()
                        processTextObject(desc)
                    end)
                end
            end)
            table.insert(Hypnosis.Connections, pgConn)
        end
        local existingPg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if existingPg then
            hookPlayerGui(existingPg)
        elseif LocalPlayer then
            table.insert(
                Hypnosis.Connections,
                LocalPlayer.ChildAdded:Connect(function(ch)
                    if ch and ch:IsA("PlayerGui") then
                        hookPlayerGui(ch)
                    end
                end)
            )
        end

        local function hookCharacter(char)
            if not char then
                return
            end
            if
                isSettingActive("Spoof Names", "Spoof Names_Enabled")
                and isSettingActive("Spoof Names", "Overhead Nametags") ~= false
            then
                task.defer(function()
                    for _, desc in ipairs(char:GetDescendants()) do
                        if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                            sweepContainer(desc)
                        end
                    end
                end)
            end
            local charConn = char.DescendantAdded:Connect(function(desc)
                if not isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                    return
                end
                if isSettingActive("Spoof Names", "Overhead Nametags") == false then
                    return
                end
                if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                    task.defer(function()
                        sweepContainer(desc)
                    end)
                elseif desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                    if desc:FindFirstAncestorOfClass("BillboardGui") or desc:FindFirstAncestorOfClass("SurfaceGui") then
                        task.defer(function()
                            processTextObject(desc)
                        end)
                    end
                end
            end)
            table.insert(Hypnosis.Connections, charConn)
        end

        local function hookPlayer(p)
            if not p then
                return
            end
            if p.Character then
                hookCharacter(p.Character)
            end
            local pCharConn = p.CharacterAdded:Connect(hookCharacter)
            table.insert(Hypnosis.Connections, pCharConn)
        end
        for _, p in ipairs(Players:GetPlayers()) do
            hookPlayer(p)
        end
        local pAddedConn = Players.PlayerAdded:Connect(hookPlayer)
        table.insert(Hypnosis.Connections, pAddedConn)
        pcall(function()
            local coreConn = CoreGui.DescendantAdded:Connect(function(desc)
                if not isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                    return
                end
                if isSettingActive("Spoof Names", "CoreGui Leaderboard") == false then
                    return
                end
                if isHypnosisUI(desc) then
                    return
                end
                if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                    task.defer(function()
                        processTextObject(desc)
                    end)
                end
            end)
            table.insert(Hypnosis.Connections, coreConn)
        end)

        function Hypnosis.ToggleNameSpoofer(state)
            if state then
                runFullSweep()
                local targetMode = Hypnosis.Settings["Spoof Names_Target Category"] or "All"
                local rep = Hypnosis.Settings["Spoof Names_Spoofed Name"] or "Champion"
                showNotification(
                    "Name Spoofer Active",
                    string.format("Target '%s' -> '%s' across all UIs.", targetMode, rep),
                    "Info",
                    2.5
                )
            else
                restoreAllOriginalTexts()
                showNotification("Name Spoofer Disabled", "Restored all player names across UIs.", "Info", 2.0)
            end
        end

        function Hypnosis.SetSpooferTargetCategory(cat)
            if isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                restoreAllOriginalTexts()
                runFullSweep()
            end
        end

        function Hypnosis.UpdateCustomSpoofTarget(name)
            if isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                restoreAllOriginalTexts()
                runFullSweep()
            end
        end

        function Hypnosis.UpdateSpoofedName(name)
            if isSettingActive("Spoof Names", "Spoof Names_Enabled") then
                restoreAllOriginalTexts()
                runFullSweep()
            end
        end

        function Hypnosis.RefreshNameSpoofing()
            restoreAllOriginalTexts()
            runFullSweep()
            showNotification("Names Refreshed", "Rescanned and updated all UI name labels.", "Info", 2.0)
        end

        function Hypnosis.ResetNameSpoofing()
            restoreAllOriginalTexts()
            showNotification("Names Reverted", "All spoofed labels restored to original values.", "Info", 2.0)
        end

        function Hypnosis.CleanupNameSpoofer()
            restoreAllOriginalTexts()
            for _, conn in pairs(labelConnections) do
                pcall(function()
                    conn:Disconnect()
                end)
            end
            labelConnections = setmetatable({}, { __mode = "k" })
        end
    end

