                tagLbl.TextSize = tagSz
                tagLbl.TextXAlignment = Enum.TextXAlignment.Right
                table.insert(
                    configItemRefs,
                    { IsAct = isAct, Item = item, Stroke = iStroke, NameLbl = nameLbl, TagLbl = tagLbl }
                )
                item.MouseEnter:Connect(function()
                    if not isAct then
                        Tween(item, { BackgroundColor3 = Palette.HoverBg }, 0.1)
                    end
                end)
                item.MouseLeave:Connect(function()
                    if not isAct then
