                local w, anchor, pos, _, _, _, vp = Hypnosis.ComputeNotifLayoutMetrics()
                local left = (pos.X.Scale * vp.X) + pos.X.Offset - (anchor.X * w)
                local top = (pos.Y.Scale * vp.Y) + pos.Y.Offset - (anchor.Y == 1 and 46 or 0)
                left = math.clamp(math.floor(left + 0.5), 6, math.max(6, vp.X - w - 6))
                top = math.clamp(math.floor(top + 0.5), 6, math.max(6, vp.Y - 46 - 6))
                dragBox.Size = UDim2.new(0, w, 0, 46)
                dragBox.Position = UDim2.new(0, left, 0, top)
            end
