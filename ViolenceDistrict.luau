        local cachedEndAttack = nil

        local function getLocalChargeData(char)
            if not char then
                return false, 0
            end
            local attrCharging = (
                char:GetAttribute("ChargingSpear") == true or char:GetAttribute("SpearCharging") == true
            )
            local attrStart = tonumber(char:GetAttribute("ChargeStartTime") or char:GetAttribute("VeilChargeStart"))
                or 0
            if attrCharging and attrStart > 0 then
                return true, attrStart
            end
            local animScript = char:FindFirstChild("Animations")
            if not animScript then
                return false, 0
            end
            if
                not cachedEndAttack or (typeof(getfenv) == "function" and getfenv(cachedEndAttack).script ~= animScript)
            then
                cachedEndAttack = nil
                if typeof(getgc) == "function" then
                    for _, f in ipairs(getgc()) do
                        if type(f) == "function" and (not islclosure or islclosure(f)) then
                            if
                                debug
                                and debug.info
                                and debug.info(f, "n") == "endAttack"
                                and getfenv(f).script == animScript
                            then
                                cachedEndAttack = f
                                break
                            end
                        end
                    end
                end
            end
            if cachedEndAttack and debug and debug.getupvalues then
                local ok, uvs = pcall(debug.getupvalues, cachedEndAttack)
                if ok and uvs then
                    local isCharging = (uvs[2] == true)
                    local chargeStart = tonumber(uvs[9]) or 0
                    return isCharging, chargeStart
                end
            end
            return false, 0
        end

        local function updateChargeState(char)
            if char ~= ChargeState.LastChar then
                ChargeState.LastChar = char
                ChargeState.IsCharging = false
                ChargeState.RemoteCharging = false
                ChargeState.ChargeStartTime = 0
                ChargeState.RemoteChargeStartTime = 0
                ChargeState.MaxChargeReached = false
                ChargeState.CurrentChargeDuration = SpearConfig.FullChargeTime
            end
            local now = workspace:GetServerTimeNow()
            local isChargingGame, chargeStartGame = getLocalChargeData(char)
            local activeStart = 0
            if isChargingGame and chargeStartGame > 0 then
                activeStart = chargeStartGame
            elseif ChargeState.RemoteCharging and ChargeState.RemoteChargeStartTime > 0 then
                if (now - ChargeState.RemoteChargeStartTime) <= 8.0 then
                    activeStart = ChargeState.RemoteChargeStartTime
                else
                    ChargeState.RemoteCharging = false
                    ChargeState.RemoteChargeStartTime = 0
                end
            end
            if activeStart > 0 then
                if not ChargeState.IsCharging or ChargeState.ChargeStartTime ~= activeStart then
                    ChargeState.IsCharging = true
                    ChargeState.ChargeStartTime = activeStart
                    ChargeState.CurrentChargeDuration = SpearConfig.MinChargeTime
                    ChargeState.MaxChargeReached = false
                end
                local elapsed = math.max(0, now - ChargeState.ChargeStartTime)
                local rawCharge = math.clamp(elapsed, SpearConfig.MinChargeTime, SpearConfig.FullChargeTime)
                if rawCharge > ChargeState.CurrentChargeDuration then
                    ChargeState.CurrentChargeDuration = rawCharge
                end
                if ChargeState.CurrentChargeDuration >= SpearConfig.FullChargeTime then
                    ChargeState.MaxChargeReached = true
                    ChargeState.CurrentChargeDuration = SpearConfig.FullChargeTime
                end
            else
                if ChargeState.IsCharging then
                    ChargeState.IsCharging = false
                    ChargeState.ChargeStartTime = 0
                    ChargeState.MaxChargeReached = false
                end
                ChargeState.CurrentChargeDuration = SpearConfig.FullChargeTime
            end
            return ChargeState.IsCharging, ChargeState.CurrentChargeDuration
        end

        local function createThrowTrail(releasePos, impactPos, duration)
            local distance = (impactPos - releasePos).Magnitude
            if distance < 1.0 then
                return
            end
            local ribbon = Instance.new("Part")
            ribbon.Name = "SpearRibbonTrail"
            ribbon.Anchored = true
            ribbon.CanCollide = false
            ribbon.CanTouch = false
            ribbon.CanQuery = false
            ribbon.CastShadow = false
            ribbon.Material = Enum.Material.SmoothPlastic
            ribbon.Color = Color3.fromRGB(255, 255, 255)
            ribbon.Transparency = 1
            ribbon.Size = Vector3.new(0.02, 0.02, distance)
            ribbon.CFrame = CFrame.lookAt((releasePos + impactPos) * 0.5, impactPos)
            ribbon.Parent = trailFolder
            local enterTween = TweenService:Create(
                ribbon,
                TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                { Transparency = 0.72, Size = Vector3.new(0.22, 0.06, distance) }
            )
            enterTween:Play()
            task.delay(0.65, function()
                if not ribbon.Parent then
                    return
                end
                local exitTween = TweenService:Create(
                    ribbon,
                    TweenInfo.new(0.50, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    { Transparency = 1, Size = Vector3.new(0.01, 0.01, distance) }
                )
                exitTween:Play()
                exitTween.Completed:Connect(function()
                    ribbon:Destroy()
                end)
            end)
        end

        local function getBestRedirectDir()
            local now = tick()
            if SilentAimState.ActiveTarget ~= nil and SilentAimState.CalculatedLaunchDir then
                return SilentAimState.CalculatedLaunchDir
            end
            if SilentAimState.LastValidLaunchDir and (now - SilentAimState.LastValidTime <= 0.6) then
                return SilentAimState.LastValidLaunchDir
            end
            if SilentAimState.RecentThrowDir and (now - SilentAimState.RecentThrowTime <= 0.35) then
                return SilentAimState.RecentThrowDir
            end
            return nil
        end

        local function getReleasePoint(character)
            if not character then
                return nil
            end
            local spearModel = character:FindFirstChild("Spear")
            if spearModel then
                if spearModel:IsA("BasePart") and spearModel.Transparency < 0.5 then
                    return spearModel.Position
                end
                local spearMesh = spearModel:FindFirstChild("Spear") or spearModel:FindFirstChild("SpearHandle")
                if spearMesh and spearMesh:IsA("BasePart") and spearMesh.Transparency < 0.5 then
                    return spearMesh.Position
                end
                for _, desc in ipairs(spearModel:GetDescendants()) do
                    if desc:IsA("BasePart") and desc.Transparency < 0.5 then
                        return desc.Position
                    end
                end
            end
            local cam = workspace.CurrentCamera or Camera
            local vm = cam
                and (cam:FindFirstChild("VM") or cam:FindFirstChild("ViewModel") or cam:FindFirstChild("Viewmodel"))
            if vm then
                local vmSpear = vm:FindFirstChild("Spear") or vm:FindFirstChild("Harpoon")
                if vmSpear then
                    if vmSpear:IsA("BasePart") and vmSpear.Transparency < 0.5 then
                        return vmSpear.Position
                    end
                    local vmPart = vmSpear:FindFirstChildWhichIsA("BasePart", true)
                    if vmPart and vmPart.Transparency < 0.5 then
                        return vmPart.Position
                    end
                end
            end
            local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
            if hand and hand:IsA("BasePart") then
                return hand.Position
            end
            if Camera then
                return Camera.CFrame.Position + Camera.CFrame.LookVector * SpearConfig.SpawnOffset
            end
            return nil
        end
        local pvPredictHooked = false
        local lastPvHookAttempt = 0

        local function ensureProjectilePredictHook()
            if pvPredictHooked then
                return
            end
            local now = os.clock()
            if (now - lastPvHookAttempt) < 1.0 then
                return
            end
            lastPvHookAttempt = now
            pvPredictHooked = true
            pcall(function()
                local mods = ReplicatedStorage:FindFirstChild("Modules")
                local worldMods = mods and mods:FindFirstChild("World")
                local pvMod = worldMods and worldMods:FindFirstChild("ProjectileVisualsClient")
                if not pvMod then
                    pvPredictHooked = false
                    return
                end
                local pv = require(pvMod)
                if not pv or type(pv.predict) ~= "function" then
                    pvPredictHooked = false
                    return
                end
                if pv._hypnosisPredictHooked then
                    return
                end
                pv._hypnosisPredictHooked = true
                local oldPredict = pv.predict
                pv.predict = function(sourceChar, seq, origin, lookVec, chargeTime, piercing, launchTime)
                    if Hypnosis._Unloaded or Hypnosis._Teleporting then
                        return oldPredict(sourceChar, seq, origin, lookVec, chargeTime, piercing, launchTime)
                    end
                    local isLocal = (sourceChar == LocalPlayer.Character)
                    local effectiveLook = lookVec
                    local silentActive = (Hypnosis.Settings["Veil_Enabled"] == true)
                        and (isSettingActive("Veil", "Spear Silent Aim") == true)
                    local silentDir = getBestRedirectDir()
                    if isLocal and silentActive and silentDir then
                        effectiveLook = silentDir
                    end
                    local predictResults = (table.pack or function(...)
                        return { n = select("#", ...), ... }
                    end)(
                        oldPredict(sourceChar, seq, origin, effectiveLook, chargeTime, piercing, launchTime)
                    )
                    if isLocal then
                        task.spawn(function()
                            pcall(function()
                                local releasePos = getReleasePoint(sourceChar)
                                    or (origin + effectiveLook * SpearConfig.SpawnOffset)
                                local pNow = releasePos
                                local vNow = effectiveLook * SpearConfig.Speed
                                local dt = 0.04
                                local finalImpact = pNow + vNow * 1.5
                                local fallbackParams = RaycastParams.new()
                                fallbackParams.FilterType = Enum.RaycastFilterType.Exclude
                                fallbackParams.FilterDescendantsInstances = { sourceChar, trajFolder, trailFolder }
                                for _ = 1, 45 do
                                    local pNext = pNow + vNow * dt + 0.5 * SpearConfig.Gravity * (dt * dt)
                                    vNow = vNow + SpearConfig.Gravity * dt
                                    local ray = workspace:Raycast(pNow, pNext - pNow, fallbackParams)
                                    if ray then
                                        finalImpact = ray.Position
                                        break
                                    end
                                    pNow = pNext
                                end
                                createThrowTrail(releasePos, finalImpact, 1.2)
                            end)
                        end)
                    end
                    return (table.unpack or unpack)(predictResults, 1, predictResults.n)
                end
            end)
        end

