    local function detectExecutor()
        local execFunc = (syn and syn.identify_executor) or identify_executor or identifyexecutor or getexecutorname
        if execFunc then
            local ok, name = pcall(execFunc)
            if ok and name and name ~= "" then
                return tostring(name)
            end
        end
        if syn and syn.request then
            return "Synapse X"
        end
        if Krnl then
            return "Krnl"
        end
        if fluxus then
            return "Fluxus"
        end
        if electron then
            return "Electron"
        end
        if solara then
            return "Solara"
        end
        return "Native / Studio"
    end
