        local mapLbl = Instance.new("TextLabel", bannerFrame)
        mapLbl.Name = "MapLabel"
        mapLbl.Size = UDim2.new(0, 0, 1, 0)
        mapLbl.AutomaticSize = Enum.AutomaticSize.X
        mapLbl.BackgroundTransparency = 1
        mapLbl.Font = Enum.Font.GothamMedium
        mapLbl.RichText = true
        mapLbl.Text = '<font color="#808088">MAP</font> <font color="#FFFFFF">LOBBY</font>'
        mapLbl.TextSize = 10.5
        mapLbl.LayoutOrder = 3
        local sep2 = createSeparator(4)
        local killerLbl = Instance.new("TextLabel", bannerFrame)
        killerLbl.Name = "KillerLabel"
        killerLbl.Size = UDim2.new(0, 0, 1, 0)
        killerLbl.AutomaticSize = Enum.AutomaticSize.X
        killerLbl.BackgroundTransparency = 1
        killerLbl.Font = Enum.Font.GothamMedium
        killerLbl.RichText = true
        killerLbl.Text = '<font color="#808088">KILLER</font> <font color="#FFFFFF">NONE</font>'
        killerLbl.TextSize = 10.5
        killerLbl.LayoutOrder = 5
        local sep3 = createSeparator(6)
        local abilityContainer = Instance.new("Frame", bannerFrame)
        abilityContainer.Name = "Abilities"
        abilityContainer.Size = UDim2.new(0, 0, 1, 0)
        abilityContainer.AutomaticSize = Enum.AutomaticSize.X
        abilityContainer.BackgroundTransparency = 1
        abilityContainer.LayoutOrder = 7
        local aLayout = Instance.new("UIListLayout", abilityContainer)
        aLayout.FillDirection = Enum.FillDirection.Horizontal
        aLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        aLayout.SortOrder = Enum.SortOrder.LayoutOrder
        aLayout.Padding = UDim.new(0, 5)
        local sep4 = createSeparator(8)
        local statsLbl = Instance.new("TextLabel", bannerFrame)
        statsLbl.Name = "StatsLabel"
        statsLbl.Size = UDim2.new(0, 0, 1, 0)
        statsLbl.AutomaticSize = Enum.AutomaticSize.X
        statsLbl.BackgroundTransparency = 1
        statsLbl.Font = Enum.Font.GothamMedium
        statsLbl.RichText = true
        statsLbl.Text =
            '<font color="#808088">FPS</font> <font color="#FFFFFF">60</font>  <font color="#808088">PING</font> <font color="#FFFFFF">50ms</font>'
        statsLbl.TextSize = 10.5
        statsLbl.LayoutOrder = 9
        Hypnosis.RegisterSavedPosition("UI_Pos_StatusBanner", bannerFrame, UDim2.new(0.5, 0, 0, 10))
        Hypnosis.MakeDraggableHud(bannerFrame, nil, { PosKey = "UI_Pos_StatusBanner" })
        local cachedMapTitleLbl = nil
        local lastMapTitleLookup = 0
        local cachedMapName = "Lobby / Voting"
        local cachedMapObj = nil
        local lastMapDetectTick = 0

        local function getMapTitleText()
            if cachedMapTitleLbl and cachedMapTitleLbl.Parent then
                return cachedMapTitleLbl.Text
            end
            local now = os.clock()
            if now - lastMapTitleLookup < 1.0 then
                return nil
            end
            lastMapTitleLookup = now
            local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
            local darkness = pg and pg:FindFirstChild("Darkness")
            local frame = darkness and darkness:FindFirstChild("Frame")
            local mapInfo = frame and frame:FindFirstChild("MapInfo")
            local title = mapInfo and mapInfo:FindFirstChild("MapTitle")
            if title then
                cachedMapTitleLbl = title
                return title.Text
            end
            return nil
        end

        local function detectMapName(now)
            local text = getMapTitleText()
            if text and text ~= "" and text:upper() ~= "NOSTROMO" then
                cachedMapName = text
                lastMapDetectTick = now
                return text
            end
            local map = workspace:FindFirstChild("Map")
            if map ~= cachedMapObj or (now - lastMapDetectTick) >= 2.0 then
                cachedMapObj = map
                lastMapDetectTick = now
                if map then
                    if map:FindFirstChild("HooksMeat", true) then
                        cachedMapName = "Bloodbath Club"
                    elseif map:FindFirstChild("Rooftop", true) then
                        cachedMapName = "Mercy Hospital"
                    else
                        local cur = map:FindFirstChildOfClass("Model") or map:FindFirstChildOfClass("Folder")
                        cachedMapName = cur and cur.Name or "Lobby / Voting"
                    end
                else
                    cachedMapName = "Lobby / Voting"
                end
            end
            return cachedMapName
        end
        local lastStatUpdate = 0
        local fpsCount = 60
        local fpsFrameCount = 0
        local fpsLastTime = os.clock()
        local cachedPills = {}
        local usedPills = {}
        local lastMapMarkup = nil
        local lastKillerMarkup = nil
        local lastStatsMarkup = nil
        local lastBannerKillerName = "None"
        local lastBannerKillerScanTick = 0
        local lastBannerKillerChar = nil
        local lastBannerKillerRef = nil
        local StatsService = game:GetService("Stats")
        local cachedPingItem = nil
        local lastPingLookup = 0

        local function getOrCreatePill(id, text)
            local pill = cachedPills[id]
            if not pill or not pill.frame or not pill.frame.Parent then
                local frame = Instance.new("Frame", abilityContainer)
                frame.Name = "Pill_" .. id
                frame.Size = UDim2.new(0, 0, 0, 18)
                frame.AutomaticSize = Enum.AutomaticSize.X
                frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
                frame.BorderSizePixel = 0
                local pCorner = Instance.new("UICorner", frame)
                pCorner.CornerRadius = UDim.new(0, 3)
                local pStroke = Instance.new("UIStroke", frame)
                pStroke.Color = Color3.fromRGB(42, 42, 50)
                pStroke.Thickness = 0.8
                local pPad = Instance.new("UIPadding", frame)
                pPad.PaddingLeft = UDim.new(0, 6)
                pPad.PaddingRight = UDim.new(0, 6)
                pPad.PaddingTop = UDim.new(0, 2)
                pPad.PaddingBottom = UDim.new(0, 2)
                local lbl = Instance.new("TextLabel", frame)
                lbl.Name = "Text"
                lbl.Size = UDim2.new(0, 0, 1, 0)
                lbl.AutomaticSize = Enum.AutomaticSize.X
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 9.5
                lbl.TextColor3 = Color3.fromRGB(240, 240, 245)
                pill = { frame = frame, label = lbl, stroke = pStroke, lastText = nil, lastVisualState = nil }
                cachedPills[id] = pill
            end
            if pill.lastText ~= text then
                pill.lastText = text
                pill.label.Text = text
            end
            if not pill.frame.Visible then
                pill.frame.Visible = true
            end
            return pill
        end

        local function resolveKillerDisplayName(arch)
            if not arch or arch == "None" or arch == "Killer" then
                return nil
            end
            local kDefs = Hypnosis.KillerDefs or KILLER_DEFS
            local dDef = kDefs and kDefs[arch]
            if not dDef and kDefs then
                local lowArch = string.lower(tostring(arch))
                for k, v in pairs(kDefs) do
                    if string.lower(k) == lowArch then
                        dDef = v
                        break
                    end
                end
            end
            return (dDef and dDef.name) or tostring(arch)
        end
        local bannerUpdateConn = RunService.RenderStepped:Connect(function()
            local isEnabled = Hypnosis.Settings["Status Banner_Enabled"] ~= false
            if not isEnabled then
                if bannerFrame.Visible then
                    bannerFrame.Visible = false
                end
                return
            end
            if not bannerFrame.Visible then
                bannerFrame.Visible = true
            end
            local now = os.clock()
            fpsFrameCount = fpsFrameCount + 1
            if now - fpsLastTime >= 0.5 then
                fpsCount = math.floor(fpsFrameCount / (now - fpsLastTime))
                fpsFrameCount = 0
                fpsLastTime = now
            end
            local showMap = Hypnosis.Settings["Status Banner_Show Map"] ~= false
            if mapLbl.Visible ~= showMap then
                mapLbl.Visible = showMap
                sep1.Visible = showMap
            end
            if showMap then
                local mapStr = detectMapName(now)
                if mapStr ~= lastMapMarkup then
                    lastMapMarkup = mapStr
                    mapLbl.Text =
                        string.format('<font color="#808088">MAP</font> <font color="#FFFFFF">%s</font>', mapStr)
                end
            end
            local showKiller = Hypnosis.Settings["Status Banner_Show Killer"] ~= false
            if killerLbl.Visible ~= showKiller then
                killerLbl.Visible = showKiller
                sep2.Visible = showKiller
            end
            local activeKiller = Hypnosis.ActiveKillerData
            if showKiller then
                local akChar = activeKiller and activeKiller.character or nil
                if
                    activeKiller ~= lastBannerKillerRef
                    or akChar ~= lastBannerKillerChar
                    or (now - lastBannerKillerScanTick) >= 0.75
                then
                    lastBannerKillerRef = activeKiller
                    lastBannerKillerChar = akChar
                    lastBannerKillerScanTick = now
                    local kName = nil
                    if akChar then
                        local dynArch = getKillerArchetype(akChar)
                        kName = resolveKillerDisplayName(dynArch)
                    end
                    if not kName or kName == "None" or kName == "Killer" or kName == "The Killer" then
                        if
                            activeKiller
                            and activeKiller.name
                            and activeKiller.name ~= "The Killer"
                            and activeKiller.name ~= "Killer"
                        then
                            kName = activeKiller.name
                        else
                            for _, p in ipairs(Players:GetPlayers()) do
                                if isKiller(p) then
                                    local c = p.Character or (workspace and workspace:FindFirstChild(p.Name))
                                    local arch = (c and getKillerArchetype(c)) or p:GetAttribute("SelectedKiller")
                                    local resolved = resolveKillerDisplayName(arch)
                                    if resolved then
                                        kName = resolved
                                        break
                                    end
                                end
                            end
                        end
                    end
                    lastBannerKillerName = kName or (activeKiller and activeKiller.name) or "None"
                end
                if lastBannerKillerName ~= lastKillerMarkup then
                    lastKillerMarkup = lastBannerKillerName
                    killerLbl.Text = string.format(
                        '<font color="#808088">KILLER</font> <font color="#FFFFFF">%s</font>',
                        string.upper(lastBannerKillerName)
                    )
                end
            end
            local showAbils = Hypnosis.Settings["Status Banner_Show Ability Cooldowns"] ~= false
            if abilityContainer.Visible ~= showAbils then
                abilityContainer.Visible = showAbils
                sep3.Visible = showAbils
            end
            if showAbils and activeKiller and activeKiller.abilities then
                for k in pairs(usedPills) do
                    usedPills[k] = nil
                end
                for abId, ab in pairs(activeKiller.abilities) do
                    usedPills[abId] = true
                    local state = ab.state or "READY"
                    local pillText
                    local visState = 0
                    if state == "ACTIVE" then
                        visState = 2
                        local rem = math.max(0, (ab.activeEnd or 0) - now)
                        pillText =
                            string.format("%s: ACTIVE (%.1fs)", ab._upperName or string.upper(ab.name or abId), rem)
                    elseif state == "FATIGUE" then
                        local rem = math.max(0, (ab.fatigueEnd or 0) - now)
                        pillText =
                            string.format("%s: FATIGUE (%.1fs)", ab._upperName or string.upper(ab.name or abId), rem)
                    elseif state == "COOLDOWN" then
                        local rem = math.max(0, (ab.cdEnd or 0) - now)
                        local uName = ab._upperName
                        if not uName then
                            uName = string.upper(ab.name or abId)
                            ab._upperName = uName
                        end
                        if ab.maxCharges and ab.maxCharges > 1 then
                            pillText =
                                string.format("%s: %d/%d (%.1fs)", uName, ab.currentCharges or 0, ab.maxCharges, rem)
                        else
                            pillText = string.format("%s: %.1fs", uName, rem)
                        end
                    else
                        visState = 1
                        local uName = ab._upperName
                        if not uName then
                            uName = string.upper(ab.name or abId)
                            ab._upperName = uName
                        end
                        if ab.maxCharges and ab.maxCharges > 1 then
                            pillText = string.format(
                                "%s: %d/%d READY",
                                uName,
                                ab.currentCharges or ab.maxCharges,
                                ab.maxCharges
                            )
                        else
                            pillText = uName .. ": READY"
                        end
                    end
                    if not ab._upperName then
                        ab._upperName = string.upper(ab.name or abId)
                    end
                    local pill = getOrCreatePill(abId, pillText)
                    if pill.lastVisualState ~= visState then
                        pill.lastVisualState = visState
                        if visState == 1 then
                            pill.frame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
                            pill.stroke.Color = Color3.fromRGB(60, 60, 72)
                            pill.label.TextColor3 = Color3.fromRGB(255, 255, 255)
                        elseif visState == 2 then
                            pill.frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                            pill.stroke.Color = Color3.fromRGB(120, 120, 140)
                            pill.label.TextColor3 = Color3.fromRGB(255, 255, 255)
                        else
                            pill.frame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
                            pill.stroke.Color = Color3.fromRGB(34, 34, 40)
                            pill.label.TextColor3 = Color3.fromRGB(160, 160, 170)
                        end
                    end
                end
                for pId, pData in pairs(cachedPills) do
                    if not usedPills[pId] and pData.frame.Visible then
                        pData.frame.Visible = false
                    end
                end
            else
                for _, pData in pairs(cachedPills) do
                    if pData.frame.Visible then
                        pData.frame.Visible = false
                    end
                end
            end
            local showStats = Hypnosis.Settings["Status Banner_Show Performance Stats"] ~= false
            if statsLbl.Visible ~= showStats then
                statsLbl.Visible = showStats
                sep4.Visible = showStats
            end
            if showStats and now - lastStatUpdate >= 0.25 then
                lastStatUpdate = now
                local pingVal = 50
                if (not cachedPingItem or not cachedPingItem.Parent) and (now - lastPingLookup >= 2.0) then
                    lastPingLookup = now
                    local net = StatsService and StatsService:FindFirstChild("Network")
                    local serverStatsItem = net and net:FindFirstChild("ServerStatsItem")
                    cachedPingItem = serverStatsItem and serverStatsItem:FindFirstChild("Data Ping")
                end
                if cachedPingItem then
                    pingVal = math.floor(cachedPingItem:GetValue())
                end
                local statsMarkup = string.format(
                    '<font color="#808088">FPS</font> <font color="#FFFFFF">%d</font>  <font color="#808088">PING</font> <font color="#FFFFFF">%dms</font>',
                    fpsCount,
                    pingVal
                )
                if statsMarkup ~= lastStatsMarkup then
                    lastStatsMarkup = statsMarkup
                    statsLbl.Text = statsMarkup
                end
            end
        end)
        table.insert(Hypnosis.Connections, bannerUpdateConn)

        function Hypnosis.ToggleStatusBanner(state)
            UpdateSetting("Status Banner_Enabled", state)
            bannerFrame.Visible = state
        end
    end

    function Hypnosis.InitMoonwalk()
        local mwActive = false
        local mwFacingDir = nil
        local mwCurrentYaw = nil
        local mwLastBaseX = nil
        local mwLastBaseZ = nil
        local mwLastSacTick = 0
        local mwLastHookRetryTick = 0
        local mwAutoRotateClaimed = false
        local mwLookScriptClaimed = false
        local mwOrigAutoRotate = nil
        local mwNativeFacingSeen = false
        local mwHooksDisposed = false
        local mwSwayPhase = 0
        local mwSwayRamp = 0
        local mwSwayFreqJitter = 1.0
        local mwSwayAmpJitter = 1.0
        local mwSwayJitterTimer = 0
        local mwSwayHalfIdx = -1
        local mwWeaveRad = 0
        local SACModule = nil
        local FacingModule = nil
        local origApplyGroundMovement = nil
        local wrappedApplyGroundMovement = nil
        local origFacingGet = nil
        local wrappedFacingGet = nil
        local vaultList = {}
        local vaultIndex = {}
        local palletList = {}
        local palletIndex = {}

        local function resolveEntryPart(inst)
            if not inst then
                return nil
            end
            if inst:IsA("BasePart") then
                return inst
            end
            if inst:IsA("Model") then
                return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
            end
            return inst:FindFirstChildWhichIsA("BasePart", true)
        end

        local function addTracked(list, idxMap, inst)
            if not inst or idxMap[inst] then
                return
            end
            local entry = { inst = inst, part = resolveEntryPart(inst) }
            local n = #list + 1
            list[n] = entry
            idxMap[inst] = n
        end

        local function removeTracked(list, idxMap, inst)
            local idx = idxMap[inst]
            if not idx then
                return
            end
            local n = #list
            if idx ~= n then
                local lastEntry = list[n]
                list[idx] = lastEntry
                idxMap[lastEntry.inst] = idx
            end
            list[n] = nil
            idxMap[inst] = nil
        end
        pcall(function()
            for _, inst in ipairs(CollectionService:GetTagged("VaultPoint")) do
                addTracked(vaultList, vaultIndex, inst)
            end
            table.insert(
                Hypnosis.Connections,
                CollectionService:GetInstanceAddedSignal("VaultPoint"):Connect(function(inst)
                    addTracked(vaultList, vaultIndex, inst)
                end)
            )
            table.insert(
                Hypnosis.Connections,
                CollectionService:GetInstanceRemovedSignal("VaultPoint"):Connect(function(inst)
                    removeTracked(vaultList, vaultIndex, inst)
                end)
            )
            for _, inst in ipairs(CollectionService:GetTagged("pallet")) do
                addTracked(palletList, palletIndex, inst)
            end
            table.insert(
                Hypnosis.Connections,
                CollectionService:GetInstanceAddedSignal("pallet"):Connect(function(inst)
                    addTracked(palletList, palletIndex, inst)
                end)
            )
            table.insert(
                Hypnosis.Connections,
                CollectionService:GetInstanceRemovedSignal("pallet"):Connect(function(inst)
                    removeTracked(palletList, palletIndex, inst)
                end)
            )
        end)

        local function getEntryPosXZ(entry)
            local part = entry.part
            if part and part.Parent then
                return part.Position
            end
            local inst = entry.inst
            if not inst or not inst.Parent then
                return nil
            end
            local resolved = resolveEntryPart(inst)
            if resolved then
                entry.part = resolved
                return resolved.Position
            end
            if inst:IsA("PVInstance") then
                return inst:GetPivot().Position
            end
            return nil
        end

        local function isNearTrackedObstacle(list, rootPos, radius, checkBrokenPallet)
            local rSq = radius * radius
            local rx, ry, rz = rootPos.X, rootPos.Y, rootPos.Z
            for i = 1, #list do
                local entry = list[i]
                local inst = entry.inst
                if inst and inst.Parent then
                    local skip = false
                    if checkBrokenPallet then
                        if
                            inst:GetAttribute("PalletState") == "Broken"
                            or inst:GetAttribute("BreakthroughSmashed") == true
                            or inst:GetAttribute("PursuitSmashed") == true
                        then
                            skip = true
                        end
                    end
                    if not skip then
                        local pos = getEntryPosXZ(entry)
                        if pos then
                            local dy = pos.Y - ry
                            if dy >= -8 and dy <= 8 then
                                local dx = pos.X - rx
                                local dz = pos.Z - rz
                                if (dx * dx + dz * dz) <= rSq then
                                    return true
                                end
                            end
                        end
                    end
                end
            end
            return false
        end

        local function isNativeActionBlocking(char, hum, hrp, sacSelf)
            if hum.Health <= 0 or hum.PlatformStand or hum.Sit then
                return true
            end
            if CollectionService:HasTag(hrp, "doing action") then
                return true
            end
            if sacSelf then
                if
                    sacSelf.isVaulting
                    or sacSelf.isSliding
                    or sacSelf.isSlideingPallet
                    or sacSelf.isDroppingPallet
                    or sacSelf.isHealingActive
                    or sacSelf.isHealing
                    or sacSelf.isRepairing
                    or sacSelf.isUnhooking
                    or sacSelf.isExiting
                    or sacSelf.isEmoting
                then
                    return true
                end
            end
            local knockedObj = char:FindFirstChild("Knocked")
            if knockedObj then
                if typeof(knockedObj) == "Instance" and knockedObj:IsA("ValueBase") then
                    if knockedObj.Value == true then
                        return true
                    end
                else
                    return true
                end
            end
            if
                char:GetAttribute("IsCarried") == true
                or char:GetAttribute("IsHooked") == true
                or char:GetAttribute("IsUnhooking") == true
                or char:GetAttribute("Ragdolled") == true
                or char:GetAttribute("IsStunned") == true
                or char:GetAttribute("MovementLocked") == true
                or char:GetAttribute("Knocked") == true
                or char:GetAttribute("downed") == true
                or char:GetAttribute("Aiming") == true
                or (
                    LocalPlayer
                    and (
                        LocalPlayer:GetAttribute("downed") == true
                        or LocalPlayer:GetAttribute("hooked") == true
                        or LocalPlayer:GetAttribute("Knocked") == true
                    )
                )
            then
                return true
            end
            if not mwLookScriptClaimed and char:GetAttribute("overridelookscript") == true then
                return true
            end
            return false
        end

        local function releaseMoonwalk(char, hum, hrp, sacSelf)
            local wasActive = mwActive
            mwActive = false
            mwFacingDir = nil
            mwCurrentYaw = nil
            mwSwayPhase = 0
            mwSwayRamp = 0
            mwSwayJitterTimer = 0
            mwSwayHalfIdx = -1
            mwWeaveRad = 0
            if not wasActive and not mwAutoRotateClaimed and not mwLookScriptClaimed then
                return
            end
            local inAction = false
            if hrp and hrp.Parent and CollectionService:HasTag(hrp, "doing action") then
                inAction = true
            end
            if
                sacSelf
                and (sacSelf.isVaulting or sacSelf.isSliding or sacSelf.isSlideingPallet or sacSelf.isDroppingPallet)
            then
                inAction = true
            end
            if mwAutoRotateClaimed then
                mwAutoRotateClaimed = false
                if hum and hum.Parent and hum.Health > 0 and not inAction and not mwNativeFacingSeen then
                    if mwOrigAutoRotate ~= nil then
                        hum.AutoRotate = mwOrigAutoRotate
                    else
                        hum.AutoRotate = true
                    end
                end
                mwOrigAutoRotate = nil
            end
            if mwLookScriptClaimed then
                mwLookScriptClaimed = false
                if char and char.Parent and not inAction and not mwNativeFacingSeen then
                    char:SetAttribute("overridelookscript", false)
                end
            end
        end

        local function canRunMoonwalk(char, hum, hrp, moveVec, sacSelf)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return false
            end
            if not isSettingActive("Moonwalk", "Enabled") then
                return false
            end
            if not char or not char.Parent or not hum or not hum.Parent or not hrp or not hrp.Parent then
                return false
            end
            local cam = workspace.CurrentCamera
            if cam and cam.CameraType == Enum.CameraType.Scriptable then
                return false
            end
            if not isSettingActive("Moonwalk", "Work As Killer") and isKiller(LocalPlayer) then
                return false
            end
            if mwNativeFacingSeen then
                return false
            end
            if isNativeActionBlocking(char, hum, hrp, sacSelf) then
                return false
            end
            if isSettingActive("Moonwalk", "Only While Sprinting") then
                local sprinting = (char:GetAttribute("Sprinting") == true)
                    or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                    or (sacSelf ~= nil and sacSelf.isShiftHeld == true)
                if not sprinting then
                    return false
                end
            end
            local moveMagSq = (moveVec.X * moveVec.X) + (moveVec.Z * moveVec.Z)
            if isSettingActive("Moonwalk", "Movement-Based") and moveMagSq < 0.0025 then
                return false
            end
            local radius = tonumber(Hypnosis.Settings["Moonwalk_Vault Disable Radius"]) or 12
            local rootPos = hrp.Position
            if isSettingActive("Moonwalk", "Disable Near Vaults") then
                if isNearTrackedObstacle(vaultList, rootPos, radius, false) then
                    return false
                end
            end
            if isSettingActive("Moonwalk", "Disable Near Pallets") then
                if isNearTrackedObstacle(palletList, rootPos, radius, true) then
                    return false
                end
            end
            return true
        end

        local function computeDesiredDirAndYaw(hrp, moveVec)
            local mode = tonumber(Hypnosis.Settings["Moonwalk_Direction Mode"]) or 1
            local bx, bz
            if mode == 2 or mode == 3 then
                local cam = workspace.CurrentCamera
                if cam then
                    local camLook = cam.CFrame.LookVector
                    local cx, cz = camLook.X, camLook.Z
                    local cLenSq = cx * cx + cz * cz
                    if cLenSq > 0.0001 then
                        local invLen = 1 / math.sqrt(cLenSq)
                        if mode == 2 then
                            bx = -cx * invLen
                            bz = -cz * invLen
                        else
                            bx = cx * invLen
                            bz = cz * invLen
                        end
                    end
                end
            else
                local mx, mz = moveVec.X, moveVec.Z
                local mLenSq = mx * mx + mz * mz
                if mLenSq > 0.0025 then
                    local invLen = 1 / math.sqrt(mLenSq)
                    bx = -mx * invLen
                    bz = -mz * invLen
                elseif mwLastBaseX and mwLastBaseZ then
                    bx = mwLastBaseX
                    bz = mwLastBaseZ
                else
                    local cam = workspace.CurrentCamera
                    if cam then
                        local camLook = cam.CFrame.LookVector
                        local cx, cz = camLook.X, camLook.Z
                        local cLenSq = cx * cx + cz * cz
                        if cLenSq > 0.0001 then
                            local invLen = 1 / math.sqrt(cLenSq)
                            bx = -cx * invLen
                            bz = -cz * invLen
                        end
                    end
                end
            end
            if not bx or not bz then
                local look = hrp.CFrame.LookVector
                local lx, lz = look.X, look.Z
                local lLenSq = lx * lx + lz * lz
                if lLenSq > 0.0001 then
                    local invLen = 1 / math.sqrt(lLenSq)
                    bx = lx * invLen
                    bz = lz * invLen
                else
                    bx, bz = 0, -1
                end
            end
            mwLastBaseX = bx
            mwLastBaseZ = bz
            local offsetDeg = tonumber(Hypnosis.Settings["Moonwalk_Angle Offset"]) or 0
            if offsetDeg ~= 0 then
                local rad = math.rad(offsetDeg)
                local cosR = math.cos(rad)
                local sinR = math.sin(rad)
                local rx = bx * cosR + bz * sinR
                local rz = -bx * sinR + bz * cosR
                bx, bz = rx, rz
            end
            local targetYaw = math.atan2(-bx, -bz)
            return bx, bz, targetYaw
        end

        local function evalMoonwalkSwayWave(phase)
            local halfCycle = (phase >= math.pi) and -1 or 1
            local u = (phase % math.pi) / math.pi
            local mag
            if u < 0.24 then
                local t = u / 0.24
                local ease = 1 - (1 - t) * (1 - t)
                mag = -0.88 + 1.24 * ease
            elseif u < 0.86 then
                local t = (u - 0.24) / 0.62
                mag = 0.36 + 0.64 * math.sin(t * 1.5707963267948966)
            else
                local t = (u - 0.86) / 0.14
                mag = 1.0 - 0.12 * (1 - math.cos(t * 1.5707963267948966))
            end
            return halfCycle * mag
        end

        local function stepMoonwalk(char, hum, hrp, moveVec, dt, sacSelf)
            if not canRunMoonwalk(char, hum, hrp, moveVec, sacSelf) then
                releaseMoonwalk(char, hum, hrp, sacSelf)
                return false
            end
            if not mwAutoRotateClaimed then
                mwOrigAutoRotate = hum.AutoRotate
                mwAutoRotateClaimed = true
            end
            if hum.AutoRotate ~= false then
                hum.AutoRotate = false
            end
            if isSettingActive("Moonwalk", "Lock Head Look") then
                if char:GetAttribute("overridelookscript") ~= true then
                    char:SetAttribute("overridelookscript", true)
                end
                mwLookScriptClaimed = true
            elseif mwLookScriptClaimed then
                mwLookScriptClaimed = false
                char:SetAttribute("overridelookscript", false)
            end
            local dx, dz, targetYaw = computeDesiredDirAndYaw(hrp, moveVec)
            if not mwCurrentYaw then
                if sacSelf and type(sacSelf.currentYaw) == "number" then
                    mwCurrentYaw = sacSelf.currentYaw
                else
                    local _, currentY, _ = hrp.CFrame:ToEulerAnglesYXZ()
                    mwCurrentYaw = currentY
                end
            end
            local smooth = tonumber(Hypnosis.Settings["Moonwalk_Turn Smoothness"])
            if smooth == nil then
                smooth = 0.30
            end
            local safeDt = math.clamp(dt or 0.016, 0.001, 0.1)
            local nextYaw
            if smooth <= 0.01 then
                nextYaw = targetYaw
            else
                local turnSpeed = 3.5 + ((1 - math.clamp(smooth, 0, 1)) ^ 1.8) * 32
                local alpha = 1 - math.exp(-turnSpeed * safeDt)
                local delta = (targetYaw - mwCurrentYaw + math.pi) % (2 * math.pi) - math.pi
                nextYaw = mwCurrentYaw + delta * alpha
            end
            mwCurrentYaw = nextYaw
            local swayOffsetRad = 0
            mwWeaveRad = 0
            local isMoving = ((moveVec.X * moveVec.X) + (moveVec.Z * moveVec.Z)) >= 0.0025
            local swayAngleDeg = tonumber(Hypnosis.Settings["Moonwalk_A/D Sway Angle"])
            if swayAngleDeg == nil then
                swayAngleDeg = 44
            end
            local swaySpeedHz = tonumber(Hypnosis.Settings["Moonwalk_A/D Sway Speed"])
            if swaySpeedHz == nil then
                swaySpeedHz = 3.9
            end
            local weaveAngleDeg = tonumber(Hypnosis.Settings["Moonwalk_A/D Path Weave"])
            if weaveAngleDeg == nil then
                weaveAngleDeg = 12
            end
            if isSettingActive("Moonwalk", "Legit A/D Sway") and isMoving then
                mwSwayRamp = math.min(1, mwSwayRamp + safeDt * 7.5)
                local twoPi = 6.283185307179586
                mwSwayPhase = mwSwayPhase + safeDt * swaySpeedHz * mwSwayFreqJitter * twoPi
                if mwSwayPhase >= twoPi then
                    mwSwayPhase = mwSwayPhase % twoPi
                end
                local halfIdx = (mwSwayPhase >= math.pi) and 1 or 0
                if halfIdx ~= mwSwayHalfIdx then
                    mwSwayHalfIdx = halfIdx
                    mwSwayFreqJitter = 0.86 + math.random() * 0.32
                    mwSwayAmpJitter = 0.84 + math.random() * 0.28
                end
                local wave = evalMoonwalkSwayWave(mwSwayPhase)
                swayOffsetRad = math.rad(swayAngleDeg) * wave * mwSwayAmpJitter * mwSwayRamp
                if weaveAngleDeg > 0 then
                    mwWeaveRad = math.rad(math.clamp(weaveAngleDeg, 0, 28)) * math.sin(mwSwayPhase - 1.15) * mwSwayRamp
                end
            else
                mwSwayRamp = math.max(0, mwSwayRamp - safeDt * 8.0)
                if mwSwayRamp > 0.001 then
                    local wave = evalMoonwalkSwayWave(mwSwayPhase)
                    swayOffsetRad = math.rad(swayAngleDeg) * wave * mwSwayAmpJitter * mwSwayRamp
                else
                    mwSwayHalfIdx = -1
                end
            end
            local finalYaw = nextYaw + swayOffsetRad
            mwFacingDir = Vector3.new(-math.sin(finalYaw), 0, -math.cos(finalYaw))
            mwActive = true
            if sacSelf then
                sacSelf.currentYaw = finalYaw
                sacSelf.targetYaw = targetYaw + swayOffsetRad
            end
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, finalYaw, 0)
            return true
        end

        local function isMoonwalkMatchReady()
            if mwHooksDisposed or Hypnosis._Unloaded or Hypnosis._Teleporting then
                return false
            end
            if not isInActiveGameTeam(LocalPlayer) then
                return false
            end
            local workAsKiller = isSettingActive("Moonwalk", "Work As Killer")
            if not workAsKiller and isKiller(LocalPlayer) then
                return false
            end
            local char = LocalPlayer and LocalPlayer.Character
            if not char or not char.Parent then
                return false
            end
            if
                char:FindFirstChild("SurvivorScript")
                or char:FindFirstChild("SurvivorRoot")
                or char:FindFirstChild("CheckInterractable")
            then
                return true
            end
            if
                workAsKiller
                and (
                    char:FindFirstChild("KillerScript")
                    or char:FindFirstChild("MorphedKiller")
                    or char:FindFirstChild("KillerRoot")
                )
            then
                return true
            end
            return false
        end

        local function uninstallHooks()
            if FacingModule and wrappedFacingGet and FacingModule.get == wrappedFacingGet and origFacingGet then
                FacingModule.get = origFacingGet
            end
            if
                SACModule
                and wrappedApplyGroundMovement
                and SACModule._applyGroundMovement == wrappedApplyGroundMovement
                and origApplyGroundMovement
            then
                SACModule._applyGroundMovement = origApplyGroundMovement
            end
        end

        local function tryInstallHooks()
            if mwHooksDisposed then
                return true
            end
            if not isMoonwalkMatchReady() then
                return false
            end
            local modulesFolder = ReplicatedStorage:FindFirstChild("Modules")
            local survivorsFolder = modulesFolder and modulesFolder:FindFirstChild("Survivors")
            if not survivorsFolder then
                return false
            end
            if not FacingModule then
                local facingScript = survivorsFolder:FindFirstChild("SurvivorFacing")
                if facingScript then
                    local ok, mod = pcall(require, facingScript)
                    if ok and type(mod) == "table" and type(mod.get) == "function" then
                        FacingModule = mod
                    end
                end
            end
            if FacingModule and type(FacingModule.get) == "function" then
                if not FacingModule._hypnosisMwOrigGet then
                    FacingModule._hypnosisMwOrigGet = FacingModule.get
                end
                origFacingGet = FacingModule._hypnosisMwOrigGet
                if not wrappedFacingGet then
                    wrappedFacingGet = function(root)
                        local nativeDir = origFacingGet(root)
                        local char = LocalPlayer and LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if hrp and root == hrp then
                            mwNativeFacingSeen = (nativeDir ~= nil)
                        end
                        if nativeDir ~= nil then
                            return nativeDir
                        end
                        if
                            not mwHooksDisposed
                            and not Hypnosis._Unloaded
                            and not Hypnosis._Teleporting
                            and isSettingActive("Moonwalk", "Enabled")
                            and isInActiveGameTeam(LocalPlayer)
                            and mwFacingDir
                            and hrp
                            and root == hrp
                        then
                            return mwFacingDir
                        end
                        return nil
                    end
                end
                if FacingModule.get ~= wrappedFacingGet then
                    FacingModule.get = wrappedFacingGet
                end
            end
            if not SACModule then
                local sacScript = survivorsFolder:FindFirstChild("SurvivorAnimationsController")
                if sacScript then
                    local ok, mod = pcall(require, sacScript)
                    if ok and type(mod) == "table" and type(mod._applyGroundMovement) == "function" then
                        SACModule = mod
                    end
                end
            end
            if SACModule and type(SACModule._applyGroundMovement) == "function" then
                if not SACModule._hypnosisMwOrigApply then
                    SACModule._hypnosisMwOrigApply = SACModule._applyGroundMovement
                end
                origApplyGroundMovement = SACModule._hypnosisMwOrigApply
                if not wrappedApplyGroundMovement then
                    wrappedApplyGroundMovement = function(self, intentDir, dt)
                        if
                            mwHooksDisposed
                            or Hypnosis._Unloaded
                            or Hypnosis._Teleporting
                            or not isSettingActive("Moonwalk", "Enabled")
                            or not isInActiveGameTeam(LocalPlayer)
                        then
                            return origApplyGroundMovement(self, intentDir, dt)
                        end
                        local appliedIntent = intentDir
                        local mwApplied = false
                        local char = LocalPlayer and LocalPlayer.Character
                        if char and self and self.character == char then
                            local hum = self.humanoid
                            local hrp = self.humanoidRootPart
                            if hum and hrp then
                                mwLastSacTick = os.clock()
                                mwApplied = stepMoonwalk(char, hum, hrp, intentDir or Vector3.new(0, 0, 0), dt, self)
                            end
                        end
                        if mwApplied and appliedIntent and mwWeaveRad ~= 0 then
                            local ix, iy, iz = appliedIntent.X, appliedIntent.Y, appliedIntent.Z
                            if (ix * ix + iz * iz) > 0.0025 then
                                local c = math.cos(mwWeaveRad)
                                local s = math.sin(mwWeaveRad)
                                appliedIntent = Vector3.new(ix * c + iz * s, iy, -ix * s + iz * c)
                            end
                        end
                        return origApplyGroundMovement(self, appliedIntent, dt)
                    end
                end
                if SACModule._applyGroundMovement ~= wrappedApplyGroundMovement then
                    SACModule._applyGroundMovement = wrappedApplyGroundMovement
                end
            end
            return (FacingModule ~= nil and SACModule ~= nil)
        end
        table.insert(
            Hypnosis.Connections,
            RunService.RenderStepped:Connect(function(dt)
                if Hypnosis._Unloaded or Hypnosis._Teleporting then
                    uninstallHooks()
                    local char = LocalPlayer and LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    releaseMoonwalk(char, hum, hrp, nil)
                    return
                end
                local char = LocalPlayer and LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not isSettingActive("Moonwalk", "Enabled") then
                    uninstallHooks()
                    if mwActive or mwAutoRotateClaimed or mwLookScriptClaimed then
                        releaseMoonwalk(char, hum, hrp, nil)
                    end
                    mwNativeFacingSeen = false
                    return
                end
                local now = os.clock()
                if isMoonwalkMatchReady() then
                    local hooksAttached = (FacingModule and FacingModule.get == wrappedFacingGet)
                        and (SACModule and SACModule._applyGroundMovement == wrappedApplyGroundMovement)
                    if not hooksAttached and (now - mwLastHookRetryTick) >= 1.5 then
                        mwLastHookRetryTick = now
                        tryInstallHooks()
                    end
                else
                    uninstallHooks()
                end
                if (now - mwLastSacTick) <= 0.05 then
                    return
                end
                mwNativeFacingSeen = false
                if not char or not hum or not hrp then
                    releaseMoonwalk(char, hum, hrp, nil)
                    return
                end
                stepMoonwalk(char, hum, hrp, hum.MoveDirection, dt, nil)
            end)
        )
        table.insert(
            Hypnosis.Connections,
            LocalPlayer.CharacterAdded:Connect(function()
                uninstallHooks()
                mwActive = false
                mwFacingDir = nil
                mwCurrentYaw = nil
                mwLastBaseX = nil
                mwLastBaseZ = nil
                mwLastSacTick = 0
                mwSwayPhase = 0
                mwSwayRamp = 0
                mwSwayJitterTimer = 0
                mwSwayHalfIdx = -1
                mwWeaveRad = 0
                mwAutoRotateClaimed = false
                mwLookScriptClaimed = false
                mwOrigAutoRotate = nil
                mwNativeFacingSeen = false
            end)
        )

        function Hypnosis.ToggleMoonwalk(state)
            UpdateSetting("Moonwalk_Enabled", state)
            if state then
                if isMoonwalkMatchReady() then
                    tryInstallHooks()
                end
                if showNotification then
                    showNotification("Moonwalk", "Moonwalk enabled.", "success", 2.0)
                end
            else
                uninstallHooks()
                local char = LocalPlayer and LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
