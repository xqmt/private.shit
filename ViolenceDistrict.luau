    function UI.addInput(parent, placeholder, defaultVal, onFocusLost, customKey)
        local frame = Instance.new("Frame", parent)
        frame.Size = UDim2.new(1, -16, 0, 22)
        frame.Position = UDim2.new(0, 16, 0, 0)
        frame.BackgroundColor3 = Palette.InputBg
        frame.BorderSizePixel = 0
        local fC = Instance.new("UICorner", frame)
        fC.CornerRadius = UDim.new(0, 3)
        local fS = Instance.new("UIStroke", frame)
        fS.Color = Palette.Border
        fS.Thickness = 1
        ThemeBind(frame, "BackgroundColor3", "InputBg")
        ThemeBind(fS, "Color", "Border")
        local box = Instance.new("TextBox", frame)
        box.Size = UDim2.new(1, -12, 1, 0)
        box.Position = UDim2.new(0, 6, 0, 0)
        box.BackgroundTransparency = 1
        box.Font = Enum.Font.GothamMedium
        box.RichText = false
        box.Text = defaultVal or ""
        box.PlaceholderText = placeholder or "Custom Name..."
        box.PlaceholderColor3 = Palette.TextDim
        box.TextColor3 = Palette.TextActive
        box.TextSize = 9
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.ClearTextOnFocus = false
        ThemeBind(box, "PlaceholderColor3", "TextDim")
        ThemeBind(box, "TextColor3", "TextActive")
        ScaleHook("button", function(bs)
            frame.Size = UDim2.new(1, -16, 0, math.floor(22 * bs + 0.5))
            box.TextSize = math.clamp(math.floor(9 * (0.8 + 0.2 * bs) + 0.5), 9, 14)
        end)
        local prefix = (parent and parent.Parent and parent.Parent.Name:match("^Mod_(.+)"))
        local settingKey = customKey or (prefix and (prefix .. "_" .. (placeholder or "CustomName"))) or placeholder
        if settingKey then
            RegisterSetting(settingKey, defaultVal or "", function(v)
                box.Text = tostring(v)
                if onFocusLost then
                    pcall(onFocusLost, box.Text, false)
                end
            end)
        end
        box.FocusLost:Connect(function(enterPressed)
            if settingKey then
                UpdateSetting(settingKey, box.Text)
            end
            if onFocusLost then
                onFocusLost(box.Text, enterPressed)
            end
        end)
        return frame, box
    end

    function UI.addCustomNameInput(parent, placeholder, defaultVal, onFocusLost, customKey)
        return UI.addInput(parent, placeholder, defaultVal, onFocusLost, customKey)
    end
