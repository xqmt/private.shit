    local function recomputePalette()
        local w = ThemeState.WindowBg
        local s = ThemeState.SidebarBg
        local b = ThemeState.ButtonBg
        local bd = ThemeState.Border
        local ac = ThemeState.Accent
        local tm = ThemeState.TextMain
        local td = ThemeState.TextDim
        Palette.WindowBg = w
        Palette.SidebarBg = s
        Palette.ModuleBg = s:Lerp(tm, 0.02)
        Palette.ButtonBg = b
        Palette.HoverBg = b:Lerp(ac, 0.14)
        Palette.Divider = s:Lerp(bd, 0.65)
        Palette.Border = bd
        Palette.BorderActive = bd:Lerp(ac, 0.25)
        Palette.Accent = ac
        Palette.TextActive = tm
        Palette.ButtonText = tm:Lerp(td, 0.25)
        Palette.TextDim = td
        Palette.TextMuted = td:Lerp(s, 0.08)
        Palette.KeybindText = td:Lerp(s, 0.35)
        Palette.TabActive = ac
        Palette.TabHover = td:Lerp(ac, 0.55)
        Palette.TabDim = td:Lerp(s, 0.25)
        Palette.TrackBg = s:Lerp(bd, 0.85)
        Palette.TrackFill = ac:Lerp(b, 0.15)
        Palette.ThumbWhite = ac
        Palette.PopupBg = s:Lerp(w, 0.25)
        Palette.PopupBorder = Palette.BorderActive
        Palette.InputBg = b:Lerp(w, 0.15)
    end

    local function ThemeBind(inst, prop, tokenName)
        if not inst then
            return
        end
        table.insert(themeBindings, { inst = inst, prop = prop, token = tokenName })
        local col = Palette[tokenName]
        if col then
            inst[prop] = col
        end
    end

    local function ThemeHook(fn)
        if type(fn) ~= "function" then
            return
        end
        table.insert(themeCallbacks, fn)
        pcall(fn)
    end

    function Hypnosis.RefreshTheme()
        recomputePalette()
        local alive = {}
        for i = 1, #themeBindings do
            local entry = themeBindings[i]
            local inst = entry.inst
            if inst and inst.Parent then
                local col = Palette[entry.token]
                if col then
                    pcall(function()
                        inst[entry.prop] = col
                    end)
                end
                table.insert(alive, entry)
            end
        end
        themeBindings = alive
        for i = 1, #themeCallbacks do
            pcall(themeCallbacks[i])
        end
    end

    local function ScaleHook(kind, fn)
        local bucket = scaleHooks[kind]
        if not bucket or type(fn) ~= "function" then
            return
        end
        table.insert(bucket, fn)
        local cur = (kind == "button") and ScaleState.Buttons or ScaleState.Toggles
        pcall(fn, cur)
    end

    function Hypnosis.SetButtonScale(scaleVal)
        local num = math.clamp(tonumber(scaleVal) or 1.0, 0.85, 2.00)
        num = math.floor(num * 100 + 0.5) / 100
        ScaleState.Buttons = num
        local list = scaleHooks.button
        for i = 1, #list do
            pcall(list[i], num)
        end
    end

    function Hypnosis.SetToggleScale(scaleVal)
        local num = math.clamp(tonumber(scaleVal) or 1.0, 0.85, 2.00)
        num = math.floor(num * 100 + 0.5) / 100
        ScaleState.Toggles = num
        local list = scaleHooks.toggle
        for i = 1, #list do
            pcall(list[i], num)
        end
    end
