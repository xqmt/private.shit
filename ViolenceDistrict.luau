                end
                if nearestKiller and nearestDist <= targetRadius then
                    local kHrp = nearestKiller:FindFirstChild("HumanoidRootPart")
                        or nearestKiller:FindFirstChild("Torso")
                        or nearestKiller.PrimaryPart
                    if kHrp then
                        local passesFace = true
                        if faceCheck then
                            local toPlayer = myHrp.Position - kHrp.Position
                            local flatToPlayer = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                            if flatToPlayer.Magnitude > 0.05 then
                                flatToPlayer = flatToPlayer.Unit
                                local killerLook =
                                    Vector3.new(kHrp.CFrame.LookVector.X, 0, kHrp.CFrame.LookVector.Z).Unit
                                local dot = math.clamp(killerLook:Dot(flatToPlayer), -1, 1)
                                local angleDeg = math.deg(math.acos(dot))
                                if angleDeg > maxAngle then
                                    passesFace = false
                                end
                            end
                        end
                        if passesFace then
                            killerInRange = true
                        end
                    end
                end
            end
            currentRadius = currentRadius + (targetRadius - currentRadius) * math.clamp(dt * 12, 0, 1)
            local shouldShowRadius = false
            if isVisualActive and isAlive then
                if inRangeVisual then
                    shouldShowRadius = killerInRange
                else
                    shouldShowRadius = true
                end
            end
            local targetAlpha = shouldShowRadius and 0.55 or 0.0
            currentAlpha = currentAlpha + (targetAlpha - currentAlpha) * math.clamp(dt * 7, 0, 1)
            if currentAlpha > 0.005 and isAlive then
                local curCam = workspace.CurrentCamera or Camera
                if curCam and radiusAdornment.Parent ~= curCam then
                    radiusAdornment.Parent = curCam
                end
                radiusAdornment.Visible = true
                radiusAdornment.Adornee = myHrp
                radiusAdornment.CFrame = CFrame.new(0, -2.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
                radiusAdornment.Radius = currentRadius
                radiusAdornment.InnerRadius = math.max(0, currentRadius - 0.3)
                local radColor = getRadiusColor()
                radiusAdornment.Color3 = radColor
                radiusAdornment.Transparency = 1 - currentAlpha
            else
                if radiusAdornment.Visible then
                    radiusAdornment.Visible = false
                end
            end
            if not isEnabled or not isAlive then
                return
            end
            if not nearestKiller or nearestDist > currentRadius then
                return
            end
            local kHrp = nearestKiller:FindFirstChild("HumanoidRootPart")
                or nearestKiller:FindFirstChild("Torso")
                or nearestKiller.PrimaryPart
            local kHum = nearestKiller:FindFirstChildOfClass("Humanoid")
            if not kHrp or not kHum or kHum.Health <= 0 then
                return
            end
            if faceCheck then
                local toPlayer = myHrp.Position - kHrp.Position
                local flatToPlayer = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                if flatToPlayer.Magnitude > 0.05 then
                    flatToPlayer = flatToPlayer.Unit
                    local killerLook = Vector3.new(kHrp.CFrame.LookVector.X, 0, kHrp.CFrame.LookVector.Z).Unit
                    local dot = math.clamp(killerLook:Dot(flatToPlayer), -1, 1)
                    local angleDeg = math.deg(math.acos(dot))
                    if angleDeg > maxAngle then
                        return
                    end
                end
            end
            local kAnimator = kHum:FindFirstChildOfClass("Animator")
            if kAnimator and not monitoredAnimators[kAnimator] then
                monitoredAnimators[kAnimator] = true
                local aConn = kAnimator.AnimationPlayed:Connect(function(track)
                    if isAttackTrack(track) and canParry(myChar, myHum, myHrp) then
                        local curDist = (kHrp.Position - myHrp.Position).Magnitude
                        if curDist <= currentRadius then
                            executeParry(myChar, myHum, myHrp, kHrp.Position)
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, aConn)
            end
            if canParry(myChar, myHum, myHrp) then
                local isAttacking = false
                if kAnimator then
                    for _, track in ipairs(kAnimator:GetPlayingAnimationTracks()) do
                        if isAttackTrack(track) then
                            isAttacking = true
                            break
                        end
                    end
                end
                if not isAttacking then
                    if
                        nearestKiller:GetAttribute("Attacking") == true
                        or nearestKiller:GetAttribute("m1") == true
                        or nearestKiller:GetAttribute("M1") == true
                        or nearestKiller:GetAttribute("m2") == true
                        or nearestKiller:GetAttribute("M2") == true
                        or nearestKiller:GetAttribute("Slash") == true
                        or nearestKiller:GetAttribute("Slashing") == true
                        or nearestKiller:GetAttribute("Swing") == true
                        or nearestKiller:GetAttribute("AbysswalkerSlashViewmodelLevel") == true
                        or nearestKiller:GetAttribute("Lunge") == true
                        or nearestKiller:GetAttribute("Lunging") == true
                        or nearestKiller:GetAttribute("HeavyAttacking") == true
                    then
                        isAttacking = true
                    end
                end
                if isAttacking then
                    executeParry(myChar, myHum, myHrp, kHrp.Position)
                end
            end
        end)
        table.insert(Hypnosis.Connections, parryConn)
    end

    function Hypnosis.InitRiotShield()
        local shieldConn = RunService.RenderStepped:Connect(function()
            if isKiller(LocalPlayer) then
                return
            end

            local isEnabled = (Hypnosis.Settings["Riot Shield_Enabled"] == true)
            if not isEnabled then
                return
            end
            local enhancedSteer = isSettingActive("Riot Shield", "Enhanced Steering") ~= false
            local speedMult = tonumber(Hypnosis.Settings["Riot Shield_Rush Speed Multiplier"]) or 1.00
            local char = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
            local hum = char and char:FindFirstChildWhichIsA("Humanoid")
            if not char or not hrp or not hum or hum.Health <= 0 then
                return
            end
            local rushVel = hrp:FindFirstChild("RushVelocity")
            if rushVel and rushVel:IsA("LinearVelocity") then
                if enhancedSteer or speedMult > 1.001 then
                    local curCam = workspace.CurrentCamera or Camera
                    local camCF = curCam and curCam.CFrame or CFrame.new()
                    local camLook = camCF.LookVector
                    local flatCamLook = Vector3.new(camLook.X, 0, camLook.Z)
                    local moveDir = hum.MoveDirection
                    local targetDir = nil
                    if moveDir.Magnitude > 0.1 then
                        targetDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
                    elseif flatCamLook.Magnitude > 0.01 then
                        targetDir = flatCamLook.Unit
                    end
                    if targetDir then
                        local currentMag = rushVel.VectorVelocity.Magnitude
                        local baseSpeed = math.max(currentMag, 10)
                        local finalSpeed = baseSpeed * math.clamp(speedMult, 1.00, 1.20)
                        if enhancedSteer then
                            rushVel.VectorVelocity = targetDir * finalSpeed
                            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + targetDir)
                        elseif speedMult > 1.001 and currentMag > 0.5 then
                            local currentDir = rushVel.VectorVelocity.Unit
                            rushVel.VectorVelocity = currentDir * finalSpeed
                        end
                    end
                end
            end
        end)
        table.insert(Hypnosis.Connections, shieldConn)

        function Hypnosis.ToggleRiotShield(state)
            UpdateSetting("Riot Shield_Enabled", state)
        end
    end

    function Hypnosis.InitAbysswalkerAutoDodge()
        local VirtualInputManager = nil
        pcall(function()
            VirtualInputManager = game:GetService("VirtualInputManager")
        end)
        local ContextActionService = game:GetService("ContextActionService")
        local radiusAdornment = Instance.new("CylinderHandleAdornment")
        radiusAdornment.Name = "Hypnosis_AbysswalkerRadius"
        radiusAdornment.Height = 0.08
        radiusAdornment.Color3 = Color3.fromRGB(255, 255, 255)
        radiusAdornment.Transparency = 1
        radiusAdornment.ZIndex = 5
        radiusAdornment.AlwaysOnTop = false
        radiusAdornment.Visible = false
        pcall(function()
            radiusAdornment.Parent = workspace.CurrentCamera or Camera
        end)
        Hypnosis.DodgeRing = radiusAdornment
        local currentAlpha = 0.0
        local currentRadius = 28.0
        local isCrouching = false
        local lastDodgeTick = 0

        local function getRadiusColor()
            local cv = Hypnosis.Settings["Abysswalker_Radius Color_Color"]
            if typeof(cv) == "Color3" then
                return cv
            end
            if type(cv) == "table" and #cv >= 3 then
                return Color3.new(cv[1], cv[2], cv[3])
            end
            return Color3.fromRGB(255, 255, 255)
        end

        local function triggerCrouch(state)
            local char = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            local hum = char and char:FindFirstChildWhichIsA("Humanoid")
            pcall(function()
                if char and hum then
                    char:SetAttribute("Crouching", state)
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    local changeAtt = remotes
                        and remotes:FindFirstChild("Mechanics")
                        and remotes.Mechanics:FindFirstChild("ChangeAttribute")
                    if changeAtt then
                        changeAtt:FireServer("Crouchingserver", state)
                    end
                    if state then
                        local runEvent = remotes
                            and remotes:FindFirstChild("Chase")
                            and remotes.Chase:FindFirstChild("Runevent")
                        if runEvent then
                            runEvent:FireServer(char, false)
                        end
                        char:SetAttribute("Sprinting", false)
                    end
                    hum:ChangeState(Enum.HumanoidStateType.Landed)
                end
            end)
            pcall(function()
                local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                local mobGui = pGui and pGui:FindFirstChild("Survivor-mob")
                local controls = mobGui and (mobGui:FindFirstChild("Controls") or mobGui)
                local crouchBtn = controls and (controls:FindFirstChild("crouch") or controls:FindFirstChild("Crouch"))
                if crouchBtn and crouchBtn:IsA("GuiButton") then
                    local cPos = crouchBtn.AbsolutePosition + (crouchBtn.AbsoluteSize * 0.5)
                    if state then
                        pcall(function()
                            crouchBtn.MouseButton1Down:Fire(cPos.X, cPos.Y)
                        end)
                        pcall(function()
                            crouchBtn.MouseButton1Click:Fire()
                        end)
                    else
                        pcall(function()
                            crouchBtn.MouseButton1Up:Fire(cPos.X, cPos.Y)
                        end)
                    end
                end
            end)
            pcall(function()
                if VirtualInputManager then
                    VirtualInputManager:SendKeyEvent(state, Enum.KeyCode.C, false, game)
                    VirtualInputManager:SendKeyEvent(state, Enum.KeyCode.LeftControl, false, game)
                    VirtualInputManager:SendKeyEvent(state, Enum.KeyCode.ButtonB, false, game)
                end
            end)
            pcall(function()
                local uState = state and Enum.UserInputState.Begin or Enum.UserInputState.End
                ContextActionService:CallFunction("crouch", uState, nil)
                ContextActionService:CallFunction("Crouch", uState, nil)
            end)
        end

        local function performDodge(duration)
            if isCrouching then
                return
            end
            isCrouching = true
            lastDodgeTick = tick()
            triggerCrouch(true)
            task.delay(duration, function()
                triggerCrouch(false)
                isCrouching = false
            end)
        end
        local cachedKillerChar = nil
        local lastKillerFindTick = 0

        local function findKiller()
            local now = tick()
            if cachedKillerChar and cachedKillerChar.Parent and (now - lastKillerFindTick) < 0.5 then
                return cachedKillerChar
            end
            lastKillerFindTick = now
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and isKiller(p) then
                    local c = p.Character or workspace:FindFirstChild(p.Name)
                    if c and c.Parent then
                        cachedKillerChar = c
                        return c
                    end
                end
            end
            local kFolder = workspace:FindFirstChild("Killers")
            if kFolder then
                for _, child in ipairs(kFolder:GetChildren()) do
                    if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
                        cachedKillerChar = child
                        return child
                    end
                end
            end
            for _, c in ipairs(workspace:GetChildren()) do
                if c:FindFirstChild("MorphedKiller") or (c:IsA("Model") and c.Name == "Killer") then
                    cachedKillerChar = c
                    return c
                end
            end
            cachedKillerChar = nil
            return nil
        end
        local monitoredAnimators = {}
        local dodgeConn = RunService.RenderStepped:Connect(function(dt)
            if isKiller(LocalPlayer) or false then
                if radiusAdornment.Visible then
                    radiusAdornment.Visible = false
                end
                currentAlpha = 0.0
                return
            end
            local mainEnabled = (Hypnosis.Settings["Abysswalker_Enabled"] == true)

            if not mainEnabled then
                if radiusAdornment.Visible then
                    radiusAdornment.Visible = false
                end
                currentAlpha = 0.0
                return
            end
            local isEnabled = isSettingActive("Abysswalker", "Auto Dodge") == true
            local targetRadius = tonumber(Hypnosis.Settings["Abysswalker_Dodge Radius"]) or 28
            local isVisualActive = isSettingActive("Abysswalker", "Visualize Radius") == true
            local dodgeDuration = tonumber(Hypnosis.Settings["Abysswalker_Dodge Duration"]) or 0.8
            local radColor = getRadiusColor()
            local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
            local myHum = myChar and myChar:FindFirstChildWhichIsA("Humanoid")
            local isAlive = myChar and myHrp and myHum and (myHum.Health > 0) and not isKiller(LocalPlayer)
            currentRadius = currentRadius + (targetRadius - currentRadius) * math.clamp(dt * 12, 0, 1)
            local targetAlpha = (isVisualActive and isAlive) and 0.55 or 0.0
            currentAlpha = currentAlpha + (targetAlpha - currentAlpha) * math.clamp(dt * 7, 0, 1)
            if currentAlpha > 0.005 and isAlive then
                local curCam = workspace.CurrentCamera or Camera
                if curCam and radiusAdornment.Parent ~= curCam then
                    radiusAdornment.Parent = curCam
                end
                radiusAdornment.Visible = true
                radiusAdornment.Adornee = myHrp
                radiusAdornment.CFrame = CFrame.new(0, -2.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
                radiusAdornment.Radius = currentRadius
                radiusAdornment.InnerRadius = math.max(0, currentRadius - 0.3)
                radiusAdornment.Color3 = radColor
                radiusAdornment.Transparency = 1 - currentAlpha
            else
                radiusAdornment.Visible = false
            end
            if not isEnabled or not isAlive then
                return
            end
            local kChar = findKiller()
            if not kChar then
                return
            end
            local kHrp = kChar:FindFirstChild("HumanoidRootPart") or kChar:FindFirstChild("Torso") or kChar.PrimaryPart
            local kHum = kChar:FindFirstChildWhichIsA("Humanoid")
            if not kHrp or not kHum or kHum.Health <= 0 then
                return
            end
            local dist = (kHrp.Position - myHrp.Position).Magnitude
            if dist > currentRadius then
                return
            end
            local kAnimator = kHum:FindFirstChildOfClass("Animator")
            if kAnimator and not monitoredAnimators[kAnimator] then
                monitoredAnimators[kAnimator] = true
                local pConn = kAnimator.AnimationPlayed:Connect(function(track)
                    local id = track.Animation and track.Animation.AnimationId or ""
                    if string.find(id, "100014992013740") or track.Name == "slash" then
                        if (tick() - lastDodgeTick) > 1.8 then
                            local curDist = (kHrp.Position - myHrp.Position).Magnitude
                            if curDist <= currentRadius then
                                performDodge(dodgeDuration)
                            end
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, pConn)
            end
            if (tick() - lastDodgeTick) > 1.8 then
                local isSlashing = false
                if kAnimator then
                    for _, track in ipairs(kAnimator:GetPlayingAnimationTracks()) do
                        local id = track.Animation and track.Animation.AnimationId or ""
                        if string.find(id, "100014992013740") or track.Name == "slash" then
                            isSlashing = true
                            break
                        end
                    end
                end
                if not isSlashing and kChar:GetAttribute("AbysswalkerSlashViewmodelLevel") == true then
                    isSlashing = true
                end
                if isSlashing then
                    performDodge(dodgeDuration)
                end
            end
        end)
        table.insert(Hypnosis.Connections, dodgeConn)
    end

