            AccentBar.BackgroundColor3 = accentCol
            AccentBar.BackgroundTransparency = 1
            AccentBar.BorderSizePixel = 0
            AccentBar.ZIndex = 203
            local barCorner = Instance.new("UICorner", AccentBar)
            barCorner.CornerRadius = UDim.new(1, 0)
            local TitleLbl = Instance.new("TextLabel", ToastCard)
            TitleLbl.Size = UDim2.new(1, -44, 0, 14)
            TitleLbl.Position = UDim2.new(0, 20, 0, 9)
