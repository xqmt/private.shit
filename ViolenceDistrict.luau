        local function refreshKillerChars()
            local cure, abyss, hidden = nil, nil, nil
            for _, pl in ipairs(Players:GetPlayers()) do
                local c = pl.Character
                if c then
                    local morphed = c:GetAttribute("MorphedKiller")
                    if morphed == "Cure" or c:GetAttribute("Cure") == true or c:FindFirstChild("Flask") then
                        cure = c
                    elseif morphed == "Abysswalker" or c:GetAttribute("Abysswalker") == true then
                        abyss = c
                    elseif morphed == "TheHidden" or morphed == "Hidden" or c:GetAttribute("Hidden") == true then
                        hidden = c
                    end
                end
            end
            if not cure or not abyss or not hidden then
                for _, child in ipairs(workspace:GetChildren()) do
                    if child:IsA("Model") then
                        local morphed = child:GetAttribute("MorphedKiller")
                        if
                            not cure
                            and (
                                morphed == "Cure"
                                or child:GetAttribute("Cure") == true
                                or child:FindFirstChild("Flask")
                            )
                        then
                            cure = child
                        elseif
                            not abyss and (morphed == "Abysswalker" or child:GetAttribute("Abysswalker") == true)
                        then
                            abyss = child
                        elseif
                            not hidden
                            and (morphed == "TheHidden" or morphed == "Hidden" or child:GetAttribute("Hidden") == true)
                        then
                            hidden = child
                        end
                    end
                end
            end
            cachedCureChar = cure
            cachedAbyssChar = abyss
            cachedHiddenChar = hidden
        end

        local function ensureKillerCharCache()
            local now = tick()
            local invalidated = (cachedCureChar and not cachedCureChar.Parent)
                or (cachedAbyssChar and not cachedAbyssChar.Parent)
                or (cachedHiddenChar and not cachedHiddenChar.Parent)
            if invalidated or (now - lastCharScan) >= 1.5 then
                lastCharScan = now
                refreshKillerChars()
            end
        end

        local function getCureCharacter()
            ensureKillerCharCache()
            return cachedCureChar
        end

        local function getAbysswalkerCharacter()
            ensureKillerCharCache()
            return cachedAbyssChar
        end

        local function getHiddenCharacter()
            ensureKillerCharCache()
            return cachedHiddenChar
        end

        local function parseColor3(val, fallback)
            if typeof(val) == "Color3" then
                return val
            end
            if type(val) == "table" and #val >= 3 then
                local r = tonumber(val[1]) or 1
                local g = tonumber(val[2]) or 1
                local b = tonumber(val[3]) or 1
                if r > 1 or g > 1 or b > 1 then
                    return Color3.fromRGB(r, g, b)
                end
                return Color3.new(r, g, b)
            end
            return fallback or Color3.fromRGB(255, 255, 255)
        end
        local cureSegments = {}
        local cureMarker = nil
        local FT = nil

        local function clearBottleTrajectory()
            for _, seg in ipairs(cureSegments) do
                if seg and seg.Parent then
                    seg:Destroy()
                end
            end
            table.clear(cureSegments)
            if cureMarker and cureMarker.Parent then
                cureMarker:Destroy()
                cureMarker = nil
            end
        end

        local function displayBottleTrajectory(points, color)
            if not points or #points < 2 then
                clearBottleTrajectory()
                return
            end
            local numNeeded = #points - 1
            for i = 1, numNeeded do
                local seg = cureSegments[i]
                if not seg or not seg.Parent then
                    seg = Instance.new("LineHandleAdornment")
                    seg.Name = "CureSeg_" .. i
                    seg.Adornee = workspace.Terrain
                    seg.Thickness = 3.5
                    seg.AlwaysOnTop = true
                    seg.ZIndex = 5
                    seg.Parent = cureFolder
                    cureSegments[i] = seg
                end
                local p1 = points[i]
                local p2 = points[i + 1]
                local dist = (p2 - p1).Magnitude
                seg.Length = dist
                seg.Color3 = color
                seg.Visible = dist > 0.01
                if dist > 0.01 then
                    seg.CFrame = CFrame.lookAt(p1, p2)
                end
            end
            for i = numNeeded + 1, #cureSegments do
                if cureSegments[i] and cureSegments[i].Parent then
                    cureSegments[i]:Destroy()
                end
                cureSegments[i] = nil
            end
            local lastPt = points[#points]
            if not cureMarker or not cureMarker.Parent then
                local marker = Instance.new("SphereHandleAdornment")
                marker.Name = "CureImpactMarker"
                marker.Adornee = workspace.Terrain
                marker.Radius = 0.65
                marker.AlwaysOnTop = true
                marker.ZIndex = 6
                marker.Parent = cureFolder
                cureMarker = marker
            end
            cureMarker.CFrame = CFrame.new(lastPt)
            cureMarker.Color3 = color
            cureMarker.Visible = true
        end

        local function isCurePreparingFlask(char)
            if not char or not char.Parent then
                return false
            end
            local flask = char:FindFirstChild("Flask")
                or (char:FindFirstChild("Weapon") and char.Weapon:FindFirstChild("Flask"))
            if flask then
                local main = flask:FindFirstChild("main")
                    or flask:FindFirstChild("FallbackFlask")
                    or flask.PrimaryPart
                    or flask:FindFirstChildWhichIsA("BasePart")
                if main and main:IsA("BasePart") and main.Transparency < 0.5 then
                    return true
                end
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local anim = hum and hum:FindFirstChildOfClass("Animator")
            if anim then
                for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                    local animObj = track.Animation
                    local animId = animObj and animObj.AnimationId or ""
                    if
                        animId:find("121108316060822")
                        or animId:find("79390410596403")
                        or animId:find("99210996402874")
                        or animId:find("134502209203983")
                        or animId:find("112368965487482")
                        or animId:find("80719429000028")
                    then
                        return true
                    end
                end
            end
            return false
        end
