    local function getRequestFunction()
        return (syn and syn.request)
            or (http and http.request)
            or http_request
            or (fluxus and fluxus.request)
            or request
    end

    local function decryptPayloadXor(hexStr, keyStr)
        local bit32 = bit32
        if not bit32 or not bit32.bxor then
            return nil
        end
        local bxor = bit32.bxor
        local bytes = {}
        local keyLen = #keyStr
        if keyLen == 0 then
            return nil
        end
        for i = 1, #hexStr, 2 do
            local hexByte = hexStr:sub(i, i + 1)
            local charCode = tonumber(hexByte, 16)
            if not charCode then
                return nil
            end
            local kIdx = (#bytes % keyLen) + 1
            local keyChar = string.byte(keyStr, kIdx)
            table.insert(bytes, string.char(bxor(charCode, keyChar)))
        end
        return table.concat(bytes)
    end

    local function parseTimestampToEpoch(str)
        if type(str) == "number" then
            return str
        end
        if type(str) ~= "string" then
            return nil
        end
        local y, m, d, h, min, s = str:match("(%d%d%d%d)[%-%/](%d%d?)[%-%/](%d%d?)[%sT](%d%d?):(%d%d?)")
        if not (y and m and d) then
            y, m, d = str:match("(%d%d%d%d)[%-%/](%d%d?)[%-%/](%d%d?)")
            h, min, s = 0, 0, 0
        end
        if not (y and m and d) then
            return nil
        end
        local now = os.time()
        local utcDate = os.date("!*t", now)
        local localDate = os.date("*t", now)
        local offset = os.time(localDate) - os.time(utcDate)
        local targetLocal = os.time({
            year = tonumber(y),
            month = tonumber(m),
            day = tonumber(d),
            hour = tonumber(h) or 0,
            min = tonumber(min) or 0,
            sec = tonumber(s) or 0,
        })
        return targetLocal + offset
    end

