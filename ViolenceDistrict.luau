            local prevState = bindData.GetActive and bindData.GetActive()
            local seqBefore = Hypnosis._NotifCount or 0
            bindData.Toggle()
            local newState = bindData.GetActive and bindData.GetActive()
            local seqAfter = Hypnosis._NotifCount or 0
            local settings = Hypnosis.Settings or {}
            if
                settings["Notifications_KeybindAlerts"] ~= false
                and prevState ~= nil
                and newState ~= nil
                and prevState ~= newState
                and seqAfter == seqBefore
            then
                local featName = tostring(bindData.DisplayName or bindData.Name or "Feature")
                local tagKey = "kb:" .. tostring(bindData.SettingKey or bindData.Name or featName)
                local msgText = newState and "Enabled via keybind." or "Disabled via keybind."
                showNotification(featName, msgText, newState and "success" or "info", nil, tagKey)
            end
            if Hypnosis.RefreshFeatureOverlays then
                pcall(Hypnosis.RefreshFeatureOverlays)
            end
