        Hypnosis.SyncHudPositionsToSettings()
        local targetCfg = ConfigManager.Configs[ConfigManager.Active]
        for k in pairs(targetCfg) do
            if Hypnosis.IsBlockedHudPosKey(k) or (Hypnosis.IsDynamicPosKey(k) and Hypnosis.Settings[k] == nil) then
                targetCfg[k] = nil
            end
        end
        for k, v in pairs(Hypnosis.Settings) do
            if not Hypnosis.IsBlockedHudPosKey(k) then
                targetCfg[k] = v
            end
        end
