        ConfigManager.AutoSave = false
        pcall(function()
            local del = delfile or (syn and syn.delfile)
            local isf = isfile or (syn and syn.isfile)
            if del and isf then
                if isf(CONFIGS_FILE) then
                    del(CONFIGS_FILE)
                end
                if isf(CONFIG_FILE) then
                    del(CONFIG_FILE)
                end
            end
        end)
        ConfigManager.Configs = { ["Default"] = {} }
        ConfigManager._PendingPremiumConfigs = {}
        Hypnosis._UserModifiedSettings = {}
        ConfigManager.Active = "Default"
        ConfigManager.SurvivorConfig = nil
        ConfigManager.KillerConfig = nil
        for k in pairs(Hypnosis.Settings) do
            if Hypnosis.DefaultSettings[k] == nil then
                Hypnosis.Settings[k] = nil
            end
        end
        for k, defVal in pairs(Hypnosis.DefaultSettings) do
            local resetVal = defVal

            Hypnosis.Settings[k] = resetVal
            local setter = Hypnosis.Setters[k]
            if setter then
                pcall(setter, resetVal)
            end
        end
        if Hypnosis.SetMenuToggleKey then
            pcall(Hypnosis.SetMenuToggleKey, Hypnosis.DefaultSettings["Menu_ToggleKey"] or "K")
        end
        Hypnosis.ApplySavedHudPositions()
        ConfigManager.AutoSave = prevAutoSave
        ConfigManager.PersistToDisk()
        if Hypnosis.RebuildMobileKeybinds then
            pcall(Hypnosis.RebuildMobileKeybinds)
        end
        if Hypnosis.RefreshConfigsUI then
            pcall(Hypnosis.RefreshConfigsUI)
        end
        showNotification("Configs", "Factory reset complete. All settings restored to default.", "warning")
    end
