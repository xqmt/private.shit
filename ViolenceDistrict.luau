    function UI.addSlider(parent, labelText, minVal, maxVal, defaultVal, isFloat, callback, customKey, opts)
        opts = opts or {}
        local step = opts.step or (isFloat and 0.01 or 1)
        local snapStep = opts.snapStep
        local relToVal = opts.relToVal
        local valToRel = opts.valToRel

        local function formatSliderVal(num)
            if isFloat then
                return string.format("%.2f", num)
            end
            return tostring(math.floor(num + 0.5))
        end

        local function normalizeSliderVal(num, applySnap)
            local clamped = math.clamp(num, minVal, maxVal)
            if applySnap and snapStep and snapStep > 0 then
                clamped = math.clamp(math.floor(clamped / snapStep + 0.5) * snapStep, minVal, maxVal)
            end
            if isFloat then
                clamped = math.floor(clamped * 1000 + 0.5) / 1000
            else
                clamped = math.floor(clamped + 0.5)
            end
            return math.clamp(clamped, minVal, maxVal)
        end

        local function mapRelToVal(rel)
            rel = math.clamp(rel, 0, 1)
            if relToVal then
                return relToVal(rel)
            end
            return minVal + (rel * (maxVal - minVal))
        end

        local function mapValToRel(val)
            if valToRel then
                return math.clamp(valToRel(val), 0, 1)
            end
            local span = maxVal - minVal
            if span == 0 then
                return 0
            end
            return math.clamp((val - minVal) / span, 0, 1)
        end
        local s = Instance.new("Frame", parent)
        s.Size = UDim2.new(1, 0, 0, 24)
        s.Position = UDim2.new(0, 0, 0, 0)
        s.BackgroundTransparency = 1
        local titleLbl = Instance.new("TextLabel", s)
        titleLbl.Size = UDim2.new(0.60, 0, 0, 12)
        titleLbl.BackgroundTransparency = 1
        titleLbl.Font = Enum.Font.GothamMedium
        titleLbl.RichText = true
        titleLbl.Text = Italic(labelText)
        titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
        titleLbl.TextColor3 = Palette.TextDim
        titleLbl.TextSize = 9
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left
        ThemeBind(titleLbl, "TextColor3", "TextDim")
        local valWrap = Instance.new("Frame", s)
        valWrap.Size = UDim2.new(0.40, 0, 0, 12)
        valWrap.Position = UDim2.new(0.60, 0, 0, 0)
        valWrap.BackgroundTransparency = 1
        local valLayout = Instance.new("UIListLayout", valWrap)
        valLayout.FillDirection = Enum.FillDirection.Horizontal
        valLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        valLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        valLayout.SortOrder = Enum.SortOrder.LayoutOrder
        valLayout.Padding = UDim.new(0, 2)
        local decBtn = Instance.new("TextButton", valWrap)
        decBtn.LayoutOrder = 1
        decBtn.Size = UDim2.new(0, 11, 1, 0)
        decBtn.BackgroundTransparency = 1
        decBtn.AutoButtonColor = false
        decBtn.Font = Enum.Font.GothamBold
        decBtn.Text = "-"
        decBtn.TextColor3 = Palette.TextMuted
        decBtn.TextSize = 10
        ThemeBind(decBtn, "TextColor3", "TextMuted")
        local valLbl = Instance.new("TextButton", valWrap)
        valLbl.LayoutOrder = 2
        valLbl.Size = UDim2.new(0, 0, 1, 0)
        valLbl.AutomaticSize = Enum.AutomaticSize.X
        valLbl.BackgroundTransparency = 1
        valLbl.AutoButtonColor = false
        valLbl.Font = Enum.Font.GothamMedium
        valLbl.RichText = true
        valLbl.Text = Italic(formatSliderVal(defaultVal))
        valLbl.TextColor3 = Palette.TextActive
        valLbl.TextSize = 9
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        ThemeBind(valLbl, "TextColor3", "TextActive")
        local valBox = Instance.new("TextBox", valWrap)
        valBox.LayoutOrder = 3
        valBox.Visible = false
        valBox.Size = UDim2.new(0, 34, 1, 0)
        valBox.BackgroundColor3 = Palette.ButtonBg
        valBox.BorderSizePixel = 0
        valBox.ClearTextOnFocus = false
        valBox.Font = Enum.Font.GothamMedium
        valBox.Text = formatSliderVal(defaultVal)
        valBox.TextColor3 = Palette.TextActive
        valBox.TextSize = 9
        valBox.TextXAlignment = Enum.TextXAlignment.Right
        local vbC = Instance.new("UICorner", valBox)
        vbC.CornerRadius = UDim.new(0, 2)
        ThemeBind(valBox, "BackgroundColor3", "ButtonBg")
        ThemeBind(valBox, "TextColor3", "TextActive")
        local incBtn = Instance.new("TextButton", valWrap)
        incBtn.LayoutOrder = 4
        incBtn.Size = UDim2.new(0, 11, 1, 0)
        incBtn.BackgroundTransparency = 1
        incBtn.AutoButtonColor = false
        incBtn.Font = Enum.Font.GothamBold
        incBtn.Text = "+"
        incBtn.TextColor3 = Palette.TextMuted
        incBtn.TextSize = 10
        ThemeBind(incBtn, "TextColor3", "TextMuted")
        local track = Instance.new("Frame", s)
        track.Size = UDim2.new(1, 0, 0, 2)
        track.Position = UDim2.new(0, 0, 0, 16)
        track.BackgroundColor3 = Palette.TrackBg
        track.BorderSizePixel = 0
        ThemeBind(track, "BackgroundColor3", "TrackBg")
        local currentPct = mapValToRel(defaultVal)
        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new(currentPct, 0, 1, 0)
        fill.BackgroundColor3 = Palette.TrackFill
        fill.BorderSizePixel = 0
        ThemeBind(fill, "BackgroundColor3", "TrackFill")
        local thumb = Instance.new("Frame", track)
        thumb.Size = UDim2.new(0, 5, 0, 5)
        thumb.AnchorPoint = Vector2.new(0.5, 0.5)
        thumb.Position = UDim2.new(currentPct, 0, 0.5, 0)
        thumb.BackgroundColor3 = Palette.ThumbWhite
        thumb.BorderSizePixel = 0
        local thC = Instance.new("UICorner", thumb)
        thC.CornerRadius = UDim.new(1, 0)
        ThemeBind(thumb, "BackgroundColor3", "ThumbWhite")
        local hitZone = Instance.new("TextButton", track)
        hitZone.Name = "DragHitZone"
        hitZone.AnchorPoint = Vector2.new(0.5, 0.5)
        hitZone.Position = UDim2.new(0.5, 0, 0.5, 0)
        hitZone.Size = UDim2.new(1, 0, 0, 14)
        hitZone.BackgroundTransparency = 1
        hitZone.Text = ""
        hitZone.AutoButtonColor = false
        hitZone.ZIndex = track.ZIndex + 1
        local prefix = (parent and parent.Parent and parent.Parent.Name:match("^Mod_(.+)"))
        local settingKey = customKey or (prefix and (prefix .. "_" .. labelText)) or labelText
        local currentNum = normalizeSliderVal(defaultVal, false)
        local currentRel = mapValToRel(currentNum)
        local isDrag = false
        local dragTrackX = nil
        local dragTrackW = nil
        local lastPointerX = nil

        local function commitValue(newNum, visualRel, useTween)
            currentNum = newNum
            currentRel = math.clamp(visualRel or mapValToRel(newNum), 0, 1)
            if useTween then
                Tween(fill, { Size = UDim2.new(currentRel, 0, 1, 0) }, 0.07)
                Tween(thumb, { Position = UDim2.new(currentRel, 0, 0.5, 0) }, 0.07)
            else
                fill.Size = UDim2.new(currentRel, 0, 1, 0)
                thumb.Position = UDim2.new(currentRel, 0, 0.5, 0)
            end
            valLbl.Text = Italic(formatSliderVal(currentNum))
            UpdateSetting(settingKey, currentNum)
            UpdateSetting(labelText, currentNum)
            if callback then
                callback(currentNum)
            end
        end

        local function SmoothUpdate(inp, isInitialClick)
            local tX = dragTrackX or track.AbsolutePosition.X
            local tW = dragTrackW or math.max(1, track.AbsoluteSize.X)
            local fineHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
            local rel
            if (not isInitialClick) and fineHeld and lastPointerX ~= nil then
                rel = math.clamp(currentRel + (((inp.Position.X - lastPointerX) / tW) * 0.2), 0, 1)
            else
                rel = math.clamp((inp.Position.X - tX) / tW, 0, 1)
            end
            lastPointerX = inp.Position.X
            local targetVal = normalizeSliderVal(mapRelToVal(rel), true)
            local dispRel = snapStep and mapValToRel(targetVal) or rel
            commitValue(targetVal, dispRel, true)
        end
        RegisterSetting(settingKey, defaultVal, function(v)
            local numV = tonumber(v)
            if numV == nil then
                numV = defaultVal
            end
            currentNum = normalizeSliderVal(numV, false)
            currentRel = mapValToRel(currentNum)
            fill.Size = UDim2.new(currentRel, 0, 1, 0)
            thumb.Position = UDim2.new(currentRel, 0, 0.5, 0)
            valLbl.Text = Italic(formatSliderVal(currentNum))
            if labelText ~= settingKey then
                Hypnosis.Settings[labelText] = currentNum
            end
            if callback then
                callback(currentNum)
            end
        end)
        if labelText ~= settingKey and Hypnosis.Settings[labelText] == nil then
            Hypnosis.Settings[labelText] = currentNum
        end

        local function nudgeSlider(delta)
            local raw = currentNum + delta
            local aligned = math.floor(raw / step + 0.5) * step
            local targetVal = normalizeSliderVal(aligned, false)
            commitValue(targetVal, mapValToRel(targetVal), true)
        end
        decBtn.MouseEnter:Connect(function()
            decBtn.TextColor3 = Palette.TextActive
        end)
        decBtn.MouseLeave:Connect(function()
            decBtn.TextColor3 = Palette.TextMuted
        end)
        incBtn.MouseEnter:Connect(function()
            incBtn.TextColor3 = Palette.TextActive
        end)
        incBtn.MouseLeave:Connect(function()
            incBtn.TextColor3 = Palette.TextMuted
        end)
        decBtn.MouseButton1Click:Connect(function()
            nudgeSlider(-step)
        end)
        incBtn.MouseButton1Click:Connect(function()
            nudgeSlider(step)
        end)
        valLbl.MouseButton1Click:Connect(function()
            valBox.Text = formatSliderVal(currentNum)
            valLbl.Visible = false
            valBox.Visible = true
            valBox:CaptureFocus()
        end)
        valBox.FocusLost:Connect(function(enterPressed)
            local txt = valBox.Text
            valBox.Visible = false
            valLbl.Visible = true
            local parsed = tonumber(txt)
            if parsed ~= nil then
                local targetVal = normalizeSliderVal(parsed, false)
                commitValue(targetVal, mapValToRel(targetVal), true)
            end
        end)
        hitZone.InputBegan:Connect(function(inp)
            if
                inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch
            then
                isDrag = true
                dragTrackX = track.AbsolutePosition.X
                dragTrackW = math.max(1, track.AbsoluteSize.X)
                lastPointerX = inp.Position.X
                SmoothUpdate(inp, true)
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if
                inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch
            then
                isDrag = false
                dragTrackX = nil
                dragTrackW = nil
                lastPointerX = nil
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if
                isDrag
                and (
                    inp.UserInputType == Enum.UserInputType.MouseMovement
                    or inp.UserInputType == Enum.UserInputType.Touch
                )
            then
                SmoothUpdate(inp, false)
            end
        end)
        ScaleHook("toggle", function(ts)
            local rowH = math.floor(24 * (0.8 + 0.2 * ts) + 0.5)
            local lblH = math.floor(12 * (0.85 + 0.15 * ts) + 0.5)
            local txtSz = math.clamp(math.floor(9 * (0.8 + 0.2 * ts) + 0.5), 9, 13)
            local stepW = math.clamp(math.floor(11 * (0.85 + 0.15 * ts) + 0.5), 10, 18)
            s.Size = UDim2.new(1, 0, 0, rowH)
            titleLbl.Size = UDim2.new(0.60, 0, 0, lblH)
            valWrap.Size = UDim2.new(0.40, 0, 0, lblH)
            valWrap.Position = UDim2.new(0.60, 0, 0, 0)
            titleLbl.TextSize = txtSz
            valLbl.TextSize = txtSz
            valBox.TextSize = txtSz
            valBox.Size = UDim2.new(0, math.clamp(math.floor(34 * (0.85 + 0.15 * ts) + 0.5), 30, 52), 1, 0)
            decBtn.Size = UDim2.new(0, stepW, 1, 0)
            incBtn.Size = UDim2.new(0, stepW, 1, 0)
            decBtn.TextSize = math.clamp(txtSz + 1, 10, 14)
            incBtn.TextSize = math.clamp(txtSz + 1, 10, 14)
            track.Position = UDim2.new(0, 0, 0, math.floor(rowH * 0.67 + 0.5))
            hitZone.Size = UDim2.new(1, 0, 0, math.floor(14 * ts + 0.5))
        end)
        return s
    end

