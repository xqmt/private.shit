        local function registerFlaskZone(child)
            if not child or not child.Parent then
                return
            end
            if child.Name == "FlaskZone" and child:IsA("BasePart") and not activeCloudAdorns[child] then
                local cloudEnabled = isSettingActive("The Cure", "Poison Cloud Hitbox") ~= false
                local cloudCol =
                    parseColor3(Hypnosis.Settings["The Cure_Cloud Color_Color"], Color3.fromRGB(80, 220, 60))
                local cloudTransp = (tonumber(Hypnosis.Settings["The Cure_Cloud Transparency (%)"]) or 85) / 100
                local radius = child:GetAttribute("HazardRadius") or (child.Size.X / 2)
                if radius <= 0 then
                    radius = 12
                end
                local adorn = Instance.new("SphereHandleAdornment")
                adorn.Name = "CloudVisual"
                adorn.Adornee = child
                adorn.Radius = radius
                adorn.Color3 = cloudCol
                adorn.Transparency = cloudTransp
                adorn.AlwaysOnTop = true
                adorn.ZIndex = 3
                adorn.Visible = cloudEnabled
                adorn.Parent = cureFolder
                local conn
                conn = child.AncestryChanged:Connect(function(_, parent)
                    if not parent then
                        if conn then
                            conn:Disconnect()
                        end
                        if adorn and adorn.Parent then
                            adorn:Destroy()
                        end
                        activeCloudAdorns[child] = nil
                    end
                end)
                activeCloudAdorns[child] = { adorn = adorn, conn = conn }
            end
        end
