        Hypnosis.MakeDraggableHud(overlayBar, nil, { PosKey = "UI_Pos_FlowstateOverlay" })
        local flowstateCooldownEnd = 0
        local flowstateActiveEnd = 0
        local wasVaulting = false
        local lastBarStatus = ""
        local lastBarColor = nil
        local lastBarWidth = -1
        local lastHkStatus = ""
        local lastHkColor = nil
        local lastDesiredFlowstate = nil
        local searchRoots = { "climb_obsessing", "climb_collisoning", "climb_collisioning", "climb_colliding" }

        local function clearFlowstateAttributes()
            lastDesiredFlowstate = nil
            pcall(function()
                LocalPlayer:SetAttribute("Flowstate", nil)
            end)
            local char = LocalPlayer.Character
            if char then
                pcall(function()
                    char:SetAttribute("Flowstate", nil)
                end)
            end
            local direct = workspace:FindFirstChild(LocalPlayer.Name)
            if direct and direct:IsA("Model") and direct ~= char then
                pcall(function()
                    direct:SetAttribute("Flowstate", nil)
                end)
            end
            for _, rootName in ipairs(searchRoots) do
                local root = workspace:FindFirstChild(rootName)
                if root then
                    local climbModel = root:FindFirstChild(LocalPlayer.Name)
                    if climbModel and climbModel:IsA("Model") then
                        pcall(function()
                            climbModel:SetAttribute("Flowstate", nil)
                        end)
                    end
                end
            end
        end

        local function detectIsVaulting(char)
            if not char then
                return false
            end
            local checkInteract = char:FindFirstChild("CheckInterractable")
            if checkInteract then
                if
                    checkInteract:GetAttribute("isVaulting") == true
                    or checkInteract:GetAttribute("isSliding") == true
                then
                    return true
                end
            end
            if char:GetAttribute("isVaulting") == true or LocalPlayer:GetAttribute("isVaulting") == true then
                return true
            end
            for _, rootName in ipairs(searchRoots) do
                local root = workspace:FindFirstChild(rootName)
                if root and root:FindFirstChild(LocalPlayer.Name) then
                    return true
                end
            end
            return false
        end
        local conn = RunService.RenderStepped:Connect(function()
            local isEnabled = isSettingActive("Flowstate", "Flowstate_Enabled")
            if not isEnabled then
                if overlayBar.Visible then
                    overlayBar.Visible = false
                end
                Hypnosis.FlowstateLiveStatus = nil
                return
            end
            if isKiller(LocalPlayer) then
                if overlayBar.Visible then
                    overlayBar.Visible = false
                end
                Hypnosis.FlowstateLiveStatus = nil
                clearFlowstateAttributes()
                return
            end
            local char = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            local hum = char and char:FindFirstChildWhichIsA("Humanoid")
            local isAlive = char and hum and hum.Health > 0
            if not isAlive then
                if overlayBar.Visible then
                    overlayBar.Visible = false
                end
                Hypnosis.FlowstateLiveStatus = nil
                return
            end
            local isVaulting = detectIsVaulting(char)
            local now = tick()
            if isVaulting and not wasVaulting then
                if now >= flowstateCooldownEnd then
                    local customCd = tonumber(Hypnosis.Settings["Flowstate_Cooldown"]) or 15
                    flowstateActiveEnd = now + 0.55
                    flowstateCooldownEnd = now + customCd
                end
            end
            wasVaulting = isVaulting
            local onCooldown = (now < flowstateCooldownEnd)
            local duringActiveVault = (now < flowstateActiveEnd)
            local desiredFlowstate = duringActiveVault or not onCooldown
            if lastDesiredFlowstate ~= desiredFlowstate then
                lastDesiredFlowstate = desiredFlowstate
                if LocalPlayer:GetAttribute("Flowstate") ~= desiredFlowstate then
                    pcall(function()
                        LocalPlayer:SetAttribute("Flowstate", desiredFlowstate)
                    end)
                end
                if char:GetAttribute("Flowstate") ~= desiredFlowstate then
                    pcall(function()
                        char:SetAttribute("Flowstate", desiredFlowstate)
                    end)
                end
                local direct = workspace:FindFirstChild(LocalPlayer.Name)
                if direct and direct:IsA("Model") and direct ~= char then
                    if direct:GetAttribute("Flowstate") ~= desiredFlowstate then
                        pcall(function()
                            direct:SetAttribute("Flowstate", desiredFlowstate)
                        end)
                    end
                end
                for _, rootName in ipairs(searchRoots) do
                    local root = workspace:FindFirstChild(rootName)
                    if root then
                        local climbModel = root:FindFirstChild(LocalPlayer.Name)
                        if climbModel and climbModel:IsA("Model") then
                            if climbModel:GetAttribute("Flowstate") ~= desiredFlowstate then
                                pcall(function()
                                    climbModel:SetAttribute("Flowstate", desiredFlowstate)
                                end)
                            end
                        end
                    end
                end
            end
            local showOverlay = isSettingActive("Flowstate", "Cooldown Overlay") ~= false
            if showOverlay then
                local overlayType = tonumber(Hypnosis.Settings["Flowstate_Overlay Type"]) or 1
                local isKeybinds = (overlayType == 2)
                if isKeybinds then
                    if overlayBar.Visible then
                        overlayBar.Visible = false
                    end
                else
                    if not overlayBar.Visible then
                        overlayBar.Visible = true
                    end
                end
                local stateText = "READY"
                local stateColor = Color3.fromRGB(255, 255, 255)
                local fillFrac = 1.0
                if now < flowstateActiveEnd then
                    stateText = "ACTIVE"
                    stateColor = Color3.fromRGB(255, 255, 255)
                    fillFrac = 1.0
                elseif now < flowstateCooldownEnd then
                    local customCd = tonumber(Hypnosis.Settings["Flowstate_Cooldown"]) or 15
                    local remaining = flowstateCooldownEnd - now
                    fillFrac = math.clamp(1 - (remaining / math.max(1, customCd)), 0, 1)
                    stateText = string.format("%.1fs", remaining)
                    stateColor = Color3.fromRGB(180, 180, 185)
                end
                Hypnosis.FlowstateLiveStatus = stateText
                Hypnosis.FlowstateLiveColor = stateColor
                if not isKeybinds then
                    if lastBarStatus ~= stateText then
                        lastBarStatus = stateText
                        barStatusLbl.Text = stateText
                    end
                    if lastBarColor ~= stateColor then
                        lastBarColor = stateColor
                        barStatusLbl.TextColor3 = stateColor
                        barFill.BackgroundColor3 = stateColor
                    end
                    local roundedWidth = math.floor(fillFrac * 100) / 100
                    if lastBarWidth ~= roundedWidth then
                        lastBarWidth = roundedWidth
                        barFill.Size = UDim2.new(fillFrac, 0, 1, 0)
                    end
                end
            else
                if overlayBar.Visible then
                    overlayBar.Visible = false
                end
                Hypnosis.FlowstateLiveStatus = nil
            end
        end)
        table.insert(Hypnosis.Connections, conn)

        function Hypnosis.ToggleFlowstate(state)
            if state then
                local cd = tonumber(Hypnosis.Settings["Flowstate_Cooldown"]) or 15
                showNotification(
                    "Flowstate Active",
                    string.format("Perk force-enabled with %.0fs cooldown overlay.", cd),
                    "Info",
                    2.0
                )
            else
                clearFlowstateAttributes()
                if overlayBar.Visible then
                    overlayBar.Visible = false
                end
                Hypnosis.FlowstateLiveStatus = nil
                showNotification("Flowstate Disabled", "Restored default perk attributes.", "Info", 2.0)
            end
        end

        function Hypnosis.CleanupFlowstate()
            clearFlowstateAttributes()
            if overlayBar and overlayBar.Parent then
                pcall(function()
                    overlayBar:Destroy()
                end)
            end
        end
    end

    function Hypnosis.InitObstacleTraversal()
        local function isWindowVaultInstance(w)
            if not w or not w:IsDescendantOf(workspace) then
                return false
            end
            local wName = string.lower(w.Name)
            if
                wName == "window"
                or CollectionService:HasTag(w, "window")
                or CollectionService:HasTag(w, "vaultbox")
            then
                return true
            end
            if
                w:FindFirstChild("inviswall")
                or w:FindFirstChild("VaultTrigger")
                or w:FindFirstChild("LeapVaultTrigger")
                or w:FindFirstChild("VaultPoint", true)
            then
                return true
            end
            return false
        end

        local function cleanBlockedWindow(w)
            if not isWindowVaultInstance(w) then
                return
            end
            if CollectionService:HasTag(w, "Blocked") then
                CollectionService:RemoveTag(w, "Blocked")
            end
            local iw = w:FindFirstChild("inviswall")
            if iw and not iw.CanCollide then
                iw.CanCollide = true
            end
            local bottom = w:FindFirstChild("Bottom")
            if bottom and not bottom.CanCollide then
                bottom.CanCollide = true
            end
            for _, ch in ipairs(w:GetChildren()) do
                local name = ch.Name:lower()
                if name:find("spike") or name:find("block") or name:find("entity") or name:find("bamboozle") then
                    if ch:IsA("BasePart") then
                        ch.Transparency = 1
                        ch.CanCollide = false
                    elseif ch:IsA("Model") then
                        for _, p in ipairs(ch:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.Transparency = 1
                                p.CanCollide = false
                            end
                        end
                    end
                end
            end
        end
        local blockAddedConn = CollectionService:GetInstanceAddedSignal("Blocked"):Connect(function(inst)
            local isNeverBlock = (isSettingActive("Vault Settings", "Never Block") == true)

            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
            if isModActive and isNeverBlock and not isKiller(LocalPlayer) and isInActiveGameTeam(LocalPlayer) then
                cleanBlockedWindow(inst)
            end
        end)
        table.insert(Hypnosis.Connections, blockAddedConn)
        local lastBlockedSweep = 0
        local heartbeatBlockConn = RunService.Heartbeat:Connect(function()
            local now = tick()
            if now - lastBlockedSweep < 1.5 then
                return
            end
            lastBlockedSweep = now
            local isNeverBlock = (isSettingActive("Vault Settings", "Never Block") == true)

            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
            if isModActive and isNeverBlock and not isKiller(LocalPlayer) and isInActiveGameTeam(LocalPlayer) then
                for _, w in ipairs(CollectionService:GetTagged("Blocked")) do
                    cleanBlockedWindow(w)
                end
            end
        end)
        table.insert(Hypnosis.Connections, heartbeatBlockConn)
        local cachedSV, cachedSAC, cachedAL, cachedSP = nil, nil, nil, nil
        local traversalHooksInstalled = false
        local lastTraversalSync = 0
        local vaultCtrl = { claimedLook = false, claimedRotate = false, origAutoRotate = nil }

        function vaultCtrl.claim(hum, char)
            if hum and not vaultCtrl.claimedRotate then
                vaultCtrl.origAutoRotate = hum.AutoRotate
                vaultCtrl.claimedRotate = true
            end
            if hum then
                hum.AutoRotate = false
            end
            if char then
                char:SetAttribute("overridelookscript", true)
                vaultCtrl.claimedLook = true
            end
        end

        function vaultCtrl.release(hum, char)
            if vaultCtrl.claimedLook then
                vaultCtrl.claimedLook = false
                if char and char.Parent and char:GetAttribute("overridelookscript") == true then
                    char:SetAttribute("overridelookscript", false)
                end
            end
            if vaultCtrl.claimedRotate then
                local orig = vaultCtrl.origAutoRotate
                vaultCtrl.claimedRotate = false
                vaultCtrl.origAutoRotate = nil
                if hum and hum.Parent then
                    hum.AutoRotate = (orig ~= nil) and orig or true
                end
            end
        end

        local function isTraversalGameplayReady()
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return false
            end
            if isKiller(LocalPlayer) or not isInActiveGameTeam(LocalPlayer) then
                return false
            end
            local char = LocalPlayer and LocalPlayer.Character
            if not char or not char.Parent then
                return false
            end
            local mkAttr = char:GetAttribute("MorphedKiller")
            if
                char:FindFirstChild("KillerScript")
                or char:FindFirstChild("KillerRoot")
                or char:FindFirstChild("MorphedKiller")
                or (mkAttr ~= nil and mkAttr ~= false)
                or char:GetAttribute("Killer") == true
                or char:GetAttribute("IsKiller") == true
                or char:GetAttribute("Role") == "Killer"
            then
                return false
            end
            if
                not (
                    char:FindFirstChild("SurvivorScript")
                    or char:FindFirstChild("SurvivorRoot")
                    or char:FindFirstChild("CheckInterractable")
                )
            then
                return false
            end
            return true
        end

        local function uninstallModuleHooks()
            if
                cachedSV
                and cachedSV._hypnosisOrigEvaluate
                and cachedSV.evaluate == cachedSV._hypnosisWrappedEvaluate
            then
                cachedSV.evaluate = cachedSV._hypnosisOrigEvaluate
            end
            if cachedSAC then
                if
                    cachedSAC._hypnosisOrigValidate
                    and cachedSAC._validateFastVault == cachedSAC._hypnosisWrappedValidate
                then
                    cachedSAC._validateFastVault = cachedSAC._hypnosisOrigValidate
                end
                if
                    cachedSAC._hypnosisOrigCancelVaultTraversal
                    and cachedSAC._cancelVaultTraversal == cachedSAC._hypnosisWrappedCancel
                then
                    cachedSAC._cancelVaultTraversal = cachedSAC._hypnosisOrigCancelVaultTraversal
                end
                if
                    cachedSAC._origOnVaultAnimation
                    and cachedSAC._onVaultAnimation == cachedSAC._hypnosisWrappedOnVault
                then
                    cachedSAC._onVaultAnimation = cachedSAC._origOnVaultAnimation
                end
                if cachedSAC._origOnPalletSlide and cachedSAC._onPalletSlide == cachedSAC._hypnosisWrappedOnPallet then
                    cachedSAC._onPalletSlide = cachedSAC._origOnPalletSlide
                end
            end
            if
                cachedAL
                and cachedAL._hypnosisOrigIsBlocked
                and cachedAL.isBlocked == cachedAL._hypnosisWrappedIsBlocked
            then
                cachedAL.isBlocked = cachedAL._hypnosisOrigIsBlocked
            end
            if
                cachedSP
                and cachedSP._hypnosisOrigFindNearestPoint
                and cachedSP.findNearestPoint == cachedSP._hypnosisWrappedFindNearestPoint
            then
                cachedSP.findNearestPoint = cachedSP._hypnosisOrigFindNearestPoint
            end
            traversalHooksInstalled = false
        end

        local function ensureVaultNamecallHook()
            if Hypnosis._VaultCompleteHooked then
                return
            end
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local windowFolder = remotes and remotes:FindFirstChild("Window")
            local vaultCompleteEvent = windowFolder and windowFolder:FindFirstChild("VaultCompleteEvent")
            local okHook = Hypnosis._SafeHookNamecall(function(oldNamecall, self, ...)
                local method = getnamecallmethod()
                if
                    method == "FireServer"
                    and typeof(self) == "Instance"
                    and (self == vaultCompleteEvent or self.Name == "VaultCompleteEvent")
                then
                    local isNeverBlock = (isSettingActive("Vault Settings", "Never Block") == true)

                    local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                    if
                        isModActive
                        and isNeverBlock
                        and not isKiller(LocalPlayer)
                        and isInActiveGameTeam(LocalPlayer)
                    then
                        return
                    end
                end
                return oldNamecall(self, ...)
            end)
            if okHook then
                Hypnosis._VaultCompleteHooked = true
            end
        end

        local function installModuleHooks()
            if not isTraversalGameplayReady() then
                return
            end
            local modules = ReplicatedStorage:FindFirstChild("Modules")
            local survivors = modules and modules:FindFirstChild("Survivors")
            if not survivors then
                return
            end
            pcall(function()
                local svMod = survivors:FindFirstChild("SurvivorVault")
                local SV = svMod and require(svMod)
                if SV and type(SV.evaluate) == "function" then
                    cachedSV = SV
                    if not SV._hypnosisOrigEvaluate then
                        SV._hypnosisOrigEvaluate = SV.evaluate
                    end
                    if not SV._hypnosisWrappedEvaluate then
                        SV._hypnosisWrappedEvaluate = function(samples, params)
                            if isKiller(LocalPlayer) or not isInActiveGameTeam(LocalPlayer) then
                                if SV._hypnosisOrigEvaluate then
                                    return SV._hypnosisOrigEvaluate(samples, params)
                                end
                                return false, "failed", 0
                            end
                            local isFast = isSettingActive("Vault Settings", "Fast Vault") ~= false
                            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                            if isModActive and isFast then
                                return true, "ready", 5
                            end
                            if SV._hypnosisOrigEvaluate then
                                return SV._hypnosisOrigEvaluate(samples, params)
                            end
                            return false, "failed", 0
                        end
                    end
                    SV.evaluate = SV._hypnosisWrappedEvaluate
                end
            end)
            pcall(function()
                local sacMod = survivors:FindFirstChild("SurvivorAnimationsController")
                local SAC = sacMod and require(sacMod)
                if SAC and type(SAC._validateFastVault) == "function" then
                    cachedSAC = SAC
                    if not SAC._hypnosisOrigValidate then
                        SAC._hypnosisOrigValidate = SAC._validateFastVault
                    end
                    if not SAC._hypnosisWrappedValidate then
                        SAC._hypnosisWrappedValidate = function(self, point, isSprinting)
                            if isKiller(LocalPlayer) or not isInActiveGameTeam(LocalPlayer) then
                                if SAC._hypnosisOrigValidate then
                                    return SAC._hypnosisOrigValidate(self, point, isSprinting)
                                end
                                return false, "failed", 0
                            end
                            local isFast = isSettingActive("Vault Settings", "Fast Vault") ~= false
                            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                            if isModActive and isFast then
                                return true, "ready", 5
                            end
                            if SAC._hypnosisOrigValidate then
                                return SAC._hypnosisOrigValidate(self, point, isSprinting)
                            end
                            return false, "failed", 0
                        end
                    end
                    SAC._validateFastVault = SAC._hypnosisWrappedValidate
                end
            end)
            pcall(function()
                local alMod = survivors:FindFirstChild("ActionLocks")
                local AL = alMod and require(alMod)
                if AL and type(AL.isBlocked) == "function" then
                    cachedAL = AL
                    if not AL._hypnosisOrigIsBlocked then
                        AL._hypnosisOrigIsBlocked = AL.isBlocked
                    end
                    if not AL._hypnosisWrappedIsBlocked then
                        AL._hypnosisWrappedIsBlocked = function(char, actionName)
                            if isKiller(LocalPlayer) or not isInActiveGameTeam(LocalPlayer) then
                                if AL._hypnosisOrigIsBlocked then
                                    return AL._hypnosisOrigIsBlocked(char, actionName)
                                end
                                return false
                            end
                            local isAlways = (isSettingActive("Vault Settings", "Always Vault") == true)

                            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                            if isModActive and isAlways and (actionName == "vault" or actionName == "palletslide") then
                                return false
                            end
                            if AL._hypnosisOrigIsBlocked then
                                return AL._hypnosisOrigIsBlocked(char, actionName)
                            end
                            return false
                        end
                    end
                    AL.isBlocked = AL._hypnosisWrappedIsBlocked
                end
            end)
            pcall(function()
                local spMod = survivors:FindFirstChild("SurvivorProximity")
                local SP = spMod and require(spMod)
                if SP and type(SP.findNearestPoint) == "function" then
                    cachedSP = SP
                    if not SP._hypnosisOrigFindNearestPoint then
                        SP._hypnosisOrigFindNearestPoint = SP.findNearestPoint
                    end
                    local origFind = SP._hypnosisOrigFindNearestPoint
                    if not SP._hypnosisWrappedFindNearestPoint then
                        SP._hypnosisWrappedFindNearestPoint = function(self, a2, a3)
                            if
                                Hypnosis._Unloaded
                                or Hypnosis._Teleporting
                                or Hypnosis._IsInteractingPrompt
                                or isKiller(LocalPlayer)
                                or not isInActiveGameTeam(LocalPlayer)
                            then
                                return origFind(self, a2, a3)
                            end
                            local cam = workspace.CurrentCamera
                            if cam and cam.CameraType == Enum.CameraType.Scriptable then
                                return origFind(self, a2, a3)
                            end
                            local isAlways = (isSettingActive("Vault Settings", "Always Vault") == true)

                            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                            if isModActive and isAlways then
                                local hrp = self.humanoidRootPart
                                    or (self.character and self.character:FindFirstChild("HumanoidRootPart"))
                                if hrp and CollectionService and CollectionService:HasTag(hrp, "doing action") then
                                    return origFind(self, a2, a3)
                                end
                                local hrpPos = hrp and hrp.Position
                                local maxDist = 7.5
                                if hrpPos then
                                    if a2 == "VaultPoint" then
                                        local bestPoint = nil
                                        local bestDist = maxDist
                                        for _, v in ipairs(CollectionService:GetTagged("VaultPoint")) do
                                            if v:IsA("BasePart") and not v:IsDescendantOf(self.character) then
                                                local d = (v.Position - hrpPos).Magnitude
                                                if d <= bestDist then
                                                    bestDist = d
                                                    bestPoint = v
                                                end
                                            end
                                        end
                                        if bestPoint then
                                            return bestPoint
                                        end
                                        return nil
                                    elseif a2 == "PalletPointSlide" then
                                        local bestPoint = nil
                                        local bestDist = maxDist
                                        for _, p in ipairs(CollectionService:GetTagged("pallet")) do
                                            local pState = p:GetAttribute("PalletState")
                                            local isDropped = (
                                                pState == "Down"
                                                or pState == "Dropped"
                                                or pState == "Fallen"
                                                or p:GetAttribute("Dropped") == true
                                                or p:GetAttribute("IsDropped") == true
                                                or p:GetAttribute("DroppedAt") ~= nil
                                            )
                                            if isDropped then
                                                local intact = p:FindFirstChild("Intact")
                                                if intact then
                                                    for _, ch in ipairs(intact:GetChildren()) do
                                                        if
                                                            ch:IsA("BasePart")
                                                            and (
                                                                ch.Name == "PalletPoint"
                                                                or ch.Name == "PalletPointSlide"
                                                            )
                                                        then
                                                            local d = (ch.Position - hrpPos).Magnitude
                                                            if d <= bestDist then
                                                                bestDist = d
                                                                bestPoint = ch
                                                            end
                                                        end
                                                    end
                                                else
                                                    for _, ch in ipairs(p:GetDescendants()) do
                                                        if
                                                            ch:IsA("BasePart")
                                                            and (
                                                                ch.Name == "PalletPoint"
                                                                or ch.Name == "PalletPointSlide"
                                                                or ch.Name == "RootPart"
                                                            )
                                                        then
                                                            local d = (ch.Position - hrpPos).Magnitude
                                                            if d <= bestDist then
                                                                bestDist = d
                                                                bestPoint = ch
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                        if bestPoint then
                                            return bestPoint
                                        end
                                        return nil
                                    end
                                end
                            end
                            return origFind(self, a2, a3)
                        end
                    end
                    SP.findNearestPoint = SP._hypnosisWrappedFindNearestPoint
                end
            end)
            pcall(function()
                local sacMod = survivors:FindFirstChild("SurvivorAnimationsController")
                local SAC = sacMod and require(sacMod)
                if SAC and type(SAC._cancelVaultTraversal) == "function" then
                    cachedSAC = SAC
                    if not SAC._hypnosisOrigCancelVaultTraversal then
                        SAC._hypnosisOrigCancelVaultTraversal = SAC._cancelVaultTraversal
                    end
                    if not SAC._hypnosisWrappedCancel then
                        SAC._hypnosisWrappedCancel = function(self)
                            if isKiller(LocalPlayer) or not isInActiveGameTeam(LocalPlayer) then
                                if SAC._hypnosisOrigCancelVaultTraversal then
                                    return SAC._hypnosisOrigCancelVaultTraversal(self)
                                end
                                return
                            end
                            local cam = workspace.CurrentCamera
                            if cam and cam.CameraType == Enum.CameraType.Scriptable then
                                if SAC._hypnosisOrigCancelVaultTraversal then
                                    return SAC._hypnosisOrigCancelVaultTraversal(self)
                                end
                                return
                            end
                            local isNeverBlock = (isSettingActive("Vault Settings", "Never Block") == true)

                            local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                            if
                                isModActive
                                and isNeverBlock
                                and self
                                and self.isVaulting
                                and not (self.character and self.character:GetAttribute("Knocked") == true)
                            then
                                return
                            end
                            if SAC._hypnosisOrigCancelVaultTraversal then
                                return SAC._hypnosisOrigCancelVaultTraversal(self)
                            end
                        end
                    end
                    SAC._cancelVaultTraversal = SAC._hypnosisWrappedCancel
                end
            end)
            pcall(function()
                local sacMod = survivors:FindFirstChild("SurvivorAnimationsController")
                local svMod = survivors:FindFirstChild("SurvivorVault")
                local SAC = sacMod and require(sacMod)
                local SV = svMod and require(svMod)
                if not (SAC and SV) then
                    return
                end
                cachedSAC = SAC
                cachedSV = SV
                local tweenRootAuthoritative = nil
                local origVault = SAC._origOnVaultAnimation or SAC._onVaultAnimation
                local getUpvals = (type(debug) == "table" and debug.getupvalues) or getupvalues
                if origVault and type(getUpvals) == "function" then
                    local okU, uvs = pcall(getUpvals, origVault)
                    if okU and uvs then
                        for _, v in pairs(uvs) do
                            if type(v) == "function" and not tweenRootAuthoritative then
                                tweenRootAuthoritative = v
                                break
                            end
                        end
                    end
                end
                if not SAC._origOnVaultAnimation then
                    SAC._origOnVaultAnimation = SAC._onVaultAnimation
                end
                if not SAC._origOnPalletSlide then
                    SAC._origOnPalletSlide = SAC._onPalletSlide
                end
                if not SAC._hypnosisWrappedOnVault then
                    SAC._hypnosisWrappedOnVault = function(self, a2, a3, a4)
                        if isKiller(LocalPlayer) or not isInActiveGameTeam(LocalPlayer) then
                            return SAC._origOnVaultAnimation(self, a2, a3, a4)
                        end
                        local cam = workspace.CurrentCamera
                        if cam and cam.CameraType == Enum.CameraType.Scriptable then
                            return SAC._origOnVaultAnimation(self, a2, a3, a4)
                        end
                        local isModActive = Hypnosis.Settings["Vault Settings_Enabled"] == true
                        local speedFactor = tonumber(Hypnosis.Settings["Vault Settings_Vault Speed"])
                            or tonumber(Hypnosis.Settings["Vault Speed"])
                            or tonumber(Hypnosis.Settings["Universal Obstacle Vault_Vault Speed Factor"])
                            or 1.0
                        local endlag = tonumber(Hypnosis.Settings["Vault Settings_Vault Endlag (s)"])
                            or tonumber(Hypnosis.Settings["Vault Endlag (s)"])
                            or 0.0
                        local isNeverBlock = (isSettingActive("Vault Settings", "Never Block") == true)

                        if not isModActive or (speedFactor == 1.0 and endlag == 0.0 and not isNeverBlock) then
                            return SAC._origOnVaultAnimation(self, a2, a3, a4)
                        end
                        if not (self.character and self.humanoid and self.humanoidRootPart and self.animator) then
                            return
                        end
                        if self.isVaulting or self.humanoidRootPart:HasTag("doing action") then
                            return
                        end
                        local v2, v3 = self:_validateFastVault(a2, a3)
