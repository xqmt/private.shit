                state.Rows[i].LastTrans = nil
            end
            local baseH = showHeader and 30 or 14
            local targetSize = UDim2.new(0, state.Width, 0, baseH + (#entries * 19))
            if state.LastTargetSize ~= targetSize then
                state.LastTargetSize = targetSize
                Tween(card, { Size = targetSize }, 0.2, Enum.EasingStyle.Quad)
            end
