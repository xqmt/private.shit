    local function refreshLocalPlayerKillerRole()
        if not LocalPlayer then
            return false
        end
        local isK = false
        if LocalPlayer.Team then
            local tLower = string.lower(LocalPlayer.Team.Name)
            if
                LocalPlayer.Team.Name == "Killer"
                or string.find(tLower, "killer", 1, true)
                or string.find(tLower, "slasher", 1, true)
            then
                isK = true
            end
        end
        if not isK then
            local lpRole = LocalPlayer:GetAttribute("Role")
            if
                lpRole == "Killer"
                or LocalPlayer:GetAttribute("IsKiller") == true
                or LocalPlayer:GetAttribute("Killer") == true
            then
                isK = true
            end
        end
        if not isK then
            local teamObj = LocalPlayer:FindFirstChild("Team")
            if teamObj then
                if teamObj:FindFirstChild("Killer") or teamObj:FindFirstChild("Killers") then
                    isK = true
                elseif teamObj:IsA("ValueBase") then
                    local tvLower = string.lower(tostring(teamObj.Value))
                    if
                        teamObj.Value == "Killer"
                        or string.find(tvLower, "killer", 1, true)
                        or string.find(tvLower, "slasher", 1, true)
                    then
                        isK = true
                    end
                end
            end
        end
        if not isK then
            local char = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            if char then
                local mkAttr = char:GetAttribute("MorphedKiller")
                if
                    char:FindFirstChild("MorphedKiller")
                    or (mkAttr ~= nil and mkAttr ~= false)
                    or char:GetAttribute("Role") == "Killer"
                    or char:GetAttribute("IsKiller") == true
                    or char:GetAttribute("Killer") == true
                    or char:FindFirstChild("KillerScript")
                    or char:FindFirstChild("KillerRoot")
                    or (CollectionService and CollectionService:HasTag(char, "Killer"))
                then
                    isK = true
                end
            end
        end
        cachedLocalPlayerIsKiller = isK
        return isK
    end

