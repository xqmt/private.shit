            showNotification("Configs", "Config '" .. ConfigManager.Active .. "' saved successfully.", "success")
        end
    end

    function ConfigManager.ApplyConfig(name)
        local cfg = ConfigManager.Configs[name]
        if not cfg then
            return
        end
        ConfigManager.Active = name
        for k in pairs(cfg) do
            if Hypnosis.IsBlockedHudPosKey(k) then
                cfg[k] = nil
            end
        end
        for k in pairs(Hypnosis.Settings) do
            if Hypnosis.IsBlockedHudPosKey(k) or (Hypnosis.IsDynamicPosKey(k) and cfg[k] == nil) then
                Hypnosis.Settings[k] = nil
            end
        end
        for k, defVal in pairs(Hypnosis.DefaultSettings) do
            if cfg[k] == nil then
                local resetVal = defVal

                Hypnosis.Settings[k] = resetVal
                local setter = Hypnosis.Setters[k]
                if setter then
                    pcall(setter, resetVal)
                end
            end
        end
        for k, v in pairs(cfg) do
            if not Hypnosis.IsBlockedHudPosKey(k) then
                Hypnosis.Settings[k] = v
                local setter = Hypnosis.Setters[k]
                if setter then
                    pcall(setter, v)
                end
            end
        end
        Hypnosis.ApplySavedHudPositions()
        ConfigManager.PersistToDisk()
        if Hypnosis.RebuildMobileKeybinds then
            pcall(Hypnosis.RebuildMobileKeybinds)
        end
        showNotification("Configs", "Loaded config '" .. name .. "'.", "info")
    end

    function ConfigManager.ImportJson(rawJson, customName)
        if not rawJson or type(rawJson) ~= "string" or rawJson:match("^%s*$") then
            showNotification("Configs", "Please provide a valid JSON string.", "error")
            return false
        end
        local cleanJson = rawJson
            :gsub("^%s*```json%s*", "")
            :gsub("^%s*```%s*", "")
            :gsub("%s*```%s*$", "")
            :gsub("^%s+", "")
            :gsub("%s+$", "")
        local success, parsed = pcall(function()
            return game:GetService("HttpService"):JSONDecode(cleanJson)
        end)
        if not success or type(parsed) ~= "table" then
            showNotification("Configs", "Invalid JSON format. Failed to parse.", "error")
            return false
        end
        local targetSettings = nil
        local targetName = (customName and customName:gsub("^%s+", ""):gsub("%s+$", "")) or nil
        if targetName == "" or (targetName and targetName:sub(1, 1) == "{") then
            targetName = nil
        end
        if parsed.Configs and type(parsed.Configs) == "table" then
            local activeKey = parsed.Active
            if activeKey and parsed.Configs[activeKey] and type(parsed.Configs[activeKey]) == "table" then
                targetSettings = parsed.Configs[activeKey]
                if not targetName then
                    targetName = activeKey
                end
            else
                for k, v in pairs(parsed.Configs) do
                    if type(v) == "table" then
                        targetSettings = v
                        if not targetName then
                            targetName = k
                        end
                        break
                    end
                end
            end
        else
            targetSettings = parsed
        end
        if not targetSettings or type(targetSettings) ~= "table" then
            showNotification("Configs", "No configuration data found in JSON.", "error")
            return false
        end
        if not targetName or targetName == "" then
            local base = "Imported"
            local idx = 1
            targetName = base
            while ConfigManager.Configs[targetName] do
                idx = idx + 1
                targetName = base .. "_" .. tostring(idx)
            end
        end
        local sanitized = {}
        for k, v in pairs(targetSettings) do
            if not Hypnosis.IsBlockedHudPosKey(k) then
                sanitized[k] = v
            end
        end
        ConfigManager.Configs[targetName] = sanitized
        ConfigManager.Active = targetName
        ConfigManager.ApplyConfig(targetName)
        ConfigManager.PersistToDisk()
        showNotification("Configs", "Imported & loaded config '" .. targetName .. "'.", "success")
        return true
    end

    function ConfigManager.CreateConfig(name)
        local cleanName = name:gsub("^%s+", ""):gsub("%s+$", "")
        if cleanName == "" then
            showNotification("Configs", "Please enter a valid config name.", "error")
            return false
        end
        if (cleanName:sub(1, 1) == "{" and cleanName:sub(-1) == "}") or cleanName:find('"') then
            return ConfigManager.ImportJson(cleanName)
        end
        if ConfigManager.Configs[cleanName] then
            showNotification("Configs", "Config '" .. cleanName .. "' already exists.", "error")
            return false
        end
        Hypnosis.SyncHudPositionsToSettings()
        local newCfg = {}
        for k, v in pairs(Hypnosis.Settings) do
            if not Hypnosis.IsBlockedHudPosKey(k) then
                newCfg[k] = v
            end
        end
        ConfigManager.Configs[cleanName] = newCfg
        ConfigManager.Active = cleanName
        ConfigManager.PersistToDisk()
        showNotification("Configs", "Created & activated config '" .. cleanName .. "'.", "success")
        return true
    end

    function ConfigManager.RenameConfig(newName)
        local cleanName = newName:gsub("^%s+", ""):gsub("%s+$", "")
        if cleanName == "" then
            showNotification("Configs", "Please enter a new name.", "error")
            return false
        end
        if cleanName == ConfigManager.Active then
            showNotification("Configs", "Name is identical to current.", "info")
            return false
        end
        if ConfigManager.Configs[cleanName] then
            showNotification("Configs", "A config named '" .. cleanName .. "' already exists.", "error")
            return false
        end
        local oldName = ConfigManager.Active
        ConfigManager.Configs[cleanName] = ConfigManager.Configs[oldName]
        ConfigManager.Configs[oldName] = nil
        ConfigManager.Active = cleanName
        ConfigManager.PersistToDisk()
        showNotification("Configs", "Renamed '" .. oldName .. "' to '" .. cleanName .. "'.", "success")
        return true
    end

    function ConfigManager.DeleteConfig(name)
        name = name or ConfigManager.Active
        local count = 0
        for _ in pairs(ConfigManager.Configs) do
            count = count + 1
        end
        if count <= 1 then
            showNotification("Configs", "Cannot delete the only remaining config.", "error")
            return false
        end
        local deletedName = name
        ConfigManager.Configs[deletedName] = nil
        for k in pairs(ConfigManager.Configs) do
            ConfigManager.Active = k
            break
        end
        ConfigManager.ApplyConfig(ConfigManager.Active)
        ConfigManager.PersistToDisk()
        showNotification(
            "Configs",
            "Deleted '" .. deletedName .. "'. Switched to '" .. ConfigManager.Active .. "'.",
            "success"
        )
        return true
    end

    function ConfigManager.ResetToFactory()
