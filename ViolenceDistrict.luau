        local function isPalletOrCharacterDesc(inst)
            local cur = inst
            local steps = 0
            while cur and cur ~= workspace and cur ~= cachedMap and steps < 8 do
                local ln = string.lower(cur.Name)
                if string.find(ln, "pallet", 1, true) or hasTagSafe(cur, "pallet") then
                    return true
                end
                if
                    cur:IsA("Model")
                    and (Players:GetPlayerFromCharacter(cur) ~= nil or cur:FindFirstChildOfClass("Humanoid") ~= nil)
                then
                    return true
                end
                cur = cur.Parent
                steps = steps + 1
            end
            return false
        end

        local function isVaultMarkerChildName(lowerName)
            return lowerName == "vaulttrigger"
                or lowerName == "leapvaulttrigger"
                or lowerName == "vaultpointinuse"
                or lowerName == "vaultpoint"
                or lowerName == "bottom"
                or lowerName == "inviswall"
        end

        local function isNonHighlightVaultPartName(lowerName)
            return string.find(lowerName, "trigger", 1, true) ~= nil
                or lowerName == "inviswall"
                or lowerName == "vaultpoint"
                or string.find(lowerName, "spike", 1, true) ~= nil
                or string.find(lowerName, "block", 1, true) ~= nil
                or string.find(lowerName, "bamboozle", 1, true) ~= nil
                or string.find(lowerName, "entity", 1, true) ~= nil
        end

        local function isContainerWindowVault(c)
            if not c or not c.Parent or c == workspace or c == cachedMap then
                return false
            end
            if not (c:IsA("Model") or c:IsA("Folder") or c:IsA("BasePart")) then
                return false
            end
            local ln = string.lower(c.Name)
            local isWinName = (ln == "window")
            local hasWinTag = isWinName or hasTagSafe(c, "window")
            local hasBoxTag = hasTagSafe(c, "vaultbox")
            if not hasWinTag and not hasBoxTag then
                return false
            end
            if isPalletOrCharacterDesc(c) then
                return false
            end
            if hasWinTag then
                if
                    hasTagSafe(c, "window")
                    or hasBoxTag
                    or c:FindFirstChild("VaultTrigger")
                    or c:FindFirstChild("LeapVaultTrigger")
                    or c:FindFirstChild("VaultPointInUse")
                    or c:FindFirstChild("VaultPoint", true)
                    or (c:FindFirstChild("Bottom") and c:FindFirstChild("inviswall"))
                then
                    return true
                end
            elseif hasBoxTag then
                return true
            end
            return false
        end

        local function resolveVaultContainer(desc)
            if not desc or not desc.Parent or desc == workspace or desc == cachedMap then
                return nil
            end
            local ln = string.lower(desc.Name)
            local quickCandidate = (ln == "window")
                or isVaultMarkerChildName(ln)
                or hasTagSafe(desc, "window")
                or hasTagSafe(desc, "vaultbox")
                or hasTagSafe(desc, "VaultPoint")
            if not quickCandidate then
                return nil
            end
            if isPalletOrCharacterDesc(desc) then
                return nil
            end
            if isContainerWindowVault(desc) then
                if desc:IsA("BasePart") and desc.Parent and desc.Parent ~= workspace and desc.Parent ~= cachedMap then
                    local p = desc.Parent
                    if string.lower(p.Name) == "window" or hasTagSafe(p, "window") then
                        return p
                    end
                end
                return desc
            end
            local p1 = desc.Parent
            if isContainerWindowVault(p1) then
                return p1
            end
            local p2 = p1 and p1.Parent
            if isContainerWindowVault(p2) then
                return p2
            end
            if (ln == "vaulttrigger" or ln == "leapvaulttrigger") and desc:IsA("BasePart") then
                if p1 and (p1 == cachedMap or p1 == workspace) then
                    return desc
                elseif
                    p1
                    and p1 ~= cachedMap
                    and p1 ~= workspace
                    and (p1:IsA("Model") or p1:IsA("Folder"))
                    and (p1:FindFirstChild("Bottom") or p1:FindFirstChild("inviswall"))
                    and #p1:GetChildren() <= 40
                then
                    return p1
                end
                return desc
            end
            return nil
        end

