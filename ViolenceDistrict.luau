    function Hypnosis.ValidateKey(rawInput, metaData, callback, silent)
        local cleanKey = ""
        local meta = type(metaData) == "table" and metaData or nil
        if type(rawInput) == "table" then
            meta = rawInput
            cleanKey = tostring(meta.key or ""):gsub("%s+", "")
        elseif type(rawInput) == "string" then
            local trimmed = rawInput:match("^%s*(.-)%s*$")
            if trimmed:sub(1, 1) == "{" and trimmed:sub(-1) == "}" then
                local ok, decoded = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(trimmed)
                end)
                if ok and type(decoded) == "table" then
                    meta = decoded
                    cleanKey = tostring(meta.key or ""):gsub("%s+", "")
                end
            end
            if cleanKey == "" then
                cleanKey = trimmed:gsub("%s+", "")
            end
        end
        if cleanKey == "" then
            if not silent then
                showNotification("Authentication", "License key cannot be empty.", "error")
            end
            if callback then
                callback(false, "License key cannot be empty.")
            end
            return false
        end
        local upperKey = cleanKey:upper()
        local lifetimeKeys = {
            ["HYPNOSIS-LIFETIME"] = true,
            ["HYPNOSIS-2026"] = true,
            ["LIFETIME-ACCESS"] = true,
            ["HYP-VIP-LIFETIME"] = true,
            ["DEV-MASTER-KEY"] = true,
        }
        local yearlyKeys = { ["PREMIUM-2026"] = true, ["HYP-PRO-365"] = true, ["HYPNOSIS-YEAR"] = true }
        if lifetimeKeys[upperKey] or upperKey:find("LIFETIME") or yearlyKeys[upperKey] or upperKey:find("YEAR") then
            local isLifetime = lifetimeKeys[upperKey] or upperKey:find("LIFETIME")
            local tierText = isLifetime and "Lifetime Tier" or "Premium Tier"
            local expiryText = isLifetime and "Lifetime (Permanent)" or "365 Days Remaining"
            Hypnosis.IsPremium = true
            Hypnosis.SubscriptionStatus = tierText
            Hypnosis.ExpiryDays = expiryText
            Hypnosis.ActiveLicense = cleanKey
            _G.VD_IsPremium = true
            Hypnosis._OnPremiumActivated()
            pcall(function()
                if writefile then
                    local saveObj = { key = cleanKey, tier = tierText, expiry = expiryText, is_active = true }
                    writefile(LICENSE_FILE, game:GetService("HttpService"):JSONEncode(saveObj))
                    writefile(VD_PREMIUM_FILE, game:GetService("HttpService"):JSONEncode({ key = cleanKey }))
                end
            end)
            Hypnosis.TriggerUIUpdate()
            if not silent then
                showNotification("Authentication", "Master key active! Premium enabled.", "success")
            end
            if callback then
                callback(true, "Master key active!")
            end
            return true
        end
        if not silent then
            showNotification("Authentication", "Validating license...", "info", 1.5)
        end
        task.spawn(function()
            local requestFunc = getRequestFunction()
            local reqPayload = {
                key = cleanKey,
                hwid = getHWID(),
                username = (LocalPlayer and LocalPlayer.Name) or "Player",
                session_key = sessionKey,
                build = OFFICIAL_BUILD_ID,
            }
            local processKeyResult = function(resBody, statusCode)
                if not resBody or #resBody == 0 then
                    return false
                end
                local ok, decoded = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(resBody)
                end)
                if not (ok and type(decoded) == "table") then
                    return false
                end
                if decoded.success == true then
                    activeSessionToken = decoded.token
                    activeSessionTs = decoded.ts
                    if decoded.payload and type(decoded.payload) == "string" and #decoded.payload > 0 then
                        pcall(function()
                            local encSecret = OFFICIAL_BUILD_ID .. "_SEC_2026"
                            local encKey = encSecret
                                .. ":"
                                .. cleanKey
                                .. ":"
                                .. getHWID()
                                .. ":"
                                .. sessionKey
                                .. ":"
                                .. tostring(decoded.ts)
                            local decryptedLua = decryptPayloadXor(decoded.payload, encKey)
                            if decryptedLua and #decryptedLua > 0 and loadstring then
                                local remoteFunc = loadstring(decryptedLua)
                                if type(remoteFunc) == "function" then
                                    local unlockFn = function(k)
                                        if k == sessionKey then
                                            Hypnosis.IsPremium = true
                                            if Hypnosis.RefreshPremiumBadges then
                                                Hypnosis.RefreshPremiumBadges()
                                            end
                                            _G.VD_IsPremium = true
                                        end
                                    end
                                    pcall(remoteFunc, unlockFn, sessionKey, activeHooksTable)
                                end
                            end
                        end)
                    end
                    local msg = decoded.message or "Premium activated!"
                    Hypnosis.IsPremium = true
                    Hypnosis.SubscriptionStatus = "Premium Tier"
                    Hypnosis.ExpiryDays = msg
                    Hypnosis.ActiveLicense = cleanKey
                    _G.VD_IsPremium = true
                    Hypnosis._OnPremiumActivated()
                    pcall(function()
                        if writefile then
                            local saveObj = {
                                key = cleanKey,
                                tier = "Premium Tier",
                                expiry = msg,
                                is_active = true,
                                ts = decoded.ts or os.time(),
                            }
                            writefile(LICENSE_FILE, game:GetService("HttpService"):JSONEncode(saveObj))
                            writefile(VD_PREMIUM_FILE, game:GetService("HttpService"):JSONEncode({ key = cleanKey }))
                        end
                    end)
                    Hypnosis.TriggerUIUpdate()
                    if not silent then
                        showNotification("Authentication", msg, "success")
                    end
                    if callback then
                        callback(true, msg)
                    end
                    return true
                else
                    local errMsg = decoded.message or decoded.error or "Invalid key"
                    local isExpired = (errMsg:lower():find("expire") ~= nil)
                    Hypnosis._AwaitingStartupAuth = false
                    Hypnosis.IsPremium = false
                    Hypnosis.SubscriptionStatus = isExpired and "Expired" or "Free Tier"
                    Hypnosis.ExpiryDays = isExpired and "Key Expired" or "Invalid License"
                    Hypnosis.ActiveLicense = cleanKey
                    _G.VD_IsPremium = false
                    Hypnosis.TriggerUIUpdate()
                    if not silent then
                        showNotification("Authentication", errMsg, "error")
                    end
                    if callback then
                        callback(false, errMsg)
                    end
                    return true
                end
            end
            if requestFunc then
                local okPost, res = pcall(function()
                    return requestFunc({
                        Url = SERVER_API_URL .. "/api/validatekey?build=" .. OFFICIAL_BUILD_ID,
                        Method = "POST",
                        Timeout = 12,
                        Headers = { ["Content-Type"] = "application/json", ["x-vd-build"] = OFFICIAL_BUILD_ID },
                        Body = game:GetService("HttpService"):JSONEncode(reqPayload),
                    })
                end)
                if okPost and res then
                    local resBody = nil
                    local statusCode = 200
                    if type(res) == "string" then
                        resBody = res
                    elseif type(res) == "table" then
                        resBody = res.Body or res.body or res.data or res.content or res.Content
                        statusCode = res.StatusCode or res.status or 200
                    end
                    if resBody and #resBody > 0 then
                        if processKeyResult(resBody, statusCode) then
                            return
                        end
                    end
                end
            end
            local httpService = game:GetService("HttpService")
            local getUrl = SERVER_API_URL
                .. "/api/validatekey?key="
                .. httpService:UrlEncode(cleanKey)
                .. "&hwid="
                .. httpService:UrlEncode(getHWID())
                .. "&username="
                .. httpService:UrlEncode((LocalPlayer and LocalPlayer.Name) or "Player")
                .. "&session_key="
                .. httpService:UrlEncode(sessionKey)
                .. "&build="
                .. OFFICIAL_BUILD_ID
                .. "&t="
                .. tostring(math.floor(tick()))
            local okGet, getBody = pcall(function()
                return game:HttpGet(getUrl)
            end)
            if okGet and getBody and #getBody > 0 then
                if processKeyResult(getBody, 200) then
                    return
                end
            end
            local connErrMsg = "Connection failed! Check network/firewall to " .. SERVER_API_URL
            Hypnosis._AwaitingStartupAuth = false
            Hypnosis.IsPremium = false
            Hypnosis.SubscriptionStatus = "Free Tier"
            Hypnosis.ExpiryDays = "Invalid License"
            Hypnosis.ActiveLicense = cleanKey
            Hypnosis.TriggerUIUpdate()
            if not silent then
                showNotification("Authentication", connErrMsg, "error")
            end
            if callback then
                callback(false, connErrMsg)
            end
        end)
        return true
    end

    function Hypnosis.RevokeKey()
        Hypnosis._AwaitingStartupAuth = false
        ConfigManager._PendingPremiumConfigs = {}
        Hypnosis._UserModifiedSettings = {}
        Hypnosis.IsPremium = false
        Hypnosis.SubscriptionStatus = "Free Tier"
        Hypnosis.ExpiryDays = "Expired (0 Days)"
        Hypnosis.ActiveLicense = "None"
        _G.VD_IsPremium = false

        if Hypnosis._DemandSync then
            pcall(Hypnosis._DemandSync)
        end
        pcall(function()
            local delfile = delfile or (syn and syn.delfile)
            if delfile then
                if isfile and isfile(LICENSE_FILE) then
                    pcall(delfile, LICENSE_FILE)
                end
                if isfile and isfile(VD_PREMIUM_FILE) then
                    pcall(delfile, VD_PREMIUM_FILE)
                end
            end
            if writefile then
                pcall(writefile, LICENSE_FILE, "{}")
                pcall(writefile, VD_PREMIUM_FILE, "{}")
            end
        end)
        Hypnosis.TriggerUIUpdate()
        showNotification("Authentication", "License unlinked. Reverted to Free Tier.", "info")
    end

    function Hypnosis.LoadSavedKey()
        local startedAsyncValidation = false
        pcall(function()
            local loadedKey = nil
            if isfile and readfile then
                if isfile(VD_PREMIUM_FILE) then
                    local content = readfile(VD_PREMIUM_FILE)
                    if content and content ~= "" and content ~= "{}" then
                        local ok, data = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(content)
                        end)
                        if ok and data and type(data) == "table" and data.key then
                            loadedKey = tostring(data.key)
                        end
                    end
                end
                if not loadedKey and isfile(LICENSE_FILE) then
                    local content = readfile(LICENSE_FILE)
                    if content and content ~= "" and content ~= "{}" then
                        local ok, data = pcall(function()
                            return game:GetService("HttpService"):JSONDecode(content)
                        end)
                        if ok and data then
                            if type(data) == "table" and data.key then
                                loadedKey = tostring(data.key)
                            elseif type(data) == "string" then
                                loadedKey = data
                            end
                        end
                    end
                end
            end
            if loadedKey and #loadedKey > 0 then
                Hypnosis._AwaitingStartupAuth = true
                startedAsyncValidation = true
                if not Hypnosis.ValidateKey(loadedKey, nil, nil, true) then
                    Hypnosis._AwaitingStartupAuth = false
                    startedAsyncValidation = false
                end
            else
                Hypnosis._AwaitingStartupAuth = false
            end
        end)
        if not startedAsyncValidation and Hypnosis.IsPremium ~= true then
            Hypnosis._AwaitingStartupAuth = false
        end
    end
