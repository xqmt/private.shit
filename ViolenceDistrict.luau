                end
                if rowData.BadgeLabel.Text ~= badgeText then
                    rowData.BadgeLabel.Text = badgeText
                end
                local badgeCol = item.BadgeColor or Color3.fromRGB(136, 136, 136)
                if rowData.BadgeLabel.TextColor3 ~= badgeCol then
                    rowData.BadgeLabel.TextColor3 = badgeCol
                end
                local targetTrans = item.NameTrans or 0.0
                if rowData.LastTrans ~= targetTrans then
                    rowData.LastTrans = targetTrans
