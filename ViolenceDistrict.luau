                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer then
                            local isK = isKiller(p)
                            local matches = false
                            if targetIdx == 1 then
                                matches = true
                            elseif targetIdx == 2 and isK then
                                matches = true
                            elseif targetIdx == 3 and not isK then
                                matches = true
                            end
                            if matches then
                                local char = p.Character or workspace:FindFirstChild(p.Name)
                                local pos = getPosition(char)
                                if pos then
                                    pooledSeenChars[char] = true
                                    local c = tracerColor
                                    if teamColors then
