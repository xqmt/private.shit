    local lastLocalKillerSync = 0

    local function isKiller(player)
        if not player then
            return false
        end
        if player == LocalPlayer then
            local now = os.clock()
            if (now - lastLocalKillerSync) >= 0.25 then
                lastLocalKillerSync = now
                return refreshLocalPlayerKillerRole()
            end
            return cachedLocalPlayerIsKiller
        end
        if player.Team then
            local tLower = string.lower(player.Team.Name)
            if
                player.Team.Name == "Killer"
                or string.find(tLower, "killer", 1, true)
                or string.find(tLower, "slasher", 1, true)
            then
                return true
            end
        end
        local teamObj = player:FindFirstChild("Team")
        if
            teamObj
            and (
                teamObj:FindFirstChild("Killer")
                or teamObj:FindFirstChild("Killers")
                or (
                    teamObj:IsA("ValueBase")
                    and (
                        teamObj.Value == "Killer"
                        or string.find(string.lower(tostring(teamObj.Value)), "killer", 1, true)
                        or string.find(string.lower(tostring(teamObj.Value)), "slasher", 1, true)
                    )
                )
            )
        then
            return true
        end
        local char = player.Character or workspace:FindFirstChild(player.Name)
        if char then
            local mkAttr = char:GetAttribute("MorphedKiller")
            if
                game:GetService("CollectionService"):HasTag(char, "Killer")
                or char:FindFirstChild("MorphedKiller")
                or (mkAttr ~= nil and mkAttr ~= false)
                or char:GetAttribute("Role") == "Killer"
                or char:GetAttribute("IsKiller") == true
                or char:GetAttribute("Killer") == true
                or char:FindFirstChild("KillerScript")
                or char:FindFirstChild("KillerRoot")
            then
                return true
            end
        end
        if
            player:GetAttribute("SelectedKiller")
            and player.Team
            and player.Team.Name ~= "Survivors"
            and player.Team.Name ~= "Survivor"
            and player.Team.Name ~= "Spectator"
        then
            return true
        end
        return false
    end

    local function isSurvivor(player)
