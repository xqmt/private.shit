        local function readCachedInstanceNumeric(root, keys, keySet, srcCache, scanAt, searchDescendants)
            local cached = srcCache[root]
            if cached then
                if cached.mode == "attr" then
                    local v = cached.inst:GetAttribute(cached.key)
                    if v ~= nil then
                        return v
                    end
                elseif cached.mode == "value" then
                    if cached.inst.Parent then
                        return cached.inst.Value
                    end
                elseif cached.mode == "attrchild" then
                    if cached.inst.Parent then
                        local v = cached.inst:GetAttribute(cached.key)
                        if v ~= nil then
                            return v
                        end
                    end
                elseif cached.mode == "none" then
                    if (tick() - (scanAt[root] or 0)) < 1.5 then
                        return nil
                    end
                end
            end
            for _, k in ipairs(keys) do
                local v = root:GetAttribute(k)
                if v ~= nil then
                    srcCache[root] = { mode = "attr", inst = root, key = k }
                    return v
                end
            end
            for _, k in ipairs(keys) do
                local child = root:FindFirstChild(k)
                if child then
                    if child:IsA("ValueBase") then
                        srcCache[root] = { mode = "value", inst = child }
                        return child.Value
                    end
                    for _, attrName in ipairs(GEN_CHILD_ATTRS) do
                        local av = child:GetAttribute(attrName)
                        if av ~= nil then
                            srcCache[root] = { mode = "attrchild", inst = child, key = attrName }
                            return av
                        end
                    end
                end
            end
            if searchDescendants and root:IsA("Model") then
                for _, c in ipairs(root:GetDescendants()) do
                    if keySet[c.Name] then
                        if c:IsA("ValueBase") then
                            srcCache[root] = { mode = "value", inst = c }
                            return c.Value
                        end
                        for _, attrName in ipairs(GEN_CHILD_ATTRS) do
                            local av = c:GetAttribute(attrName)
                            if av ~= nil then
                                srcCache[root] = { mode = "attrchild", inst = c, key = attrName }
                                return av
                            end
                        end
                    end
                end
            end
            srcCache[root] = NONE_SENTINEL
            scanAt[root] = tick()
            return nil
        end

        local function getGeneratorProgress(gen)
            if not gen then
                return 0
            end
            local rawVal =
                readCachedInstanceNumeric(gen, GEN_PROG_KEYS, GEN_PROG_KEYSET, genProgSrcCache, genProgScanAt, true)
            if rawVal == nil then
                return 0
            end
            local num = tonumber(rawVal)
            if not num then
                return 0
            end
            local maxVal =
                readCachedInstanceNumeric(gen, GEN_MAX_KEYS, GEN_PROG_KEYSET, genMaxSrcCache, genMaxScanAt, false)
            local maxNum = tonumber(maxVal)
            if maxNum and maxNum > 0 then
                local ratio = num / maxNum
                return math.clamp(math.floor(ratio * 100 + 0.5), 0, 100)
            end
            if num > 0 and num <= 1.01 then
                return math.clamp(math.floor(num * 100 + 0.5), 0, 100)
            end
            if num > 1.01 then
                return math.clamp(math.floor(num + 0.5), 0, 100)
            end
            return 0
        end

        local function isGeneratorCompleted(gen)
            if not gen then
                return false, 0
            end
            local rawRp = gen:GetAttribute("RepairProgress")
            if rawRp ~= nil then
                local rpNum = tonumber(rawRp)
                if rpNum and rpNum >= 100 then
                    return true, 100
                end
            end
            local pct = getGeneratorProgress(gen)
            return (pct >= 100), pct
        end

        local function getPlayersRepairingCount(gen)
            if not gen then
                return 0
            end
            local rawVal =
                readCachedInstanceNumeric(gen, GEN_REP_KEYS, GEN_REP_KEYSET, genRepSrcCache, genRepScanAt, true)
            if rawVal == nil then
                return 0
            end
            return math.max(math.floor(tonumber(rawVal) or 0), 0)
        end
