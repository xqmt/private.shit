        local function getGroundOrigin(basePos, charFilter)
            local rayParams = RaycastParams.new()
            if charFilter then
                rayParams.FilterDescendantsInstances = { charFilter }
            end
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            local rayStart = basePos + Vector3.new(0, 1.0, 0)
            local floorHit = workspace:Raycast(rayStart, Vector3.new(0, -12.0, 0), rayParams)
            local floorY = floorHit and floorHit.Position.Y or (basePos.Y - 4.0)
            local centerY = floorY + (BURST_HEIGHT / 2)
            return Vector3.new(basePos.X, centerY, basePos.Z)
        end

        local function clearAbyssalTrajectory()
            if abyssalWindupConn then
                abyssalWindupConn:Disconnect()
                abyssalWindupConn = nil
            end
            for _, ch in ipairs(abyssFolder:GetChildren()) do
                ch:Destroy()
            end
            activeAbyssalData = nil
            activeAbyssalPhase = "IDLE"
        end

        local function drawAbyssalGeometry(data, style, color)
            if not data or not data.startPos or not data.dir then
                clearAbyssalTrajectory()
                return
            end
            local startPos = data.startPos
            local dir = data.dir.Unit
            local range = data.range or 245.0
            local endPos = startPos + dir * range
            local midPos = startPos + dir * (range / 2)
            local boxCF = CFrame.lookAt(midPos, midPos + dir)
            if style == "Hitbox" then
                local oldLine = abyssFolder:FindFirstChild("CenterLine")
                if oldLine then
                    oldLine:Destroy()
                end
                local oldMarker = abyssFolder:FindFirstChild("ImpactMarker")
                if oldMarker then
                    oldMarker:Destroy()
                end
                local box = abyssFolder:FindFirstChild("SweptHitbox")
                if not box then
                    box = Instance.new("BoxHandleAdornment")
                    box.Name = "SweptHitbox"
                    box.Adornee = workspace.Terrain
                    box.Transparency = 0.80
                    box.AlwaysOnTop = true
                    box.ZIndex = 4
                    box.Parent = abyssFolder
                end
                box.CFrame = boxCF
                box.Size = Vector3.new(BURST_WIDTH, BURST_HEIGHT, range)
                box.Color3 = color
                local endCap = abyssFolder:FindFirstChild("ImpactFace")
                if not endCap then
                    endCap = Instance.new("BoxHandleAdornment")
                    endCap.Name = "ImpactFace"
                    endCap.Adornee = workspace.Terrain
                    endCap.Transparency = 0.50
                    endCap.AlwaysOnTop = true
                    endCap.ZIndex = 5
                    endCap.Parent = abyssFolder
                end
                endCap.CFrame = CFrame.lookAt(endPos, endPos + dir)
                endCap.Size = Vector3.new(BURST_WIDTH, BURST_HEIGHT, 0.3)
                endCap.Color3 = color
            else
                local oldBox = abyssFolder:FindFirstChild("SweptHitbox")
                if oldBox then
                    oldBox:Destroy()
                end
                local oldCap = abyssFolder:FindFirstChild("ImpactFace")
                if oldCap then
                    oldCap:Destroy()
                end
                local line = abyssFolder:FindFirstChild("CenterLine")
                if not line then
                    line = Instance.new("LineHandleAdornment")
                    line.Name = "CenterLine"
                    line.Adornee = workspace.Terrain
                    line.AlwaysOnTop = true
                    line.ZIndex = 5
                    line.Thickness = 4.0
                    line.Parent = abyssFolder
                end
                line.Length = range
                line.Color3 = color
                line.CFrame = CFrame.lookAt(startPos, endPos)
                local marker = abyssFolder:FindFirstChild("ImpactMarker")
                if not marker then
                    marker = Instance.new("SphereHandleAdornment")
                    marker.Name = "ImpactMarker"
                    marker.Adornee = workspace.Terrain
                    marker.Radius = 0.6
                    marker.AlwaysOnTop = true
                    marker.ZIndex = 6
                    marker.Parent = abyssFolder
                end
                marker.Color3 = color
                marker.CFrame = CFrame.new(endPos)
            end
        end
        local hiddenMarkPhase = "IDLE"
        local hiddenMarkActId = 0
        local lastHiddenMarkOrigin = nil
        local lastHiddenMarkDir = nil

        local function clearHiddenMarkTrajectory()
            for _, ch in ipairs(hiddenFolder:GetChildren()) do
                ch:Destroy()
            end
            hiddenMarkPhase = "IDLE"
        end

        local function drawHiddenMarkLine(startPos, dir, range, color)
            local line = hiddenFolder:FindFirstChild("MarkLine")
            if not line then
                line = Instance.new("LineHandleAdornment")
                line.Name = "MarkLine"
                line.Adornee = workspace.Terrain
                line.AlwaysOnTop = true
                line.ZIndex = 5
                line.Thickness = 3.5
                line.Parent = hiddenFolder
            end
            line.Color3 = color
            line.Length = range
            line.CFrame = CFrame.lookAt(startPos, startPos + dir * range)
        end

        local function computeMarkRange(startPos, dir, charFilter)
            local rayParams = RaycastParams.new()
            if charFilter then
                rayParams.FilterDescendantsInstances = { charFilter }
            end
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.RespectCanCollide = true
            local hit = workspace:Raycast(startPos, dir * 160.0, rayParams)
            if hit then
                return math.max(1.0, (hit.Position - startPos).Magnitude)
            end
            return 160.0
        end
        local lastAbyssWaveAt = 0
        local lastAbyssWindupAt = 0
        local trajRenderConn = RunService.RenderStepped:Connect(function()
            local isCureActive = Hypnosis.Settings["The Cure_Enabled"] == true
            local isAbyssActive = Hypnosis.Settings["Abysswalker_Enabled"] == true
            local isHiddenActive = Hypnosis.Settings["The Hidden_Enabled"] == true
            if not isCureActive and not isAbyssActive and not isHiddenActive then
                if wasTrajActive then
                    wasTrajActive = false
                    clearBottleTrajectory()
                    clearAbyssalTrajectory()
                    clearHiddenMarkTrajectory()
                end
                return
            end
            wasTrajActive = true
            if isKiller(LocalPlayer) then
                return
            end
            local bottleEnabled = isCureActive and (isSettingActive("The Cure", "Bottle Trajectory") ~= false)
            local bottleCol = parseColor3(Hypnosis.Settings["The Cure_Bottle Color_Color"], Color3.fromRGB(0, 255, 170))
            if bottleEnabled then
                local cureChar = getCureCharacter()
                if cureChar and isCurePreparingFlask(cureChar) then
                    if not FT then
                        pcall(function()
                            FT = require(ReplicatedStorage.Modules.Killers.Cure.FlaskTrajectory)
                        end)
                    end
                    if FT then
                        local head = cureChar:FindFirstChild("Head") or cureChar:FindFirstChild("HumanoidRootPart")
                        local origin = cureChar:GetAttribute("CamPos")
                            or (head and head.Position)
                            or (cureChar.PrimaryPart and cureChar.PrimaryPart.Position + Vector3.new(0, 1.5, 0))
                        local lookVec = cureChar:GetAttribute("CamLook")
                            or (head and head.CFrame.LookVector)
                            or (cureChar.PrimaryPart and cureChar.PrimaryPart.CFrame.LookVector)
                        if origin and lookVec then
                            local ok, pathRes = pcall(function()
                                return FT.trace(origin, lookVec, function(p, d)
                                    return FT.cast(workspace, p, d, { cureChar })
                                end)
                            end)
                            if ok and pathRes and type(pathRes.Points) == "table" and #pathRes.Points >= 2 then
                                displayBottleTrajectory(pathRes.Points, bottleCol)
                            end
                        end
                    end
                else
                    if #cureSegments > 0 then
                        clearBottleTrajectory()
                    end
                end
            else
                if #cureSegments > 0 then
                    clearBottleTrajectory()
                end
            end
            updateCloudVisuals()
            local abyssEnabled = (isSettingActive("Abysswalker", "Abyssal Burst Trajectory") ~= false)

            local abyssStyle = (tonumber(Hypnosis.Settings["Abysswalker_Trajectory Style"]) == 2) and "Thin Line"
                or "Hitbox"
            local abyssColor =
                parseColor3(Hypnosis.Settings["Abysswalker_Trajectory Color_Color"], Color3.fromRGB(150, 60, 240))
            if abyssEnabled then
                local abyssChar = getAbysswalkerCharacter()
                if abyssChar then
                    local waveAt = abyssChar:GetAttribute("CorruptWaveAt")
                    local windupAt = abyssChar:GetAttribute("CorruptWindupAt")
                    if type(waveAt) == "number" and waveAt > lastAbyssWaveAt then
                        lastAbyssWaveAt = waveAt
                        abyssalActId = abyssalActId + 1
                        local myActId = abyssalActId
                        activeAbyssalPhase = "RELEASED"
                        local hrp = abyssChar:FindFirstChild("HumanoidRootPart")
                        local sFrom = abyssChar:GetAttribute("CorruptWaveFrom")
                            or (hrp and hrp.Position)
                            or Vector3.new()
                        local sDir = abyssChar:GetAttribute("CorruptWaveDir")
                            or (hrp and hrp.CFrame.LookVector)
                            or Vector3.new(0, 0, -1)
                        local groundStart = getGroundOrigin(sFrom, abyssChar)
                        local horizDir = Vector3.new(sDir.X, 0, sDir.Z).Unit
                        activeAbyssalData = { startPos = groundStart, dir = horizDir, range = 245.0 }
                        drawAbyssalGeometry(activeAbyssalData, abyssStyle, abyssColor)
                        task.delay(5.0, function()
                            if abyssalActId == myActId and activeAbyssalPhase == "RELEASED" then
                                clearAbyssalTrajectory()
                            end
                        end)
                    elseif type(windupAt) == "number" and windupAt > lastAbyssWindupAt then
                        lastAbyssWindupAt = windupAt
                        if activeAbyssalPhase ~= "RELEASED" then
                            activeAbyssalPhase = "AIMING"
                            abyssalActId = abyssalActId + 1
                        end
                    end
                    if activeAbyssalPhase == "AIMING" then
                        local hrp = abyssChar:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local lookVec = abyssChar:GetAttribute("CamLook") or hrp.CFrame.LookVector
                            local horizDir = Vector3.new(lookVec.X, 0, lookVec.Z)
                            if horizDir.Magnitude > 0.001 then
                                horizDir = horizDir.Unit
                            else
                                horizDir = Vector3.new(0, 0, -1)
                            end
                            local groundStart = getGroundOrigin(hrp.Position, abyssChar)
                            activeAbyssalData = { startPos = groundStart, dir = horizDir, range = 245.0 }
                            drawAbyssalGeometry(activeAbyssalData, abyssStyle, abyssColor)
                        end
                    end
                end
            else
                if activeAbyssalPhase ~= "IDLE" then
                    clearAbyssalTrajectory()
                end
            end
            local hiddenEnabled = isSettingActive("The Hidden", "Mark Trajectory") ~= false
            local hiddenColor =
                parseColor3(Hypnosis.Settings["The Hidden_Mark Color_Color"], Color3.fromRGB(255, 60, 60))
            if hiddenEnabled then
                local hChar = getHiddenCharacter()
                if hChar then
                    local markAt = hChar:GetAttribute("MarkWindupAt")
                    local hrp = hChar:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local isPrep = hChar:GetAttribute("IsMarking") == true
                            or (type(markAt) == "number" and (workspace:GetServerTimeNow() - markAt) <= 3.0)
                        if isPrep then
                            local lookVec = hChar:GetAttribute("CamLook") or hrp.CFrame.LookVector
                            local horizDir = Vector3.new(lookVec.X, 0, lookVec.Z).Unit
                            local groundOrigin = getGroundOrigin(hrp.Position, hChar)
                            local range = computeMarkRange(groundOrigin, horizDir, hChar)
                            lastHiddenMarkOrigin = groundOrigin
                            lastHiddenMarkDir = horizDir
                            drawHiddenMarkLine(groundOrigin, horizDir, range, hiddenColor)
                        else
                            if hiddenFolder:FindFirstChild("MarkLine") and hiddenMarkPhase ~= "RELEASED" then
                                clearHiddenMarkTrajectory()
                            end
                        end
                    end
                end
            else
                if hiddenFolder:FindFirstChild("MarkLine") then
                    clearHiddenMarkTrajectory()
                end
            end
        end)
        table.insert(Hypnosis.Connections, trajRenderConn)
    end

    function Hypnosis.InitLocomotionEngine()
        local isSpeedBoostActive = false
        local activeBoostChar = nil
        local lastGraceStamp = 0
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.IgnoreWater = true
        pcall(function()
            rayParams.RespectCanCollide = true
        end)
        local lastFilteredChar = nil
        local lastFilterSync = 0
        local climbRootNames = { "climb_obsessing", "climb_collisoning", "climb_collisioning", "climb_colliding" }

        local function syncRayFilter(char, now)
            if char == lastFilteredChar and (now - lastFilterSync) < 2.0 then
                return
            end
            lastFilteredChar = char
            lastFilterSync = now
            local filter = { char }
            local ghostFolder = workspace:FindFirstChild("Hypnosis_GhostVisuals")
            if ghostFolder then
                filter[#filter + 1] = ghostFolder
            end
            for i = 1, #climbRootNames do
                local root = workspace:FindFirstChild(climbRootNames[i])
                if root then
                    local cm = root:FindFirstChild(LocalPlayer.Name)
                    if cm then
                        filter[#filter + 1] = cm
                    end
                end
            end
            rayParams.FilterDescendantsInstances = filter
        end

        local function clearCharBoostAttributes(char)
            if not char then
                return
            end
            pcall(char.SetAttribute, char, "donttrack", nil)
            pcall(char.SetAttribute, char, "AC_MovementGraceUntil", nil)
            pcall(char.SetAttribute, char, "AC_AllowedSpeed", nil)
            pcall(char.SetAttribute, char, "NetTraversalUntil", nil)
            pcall(char.SetAttribute, char, "ForensicsLaunch", nil)
        end

        local function clearBoostState()
            isSpeedBoostActive = false
            lastGraceStamp = 0
            if activeBoostChar then
                clearCharBoostAttributes(activeBoostChar)
                activeBoostChar = nil
            end
        end
        if LocalPlayer and LocalPlayer.Character then
            clearCharBoostAttributes(LocalPlayer.Character)
        end

        local function isActionLocked(char, hrp)
            if not char then
                return true
            end
            if Hypnosis._IsInteractingPrompt then
                return true
            end
            if hrp and CollectionService then
                local ok, hasTag = pcall(CollectionService.HasTag, CollectionService, hrp, "doing action")
                if ok and hasTag then
                    return true
                end
            end
            local ci = char:FindFirstChild("CheckInterractable")
            if ci then
                if
                    ci:GetAttribute("isVaulting") == true
                    or ci:GetAttribute("isSliding") == true
                    or ci:GetAttribute("isRepairing") == true
                    or ci:GetAttribute("isHealing") == true
                    or ci:GetAttribute("isUnhooking") == true
                    or ci:GetAttribute("isCarried") == true
                    or ci:GetAttribute("isDisarming") == true
                    or ci:GetAttribute("isExiting") == true
                then
                    return true
                end
            end
            if
                char:GetAttribute("isvaulting") == true
                or char:GetAttribute("issliding") == true
                or char:GetAttribute("IsStunned") == true
                or char:GetAttribute("Immobile") == true
                or char:GetAttribute("IsHooked") == true
                or char:GetAttribute("Knocked") == true
                or char:GetAttribute("IsCarried") == true
                or char:GetAttribute("downed") == true
                or char:GetAttribute("hooked") == true
                or char:GetAttribute("Trapped") == true
                or char:GetAttribute("Repairing") == true
                or char:GetAttribute("Healing") == true
            then
                return true
            end
            if
                LocalPlayer:GetAttribute("downed") == true
                or LocalPlayer:GetAttribute("hooked") == true
                or LocalPlayer:GetAttribute("Knocked") == true
            then
                return true
            end
            return false
        end
        local lastLocomotionIsKiller = isKiller(LocalPlayer)
        local simSignal = RunService.PostSimulation or RunService.Heartbeat
        local locomotionConn = simSignal:Connect(function(dt)
            if Hypnosis._Unloaded or Hypnosis._Teleporting then
                return
            end
            local cam = workspace.CurrentCamera
            local inCutscene = cam and cam.CameraType == Enum.CameraType.Scriptable
            if inCutscene or not isInActiveGameTeam(LocalPlayer) then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local curIsKiller = isKiller(LocalPlayer)
            if curIsKiller ~= lastLocomotionIsKiller then
                lastLocomotionIsKiller = curIsKiller
                if isSpeedBoostActive then
                    clearBoostState()
                end
            end
            if Hypnosis.Settings["Speed Boost_Enabled"] ~= true then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local rawMult = tonumber(Hypnosis.Settings["Speed Boost_Speed Multiplier"])
            if rawMult == nil then
                rawMult = 1.35
            end
            local mult = math.clamp(math.floor(rawMult * 100 + 0.5) / 100, 0.1, 10.0)
            local deltaMult = mult - 1.0
            if math.abs(deltaMult) < 0.001 then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local char = LocalPlayer.Character
            if not char or not char.Parent then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if not hrp or not hum or hum.Health <= 0 or hrp.Anchored then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            if isActionLocked(char, hrp) or hrp:FindFirstChild("RushVelocity") ~= nil then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local moveDir = hum.MoveDirection
            local flatMagSq = moveDir.X * moveDir.X + moveDir.Z * moveDir.Z
            if flatMagSq < 0.0025 then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local gameWalkSpeed = hum.WalkSpeed
            if gameWalkSpeed <= 0.1 then
                if isSpeedBoostActive then
                    clearBoostState()
                end
                return
            end
            local cappedWalkSpeed = math.clamp(gameWalkSpeed, 0, 26)
            local invFlatMag = 1 / math.sqrt(flatMagSq)
            local dirX = moveDir.X * invFlatMag
            local dirZ = moveDir.Z * invFlatMag
            local curVel = hrp.AssemblyLinearVelocity
            local horizSpeed = math.sqrt(curVel.X * curVel.X + curVel.Z * curVel.Z)
            local maxSafeHoriz = math.max(cappedWalkSpeed + 3.5, 21.5)
            if horizSpeed > maxSafeHoriz then
                local vScale = maxSafeHoriz / horizSpeed
                curVel = Vector3.new(curVel.X * vScale, math.clamp(curVel.Y, -75, 55), curVel.Z * vScale)
                hrp.AssemblyLinearVelocity = curVel
                horizSpeed = maxSafeHoriz
            end
            local alongDirSpeed = curVel.X * dirX + curVel.Z * dirZ
            local baseSpeed = math.clamp(alongDirSpeed, 0, cappedWalkSpeed)
            if baseSpeed <= 0.05 then
                return
            end
            local now = os.clock()
            if activeBoostChar and activeBoostChar ~= char then
                clearCharBoostAttributes(activeBoostChar)
            end
            activeBoostChar = char
            isSpeedBoostActive = true
            if deltaMult > 0 and (now - lastGraceStamp) >= 0.4 then
                lastGraceStamp = now
                local allowedSpd = math.ceil(math.max(24, cappedWalkSpeed * mult + 6))
                local graceUntil = now + 1.2
                pcall(char.SetAttribute, char, "donttrack", true)
                pcall(char.SetAttribute, char, "AC_AllowedSpeed", allowedSpd)
                pcall(char.SetAttribute, char, "AC_MovementGraceUntil", graceUntil)
                pcall(char.SetAttribute, char, "NetTraversalUntil", graceUntil)
            end
            local clampedDt = math.clamp(dt or 0.0166667, 0.0005, 0.05)
            local rawStepDist = baseSpeed * math.abs(deltaMult) * clampedDt
            if rawStepDist <= 0.00005 then
                return
            end
            syncRayFilter(char, now)
            local stepSign = (deltaMult >= 0) and 1 or -1
            local stepDirX = dirX * stepSign
            local stepDirZ = dirZ * stepSign
            local hrpPos = hrp.Position
            local bodyRadius = 1.25
            local castLen = rawStepDist + bodyRadius
            local castVec = Vector3.new(stepDirX * castLen, 0, stepDirZ * castLen)
            local hitWaist = workspace:Raycast(hrpPos, castVec, rayParams)
            local hitKnee = workspace:Raycast(Vector3.new(hrpPos.X, hrpPos.Y - 1.25, hrpPos.Z), castVec, rayParams)
            local wallHit = nil
            if hitWaist and hitWaist.Normal.Y < 0.48 then
                wallHit = hitWaist
            end
            if hitKnee and hitKnee.Normal.Y < 0.48 then
                if not wallHit or hitKnee.Distance < wallHit.Distance then
                    wallHit = hitKnee
                end
            end
            local moveX = stepDirX * rawStepDist
            local moveZ = stepDirZ * rawStepDist
            if wallHit then
                local directDist = math.max(0, wallHit.Distance - bodyRadius)
                moveX = stepDirX * directDist
                moveZ = stepDirZ * directDist
                local remDist = rawStepDist - directDist
                if stepSign > 0 and remDist > 0.0005 then
                    local nx = wallHit.Normal.X
                    local nz = wallHit.Normal.Z
                    local nMagSq = nx * nx + nz * nz
                    if nMagSq > 0.001 then
                        local invN = 1 / math.sqrt(nMagSq)
                        nx = nx * invN
                        nz = nz * invN
                        local dotN = stepDirX * nx + stepDirZ * nz
                        local tanX = stepDirX - nx * dotN
                        local tanZ = stepDirZ - nz * dotN
                        local tanMag = math.sqrt(tanX * tanX + tanZ * tanZ)
                        if tanMag > 0.15 then
                            local slideDist = remDist * tanMag
                            local uTanX = tanX / tanMag
                            local uTanZ = tanZ / tanMag
                            local slideOrigin = Vector3.new(hrpPos.X + moveX, hrpPos.Y, hrpPos.Z + moveZ)
                            local slideCast =
                                Vector3.new(uTanX * (slideDist + bodyRadius), 0, uTanZ * (slideDist + bodyRadius))
                            local slideHit = workspace:Raycast(slideOrigin, slideCast, rayParams)
                            local allowedSlide = slideDist
                            if slideHit and slideHit.Normal.Y < 0.48 then
                                allowedSlide = math.max(0, slideHit.Distance - bodyRadius)
                            end
                            moveX = moveX + uTanX * allowedSlide
                            moveZ = moveZ + uTanZ * allowedSlide
                        end
                    end
                end
            end
            local moveY = 0
            local horizMoved = math.sqrt(moveX * moveX + moveZ * moveZ)
            if horizMoved > 0.0002 and hum.FloorMaterial ~= Enum.Material.Air and math.abs(curVel.Y) < 12 then
                local downCur = workspace:Raycast(hrpPos, Vector3.new(0, -5.5, 0), rayParams)
                if downCur and downCur.Normal.Y >= 0.45 then
                    local hipDist = hrpPos.Y - downCur.Position.Y
                    if hipDist >= 1.4 and hipDist <= 4.8 then
                        local probeOrigin = Vector3.new(hrpPos.X + moveX, hrpPos.Y + 0.9, hrpPos.Z + moveZ)
                        local downNext = workspace:Raycast(probeOrigin, Vector3.new(0, -(hipDist + 1.8), 0), rayParams)
                        if downNext and downNext.Normal.Y >= 0.45 then
                            local candidateDy = (downNext.Position.Y + hipDist) - hrpPos.Y
                            local maxSlopeDy = horizMoved * 1.35
                            if candidateDy >= -maxSlopeDy and candidateDy <= maxSlopeDy then
                                moveY = candidateDy
                            end
                        end
                    end
                end
            end
            if (moveX * moveX + moveY * moveY + moveZ * moveZ) > 1e-8 then
                hrp.CFrame = hrp.CFrame + Vector3.new(moveX, moveY, moveZ)
            end
        end)
        table.insert(Hypnosis.Connections, locomotionConn)
        Hypnosis.CleanupLocomotion = clearBoostState

        function Hypnosis.ToggleSpeedBoost(state)
            UpdateSetting("Speed Boost_Enabled", state)
            if not state then
                clearBoostState()
            end
        end
    end

    function Hypnosis.InitInstantHeal()
        local isHealingNow = false

        local function executeInstantHeal(char)
            if isHealingNow or isKiller(LocalPlayer) then
                return
            end
            char = char or LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
            if not char or not char.Parent then
                return
            end
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if not hum or hum.Health <= 0 then
                return
            end
            isHealingNow = true
            pcall(function()
                if hrp then
                    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                    local healRemote = remotes
                        and remotes:FindFirstChild("Healing")
                        and remotes.Healing:FindFirstChild("HealEvent")
                    if healRemote and healRemote:IsA("RemoteEvent") then
                        healRemote:FireServer(hrp, true)
                    else
                        for _, desc in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                            if desc.Name == "HealEvent" and desc:IsA("RemoteEvent") then
                                desc:FireServer(hrp, true)
                                break
                            end
                        end
                    end
                end
                if hum.MaxHealth and hum.MaxHealth > 0 then
                    hum.Health = hum.MaxHealth
                else
                    hum.Health = 100
                end
                char:SetAttribute("Knocked", false)
                char:SetAttribute("downed", false)
                char:SetAttribute("Immobile", false)
                char:SetAttribute("Bleeding", false)
                LocalPlayer:SetAttribute("Knocked", false)
                LocalPlayer:SetAttribute("downed", false)
                LocalPlayer:SetAttribute("Bleeding", false)
                local kv = char:FindFirstChild("Knocked")
                if kv and kv:IsA("BoolValue") then
                    kv.Value = false
                end
                local dv = char:FindFirstChild("downed")
                if dv and dv:IsA("BoolValue") then
                    dv.Value = false
                end
                hum.PlatformStand = false
                hum.Sit = false
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end)
                local anim = hum:FindFirstChildOfClass("Animator")
                if anim then
                    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                        local name = track.Name:lower()
                        if name:find("knock") or name:find("crawl") or name:find("down") or name:find("bleed") then
                            pcall(function()
                                track:Stop(0)
                            end)
                        end
                    end
                end
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and not part.CanCollide then
                        local pName = part.Name:lower()
                        if pName ~= "humanoidrootpart" and not pName:find("inter") and not pName:find("sensor") then
                            part.CanCollide = true
                        end
                    end
                end
            end)
            task.delay(0.2, function()
                isHealingNow = false
            end)
        end

        local function checkAndHeal(char)
            if
                Hypnosis.Settings["Instant Heal_Enabled"] ~= true
                or isKiller(LocalPlayer)
                or not isInActiveGameTeam(LocalPlayer)
            then
                return
            end
            char = char or LocalPlayer.Character
            if not char then
                return
            end
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if not hum or hum.Health <= 0 then
                return
            end
            local maxH = hum.MaxHealth or 100
            local isKnocked = false
            if char:GetAttribute("Knocked") == true or LocalPlayer:GetAttribute("Knocked") == true then
                isKnocked = true
            elseif char:GetAttribute("downed") == true or LocalPlayer:GetAttribute("downed") == true then
                isKnocked = true
            elseif char:FindFirstChild("Knocked") and char.Knocked.Value == true then
                isKnocked = true
            end
            if isKnocked or hum.Health < maxH or hum.PlatformStand or hum.Sit then
                executeInstantHeal(char)
            end
        end

        local function bindCharacter(char)
            if not char then
                return
            end
            local attrConn1 = char:GetAttributeChangedSignal("Knocked"):Connect(function()
                checkAndHeal(char)
            end)
            table.insert(Hypnosis.Connections, attrConn1)
            local attrConn2 = char:GetAttributeChangedSignal("downed"):Connect(function()
                checkAndHeal(char)
            end)
            table.insert(Hypnosis.Connections, attrConn2)
            local hum = char:WaitForChild("Humanoid", 3)
            if hum then
                local healthConn = hum.HealthChanged:Connect(function(newHealth)
                    if Hypnosis.Settings["Instant Heal_Enabled"] == true and newHealth < (hum.MaxHealth or 100) then
                        checkAndHeal(char)
                    end
                end)
                table.insert(Hypnosis.Connections, healthConn)
                local stateConn = hum.StateChanged:Connect(function(_, newState)
                    if Hypnosis.Settings["Instant Heal_Enabled"] == true then
                        if
                            newState == Enum.HumanoidStateType.PlatformStanding
                            or newState == Enum.HumanoidStateType.Seated
                        then
                            checkAndHeal(char)
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, stateConn)
            end
            checkAndHeal(char)
        end
        if LocalPlayer.Character then
            bindCharacter(LocalPlayer.Character)
        end
        local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.2)
            bindCharacter(char)
        end)
        table.insert(Hypnosis.Connections, charAddedConn)
        local lpAttrConn = LocalPlayer:GetAttributeChangedSignal("Knocked"):Connect(function()
            checkAndHeal(LocalPlayer.Character)
        end)
        table.insert(Hypnosis.Connections, lpAttrConn)
        local lastCheck = 0
        local healHeartbeatConn = RunService.Heartbeat:Connect(function()
            if Hypnosis.Settings["Instant Heal_Enabled"] ~= true then
                return
            end
            local now = tick()
            if now - lastCheck < 0.05 then
                return
            end
            lastCheck = now
            checkAndHeal(LocalPlayer.Character)
        end)
        table.insert(Hypnosis.Connections, healHeartbeatConn)

        local function doSelfHeal()
            pcall(function()
                local char = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
                local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
                if not hrp then
                    showNotification("Heal", "HumanoidRootPart not found!", "warning")
                    return
                end
                local rep = game:GetService("ReplicatedStorage")
                local remotes = rep:FindFirstChild("Remotes")
                local healEvent = remotes
                    and remotes:FindFirstChild("Healing")
                    and remotes.Healing:FindFirstChild("HealEvent")
                if healEvent and healEvent:IsA("RemoteEvent") then
                    healEvent:FireServer(hrp, true)
                else
                    for _, desc in ipairs(rep:GetDescendants()) do
                        if desc.Name == "HealEvent" and desc:IsA("RemoteEvent") then
                            desc:FireServer(hrp, true)
                            break
                        end
                    end
                end
                executeInstantHeal(char)
                showNotification("Heal", "Heal event sent!", "success")
            end)
        end
        Hypnosis.DoSelfHeal = doSelfHeal

        function Hypnosis.TriggerInstantHeal()
            doSelfHeal()
        end

        function Hypnosis.ToggleInstantHeal(state)
            UpdateSetting("Instant Heal_Enabled", state)
            if state then
                doSelfHeal()
            end
        end
    end

    function Hypnosis.InitTwistOfFateInstantCharge()
        local tofTuningModule = nil
        local originalSteps = nil
        local originalStepFor = nil
        local lastAimHoldSync = 0
        local tofHookInstalled = false

        local function ensureTofTuning()
            if tofTuningModule and tofTuningModule.STEPS then
                return tofTuningModule
            end
            local ok, tuning = pcall(function()
                local mods = ReplicatedStorage:FindFirstChild("Modules")
                local items = mods and mods:FindFirstChild("Items")
                local tof = items and items:FindFirstChild("TwistOfFate")
                local mod = tof and tof:FindFirstChild("TwistoffateTuning")
                return mod and require(mod) or nil
            end)
            if ok and tuning and tuning.STEPS then
                tofTuningModule = tuning
            end
            return tofTuningModule
        end

        local function patchClientUpvalue(targetVal)
            pcall(function()
                if not getgc or not debug or not debug.getupvalues or not debug.setupvalue then
                    return
                end
                for _, obj in ipairs(getgc()) do
                    if type(obj) == "function" and (not islclosure or islclosure(obj)) then
                        local info = debug.getinfo(obj)
                        if info and info.source and info.source:find("TwistoffateClient") then
                            local u = debug.getupvalues(obj)
                            for k, v in pairs(u) do
                                if (targetVal == 0 and v == 0.75) or (targetVal == 0.75 and v == 0) then
                                    debug.setupvalue(obj, k, targetVal)
                                end
                            end
                        end
                    end
                end
            end)
        end

        local function applyInstantCharge(enable)
            local mod = enable and ensureTofTuning() or tofTuningModule
            if not mod or not mod.STEPS then
                return
            end
            if enable then
                if not originalSteps then
                    originalSteps = {}
                    for i, step in ipairs(mod.STEPS) do
                        originalSteps[i] = {
                            at = step.at,
                            casual = step.casual,
                            ranked = step.ranked,
                            jam = step.jam,
                            empty = step.empty,
                        }
                    end
                end
                if not originalStepFor then
                    originalStepFor = mod.stepFor
                end
                for _, step in ipairs(mod.STEPS) do
                    step.at = 0
                    step.casual = 0
                    if step.ranked ~= nil then
                        step.ranked = 0
                    end
                    step.jam = 0
                    step.empty = 0
                end
                mod.stepFor = function()
                    return 3
                end
                patchClientUpvalue(0)
            else
                if originalSteps then
                    for i, step in ipairs(mod.STEPS) do
                        local o = originalSteps[i]
                        if o then
                            step.at = o.at
                            step.casual = o.casual
                            if step.ranked ~= nil then
                                step.ranked = o.ranked
                            end
                            step.jam = o.jam
                            step.empty = o.empty
                        end
                    end
                else
                    if mod.STEPS[1] then
                        mod.STEPS[1].at = 0.75
                        mod.STEPS[1].casual = 0.75
                        mod.STEPS[1].jam = 0.4
                        mod.STEPS[1].empty = 0.8
                    end
                    if mod.STEPS[2] then
                        mod.STEPS[2].at = 1.8
                        mod.STEPS[2].casual = 1.8
                        mod.STEPS[2].jam = 0.2
                        mod.STEPS[2].empty = 0.65
                    end
                    if mod.STEPS[3] then
                        mod.STEPS[3].at = 3.0
                        mod.STEPS[3].casual = 3.0
                        mod.STEPS[3].jam = 0.0
                        mod.STEPS[3].empty = 0.5
                    end
                end
                if originalStepFor then
                    mod.stepFor = originalStepFor
                else
                    mod.stepFor = function(a1)
                        local v1 = 1
                        for i, j in ipairs(mod.STEPS) do
                            if j.at <= a1 then
                                v1 = i
                            end
                        end
                        return v1
                    end
                end
                patchClientUpvalue(0.75)
            end
        end

        local function ensureTofNamecallHook()
            if tofHookInstalled or Hypnosis._TofHookInstalled then
                return
            end
            local okHook = Hypnosis._SafeHookNamecall(function(oldNamecall, selfRemote, ...)
                local method = getnamecallmethod()
                if
                    (method == "FireServer" or method == "fireServer")
                    and typeof(selfRemote) == "Instance"
                    and selfRemote.Name == "Fire"
                then
                    local isEnabled = Hypnosis.Settings["Twist of Fate Instant Charge_Enabled"] == true
                    local enforce3 = Hypnosis.Settings["Twist of Fate Instant Charge_Enforce Stage 3"] ~= false
                    if isEnabled and enforce3 then
                        local parent = selfRemote.Parent
                        if parent and parent.Name == "Twist of Fate" then
                            local args = { ... }
                            if #args >= 3 then
                                args[3] = 3
                                return oldNamecall(selfRemote, (table.unpack or unpack)(args))
                            end
                        end
                    end
                end
                return oldNamecall(selfRemote, ...)
            end)
            if okHook then
                tofHookInstalled = true
                Hypnosis._TofHookInstalled = true
            end
        end
        local tofHeartbeat = RunService.Heartbeat:Connect(function()
            if Hypnosis.Settings["Twist of Fate Instant Charge_Enabled"] ~= true then
                return
            end
            if not tofHookInstalled and Hypnosis.Settings["Twist of Fate Instant Charge_Enforce Stage 3"] ~= false then
                ensureTofNamecallHook()
            end
            if Hypnosis.Settings["Twist of Fate Instant Charge_Auto Aim-Hold Sync"] == false then
                return
            end
            local now = os.clock()
            if now - lastAimHoldSync < 1.5 then
                return
            end
            lastAimHoldSync = now
            pcall(function()
                local char = LocalPlayer.Character
                if not char then
                    return
                end
                local tof = char:FindFirstChild("Twist of Fate")
                if tof and tof:GetAttribute("tofState") == "ready" then
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    local items = remotes and remotes:FindFirstChild("Items")
                    local tofRemotes = items and items:FindFirstChild("Twist of Fate")
                    local aimHold = tofRemotes and tofRemotes:FindFirstChild("AimHold")
                    if aimHold and aimHold:IsA("RemoteEvent") then
                        aimHold:FireServer(tof, true)
                    end
                end
            end)
        end)
        table.insert(Hypnosis.Connections, tofHeartbeat)

        function Hypnosis.ToggleTwistOfFateInstantCharge(state)
            UpdateSetting("Twist of Fate Instant Charge_Enabled", state)
            if state then
                ensureTofNamecallHook()
            end
            applyInstantCharge(state)
        end
    end

    function Hypnosis.InitKillerArmVisuals()
        local armOriginalSizes = {}
        local chamsOriginals = {}
        local chamsSurfaceAppearances = {}
        local chamsTextures = {}
        local cameraRef = workspace.CurrentCamera

        local function isHandPart(part)
            local n = string.lower(part.Name)
            local p = string.lower(part.Parent and part.Parent.Name or "")
            if n == "humanoidrootpart" or n == "camera" then
                return false
            end
            if string.find(n, "handle") or string.find(p, "handle") then
                return false
            end
            if string.find(n, "spear") or string.find(p, "spear") then
                return false
            end
            if string.find(n, "knife") or string.find(p, "knife") then
                return false
            end
            if string.find(n, "blade") or string.find(p, "blade") then
                return false
            end
            if string.find(n, "weapon") or string.find(p, "weapon") then
                return false
            end
            if string.find(n, "gun") or string.find(p, "gun") then
                return false
            end
            if string.find(n, "bat") or string.find(p, "bat") then
                return false
            end
            if string.find(n, "arm") or string.find(p, "arm") then
                return true
            end
            if string.find(n, "hand") or string.find(p, "hand") then
                return true
            end
            if string.find(n, "glove") or string.find(p, "glove") then
                return true
            end
            if string.find(n, "sleeve") or string.find(p, "sleeve") then
                return true
            end
            if string.find(n, "wrist") or string.find(p, "wrist") then
                return true
            end
            if string.find(n, "finger") or string.find(p, "finger") then
                return true
            end
            return false
        end

        local function restoreChamsPart(part)
            if not part then
                return
            end
            local orig = chamsOriginals[part]
            if orig then
                pcall(function()
                    if part.Parent then
                        part.Color = orig.Color
                        part.Material = orig.Material
                        part.Transparency = orig.Transparency
                        part.Reflectance = orig.Reflectance
                        if part:IsA("MeshPart") and orig.TextureID then
                            part.TextureID = orig.TextureID
                        end
                        local sMesh = part:FindFirstChildOfClass("SpecialMesh")
                        if sMesh and orig.MeshTextureId then
                            sMesh.TextureId = orig.MeshTextureId
                        end
                    end
                end)
                chamsOriginals[part] = nil
            end
            local sa = chamsSurfaceAppearances[part]
            if sa and part and part.Parent then
                pcall(function()
                    sa.Parent = part
                end)
                chamsSurfaceAppearances[part] = nil
            end
            local texList = chamsTextures[part]
            if texList and part and part.Parent then
                pcall(function()
                    for _, t in ipairs(texList) do
                        if t.Parent == part then
                            t.Transparency = 0
                        end
                    end
                end)
                chamsTextures[part] = nil
            end
        end

        local function restoreAllChams()
            for part, _ in pairs(chamsOriginals) do
                restoreChamsPart(part)
            end
            for part, sa in pairs(chamsSurfaceAppearances) do
                if sa and part and part.Parent then
                    pcall(function()
                        sa.Parent = part
                    end)
                end
            end
            for part, texList in pairs(chamsTextures) do
                if texList and part and part.Parent then
                    pcall(function()
                        for _, t in ipairs(texList) do
                            if t.Parent == part then
                                t.Transparency = 0
                            end
                        end
                    end)
                end
            end
            table.clear(chamsOriginals)
            table.clear(chamsSurfaceAppearances)
            table.clear(chamsTextures)
        end

        local function restoreAllArmStretch()
            for part, origSize in pairs(armOriginalSizes) do
                if part and part.Parent then
                    pcall(function()
                        part.Size = origSize
                    end)
                end
            end
            table.clear(armOriginalSizes)
        end
        local cachedArmVm = nil
        local cachedArmChar = nil
        local cachedArmAffectWeapon = nil
        local lastArmPartsScan = 0
        local cachedHandsParts = {}
        local cachedVmWeaponParts = {}
        local cachedCharWeaponParts = {}
        local pooledChamTargets = {}

        local function updateVisuals()
            local isArmStretch = Hypnosis.Settings["Killer Arm Visuals_Arm Stretch"] == true
            local isChams = Hypnosis.Settings["Killer Arm Visuals_Material Chams"] == true
            if not isArmStretch and next(armOriginalSizes) ~= nil then
                restoreAllArmStretch()
            end
            if
                not isChams
                and (next(chamsOriginals) ~= nil or next(chamsSurfaceAppearances) ~= nil or next(chamsTextures) ~= nil)
            then
                restoreAllChams()
            end
            if not isArmStretch and not isChams then
                return
            end
            cameraRef = workspace.CurrentCamera
            if not cameraRef then
                return
            end
            local vm = cameraRef:FindFirstChild("VM")
                or cameraRef:FindFirstChild("ViewModel")
                or cameraRef:FindFirstChild("Viewmodel")
            if not vm then
                cachedArmVm = nil
                return
            end
            local affectWeapon = Hypnosis.Settings["Killer Arm Visuals_Affect Weapon"] == true
            local char = affectWeapon and LocalPlayer.Character or nil
            local now = os.clock()
            if
                vm ~= cachedArmVm
                or char ~= cachedArmChar
                or affectWeapon ~= cachedArmAffectWeapon
                or (now - lastArmPartsScan) >= 1.0
            then
                cachedArmVm = vm
                cachedArmChar = char
                cachedArmAffectWeapon = affectWeapon
                lastArmPartsScan = now
                table.clear(cachedHandsParts)
                table.clear(cachedVmWeaponParts)
                for _, desc in ipairs(vm:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        local n = string.lower(desc.Name)
                        if n ~= "humanoidrootpart" and n ~= "camera" and not string.find(n, "root") then
                            if isHandPart(desc) then
                                table.insert(cachedHandsParts, desc)
                            else
                                table.insert(cachedVmWeaponParts, desc)
                            end
                        end
                    end
                end
                table.clear(cachedCharWeaponParts)
                if affectWeapon and char then
                    for _, item in ipairs(char:GetChildren()) do
                        if
                            item:IsA("Tool")
                            or item.Name == "Spear"
                            or item.Name == "Knife"
                            or item.Name == "Weapon"
                        then
                            for _, desc in ipairs(item:GetDescendants()) do
                                if desc:IsA("BasePart") and not string.find(string.lower(desc.Name), "root") then
                                    table.insert(cachedCharWeaponParts, desc)
                                end
                            end
                        end
                    end
                end
            end
            if not affectWeapon then
                for _, part in ipairs(cachedVmWeaponParts) do
                    if
                        part.Parent and (chamsOriginals[part] or chamsSurfaceAppearances[part] or chamsTextures[part])
                    then
                        restoreChamsPart(part)
                    end
                end
            end
            if isArmStretch then
                local lenMult =
                    math.clamp(tonumber(Hypnosis.Settings["Killer Arm Visuals_Arm Length"]) or 1.0, 0.5, 3.0)
                local thickMult =
                    math.clamp(tonumber(Hypnosis.Settings["Killer Arm Visuals_Arm Thickness"]) or 1.0, 0.2, 2.0)
                for _, part in ipairs(cachedHandsParts) do
                    if part.Parent then
                        if not armOriginalSizes[part] then
                            armOriginalSizes[part] = part.Size
                        end
                        local orig = armOriginalSizes[part]
                        local targetSize = Vector3.new(orig.X * thickMult, orig.Y * lenMult, orig.Z * thickMult)
                        if (part.Size - targetSize).Magnitude > 0.001 then
                            part.Size = targetSize
                        end
                    end
                end
            end
            if isChams then
                local targets = pooledChamTargets
                table.clear(targets)
                for _, p in ipairs(cachedHandsParts) do
                    if p.Parent then
                        table.insert(targets, p)
                    end
                end
                if affectWeapon then
                    for _, p in ipairs(cachedVmWeaponParts) do
                        if p.Parent then
                            table.insert(targets, p)
                        end
                    end
                    for _, p in ipairs(cachedCharWeaponParts) do
                        if p.Parent then
                            table.insert(targets, p)
                        end
                    end
                end
                local matIdx = tonumber(Hypnosis.Settings["Killer Arm Visuals_Chams Material"]) or 1
                local matNames = { "ForceField", "Glass", "Neon" }
                local matEnum = Enum.Material[matNames[matIdx] or "ForceField"] or Enum.Material.ForceField
                local transVal =
                    math.clamp((tonumber(Hypnosis.Settings["Killer Arm Visuals_Chams Transparency"]) or 75) / 100, 0, 1)
                local colVal = Hypnosis.Settings["Killer Arm Visuals_Chams Color_Color"]
                    or Color3.fromRGB(255, 255, 255)
                for _, part in ipairs(targets) do
                    if not chamsOriginals[part] then
                        local sMesh = part:FindFirstChildOfClass("SpecialMesh")
                        chamsOriginals[part] = {
                            Color = part.Color,
                            Material = part.Material,
                            Transparency = part.Transparency,
                            Reflectance = part.Reflectance,
                            TextureID = part:IsA("MeshPart") and part.TextureID or nil,
                            MeshTextureId = sMesh and sMesh.TextureId or nil,
                            WasInvisible = (part.Transparency >= 0.98),
                        }
                    end
                    local orig = chamsOriginals[part]
                    if not orig.WasInvisible then
                        local pName = string.lower(part.Name)
                        local isMesh = part:IsA("MeshPart") or (part:FindFirstChildOfClass("SpecialMesh") ~= nil)
                        if not isMesh and (pName == "left arm" or pName == "right arm") then
                            part.Transparency = 1
                        else
                            local sa = part:FindFirstChildOfClass("SurfaceAppearance")
                            if sa and not chamsSurfaceAppearances[part] then
                                chamsSurfaceAppearances[part] = sa
                                sa.Parent = nil
                            end
                            local texs = {}
                            for _, ch in ipairs(part:GetChildren()) do
                                if ch:IsA("Decal") or ch:IsA("Texture") then
                                    table.insert(texs, ch)
                                    ch.Transparency = 1
                                end
                            end
                            if #texs > 0 and not chamsTextures[part] then
                                chamsTextures[part] = texs
                            end
                            if part:IsA("MeshPart") and part.TextureID ~= "" then
                                part.TextureID = ""
                            end
                            local sMesh = part:FindFirstChildOfClass("SpecialMesh")
                            if sMesh and sMesh.TextureId ~= "" then
                                sMesh.TextureId = ""
                            end
                            part.Material = matEnum
                            part.Color = colVal
                            part.Transparency = transVal
                            part.Reflectance = 0
                        end
                    end
                end
            end
        end
        local renderConn = RunService.RenderStepped:Connect(function()
            local isEnabled = Hypnosis.Settings["Killer Arm Visuals_Enabled"] == true
            if not isEnabled then
                if next(armOriginalSizes) ~= nil then
                    restoreAllArmStretch()
                end
                if
                    next(chamsOriginals) ~= nil
                    or next(chamsSurfaceAppearances) ~= nil
                    or next(chamsTextures) ~= nil
                then
                    restoreAllChams()
                end
                return
            end
            updateVisuals()
        end)
        table.insert(Hypnosis.Connections, renderConn)

        function Hypnosis.ToggleKillerArmVisuals(state)
            UpdateSetting("Killer Arm Visuals_Enabled", state)
            if not state then
                restoreAllArmStretch()
                restoreAllChams()
            end
        end
    end

    function Hypnosis.InitKillerAbilityEngine()
        local ActiveKiller =
            { name = "Unknown Killer", morphKey = "Killer", character = nil, player = nil, abilities = {} }
        Hypnosis.ActiveKillerData = ActiveKiller
        local KILLER_DEFS = Hypnosis.KillerDefs or KILLER_DEFS
        local lastEventTimes = {}

        local function canEmit(name, minDelay)
            local now = os.clock()
            local last = lastEventTimes[name] or 0
            if now - last >= (minDelay or 0.6) then
                lastEventTimes[name] = now
                return true
            end
            return false
        end

        local function pushNotification(titleText, eventText, detailText)
            if Hypnosis.Settings["Killer Ability Notifications_Enabled"] == false then
                return
            end
            local dur = tonumber(Hypnosis.Settings["Killer Ability Notifications_Duration"]) or 3.2
            local title = titleText or "Killer"
            local message = (eventText and eventText ~= "") and eventText or "Ability Activated"
            if detailText and detailText ~= "" then
                message = message .. " (" .. detailText .. ")"
            end
            showNotification(title, message, "info", dur)
        end
        Hypnosis.PushKillerNotification = pushNotification
        local boundCharacters = {}

        local function setupKillerTracking(char, p, morphKey)
            if not char then
                return
            end
            if boundCharacters[char] and ActiveKiller.character == char and ActiveKiller.morphKey == morphKey then
                return
            end
            boundCharacters[char] = true
            boundCharacters[char] = true
            local def = KILLER_DEFS[morphKey]
            if not def and morphKey then
                for k, v in pairs(KILLER_DEFS) do
                    if string.lower(k) == string.lower(tostring(morphKey)) then
                        def = v
                        morphKey = k
                        break
                    end
                end
            end
            def = def or KILLER_DEFS.Killer
            ActiveKiller.name = def.name
            ActiveKiller.morphKey = morphKey
            ActiveKiller.character = char
            ActiveKiller.player = p
            ActiveKiller.abilities = {}
            for abId, abData in pairs(def.abilities) do
                ActiveKiller.abilities[abId] = {
                    name = abData.name,
                    baseCooldown = abData.baseCooldown or 0,
                    duration = abData.duration or 0,
                    fatigue = abData.fatigue or 0,
                    maxCharges = abData.maxCharges or 1,
                    currentCharges = abData.currentCharges or 1,
                    state = "READY",
                    cdEnd = 0,
                    activeEnd = 0,
                    fatigueEnd = 0,
                    nextChargeTime = 0,
                    secondChargeTime = 0,
                }
            end
            local kTitle = def.name .. (p and (" (" .. p.DisplayName .. ")") or "")
            local frenzyConn = char:GetAttributeChangedSignal("Frenzy"):Connect(function()
                local isFrenzy = char:GetAttribute("Frenzy") == true
                local ab = ActiveKiller.abilities["Frenzy"]
                if isFrenzy then
                    if canEmit("FrenzyActive", 0.6) then
                        if ab then
                            ab.state = "ACTIVE"
                            ab.activeEnd = os.clock() + (ab.duration or 13.0)
                        end
                        pushNotification(kTitle, "Feral Frenzy Activated", "Sprint & fast vault active (13.0s)")
                    end
                else
                    if ab and ab.state == "ACTIVE" then
                        if canEmit("FrenzyFatigue", 0.6) then
                            ab.state = "FATIGUE"
                            ab.fatigueEnd = os.clock() + (ab.fatigue or 2.5)
                            pushNotification(kTitle, "Frenzy Fatigue", "Fatigue recovery initiated (2.5s)")
                            task.delay(ab.fatigue or 2.5, function()
                                if ab.state == "FATIGUE" then
                                    ab.state = "COOLDOWN"
                                    ab.cdEnd = os.clock() + (ab.baseCooldown or 15.0)
                                end
                            end)
                        end
                    end
                end
            end)
            table.insert(Hypnosis.Connections, frenzyConn)
            if morphKey == "Veil" then
                local spearsConn = char:GetAttributeChangedSignal("Spears"):Connect(function()
                    local spears = char:GetAttribute("Spears")
                    local ab = ActiveKiller.abilities["PierceWall"]
                    if spears ~= nil and ab then
                        ab.currentCharges = spears
                        local now = os.clock()
                        local recUntil = char:GetAttribute("VeilSpearRecoverUntil") or 0
                        local sNow = workspace:GetServerTimeNow()
                        local rem = math.max(0, recUntil - sNow)
                        if spears == 2 then
                            ab.state = "READY"
                            ab.cdEnd = 0
                            ab.nextChargeTime = 0
                            ab.secondChargeTime = 0
                            pushNotification(kTitle, "Spears Replenished", "Full ammo available (2/2)")
                        elseif spears == 1 then
                            ab.state = "COOLDOWN"
                            local cd = (rem > 0) and rem or 15.0
                            ab.nextChargeTime = now + cd
                            ab.cdEnd = ab.nextChargeTime
                            pushNotification(
                                kTitle,
                                "Spear Discharged",
                                string.format("1/2 remaining (%.1fs cooldown)", cd)
                            )
                        elseif spears == 0 then
                            ab.state = "COOLDOWN"
                            local cd = (rem > 0) and rem or 15.0
                            ab.nextChargeTime = now + cd
                            ab.secondChargeTime = ab.nextChargeTime + 15.0
                            ab.cdEnd = ab.nextChargeTime
                            pushNotification(kTitle, "Spears Depleted", string.format("0/2 ammo (%.1fs cooldown)", cd))
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, spearsConn)
            end
            if morphKey == "Slasher" then
                local mistConn = char:GetAttributeChangedSignal("LakeMist"):Connect(function()
                    local isMist = char:GetAttribute("LakeMist") == true
                    local ab = ActiveKiller.abilities["LakeMist"]
                    if isMist then
                        if canEmit("LakeMistActive", 0.5) then
                            if ab then
                                ab.state = "ACTIVE"
                                ab.activeEnd = os.clock() + 13.0
                            end
                            pushNotification(kTitle, "Lake of Mist Activated", "Invisibility active (up to 13s)")
                        end
                    else
                        if ab and ab.state == "ACTIVE" and canEmit("LakeMistEnd", 0.5) then
                            ab.state = "COOLDOWN"
                            ab.cdEnd = os.clock() + (ab.baseCooldown or 30.0)
                            pushNotification(
                                kTitle,
                                "Lake of Mist Ended",
                                string.format("%.0fs Cooldown initiated", ab.baseCooldown or 30)
                            )
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, mistConn)
                local pursuitConn = char:GetAttributeChangedSignal("Pursuit"):Connect(function()
                    if char:GetAttribute("Pursuit") == true and canEmit("PursuitActive", 0.8) then
                        local ab = ActiveKiller.abilities["Pursuit"]
                        if ab then
                            ab.state = "ACTIVE"
                            ab.activeEnd = os.clock() + 22.0
                            task.delay(22.0, function()
                                if ab.state == "ACTIVE" then
                                    ab.state = "COOLDOWN"
                                    ab.cdEnd = os.clock() + (ab.baseCooldown or 60.0)
                                end
                            end)
                        end
                        pushNotification(kTitle, "Pursuit Activated", "Speed surge active (22.0s)")
                    end
                end)
                table.insert(Hypnosis.Connections, pursuitConn)
            end
            if morphKey == "Cure" then
                local lastLand = 0
                local flaskConn = char:GetAttributeChangedSignal("FlaskLandAt"):Connect(function()
                    local landAt = char:GetAttribute("FlaskLandAt")
                    if type(landAt) == "number" and landAt > 0 and landAt ~= lastLand then
                        lastLand = landAt
                        local ab = ActiveKiller.abilities["Elucidation"]
                        if ab and canEmit("CureFlask", 0.8) then
                            ab.state = "COOLDOWN"
                            ab.cdEnd = os.clock() + 15.0
                            pushNotification(kTitle, "Elucidation", "Pestilence flask thrown (15s cd)")
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, flaskConn)
                local corpseConn = char:GetAttributeChangedSignal("corpsecharge"):Connect(function()
                    local charges = char:GetAttribute("corpsecharge") or 0
                    local ab = ActiveKiller.abilities["Syringe"]
                    if ab then
                        local prev = ab.currentCharges or 0
                        ab.currentCharges = charges
                        if charges > prev then
                            pushNotification(
                                kTitle,
                                "Syringe Refilled",
                                string.format("Syringe gained charge (%d available)", charges)
                            )
                        elseif charges < prev then
                            pushNotification(
                                kTitle,
                                "Syringe Used",
                                string.format("Syringe charge used (%d remaining)", charges)
                            )
                        end
                    end
                end)
                table.insert(Hypnosis.Connections, corpseConn)
            end
            if morphKey == "Butcher" then
                local trapConn = char:GetAttributeChangedSignal("PlacingTrap"):Connect(function()
                    local placing = char:GetAttribute("PlacingTrap") == true
                    if placing and canEmit("ButcherTrap", 1.0) then
                        local ab = ActiveKiller.abilities["PlaceTrap"]
                        if ab then
                            ab.currentCharges = math.max(0, (ab.currentCharges or 2) - 1)
                            ab.state = "COOLDOWN"
                            ab.nextChargeTime = os.clock() + 45.0
                            ab.cdEnd = ab.nextChargeTime
                        end
                        pushNotification(kTitle, "Bear Trap Set", "Trap installed (45s recharge)")
                    end
                end)
                table.insert(Hypnosis.Connections, trapConn)
            end
            if morphKey == "Masked" then
                local maskConn = char:GetAttributeChangedSignal("Mask"):Connect(function()
                    local mask = char:GetAttribute("Mask")
                    local ab = ActiveKiller.abilities["MaskUp"]
                    if type(mask) == "string" and mask ~= "" and mask ~= "Richard" and canEmit("MaskEquip", 1.0) then
                        if ab then
                            ab.state = "ACTIVE"
                            ab.activeEnd = os.clock() + 64.0
                        end
                        pushNotification(kTitle, "Mask Equipped", "Equipped: " .. mask .. " (64s duration)")
                    elseif mask == "Richard" and canEmit("MaskRemove", 1.0) then
                        if ab then
                            ab.state = "COOLDOWN"
                            ab.cdEnd = os.clock() + 30.0
                        end
                        pushNotification(kTitle, "Mask Expired", "Returned to Richard (30s cd)")
                    end
                end)
                table.insert(Hypnosis.Connections, maskConn)
            end
            if morphKey == "Stalker" then
                local stageConn = char:GetAttributeChangedSignal("Stage"):Connect(function()
                    local st = char:GetAttribute("Stage")
                    if st == 2 and canEmit("StalkerStage2", 1.0) then
                        local ab = ActiveKiller.abilities["StalkerMode"]
                        if ab then
                            ab.state = "COOLDOWN"
                            ab.cdEnd = os.clock() + 70.0
                        end
                        pushNotification(kTitle, "Evil's Grasp Landed", "Entered Phase 2 surge (70s cd)")
                    end
                end)
                table.insert(Hypnosis.Connections, stageConn)
            end
        end

        local function scanForKiller()
            for _, p in ipairs(Players:GetPlayers()) do
                local char = p.Character or (workspace and workspace:FindFirstChild(p.Name))
                if char and isKiller(p) then
                    local arch = getKillerArchetype(char)
                    setupKillerTracking(char, p, arch)
                    return
                end
            end
            for _, obj in ipairs(workspace:GetChildren()) do
                if
                    obj:IsA("Model")
                    and (
                        obj:FindFirstChild("MorphedKiller")
                        or obj:FindFirstChild("KillerScript")
                        or obj:FindFirstChild("KillerRoot")
                    )
                then
                    local p = Players:GetPlayerFromCharacter(obj)
                    local arch = getKillerArchetype(obj)
                    setupKillerTracking(obj, p, arch)
                    return
                end
            end
        end
        local scanTimer = 0
        local heartbeatConn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - scanTimer >= 2.0 then
                scanTimer = now
                scanForKiller()
            end
            if ActiveKiller.abilities then
                for _, ab in pairs(ActiveKiller.abilities) do
                    if ab.state == "ACTIVE" and ab.activeEnd and now >= ab.activeEnd then
                        if ab.baseCooldown and ab.baseCooldown > 0 then
                            ab.state = "COOLDOWN"
                            ab.cdEnd = now + ab.baseCooldown
                        else
                            ab.state = "READY"
                        end
                    elseif ab.state == "COOLDOWN" and ab.cdEnd and now >= ab.cdEnd then
                        ab.state = "READY"
                    end
                end
            end
        end)
        table.insert(Hypnosis.Connections, heartbeatConn)
        scanForKiller()
    end

    function Hypnosis.InitStatusBanner()
