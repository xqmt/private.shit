                hBox.Position = UDim2.new(0, ap.X, 0, ap.Y)
                hBox.Size = UDim2.new(0, math.max(as.X, 16), 0, math.max(as.Y, 16))
                hBox.Visible = Hypnosis.GuiChanger.OutlinesVisible
