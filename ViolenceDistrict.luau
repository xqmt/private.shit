        function Hypnosis.MobileKeybindsSync(changedKey)
            if type(changedKey) == "string" and changedKey:sub(1, 15) == "Mobile Keybinds" then
                if changedKey == "Mobile Keybinds_ButtonTransparency" then
                    Hypnosis.SyncMobileKeybindStates()
                else
                    Hypnosis.RebuildMobileKeybinds()
                end
            else
                Hypnosis.SyncMobileKeybindStates()
            end
        end

        function Hypnosis.ResetMobileKeybindPositions()
            if MobileButton and MobileButton.Parent then
                MobileButton.Position = UDim2.new(0, 14, 0.45, 0)
            end
            for _, bindData in ipairs(Hypnosis.RegisteredKeybinds or {}) do
                local posKey = (bindData.SettingKey or bindData.Name) .. "_MobPos"
                if Hypnosis.Settings[posKey] ~= nil and Hypnosis.Settings[posKey] ~= "" then
                    UpdateSetting(posKey, "")
                end
            end
            Hypnosis.RebuildMobileKeybinds()
            showNotification("Mobile Keybinds", "Reset mobile button positions to default layout.", "info", 2.0)
        end

        function Hypnosis.IsPointOverMobileKeybinds(pos)
            if not pos or Hypnosis.Settings["Mobile Keybinds_Enabled"] ~= true then
                return false
            end
            local inset = Vector2.zero
            if GuiService then
                local ok, gi = pcall(function()
                    return GuiService:GetGuiInset()
                end)
                if ok and gi then
                    inset = gi
                end
            end
            for _, entry in pairs(activeEntriesById) do
                local btn = entry.Button
                if btn and btn.Parent and btn.Visible then
                    local p = btn.AbsolutePosition
                    local s = btn.AbsoluteSize
                    if s.X > 0 and s.Y > 0 then
                        if
                            (pos.X >= p.X and pos.X <= (p.X + s.X) and pos.Y >= p.Y and pos.Y <= (p.Y + s.Y))
                            or (
                                pos.X >= p.X
                                and pos.X <= (p.X + s.X)
                                and (pos.Y - inset.Y) >= p.Y
                                and (pos.Y - inset.Y) <= (p.Y + s.Y)
                            )
                        then
                            return true
                        end
                    end
                end
            end
            return false
        end
        ThemeHook(function()
            Hypnosis.SyncMobileKeybindStates()
        end)
        RegisterSetting("Mobile Keybinds_Enabled", isMobile, function()
