        local activePromptGui, activeCheckObj, activeLineObj, activeGoalObj, activeTrapGoalObj, activeTrapPerfectObj =
            nil, nil, nil, nil, nil, nil
        local activeIsTrapSkill = false
        local activePrevGoalRot = nil

        local function isCheckConsumed()
            if not activeCheckObj or not activeCheckObj.Parent or not activeCheckObj.Visible then
                return true
            end
            if activePromptGui and activePromptGui:IsA("LayerCollector") and not activePromptGui.Enabled then
