                local cam = workspace.CurrentCamera
                if cam then
                    vpConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateNotifContainerBounds)
                    table.insert(Hypnosis.Connections, vpConn)
                end
            end
            bindViewportResize()
            table.insert(
