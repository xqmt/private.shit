                    local hS = Instance.new("UIStroke", hBox)
                    hS.Color = Color3.fromRGB(75, 75, 75)
                    hS.Thickness = 1
                    Hypnosis.GuiChanger.HoverBox = hBox
                end
                local ap = target.Element.AbsolutePosition
